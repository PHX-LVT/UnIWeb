<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="DevExpress 25.2 Local" value="%ProgramFiles%\DevExpress 25.2\Components\System\Components\Packages" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="DevExpress 25.2 Local">
      <package pattern="DevExpress.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
