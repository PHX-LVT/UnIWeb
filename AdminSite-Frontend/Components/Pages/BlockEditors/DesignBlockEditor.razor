@inject AdminBlockService BlockService
@inject IHttpService Http
@inject AdminFormSubmissionService FormService
@using Contracts.Admin
@using Microsoft.AspNetCore.Components.Forms

@if (Block.Type is "card" or "metric" or "step" or "icon")
{
    <div class="form-group">
        <label class="form-label">@T("IconClass")</label>
        <DxTextBox @bind-Text="_icon" CssClass="w-100" NullText="fas fa-star" />
    </div>
}

@if (Block.Type == "card")
{
    <div class="form-group">
        <label class="form-label">@T("Image")</label>
        @if (!string.IsNullOrWhiteSpace(_imageUrl))
        {
            <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.5rem">
                <img src="@_imageUrl"
                     style="width:120px;height:78px;object-fit:cover;border-radius:6px;border:1px solid var(--border)" />
                <button type="button" class="btn-admin btn-ghost" @onclick="ClearImage">
                    <i class="fas fa-times"></i> @T("Remove")
                </button>
            </div>
        }
        <InputFile id="card-block-upload" OnChange="OnImageSelected" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />
        <label class="btn-admin btn-ghost" for="card-block-upload">
            <i class="fas fa-upload"></i> @T("UploadNew")
        </label>
        <button type="button" class="btn-admin btn-ghost" @onclick="() => _resourcePickerOpen = true">
            <i class="fas fa-photo-film"></i> @T("ChooseFromResourceLibrary")
        </button>
    </div>

    <ResourcePickerModal Open="_resourcePickerOpen" Kind="image"
                         ResourceSelected="SelectResourceImage"
                         Closed="() => _resourcePickerOpen = false" />
}

@if (Block.Type is "card" or "bullet-list" or "step" or "container")
{
    <div class="form-group">
        <label class="form-label">@T("Title")</label>
        <LangField @bind-Value="_title" Languages="Languages" />
    </div>
}

@if (Block.Type is "button" or "metric" or "icon")
{
    <div class="form-group">
        <label class="form-label">@T("Label")</label>
        <LangField @bind-Value="_label" Languages="Languages" />
    </div>
}

@if (Block.Type == "step")
{
    <div class="form-group">
        <label class="form-label">@T("StepLabel")</label>
        <LangField @bind-Value="_stepLabel" Languages="Languages" NullText="01" />
    </div>
}

@if (Block.Type is "card" or "metric" or "step" or "icon")
{
    <div class="form-group">
        <label class="form-label">@T("Description")</label>
        <LangField @bind-Value="_description" Languages="Languages" Multiline="true" />
    </div>
}

@if (Block.Type == "metric")
{
    <div style="display:grid;grid-template-columns:1fr 2fr 1fr;gap:.75rem">
        <div class="form-group">
            <label class="form-label">@T("Prefix")</label>
            <DxTextBox @bind-Text="_prefix" CssClass="w-100" />
        </div>
        <div class="form-group">
            <label class="form-label">@T("Value")</label>
            <DxTextBox @bind-Text="_value" CssClass="w-100" NullText="98" />
        </div>
        <div class="form-group">
            <label class="form-label">@T("Suffix")</label>
            <DxTextBox @bind-Text="_suffix" CssClass="w-100" />
        </div>
    </div>
}

@if (Block.Type is "button" or "card")
{
    @if (Block.Type == "card")
    {
        <div class="form-group">
            <label class="form-label">@T("ButtonLabel")</label>
            <LangField @bind-Value="_buttonLabel" Languages="Languages" NullText="Learn More" />
        </div>
    }
    <div style="display:grid;grid-template-columns:minmax(0,1fr);gap:.75rem">
        <ButtonActionFields @bind-Action="_action"
                            @bind-Href="_href"
                            @bind-FormDefinitionId="_formDefinitionId"
                            FormDefinitions="_formDefinitions"
                            ExternalActionValue="externalUrl"
                            DownloadActionValue="downloadFile"
                            AdminLanguage="AdminLanguage" />
    </div>
}

@if (Block.Type == "bullet-list")
{
    <div class="form-group">
        <label class="form-label">@T("Items")</label>
        @foreach (var (item, i) in _items.Select((item, index) => (item, index)))
        {
            <div class="design-list-item">
                <DxTextBox @bind-Text="item.Icon" NullText="fas fa-check" />
                <LangField Value="@(item.Text ?? new())"
                           ValueChanged="@(v => item.Text = v)"
                           Languages="Languages" />
                <button type="button" class="btn-admin btn-danger" @onclick="() => RemoveItem(i)">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        }
        <button type="button" class="btn-admin btn-outline" @onclick="AddItem">
            <i class="fas fa-plus"></i> @T("AddItem")
        </button>
    </div>
}

<div style="display:flex;justify-content:flex-end;margin-top:.75rem">
    <button class="btn-admin btn-primary" @onclick="Save" disabled="@_saving">
        <i class="fas fa-save"></i> @(_saving ? T("Saving") : T("Save"))
    </button>
</div>

<style>
    .design-list-item {
        display: grid;
        grid-template-columns: 150px minmax(0, 1fr) 42px;
        gap: .5rem;
        align-items: start;
        margin-bottom: .5rem;
    }
</style>

@code {
    [Parameter] public BlockModel Block { get; set; } = new();
    [Parameter] public string PageId { get; set; } = string.Empty;
    [Parameter] public string SectionId { get; set; } = string.Empty;
    [Parameter] public List<string> Languages { get; set; } = new() { "en" };
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";

    private string _icon = string.Empty;
    private string? _imageUrl;
    private BlockAssetReferenceModel _cardAsset = new();
    private bool _resourcePickerOpen;
    private Dictionary<string, string> _title = new();
    private Dictionary<string, string> _label = new();
    private Dictionary<string, string> _stepLabel = new();
    private Dictionary<string, string> _description = new();
    private Dictionary<string, string> _buttonLabel = new();
    private string? _href;
    private string _action = "linkToPage";
    private string? _formDefinitionId;
    private string _style = "filled";
    private string? _value;
    private string? _prefix;
    private string? _suffix;
    private List<BulletListItemModel> _items = new();
    private bool _saving;
    private string _layoutMode = "stack";
    private int _columns = 2;
    private string _gap = "medium";
    private string _alignItems = "stretch";
    private string _justifyContent = "start";
    private bool _wrap = true;
    private int _orbitRadius = 180;
    private int _orbitStartAngle = -90;
    private int _orbitEndAngle = 270;
    private string _orbitDirection = "clockwise";
    private int _compactRadius = 120;
    private int _compactChildWidth = 120;
    private int _semicircleRadius = 180;
    private int _semicircleStartAngle = 180;
    private int _semicircleEndAngle = 360;
    private string _containerMobileMode = "stack";
    private bool _containerGeometryLocked;
    private string _containerPurpose = "composition";
    private string? _allowedChildType;
    private bool _shareAppearance;
    private BlockAppearanceModel _sharedAppearance = new() { SchemaVersion = 2, BackgroundColor = "#ffffff", TextColor = "#0f172a" };
    private BlockAppearanceModel _appearance = new();
    private BlockResponsiveOverrideModel? _tabletResponsive;
    private BlockResponsiveOverrideModel? _mobileResponsive;
    private List<FormDefinitionModel> _formDefinitions = new();
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    protected override async Task OnInitializedAsync()
    {
        var forms = await FormService.GetDefinitionsAsync();
        _formDefinitions = forms.Data ?? new();
    }

    protected override void OnParametersSet()
    {
        _icon = Block.Icon ?? string.Empty;
        _cardAsset = CopyAsset(Block.Asset, Block.ImageUrl);
        _imageUrl = _cardAsset.Url;
        _title = new(Block.Title ?? new());
        _label = new(Block.Label ?? new());
        _stepLabel = new(Block.StepLabel ?? new());
        _description = new(Block.Description ?? new());
        _buttonLabel = new(Block.ButtonLabel ?? new());
        _href = Block.Href;
        _action = NormalizeButtonAction(Block.Action);
        _formDefinitionId = Block.FormDefinitionId;
        _style = NormalizeButtonStyle(Block.Style);
        _value = Block.Value;
        _prefix = Block.Prefix;
        _suffix = Block.Suffix;
        _layoutMode = NormalizeContainerLayout(Block.LayoutMode);
        _columns = Math.Clamp(Block.Columns ?? 2, 1, 6);
        _gap = NormalizeGap(Block.Gap);
        _alignItems = NormalizeAlignItems(Block.ContainerLayout.AlignItems);
        _justifyContent = NormalizeJustifyContent(Block.ContainerLayout.JustifyContent);
        _wrap = Block.ContainerLayout.Wrap;
        _orbitRadius = Math.Clamp(Block.OrbitRadius ?? 180, 80, 480);
        _orbitStartAngle = Math.Clamp(Block.OrbitStartAngle ?? -90, -360, 360);
        _orbitEndAngle = Math.Clamp(Block.ContainerLayout.OrbitEndAngle, -360, 360);
        _orbitDirection = NormalizeOrbitDirection(Block.ContainerLayout.OrbitDirection);
        _compactRadius = Math.Clamp(Block.ContainerLayout.CompactRadius, 60, 220);
        _compactChildWidth = Math.Clamp(Block.ContainerLayout.CompactChildWidth, 72, 180);
        _semicircleRadius = Math.Clamp(Block.SemicircleRadius ?? 180, 80, 480);
        _semicircleStartAngle = Math.Clamp(Block.SemicircleStartAngle ?? 180, -360, 360);
        _semicircleEndAngle = Math.Clamp(Block.SemicircleEndAngle ?? 360, -360, 360);
        _containerMobileMode = NormalizeResponsiveMode(Block.ContainerLayout.MobileMode, "stack");
        _containerGeometryLocked = Block.ContainerLayout.GeometryLocked;
        _containerPurpose = NormalizeContainerPurpose(Block.ContainerLayout.Purpose);
        _allowedChildType = Block.ContainerLayout.AllowedChildType;
        _shareAppearance = Block.ContainerLayout.ShareAppearance;
        _sharedAppearance = CopyAppearance(Block.ContainerLayout.SharedAppearance, null);
        _sharedAppearance.BackgroundColor ??= "#ffffff";
        _sharedAppearance.TextColor ??= "#0f172a";
        _appearance = CopyAppearance(Block.Appearance, Block.Layout);
        _tabletResponsive = CopyResponsive(Block.Responsive.Tablet);
        _mobileResponsive = CopyResponsive(Block.Responsive.Mobile);
        _items = Block.BulletItems?.Select(i => new BulletListItemModel
        {
            Id = i.Id,
            Icon = i.Icon,
            Text = new(i.Text ?? new()),
            Visible = i.Visible,
            Order = i.Order
        }).ToList() ?? new();
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        const long maxImageBytes = 20L * 1024 * 1024;
        if (file.Size > maxImageBytes)
        {
            Http.Notify(T("ImageTooLarge"), 400);
            return;
        }

        var res = await Http.PostFileAsync<AssetUploadModel>("api/admin/assets/upload?folder=card-blocks", file, maxBytes: maxImageBytes);
        if (res.Success && res.Data is not null)
        {
            _cardAsset = DirectAsset(res.Data);
            _imageUrl = _cardAsset.Url;
            Http.Notify(T("ImageUploaded"), res.StatusCode);
        }
        else
        {
            Http.Notify(res.Message ?? T("ImageUploadFailed"), res.StatusCode);
        }
    }

    private void ClearImage()
    {
        _imageUrl = string.Empty;
        _cardAsset = new();
    }

    private void AddItem() => _items.Add(new BulletListItemModel
    {
        Icon = "fas fa-check",
        Text = new(),
        Visible = true,
        Order = _items.Count
    });

    private void RemoveItem(int index)
    {
        if (index < 0 || index >= _items.Count) return;
        _items.RemoveAt(index);
        for (var i = 0; i < _items.Count; i++) _items[i].Order = i;
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var res = await BlockService.UpdateAsync(PageId, SectionId, Block.Id, BuildDto());
            Http.Notify(res.Message, res.StatusCode);
            if (res.Success) await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private BlockUpdateDto BuildDto()
    {
        var dto = BuildContentDto();
        dto.Appearance = ToAppearanceDto(_appearance);
        dto.Responsive = new BlockResponsiveSettingsDto
        {
            SchemaVersion = 1,
            Tablet = ToResponsiveDto(_tabletResponsive),
            Mobile = ToResponsiveDto(_mobileResponsive)
        };
        dto.Animation = new BlockAnimationSettingsDto
        {
            SchemaVersion = 1,
            Effect = Block.Animation.Effect,
            Trigger = Block.Animation.Trigger,
            DurationMs = Block.Animation.DurationMs,
            DelayMs = Block.Animation.DelayMs,
            Easing = Block.Animation.Easing,
            PlayOnce = Block.Animation.PlayOnce,
            StaggerMs = Block.Animation.StaggerMs,
            ContinuousEffect = Block.Animation.ContinuousEffect,
            DisableForReducedMotion = Block.Animation.DisableForReducedMotion
        };
        dto.Authoring = BlockUpdateDtoMapper.ToAuthoringDto(Block.Authoring);

        if (dto is ContainerBlockUpdateDto containerDto)
        {
            containerDto.ContainerLayout = new ContainerLayoutSettingsDto
            {
                SchemaVersion = 2,
                Purpose = NormalizeContainerPurpose(_containerPurpose),
                AllowedChildType = NormalizeContainerPurpose(_containerPurpose) == "collection" ? _allowedChildType : null,
                Mode = NormalizeContainerLayout(_layoutMode),
                Columns = Math.Clamp(_columns, 1, 6),
                Gap = NormalizeGap(_gap),
                AlignItems = NormalizeAlignItems(_alignItems),
                JustifyContent = NormalizeJustifyContent(_justifyContent),
                Wrap = _wrap,
                OrbitRadius = Math.Clamp(_orbitRadius, 80, 480),
                OrbitStartAngle = Math.Clamp(_orbitStartAngle, -360, 360),
                OrbitEndAngle = Math.Clamp(_orbitEndAngle, -360, 360),
                OrbitDirection = NormalizeOrbitDirection(_orbitDirection),
                SemicircleRadius = Math.Clamp(_semicircleRadius, 80, 480),
                SemicircleStartAngle = Math.Clamp(_semicircleStartAngle, -360, 360),
                SemicircleEndAngle = Math.Clamp(_semicircleEndAngle, -360, 360),
                MobileMode = NormalizeResponsiveMode(_containerMobileMode, "stack"),
                CompactRadius = Math.Clamp(_compactRadius, 60, 220),
                CompactChildWidth = Math.Clamp(_compactChildWidth, 72, 180),
                GeometryLocked = _containerGeometryLocked,
                ShareAppearance = _shareAppearance,
                SharedAppearance = _shareAppearance ? ToAppearanceDto(_sharedAppearance) : null
            };
        }

        return dto;
    }

    private static BlockAppearanceDto ToAppearanceDto(BlockAppearanceModel value) => new()
    {
        SchemaVersion = 2,
        BackgroundMode = value.BackgroundMode,
        BackgroundColor = OptionalText(value.BackgroundColor),
        TextColor = OptionalText(value.TextColor),
        TextAlign = value.TextAlign,
        Opacity = Math.Clamp(value.Opacity, 0, 1),
        BorderColor = OptionalText(value.BorderColor),
        BorderWidth = Math.Clamp(value.BorderWidth, 0, 20),
        BorderStyle = NormalizeBorderStyle(value.BorderStyle),
        BorderRadius = NormalizeRadius(value.BorderRadius),
        Shadow = NormalizeShadow(value.Shadow),
        Shape = NormalizeShape(value.Shape),
        AspectRatio = value.AspectRatio,
        MediaFit = value.MediaFit,
        MediaPosition = value.MediaPosition,
        Padding = NormalizeSpacing(value.Padding),
        Margin = NormalizeSpacing(value.Margin),
        Decorative = value.Decorative,
        InheritFromContainer = value.InheritFromContainer
    };

    private static string NormalizeContainerPurpose(string? value) => value == "collection" ? "collection" : "composition";
    private static string BlockTypeLabelKey(string? type) => type switch
    {
        "image" => "Image", "video" => "Video", "file" => "File", "map" => "Map", "form" => "Form",
        "card" => "Card", "button" => "Button", "metric" => "Metric", "bullet-list" => "BulletList",
        "step" => "Step", "icon" => "Icon", "container" => "Container", _ => "Text"
    };

    private void SelectResourceImage(ManagedResourceModel resource)
    {
        _cardAsset = new BlockAssetReferenceModel
        {
            SchemaVersion = 1,
            Url = resource.Url,
            ResourceId = resource.Id,
            ResourceSource = "ManagedResource",
            StorageKey = resource.StorageKey,
            FileName = resource.FileName,
            ContentType = resource.ContentType,
            SizeBytes = resource.SizeBytes
        };
        _imageUrl = resource.Url;
    }

    private static BlockAssetReferenceModel CopyAsset(BlockAssetReferenceModel? asset, string? legacyUrl) => new()
    {
        SchemaVersion = 1,
        Url = asset?.Url ?? legacyUrl,
        ResourceId = asset?.ResourceId,
        ResourceSource = asset?.ResourceSource ?? "DirectUpload",
        StorageKey = asset?.StorageKey,
        FileName = asset?.FileName,
        ContentType = asset?.ContentType,
        SizeBytes = asset?.SizeBytes ?? 0
    };

    private static BlockAssetReferenceModel DirectAsset(AssetUploadModel upload) => new()
    {
        SchemaVersion = 1,
        Url = upload.Url,
        ResourceSource = "DirectUpload",
        StorageKey = upload.StorageKey,
        FileName = upload.FileName,
        ContentType = upload.ContentType,
        SizeBytes = upload.Size
    };

    private static BlockAssetReferenceDto AssetDto(BlockAssetReferenceModel asset) => new()
    {
        SchemaVersion = 1,
        Url = asset.Url,
        ResourceId = asset.ResourceId,
        ResourceSource = asset.ResourceSource,
        StorageKey = asset.StorageKey,
        FileName = asset.FileName,
        ContentType = asset.ContentType,
        SizeBytes = asset.SizeBytes
    };

    private BlockUpdateDto BuildContentDto() => Block.Type switch
    {
        "card" => new CardBlockUpdateDto
        {
            Icon = _icon,
            Title = _title,
            Description = _description,
            Asset = AssetDto(_cardAsset),
            ImageUrl = _imageUrl,
            ButtonLabel = _buttonLabel,
            Href = _href,
            Action = _action,
            FormDefinitionId = _formDefinitionId,
            Visible = Block.Visible,
            Layout = ToLayoutDto()
        },
        "button" => new ButtonBlockUpdateDto
        {
            Label = _label,
            Href = _href,
            Action = _action,
            FormDefinitionId = _formDefinitionId,
            Style = NormalizeButtonStyle(_style),
            Visible = Block.Visible,
            Layout = ToLayoutDto()
        },
        "metric" => new MetricBlockUpdateDto
        {
            Icon = _icon,
            Label = _label,
            Value = _value ?? string.Empty,
            Prefix = _prefix,
            Suffix = _suffix,
            Description = _description,
            Visible = Block.Visible,
            Layout = ToLayoutDto()
        },
        "bullet-list" => new BulletListBlockUpdateDto
        {
            Title = _title,
            Items = _items.Select((item, i) => new BulletListItemDto
            {
                Id = item.Id,
                Icon = item.Icon,
                Text = item.Text ?? new(),
                Visible = item.Visible,
                Order = i
            }).ToList(),
            Visible = Block.Visible,
            Layout = ToLayoutDto()
        },
        "step" => new StepBlockUpdateDto
        {
            Icon = _icon,
            StepLabel = _stepLabel,
            Title = _title,
            Description = _description,
            Visible = Block.Visible,
            Layout = ToLayoutDto()
        },
        "icon" => new IconBlockUpdateDto
        {
            Icon = _icon,
            Label = _label,
            Description = _description,
            Visible = Block.Visible,
            Layout = ToLayoutDto()
        },
        "container" => new ContainerBlockUpdateDto
        {
            Title = _title,
            Visible = Block.Visible,
            Layout = ToLayoutDto()
        },
        _ => new IconBlockUpdateDto { Visible = Block.Visible, Layout = ToLayoutDto() }
    };

    private static BlockResponsiveOverrideDto? ToResponsiveDto(BlockResponsiveOverrideModel? value) =>
        value is null ? null : new()
        {
            Mode = NormalizeResponsiveMode(value.Mode, "inherit"),
            Width = NormalizeResponsiveWidth(value.Width),
            ColumnSpan = ClampNullable(value.ColumnSpan, 1, 12),
            LeftPercent = ClampNullable(value.LeftPercent, 0, 100),
            TopPx = ClampNullable(value.TopPx, 0, 10000),
            WidthPercent = ClampNullable(value.WidthPercent, 1, 100),
            HeightPx = ClampNullable(value.HeightPx, 24, 10000)
        };

    private BlockLayoutDto? ToLayoutDto() => Block.Layout is null ? null : new BlockLayoutDto
    {
        Width = Block.Layout.Width,
        ColumnSpan = Block.Layout.ColumnSpan,
        Align = Block.Layout.Align,
        Justify = Block.Layout.Justify,
        Padding = Block.Layout.Padding,
        Margin = Block.Layout.Margin,
        BackgroundColor = Block.Layout.BackgroundColor,
        BorderRadius = Block.Layout.BorderRadius,
        ZIndex = Block.Layout.ZIndex,
        X = Block.Layout.X,
        Y = Block.Layout.Y,
        W = Block.Layout.W,
        H = Block.Layout.H,
        LeftPercent = Block.Layout.LeftPercent,
        TopPx = Block.Layout.TopPx,
        WidthPercent = Block.Layout.WidthPercent,
        HeightPx = Block.Layout.HeightPx
    };

    private static string NormalizeButtonAction(string? action) => action switch
    {
        "openForm" or "OpenForm" or "OpenModal" => "openForm",
        "externalUrl" or "ExternalUrl" => "externalUrl",
        "downloadFile" or "DownloadFile" => "downloadFile",
        _ => "linkToPage"
    };

    private static bool IsOpenFormAction(string? action) =>
        string.Equals(action, "openForm", StringComparison.OrdinalIgnoreCase)
        || string.Equals(action, "OpenForm", StringComparison.OrdinalIgnoreCase)
        || string.Equals(action, "OpenModal", StringComparison.OrdinalIgnoreCase);

    private static string NormalizeButtonStyle(string? style) => style switch
    {
        "outline" => "outline",
        "ghost" => "ghost",
        _ => "filled"
    };

    private static string NormalizeContainerLayout(string? value) => value switch
    {
        "row" => "row",
        "grid" => "grid",
        "split" => "split",
        "orbit" => "orbit",
        "semicircle" => "semicircle",
        "freeform" => "freeform",
        _ => "stack"
    };

    private static string NormalizeGap(string? value) => value switch
    {
        "none" => "none",
        "small" => "small",
        "large" => "large",
        _ => "medium"
    };

    private static string NormalizeAlignItems(string? value) => value switch
    {
        "start" => "start",
        "center" => "center",
        "end" => "end",
        _ => "stretch"
    };

    private static string NormalizeJustifyContent(string? value) => value switch
    {
        "center" => "center",
        "end" => "end",
        "between" => "between",
        "around" => "around",
        "evenly" => "evenly",
        _ => "start"
    };

    private static string NormalizeOrbitDirection(string? value) =>
        value == "counter-clockwise" ? "counter-clockwise" : "clockwise";

    private static BlockAppearanceModel CopyAppearance(BlockAppearanceModel? source, BlockLayoutModel? legacyLayout) => new()
    {
        SchemaVersion = Math.Max(source?.SchemaVersion ?? 0, 2),
        BackgroundMode = source?.SchemaVersion < 2 &&
            !string.IsNullOrWhiteSpace(source?.BackgroundColor ?? legacyLayout?.BackgroundColor)
                ? "color"
                : source?.BackgroundMode ??
            (string.IsNullOrWhiteSpace(source?.BackgroundColor ?? legacyLayout?.BackgroundColor) ? "none" : "color"),
        BackgroundColor = source?.BackgroundColor ?? legacyLayout?.BackgroundColor,
        TextColor = source?.TextColor,
        TextAlign = source?.TextAlign ?? "inherit",
        Opacity = Math.Clamp(source?.Opacity ?? 1, 0, 1),
        BorderColor = source?.BorderColor,
        BorderWidth = Math.Clamp(source?.BorderWidth ?? 0, 0, 20),
        BorderStyle = NormalizeBorderStyle(source?.BorderStyle),
        BorderRadius = NormalizeRadius(source?.BorderRadius ?? legacyLayout?.BorderRadius),
        Shadow = NormalizeShadow(source?.Shadow),
        Shape = NormalizeShape(source?.Shape),
        AspectRatio = source?.AspectRatio ?? "auto",
        MediaFit = source?.MediaFit ?? "cover",
        MediaPosition = source?.MediaPosition ?? "center",
        Padding = NormalizeSpacing(source?.Padding ?? legacyLayout?.Padding),
        Margin = NormalizeSpacing(source?.Margin ?? legacyLayout?.Margin),
        Decorative = source?.Decorative ?? false,
        InheritFromContainer = source?.InheritFromContainer ?? false
    };

    private static BlockResponsiveOverrideModel? CopyResponsive(BlockResponsiveOverrideModel? source) =>
        source is null ? null : new BlockResponsiveOverrideModel
        {
            Mode = NormalizeResponsiveMode(source.Mode, "inherit"),
            Width = NormalizeResponsiveWidth(source.Width),
            ColumnSpan = ClampNullable(source.ColumnSpan, 1, 12),
            LeftPercent = ClampNullable(source.LeftPercent, 0, 100),
            TopPx = ClampNullable(source.TopPx, 0, 10000),
            WidthPercent = ClampNullable(source.WidthPercent, 1, 100),
            HeightPx = ClampNullable(source.HeightPx, 24, 10000)
        };

    private static string NormalizeResponsiveMode(string? value, string fallback) => value switch
    {
        "stack" => "stack",
        "scroll" => "horizontal-scroll",
        "preserve" => "compact-preserve",
        "compact-preserve" => "compact-preserve",
        "horizontal-scroll" => "horizontal-scroll",
        "custom" => "custom",
        "hide" => "hide",
        "inherit" => "inherit",
        _ => fallback
    };

    private static string NormalizeResponsiveWidth(string? value) => value switch
    {
        "auto" => "auto",
        "full" => "full",
        "half" => "half",
        "third" => "third",
        "custom" => "custom",
        _ => "inherit"
    };

    private static string NormalizeRadius(string? value) => value switch
    {
        "small" => "small",
        "medium" => "medium",
        "large" => "large",
        "pill" => "pill",
        "circle" => "circle",
        _ => "none"
    };

    private static string NormalizeShadow(string? value) => value switch
    {
        "small" => "small",
        "medium" => "medium",
        "large" => "large",
        _ => "none"
    };

    private static string NormalizeShape(string? value) => value switch
    {
        "rounded" => "rounded",
        "pill" => "pill",
        "circle" => "circle",
        "ellipse" => "ellipse",
        "decorative" => "decorative",
        _ => "rectangle"
    };

    private static string NormalizeSpacing(string? value) => value switch
    {
        "small" => "small",
        "medium" => "medium",
        "large" => "large",
        _ => "none"
    };

    private static string NormalizeBorderStyle(string? value) => value switch
    {
        "dashed" => "dashed",
        "dotted" => "dotted",
        "none" => "none",
        _ => "solid"
    };

    private static string? OptionalText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static int? ClampNullable(int? value, int min, int max) =>
        value.HasValue ? Math.Clamp(value.Value, min, max) : null;

    private static double? ClampNullable(double? value, double min, double max) =>
        value.HasValue ? Math.Clamp(value.Value, min, max) : null;

}
