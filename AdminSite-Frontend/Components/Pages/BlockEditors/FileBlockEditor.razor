@inject AdminBlockService BlockService
@inject IHttpService Http
@using Contracts.Admin

<div class="form-group">
    <label class="form-label">@T("File")</label>
    @if (!string.IsNullOrWhiteSpace(_asset.Url))
    {
        <div class="block-media-selection">
            <i class="fas @FileIcon"></i>
            <div>
                <strong>@(_fileName ?? _asset.FileName)</strong>
                <span>@(_asset.ContentType ?? T("File"))</span>
            </div>
            <button type="button" class="btn-admin btn-ghost" @onclick="ClearFile">
                <i class="fas fa-times"></i> @T("Remove")
            </button>
        </div>
    }
    <div class="block-media-actions">
        <InputFile id="file-block-upload" OnChange="OnFileSelected"
                   accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt" style="display:none" />
        <label class="btn-admin btn-ghost" for="file-block-upload">
            <i class="fas fa-file-upload"></i> @T("UploadNew")
        </label>
        <button type="button" class="btn-admin btn-ghost" @onclick="() => _resourcePickerOpen = true">
            <i class="fas fa-folder-open"></i> @T("ChooseFromResourceLibrary")
        </button>
    </div>
    <div class="form-hint">@T("FileUploadHint")</div>
</div>

<ResourcePickerModal Open="_resourcePickerOpen" Kind="file"
                     ResourceSelected="SelectResourceFile"
                     Closed="() => _resourcePickerOpen = false" />

<div class="form-group">
    <label class="form-label">@T("DisplayName")</label>
    <DxTextBox @bind-Text="_fileName" CssClass="w-100" NullText="@T("DisplayNamePlaceholder")" />
</div>

<div class="form-group">
    <label class="form-label">@T("FileOpenBehavior")</label>
    <select class="form-control" @bind="_openBehavior">
        <option value="open">@T("OpenInNewTab")</option>
        <option value="download">@T("DownloadFile")</option>
    </select>
</div>

<div class="ez-editor-actions">
    <button class="btn-admin btn-primary" @onclick="Save" disabled="@_saving">
        <i class="fas fa-save"></i> @(_saving ? T("Saving") : T("Save"))
    </button>
</div>

@code {
    private const long MaxFileBytes = 100L * 1024 * 1024;

    [Parameter] public BlockModel Block { get; set; } = new();
    [Parameter] public string PageId { get; set; } = string.Empty;
    [Parameter] public string SectionId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";

    private BlockAssetReferenceModel _asset = new();
    private string? _fileName;
    private string _openBehavior = "open";
    private bool _saving;
    private bool _resourcePickerOpen;
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);
    private string FileIcon => (_asset.ContentType ?? string.Empty).ToLowerInvariant() switch
    {
        var type when type.Contains("pdf") => "fa-file-pdf",
        var type when type.Contains("word") => "fa-file-word",
        var type when type.Contains("excel") || type.Contains("sheet") => "fa-file-excel",
        var type when type.Contains("powerpoint") || type.Contains("presentation") => "fa-file-powerpoint",
        _ => "fa-file"
    };

    protected override void OnParametersSet()
    {
        _asset = CopyAsset(Block.Asset, Block.FileUrl, Block.FileName, Block.FileType);
        _fileName = Block.FileName ?? _asset.FileName;
        _openBehavior = Block.OpenBehavior == "download" ? "download" : "open";
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxFileBytes)
        {
            Http.Notify(T("BlockFileTooLarge"), 400);
            return;
        }

        var response = await Http.PostFileAsync<AssetUploadModel>(
            "api/admin/assets/upload?folder=file-blocks", file, maxBytes: MaxFileBytes);
        if (!response.Success || response.Data is null)
        {
            Http.Notify(response.Message ?? T("FileUploadFailed"), response.StatusCode);
            return;
        }

        _asset = DirectAsset(response.Data);
        _fileName = response.Data.FileName;
        Http.Notify(T("FileUploaded"), response.StatusCode);
    }

    private void SelectResourceFile(ManagedResourceModel resource)
    {
        _asset = ManagedAsset(resource);
        _fileName = string.IsNullOrWhiteSpace(resource.FileName)
            ? resource.Name.GetValueOrDefault("en")
            : resource.FileName;
    }

    private void ClearFile()
    {
        _asset = new();
        _fileName = null;
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var response = await BlockService.UpdateAsync(PageId, SectionId, Block.Id, new FileBlockUpdateDto
            {
                Asset = AssetDto(_asset),
                FileUrl = _asset.Url,
                Filename = _fileName ?? _asset.FileName ?? string.Empty,
                FileType = _asset.ContentType ?? string.Empty,
                OpenBehavior = _openBehavior,
                Visible = Block.Visible,
                Authoring = BlockUpdateDtoMapper.ToAuthoringDto(Block.Authoring)
            });
            Http.Notify(response.Message, response.StatusCode);
            if (response.Success) await OnSaved.InvokeAsync();
        }
        finally { _saving = false; }
    }

    private static BlockAssetReferenceModel CopyAsset(BlockAssetReferenceModel? value, string? url, string? name, string? type) => new()
    {
        SchemaVersion = 1, Url = value?.Url ?? url, ResourceId = value?.ResourceId,
        ResourceSource = value?.ResourceSource ?? "DirectUpload", StorageKey = value?.StorageKey,
        FileName = value?.FileName ?? name, ContentType = value?.ContentType ?? type, SizeBytes = value?.SizeBytes ?? 0
    };
    private static BlockAssetReferenceModel DirectAsset(AssetUploadModel upload) => new()
    {
        SchemaVersion = 1, Url = upload.Url, ResourceSource = "DirectUpload", StorageKey = upload.StorageKey,
        FileName = upload.FileName, ContentType = upload.ContentType, SizeBytes = upload.Size
    };
    private static BlockAssetReferenceModel ManagedAsset(ManagedResourceModel resource) => new()
    {
        SchemaVersion = 1, Url = resource.Url, ResourceId = resource.Id, ResourceSource = "ManagedResource",
        StorageKey = resource.StorageKey, FileName = resource.FileName, ContentType = resource.ContentType, SizeBytes = resource.SizeBytes
    };
    private static BlockAssetReferenceDto AssetDto(BlockAssetReferenceModel value) => new()
    {
        SchemaVersion = 1, Url = value.Url, ResourceId = value.ResourceId, ResourceSource = value.ResourceSource,
        StorageKey = value.StorageKey, FileName = value.FileName, ContentType = value.ContentType, SizeBytes = value.SizeBytes
    };
}
