                string.Format(T("ContainerCapacityStatus"), AddTargetChildCount, AddTargetCapacity)
            };
            if (NextAddTargetSlot is not null)
                messages.Add(string.Format(T("NextContainerSlot"), NextAddTargetSlot.DisplayName));
            if (NormalizeContainerPurpose(target.ContainerLayout?.Purpose) == "collection")
            {
                messages.Add(string.IsNullOrWhiteSpace(target.ContainerLayout?.AllowedChildType)
                    ? T("CollectionFirstChildLocksType")
                    : $"{T("CollectionAllowsOnly")} {T(BlockLabelKey(target.ContainerLayout.AllowedChildType))}.");
