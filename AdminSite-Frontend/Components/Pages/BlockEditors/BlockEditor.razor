@inject AdminBlockService BlockService
@inject IHttpService Http
@inject IJSRuntime JS
@inject AdminAuthService Auth
@implements IAsyncDisposable

@if (_loading)
{
    <div style="text-align:center;padding:1rem">
        <div class="spinner" style="margin:0 auto"></div>
    </div>
}
else
{
    <div style="display:flex;align-items:center;justify-content:space-between;
                margin-bottom:1rem">
        <span style="font-weight:600;font-size:.85rem;color:var(--primary)">
            @T("Blocks") (@_blocks.Count)
        </span>
        <button class="btn-admin btn-primary"
                @onclick="TogglePicker">
            <i class="fas fa-plus"></i> @T("AddBlock")
        </button>
    </div>

    <BlockCreationWizard Open="_showPicker"
                         Busy="_creatingBlock"
                         AdminLanguage="@AdminLanguage"
                         AllowedTypes="@AddTargetAllowedTypes"
                         ConstraintLabel="@AddTargetConstraintLabel"
                         Confirmed="AddBlock"
                         Cancelled="ClosePicker" />

    @if (!_blocks.Any())
    {
        <div style="text-align:center;padding:1.5rem;border:2px dashed var(--border);
                    border-radius:8px">
            <i class="fas fa-cubes"
               style="font-size:1.75rem;color:var(--border);margin-bottom:.5rem"></i>
            <p class="text-muted" style="font-size:.85rem">@T("NoBlocksYet")</p>
        </div>
    }
    else
    {
        <div class="block-sort-list" @ref="_blockListRef">
        @foreach (var entry in OrderedHierarchyBlocks)
        {
            var block = entry.Block;
            <div class="block-sort-item @(entry.Depth > 0 ? "block-sort-item--nested" : "")"
                 @key="block.Id"
                 data-block-sort-id="@block.Id"
                 data-block-parent="@NormalizeParent(block.ParentBlockId)"
                 data-block-zone="@NormalizeBlockZone(block.BlockZone)"
                 data-block-slot="@NormalizeSlot(block.ColumnSlotId)"
                 data-block-sort-locked="@((block.Authoring.FullLocked || block.Authoring.GeometryLocked).ToString().ToLowerInvariant())"
                 style="--block-depth: @entry.Depth;">
            <div class="block-card @(block.Id == _activeBlockId ? "active" : "")">
                <div class="block-card-header"
                     @onclick="() => ToggleBlock(block.Id)">
                    <div style="display:flex;align-items:center;gap:.6rem">
                        <i class="fas fa-grip-vertical text-muted block-card-drag"
                           title="@T("DragToReorder")"></i>
                        <span class="block-type-badge">
                            @BlockIcon(block.Type) @block.Type
                        </span>
                        @if (!block.Visible)
                        {
                            <span class="badge badge-draft">@T("Hidden")</span>
                        }
                    </div>
                    <div style="display:flex;align-items:center;gap:.4rem"
                         @onclick:stopPropagation="true">
                        <button class="visibility-toggle
                                @(block.Visible ? "visible" : "hidden")"
                                disabled="@(block.Authoring.FullLocked || block.Authoring.ContentLocked)"
                                @onclick="() => ToggleVisibility(block)">
                            <i class="fas @(block.Visible
                                ? "fa-eye" : "fa-eye-slash")"></i>
                        </button>
                        <button class="btn-admin btn-danger"
                                style="padding:3px 8px"
                                disabled="@(block.Authoring.FullLocked || block.Authoring.ContentLocked)"
                                @onclick="() => _confirmDelete = block">
                            <i class="fas fa-trash"></i>
                        </button>
                        <i class="fas @(block.Id == _activeBlockId
                            ? "fa-chevron-up" : "fa-chevron-down")"
                           style="color:var(--text-muted);font-size:.8rem"></i>
                    </div>
                </div>

                @if (block.Id == _activeBlockId)
                {
                    <div class="block-card-body">
                        @if (_fullBlock is null)
                        {
                            <div style="text-align:center;padding:1rem">
                                <div class="spinner" style="margin:0 auto"></div>
                            </div>
                        }
                        else
                        {
                            <div class="block-focused-inspector">
                                <div class="block-focused-inspector__head">
                                    <div>
                                        <span>@T("BlockInspector")</span>
                                        <strong><i class="fas @BlockIconClass(_fullBlock.Type)"></i> @T(BlockLabelKey(_fullBlock.Type))</strong>
                                    </div>
                                    <div class="block-focused-inspector__badges">
                                        <span class="@(_fullBlock.Visible ? "is-visible" : "is-hidden")">
                                            <i class="fas @(_fullBlock.Visible ? "fa-eye" : "fa-eye-slash")"></i>
                                            @T(_fullBlock.Visible ? "Visible" : "Hidden")
                                        </span>
                                        @if (_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.ContentLocked || _fullBlock.Authoring.GeometryLocked)
                                        {
                                            <span class="is-locked"><i class="fas fa-lock"></i> @T("Governed")</span>
                                        }
                                    </div>
                                </div>

                                <div class="block-focused-inspector__organization">
                                    @if (_fullBlock.Type != "container")
                                    {
                                        <label>
                                            <span>@T("ParentContainer")</span>
                                            <select @bind="_parentBlockId" disabled="@(_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.GeometryLocked)">
                                                <option value="">@T("TopLevel")</option>
                                                @foreach (var container in ContainerOptions)
                                                {
                                                    <option value="@container.Id">@BlockDisplayName(container)</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                    <div class="block-focused-inspector__path">
                                        <span>@T("Hierarchy")</span>
                                        <strong>@BlockHierarchyPath(_fullBlock)</strong>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_fullBlock.Authoring.PresetSlotName))
                                {
                                    <div class="block-focused-inspector__preset">
                                        <i class="fas fa-shield-alt"></i>
                                        <span>@T("PresetSlot"): <strong>@_fullBlock.Authoring.PresetSlotName</strong></span>
                                    </div>
                                }

                                <div class="block-focused-inspector__actions">
                                    <button type="button" class="btn-admin btn-ghost"
                                            disabled="@(_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.ContentLocked)"
                                            @onclick="ToggleSelectedVisibility">
                                        <i class="fas @(_fullBlock.Visible ? "fa-eye-slash" : "fa-eye")"></i>
                                        @T(_fullBlock.Visible ? "Hide" : "Show")
                                    </button>
                                    @if (_fullBlock.Type != "container")
                                    {
                                        <button type="button" class="btn-admin btn-ghost"
                                                disabled="@(_savingLayout || _fullBlock.Authoring.FullLocked || _fullBlock.Authoring.GeometryLocked)"
                                                @onclick="SaveBlockLayout">
                                            <i class="fas fa-sitemap"></i> @T("SaveOrganization")
                                        </button>
                                    }
                                    <button type="button" class="btn-admin btn-ghost" @onclick="ToggleAdvancedInspector">
                                        <i class="fas fa-sliders-h"></i> @T(_showAdvancedInspector ? "CloseAdvanced" : "Advanced")
                                    </button>
                                    <button type="button" class="btn-admin btn-danger"
                                            disabled="@(_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.ContentLocked)"
                                            @onclick="() => _confirmDelete = _fullBlock">
                                        <i class="fas fa-trash"></i> @T("Delete")
                                    </button>
                                </div>

                                <details class="block-focused-inspector__governance">
                                    <summary><i class="fas fa-shield-alt"></i> @T("LocksGovernance")</summary>
                                    <div class="block-focused-inspector__lock-grid">
                                        <label><input type="checkbox" @bind="_fullBlock.Authoring.ContentLocked" disabled="@(!Auth.IsAdminAdmin)" /> @T("ContentLocked")</label>
                                        <label><input type="checkbox" @bind="_fullBlock.Authoring.GeometryLocked" disabled="@(!Auth.IsAdminAdmin)" /> @T("GeometryLocked")</label>
                                    </div>
                                    @if (Auth.IsAdminAdmin)
                                    {
                                        <button type="button" class="btn-admin btn-ghost" disabled="@_savingGovernance" @onclick="SaveGovernance">
                                            <i class="fas @(_savingGovernance ? "fa-spinner fa-spin" : "fa-save")"></i>
                                            @T(_savingGovernance ? "Saving" : "SaveGovernance")
                                        </button>
                                    }
                                </details>
                            </div>

                            @if (_showAdvancedInspector)
                            {
                            <div class="block-layout-panel @((_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.GeometryLocked) ? "block-layout-panel--locked" : "")">
                                <div class="block-layout-panel__title">@T("PlacementLayout")</div>
                                @if (_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.GeometryLocked)
                                {
                                    <div class="block-layout-panel__lock-notice"><i class="fas fa-lock"></i> @T("GeometryLockedHint")</div>
                                }
                                <div class="block-layout-panel__grid">
                                    @if (SupportsFreeformPositioning)
                                    {
                                        <label>
                                            <span>@T("Positioning")</span>
                                            <select @bind="_positionMode">
                                                <option value="flow">@T("Flow")</option>
                                                <option value="freeform">@T("Freeform")</option>
                                            </select>
                                        </label>
                                    }
                                    @if (ZoneOptions.Count > 1)
                                    {
                                        <label>
                                            <span>@T("Zone")</span>
                                            <select @bind="_blockZone">
                                                @foreach (var option in ZoneOptions)
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                    <label>
                                        <span>@T("Width")</span>
                                        <select @bind="_layoutWidth">
                                            @foreach (var option in _widthOptions)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    </label>
                                    @if (UsesGridPlacement)
                                    {
                                        <label>
                                            <span>@T("ColumnSpan")</span>
                                            <input type="number" min="1" max="12" @bind="_layoutColumnSpan" />
                                        </label>
                                    }
                                    @if (UsesVerticalAlignment)
                                    {
                                        <div class="block-layout-panel__icon-field">
                                            <span>@T("VerticalAlignment")</span>
                                            <div class="block-layout-panel__icon-options" role="group" aria-label="@T("VerticalAlignment")">
                                                @foreach (var option in _alignOptions)
                                                {
                                                    <button type="button"
                                                            class="@(option == _layoutAlign ? "is-active" : "")"
                                                            title="@AlignmentLabel(option)"
                                                            aria-label="@AlignmentLabel(option)"
                                                            @onclick="() => _layoutAlign = option">
                                                        <i class="fas @VerticalAlignmentIcon(option)"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (UsesHorizontalAlignment)
                                    {
                                        <div class="block-layout-panel__icon-field">
                                            <span>@T("HorizontalAlignment")</span>
                                            <div class="block-layout-panel__icon-options" role="group" aria-label="@T("HorizontalAlignment")">
                                                @foreach (var option in _justifyOptions)
                                                {
                                                    <button type="button"
                                                            class="@(option == _layoutJustify ? "is-active" : "")"
                                                            title="@AlignmentLabel(option)"
                                                            aria-label="@AlignmentLabel(option)"
                                                            @onclick="() => _layoutJustify = option">
                                                        <i class="fas @HorizontalAlignmentIcon(option)"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <p class="block-layout-panel__hint">
                                    @(_positionMode == "freeform" ? T("ArrangeModeHint") : T("FlowModeHint"))
                                </p>
                                <details class="block-layout-panel__advanced">
                                    <summary>@T("AdvancedLayout")</summary>
                                    <div class="block-layout-panel__grid">
                                        <div class="block-layout-panel__layer">
                                            <label>
                                                <span>@T("LayerOrder")</span>
                                                <input type="number" min="0" max="1000" @bind="_layoutZIndex" />
                                            </label>
                                            <div class="block-layout-panel__layer-actions" aria-label="@T("LayerControls")">
                                                <button type="button" title="@T("SendBackward")" @onclick="SendLayerBackward">
                                                    <i class="fas fa-arrow-down"></i>
                                                </button>
                                                <button type="button" title="@T("BringForward")" @onclick="BringLayerForward">
                                                    <i class="fas fa-arrow-up"></i>
                                                </button>
                                                <button type="button" title="@T("SendToBack")" @onclick="SendLayerToBack">
                                                    <i class="fas fa-angle-double-down"></i>
                                                </button>
                                                <button type="button" title="@T("BringToFront")" @onclick="BringLayerToFront">
                                                    <i class="fas fa-angle-double-up"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </details>
                                @if (CanEditAdvancedResponsivePolicy)
                                {
                                <details class="block-layout-panel__advanced">
                                    <summary>@T("ResponsiveBehavior")</summary>
                                    <p class="block-layout-panel__hint">@T("ResponsiveBehaviorHint")</p>
                                    <div class="block-layout-panel__responsive">
                                        <div class="block-layout-panel__responsive-card">
                                            <strong>@T("Tablet")</strong>
                                            @if (!HasTabletOverride)
                                            {
                                                <div class="block-layout-panel__inherited">
                                                    <span>@T("InheritedFromDesktop")</span>
                                                    <button type="button" @onclick="EnableTabletOverride">@T("AddOverride")</button>
                                                </div>
                                            }
                                            else
                                            {
                                            <div class="block-layout-panel__override-head">
                                                <span>@T("OverrideActive")</span>
                                                <button type="button" @onclick="ResetTabletOverride">@T("ResetToInherited")</button>
                                            </div>
                                            <div class="block-layout-panel__grid">
                                                <label>
                                                    <span>@T("ResponsiveMode")</span>
                                                    <select @bind="TabletResponsive.Mode">
                                                        @foreach (var mode in _responsiveModeOptions)
                                                        {
                                                            <option value="@mode">@ResponsiveModeLabel(mode)</option>
                                                        }
                                                    </select>
                                                </label>
                                                <label>
                                                    <span>@T("ResponsiveWidth")</span>
                                                    <select @bind="TabletResponsive.Width">
                                                        @foreach (var width in _responsiveWidthOptions)
                                                        {
                                                            <option value="@width">@WidthLabel(width)</option>
                                                        }
                                                    </select>
                                                </label>
                                            </div>
                                            @if (TabletResponsive.Mode == "custom")
                                            {
                                                <div class="block-layout-panel__grid block-layout-panel__subgrid">
                                                    @if (UsesGridPlacement)
                                                    {
                                                        <label>
                                                            <span>@T("ColumnSpan")</span>
                                                            <input type="number" min="1" max="12" @bind="TabletResponsive.ColumnSpan" />
                                                        </label>
                                                    }
                                                    <label>
                                                        <span>@T("LeftPercent")</span>
                                                        <input type="number" min="0" max="100" step="1" @bind="TabletResponsive.LeftPercent" />
                                                    </label>
                                                    <label>
                                                        <span>@T("TopPx")</span>
                                                        <input type="number" min="0" max="10000" step="4" @bind="TabletResponsive.TopPx" />
                                                    </label>
                                                    <label>
                                                        <span>@T("WidthPercent")</span>
                                                        <input type="number" min="1" max="100" step="1" @bind="TabletResponsive.WidthPercent" />
                                                    </label>
                                                    <label>
                                                        <span>@T("HeightPx")</span>
                                                        <input type="number" min="24" max="10000" step="4" @bind="TabletResponsive.HeightPx" />
                                                    </label>
                                                </div>
                                            }
                                            }
                                        </div>
                                        <div class="block-layout-panel__responsive-card">
                                            <strong>@T("Mobile")</strong>
                                            @if (!HasMobileOverride)
                                            {
                                                <div class="block-layout-panel__inherited">
                                                    <span>@T("InheritedFromDesktop")</span>
                                                    <button type="button" @onclick="EnableMobileOverride">@T("AddOverride")</button>
                                                </div>
                                            }
                                            else
                                            {
                                            <div class="block-layout-panel__override-head">
                                                <span>@T("OverrideActive")</span>
                                                <button type="button" @onclick="ResetMobileOverride">@T("ResetToInherited")</button>
                                            </div>
                                            <div class="block-layout-panel__grid">
                                                <label>
                                                    <span>@T("ResponsiveMode")</span>
                                                    <select @bind="MobileResponsive.Mode">
                                                        @foreach (var mode in _responsiveModeOptions)
                                                        {
                                                            <option value="@mode">@ResponsiveModeLabel(mode)</option>
                                                        }
                                                    </select>
                                                </label>
                                                <label>
                                                    <span>@T("ResponsiveWidth")</span>
                                                    <select @bind="MobileResponsive.Width">
                                                        @foreach (var width in _responsiveWidthOptions)
                                                        {
                                                            <option value="@width">@WidthLabel(width)</option>
                                                        }
                                                    </select>
                                                </label>
                                            </div>
                                            @if (MobileResponsive.Mode == "custom")
                                            {
                                                <div class="block-layout-panel__grid block-layout-panel__subgrid">
                                                    @if (UsesGridPlacement)
                                                    {
                                                        <label>
                                                            <span>@T("ColumnSpan")</span>
                                                            <input type="number" min="1" max="12" @bind="MobileResponsive.ColumnSpan" />
                                                        </label>
                                                    }
                                                    <label>
                                                        <span>@T("LeftPercent")</span>
                                                        <input type="number" min="0" max="100" step="1" @bind="MobileResponsive.LeftPercent" />
                                                    </label>
                                                    <label>
                                                        <span>@T("TopPx")</span>
                                                        <input type="number" min="0" max="10000" step="4" @bind="MobileResponsive.TopPx" />
                                                    </label>
                                                    <label>
                                                        <span>@T("WidthPercent")</span>
                                                        <input type="number" min="1" max="100" step="1" @bind="MobileResponsive.WidthPercent" />
                                                    </label>
                                                    <label>
                                                        <span>@T("HeightPx")</span>
                                                        <input type="number" min="24" max="10000" step="4" @bind="MobileResponsive.HeightPx" />
                                                    </label>
                                                </div>
                                            }
                                            }
                                        </div>
                                    </div>
                                    @if (_fullBlock.Type == "container")
                                    {
                                        <div class="block-layout-panel__grid block-layout-panel__subgrid">
                                            <label>
                                                <span>@T("ContainerMobileBehavior")</span>
                                                <select @bind="ContainerLayout.MobileMode">
                                                    @foreach (var mode in _containerMobileModeOptions)
                                                    {
                                                        <option value="@mode">@ResponsiveModeLabel(mode)</option>
                                                    }
                                                </select>
                                            </label>
                                            <label class="block-layout-panel__check">
                                                <input type="checkbox" @bind="ContainerLayout.GeometryLocked" />
                                                <span>@T("GeometryLocked")</span>
                                            </label>
                                        </div>
                                    }
                                </details>
                                }
                                else
                                {
                                    <div class="block-layout-panel__auto-responsive" role="note">
                                        <i class="fas fa-mobile-alt" aria-hidden="true"></i>
                                        <span>
                                            <strong>@T("AutomaticResponsivePolicy")</strong>
                                            <small>@T("AutomaticResponsivePolicyHint")</small>
                                        </span>
                                    </div>
                                }
                                <details class="block-layout-panel__advanced">
                                    <summary>@T("BlockAppearance")</summary>
                                    <p class="block-layout-panel__hint">@T("BlockAppearanceHint")</p>
                                    @if (ParentContainerForActive?.ContainerLayout?.ShareAppearance == true)
                                    {
                                        <label class="block-layout-panel__check block-layout-panel__inheritance">
                                            <input type="checkbox" @bind="Appearance.InheritFromContainer" />
                                            <span><strong>@T("InheritContainerAppearance")</strong><small>@T("InheritContainerAppearanceHint")</small></span>
                                        </label>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_visualValidationMessage))
                                    {
                                        <div class="block-layout-panel__error" role="alert">@_visualValidationMessage</div>
                                    }
                                    <div class="block-layout-panel__section-actions">
                                        <button type="button" @onclick="ResetAppearance">@T("ResetToDefault")</button>
                                    </div>
                                    <div class="block-layout-panel__grid">
                                        <label>
                                            <span>@T("BackgroundMode")</span>
                                            <select @bind="Appearance.BackgroundMode">
                                                @foreach (var mode in _backgroundModeOptions)
                                                {
                                                    <option value="@mode">@AppearanceOptionLabel(mode)</option>
                                                }
                                            </select>
                                        </label>
                                        @if (Appearance.BackgroundMode == "color")
                                        {
                                        <label>
                                            <span>@T("BackgroundColor")</span>
                                            <input type="text" placeholder="#ffffff" @bind="Appearance.BackgroundColor" />
                                        </label>
                                        }
                                        @if (SupportsTextAppearance)
                                        {
                                            <label>
                                                <span>@T("TextColor")</span>
                                                <input type="text" placeholder="#0f172a" @bind="Appearance.TextColor" />
                                            </label>
                                            <label>
                                                <span>@T("TextAlignment")</span>
                                                <select @bind="Appearance.TextAlign">
                                                    @foreach (var alignment in _textAlignOptions)
                                                    {
                                                        <option value="@alignment">@AppearanceOptionLabel(alignment)</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                        <label>
                                            <span>@T("Opacity")</span>
                                            <input type="number" min="0" max="1" step="0.05" @bind="Appearance.Opacity" />
                                        </label>
                                        <label>
                                            <span>@T("Shape")</span>
                                            <select @bind="Appearance.Shape">
                                                @foreach (var shape in _shapeOptions)
                                                {
                                                    <option value="@shape">@AppearanceOptionLabel(shape)</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>@T("BorderRadius")</span>
                                            <select @bind="Appearance.BorderRadius">
                                                @foreach (var radius in _appearanceRadiusOptions)
                                                {
                                                    <option value="@radius">@AppearanceOptionLabel(radius)</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>@T("Shadow")</span>
                                            <select @bind="Appearance.Shadow">
                                                @foreach (var shadow in _shadowOptions)
                                                {
                                                    <option value="@shadow">@AppearanceOptionLabel(shadow)</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>@T("Padding")</span>
                                            <select @bind="Appearance.Padding">
                                                @foreach (var spacing in _spaceOptions)
                                                {
                                                    <option value="@spacing">@AppearanceOptionLabel(spacing)</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>@T("Margin")</span>
                                            <select @bind="Appearance.Margin">
                                                @foreach (var spacing in _spaceOptions)
                                                {
                                                    <option value="@spacing">@AppearanceOptionLabel(spacing)</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>@T("BorderColor")</span>
                                            <input type="text" placeholder="#d1d5db" @bind="Appearance.BorderColor" />
                                        </label>
                                        <label>
                                            <span>@T("BorderWidth")</span>
                                            <input type="number" min="0" max="20" @bind="Appearance.BorderWidth" />
                                        </label>
                                        <label>
                                            <span>@T("BorderStyle")</span>
                                            <select @bind="Appearance.BorderStyle">
                                                @foreach (var style in _borderStyleOptions)
                                                {
                                                    <option value="@style">@AppearanceOptionLabel(style)</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>@T("AspectRatio")</span>
                                            <select @bind="Appearance.AspectRatio">
                                                @foreach (var ratio in _aspectRatioOptions)
                                                {
                                                    <option value="@ratio">@AppearanceOptionLabel(ratio)</option>
                                                }
                                            </select>
                                        </label>
                                        @if (SupportsMediaAppearance)
                                        {
                                            <label>
                                                <span>@T("MediaFit")</span>
                                                <select @bind="Appearance.MediaFit">
                                                    <option value="cover">@T("Cover")</option>
                                                    <option value="contain">@T("Contain")</option>
                                                </select>
                                            </label>
                                            <label>
                                                <span>@T("MediaPosition")</span>
                                                <select @bind="Appearance.MediaPosition">
                                                    @foreach (var position in _mediaPositionOptions)
                                                    {
                                                        <option value="@position">@AppearanceOptionLabel(position)</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                        <label class="block-layout-panel__check">
                                            <input type="checkbox" @bind="Appearance.Decorative" />
                                            <span>@T("DecorativeBlock")</span>
                                        </label>
                                    </div>
                                </details>
                                @if (_fullBlock.Type == "container")
                                {
                                    <details class="block-layout-panel__advanced">
                                        <summary>@T("DiagramComposition")</summary>
                                        <p class="block-layout-panel__hint">@T("DiagramCompositionHint")</p>
                                        <ContainerDiagramEditor Value="ContainerLayout.Diagram"
                                                                Children="@ContainerChildren"
                                                                Language="@AdminLanguage" />
                                    </details>
                                }
                                <details class="block-layout-panel__advanced">
                                    <summary>@T("BlockAnimation")</summary>
                                    <p class="block-layout-panel__hint">@T("BlockAnimationHint")</p>
                                    <BlockAnimationEditor Value="Animation"
                                                          BlockId="@_fullBlock.Id"
                                                          Language="@AdminLanguage"
                                                          IsContainer="@(_fullBlock.Type == "container")"
                                                          AllowContinuous="@Appearance.Decorative" />
                                </details>
                                <div class="block-layout-panel__actions">
                                    <button type="button"
                                            class="btn-admin btn-ghost"
                                            title="@T("Undo")"
                                            aria-label="@T("Undo")"
                                            disabled="@(!CanUndoVisualChange)"
                                            @onclick="UndoVisualChange">
                                        <i class="fas fa-undo"></i>
                                    </button>
                                    <button type="button"
                                            class="btn-admin btn-ghost"
                                            title="@T("Redo")"
                                            aria-label="@T("Redo")"
                                            disabled="@(!CanRedoVisualChange)"
                                            @onclick="RedoVisualChange">
                                        <i class="fas fa-redo"></i>
                                    </button>
                                    <button type="button"
                                            class="btn-admin btn-primary"
                                            disabled="@(_savingLayout || _fullBlock.Authoring.FullLocked || _fullBlock.Authoring.GeometryLocked)"
                                            @onclick="SaveBlockLayout">
                                        <i class="fas fa-save"></i> @(_savingLayout ? T("Saving") : T("SaveLayout"))
                                    </button>
                                </div>
                            </div>
                            }

                            @if (_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.ContentLocked)
                            {
                                <div class="block-layout-panel__lock-notice"><i class="fas fa-lock"></i> @T("ContentLockedHint")</div>
                            }
                            else
                            {
                            @switch (_fullBlock.Type)
                            {
                                case "text":
                                    <TextBlockEditor Block="_fullBlock"
                                                     PageId="@PageId"
                                                     SectionId="@SectionId"
                                                     Languages="Languages"
                                                     OnSaved="HandleBlockSaved" />
                                    break;
                                case "image":
                                    <ImageBlockEditor Block="_fullBlock"
                                                      PageId="@PageId"
                                                      SectionId="@SectionId"
                                                      Languages="Languages"
                                                      OnSaved="HandleBlockSaved" />
                                    break;
                                case "video":
                                    <VideoBlockEditor Block="_fullBlock"
                                                      PageId="@PageId"
                                                      SectionId="@SectionId"
                                                      Languages="Languages"
                                                      OnSaved="HandleBlockSaved" />
                                    break;
                                case "file":
                                    <FileBlockEditor Block="_fullBlock"
                                                     PageId="@PageId"
                                                     SectionId="@SectionId"
                                                     OnSaved="HandleBlockSaved" />
                                    break;
                                case "map":
                                    <MapBlockEditor Block="_fullBlock"
                                                    PageId="@PageId"
                                                    SectionId="@SectionId"
                                                    OnSaved="HandleBlockSaved" />
                                    break;
                                case "form":
                                    <FormBlockEditor Block="_fullBlock"
                                                     PageId="@PageId"
                                                     SectionId="@SectionId"
                                                     Languages="Languages"
                                                     OnSaved="HandleBlockSaved" />
                                    break;
                                case "card":
                                case "button":
                                case "metric":
                                case "bullet-list":
                                case "step":
                                case "icon":
                                case "container":
                                    <DesignBlockEditor Block="_fullBlock"
                                                       PageId="@PageId"
                                                       SectionId="@SectionId"
                                                       Languages="Languages"
                                                       ShowAdvancedFields="_showAdvancedInspector"
                                                       OnSaved="HandleBlockSaved" />
                                    break;
                                default:
                                    <p class="text-muted">@T("UnknownBlockType")</p>
                                    break;
                            }
                            }
                        }
                    </div>
                }
            </div>
            </div>
        }
        </div>
    }
}

<BlockDeleteDialog Block="_confirmDelete"
                   ConfirmTitle="@T("ConfirmDelete")"
                   CancelText="@T("Cancel")"
                   DeleteText="@T("Delete")"
                   OnCancel="ClearDelete"
                   OnConfirm="ConfirmDelete" />

