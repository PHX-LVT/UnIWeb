@code {
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";
  
   
    [Parameter] public string? SlotId { get; set; }
    [Parameter] public string       PageId    { get; set; } = string.Empty;
    [Parameter] public string       SectionId { get; set; } = string.Empty;
    [Parameter] public string?      SectionType { get; set; }
    [Parameter] public string?      SectionBlockLayoutMode { get; set; }
    [Parameter] public List<string> Languages { get; set; } = new() { "en" };
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<BlockModel> _blocks     = new();
    private BlockModel?      _fullBlock;
    private string?          _activeBlockId;
    private BlockModel?      _confirmDelete;
    private bool             _loading    = true;
    private bool             _showPicker = false;
    private bool             _creatingBlock = false;
    private bool             _reorderingBlock = false;
    private bool             _savingLayout = false;
    private bool             _savingGovernance = false;
    private bool             _showAdvancedInspector = false;
    private string?          _visualValidationMessage;
    private string?          _visualHistoryBlockId;
    private BlockUpdateDto?  _savedVisualSnapshot;
    private readonly Stack<VisualHistoryEntry> _visualUndoHistory = new();
    private readonly Stack<VisualHistoryEntry> _visualRedoHistory = new();
    private string?          _loadedPageId;
    private string?          _loadedSectionId;
    private string?          _loadedSlotId;
    private ElementReference _blockListRef;
    private DotNetObjectReference<BlockEditor>? _dotNetRef;
    private bool _blockSortableInitialized;
    private IReadOnlyList<BlockListEntry> OrderedHierarchyBlocks => BuildHierarchy();
    private List<BlockModel> ContainerOptions =>
        _blocks
            .Where(b => b.Type == "container" && b.Id != _activeBlockId)
            .Where(b => NormalizeContainerPurpose(b.ContainerLayout?.Purpose) != "collection" ||
                        string.IsNullOrWhiteSpace(b.ContainerLayout?.AllowedChildType) ||
                        string.Equals(b.ContainerLayout.AllowedChildType, _fullBlock?.Type, StringComparison.Ordinal))
            .OrderBy(b => b.Order)
            .ThenBy(b => b.Id)
            .ToList();
    private BlockModel? AddTargetContainer => _fullBlock?.Type == "container" ? _fullBlock : null;
    private IReadOnlyCollection<string>? AddTargetAllowedTypes =>
        NormalizeContainerPurpose(AddTargetContainer?.ContainerLayout?.Purpose) == "collection" &&
        !string.IsNullOrWhiteSpace(AddTargetContainer?.ContainerLayout?.AllowedChildType)
            ? new[] { AddTargetContainer.ContainerLayout.AllowedChildType! }
            : null;
    private string? AddTargetConstraintLabel
    {
        get
        {
            var target = AddTargetContainer;
            if (target is null || NormalizeContainerPurpose(target.ContainerLayout?.Purpose) != "collection") return null;
            return string.IsNullOrWhiteSpace(target.ContainerLayout?.AllowedChildType)
                ? T("CollectionFirstChildLocksType")
                : $"{T("CollectionAllowsOnly")} {T(BlockLabelKey(target.ContainerLayout.AllowedChildType))}.";
        }
    }

    private sealed record BlockListEntry(BlockModel Block, int Depth);
    private sealed record VisualHistoryEntry(BlockUpdateDto Before, BlockUpdateDto After);
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    private List<string> _widthOptions = new() { "auto", "full", "half", "third" };
    private List<string> _alignOptions = new() { "stretch", "start", "center", "end" };
    private List<string> _justifyOptions = new() { "start", "center", "end" };
    private List<string> _spaceOptions = new() { "none", "small", "medium", "large" };
    private List<string> _appearanceRadiusOptions = new() { "none", "small", "medium", "large", "pill", "circle" };
    private List<string> _responsiveModeOptions = new() { "inherit", "custom", "hide" };
    private List<string> _containerMobileModeOptions = new() { "stack", "compact-preserve", "horizontal-scroll", "custom", "hide" };
    private List<string> _responsiveWidthOptions = new() { "inherit", "auto", "full", "half", "third", "custom" };
    private List<string> _borderStyleOptions = new() { "solid", "dashed", "dotted", "none" };
    private List<string> _shadowOptions = new() { "none", "small", "medium", "large" };
    private List<string> _shapeOptions = new() { "rectangle", "rounded", "pill", "circle", "ellipse", "decorative" };
    private List<string> _backgroundModeOptions = new() { "none", "color", "theme-primary", "theme-accent", "theme-background" };
    private List<string> _textAlignOptions = new() { "inherit", "left", "center", "right" };
    private List<string> _aspectRatioOptions = new() { "auto", "square", "landscape", "widescreen", "portrait" };
    private List<string> _mediaPositionOptions = new() { "center", "top", "bottom", "left", "right" };
    private bool SupportsFreeformPositioning => SectionType is "canvas" or "columns";
    private bool SupportsMediaAppearance => _fullBlock?.Type is "image" or "video" or "card";
    private bool SupportsTextAppearance => _fullBlock?.Type is not ("image" or "video" or "file" or "map");
    private string ActiveLayoutMode
    {
        get
        {
            var parent = !string.IsNullOrWhiteSpace(_fullBlock?.ParentBlockId)
