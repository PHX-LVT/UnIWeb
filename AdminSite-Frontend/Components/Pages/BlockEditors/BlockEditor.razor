@inject AdminBlockService BlockService
@inject IHttpService Http
@inject IJSRuntime JS
@inject AdminAuthService Auth
@implements IAsyncDisposable

@if (_loading)
{
    <div style="text-align:center;padding:1rem">
        <div class="spinner" style="margin:0 auto"></div>
    </div>
}
else
{
    <div style="display:flex;align-items:center;justify-content:space-between;
                margin-bottom:1rem">
        <span style="font-weight:600;font-size:.85rem;color:var(--primary)">
            @T("Blocks") (@_blocks.Count)
        </span>
        <button class="btn-admin btn-primary"
                disabled="@(!AddTargetHasCapacity)"
                title="@AddTargetTitle"
                @onclick="TogglePicker">
            <i class="fas fa-plus"></i> @T("AddBlock")
        </button>
    </div>

    @if (_showPicker)
    {
        <div class="ez-modal-overlay block-create-modal-overlay" @onclick="ClosePicker">
            <div class="ez-modal block-create-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                <BlockCreationWizard Open="true"
                                     Busy="_creatingBlock"
                                     AdminLanguage="@AdminLanguage"
                                     AllowedTypes="@AddTargetAllowedTypes"
                                     ConstraintLabel="@AddTargetConstraintLabel"
                                     Confirmed="AddBlock"
                                     Cancelled="ClosePicker" />
            </div>
        </div>
    }

    @if (!_blocks.Any())
    {
        <div style="text-align:center;padding:1.5rem;border:2px dashed var(--border);
                    border-radius:8px">
            <i class="fas fa-cubes"
               style="font-size:1.75rem;color:var(--border);margin-bottom:.5rem"></i>
            <p class="text-muted" style="font-size:.85rem">@T("NoBlocksYet")</p>
        </div>
    }
    else
    {
        <div class="block-sort-list" @ref="_blockListRef">
        @foreach (var entry in RootBlockEntries)
        {
            var block = entry.Block;
            <div class="block-sort-item @(entry.Depth > 0 ? "block-sort-item--nested" : "")"
                 @key="block.Id"
                 data-block-sort-id="@block.Id"
                 data-block-parent="@NormalizeParent(block.ParentBlockId)"
                 data-block-zone="@NormalizeBlockZone(block.BlockZone)"
                 data-block-slot="@NormalizeSlot(block.ColumnSlotId)"
                 data-block-sort-locked="@((block.Authoring.FullLocked || block.Authoring.GeometryLocked || !PresetAllowsChildReorder(block)).ToString().ToLowerInvariant())"
                 style="--block-depth: @entry.Depth;">
            <div class="block-card @(block.Id == _activePanelBlockId ? "active" : "")">
                <div class="block-card-header"
                     @onclick="() => ToggleBlock(block.Id)">
                    <div class="block-card-header__identity">
                        @if (!UseArrangeWorkspace)
                        {
                            <i class="fas fa-grip-vertical text-muted block-card-drag"
                               title="@T("DragToReorder")"></i>
                        }
                        <span class="block-type-badge">
                            @BlockIcon(block.Type) @block.Type
                        </span>
                        <strong class="block-card-name">@BlockDisplayName(block)</strong>
                        @if (!block.Visible)
                        {
                            <span class="block-state-badge block-state-badge--hidden" title="@T("Hidden")">
                                <i class="fas fa-eye-slash"></i><span>@T("Hidden")</span>
                            </span>
                        }
                        @if (block.Authoring.FullLocked || block.Authoring.ContentLocked)
                        {
                            <span class="block-state-badge block-state-badge--content-lock" title="@T("ContentLockedHint")">
                                <i class="fas fa-lock"></i><span>@T("ContentLocked")</span>
                            </span>
                        }
                        @if (block.Authoring.FullLocked || block.Authoring.GeometryLocked)
                        {
                            <span class="block-state-badge block-state-badge--geometry-lock" title="@T("GeometryLockedHint")">
                                <i class="fas fa-vector-square"></i><span>@T("GeometryLockState")</span>
                            </span>
                        }
                    </div>
                    <div class="block-card-header__actions"
                         @onclick:stopPropagation="true">
                        <button class="visibility-toggle
                                @(block.Visible ? "visible" : "hidden")"
                                disabled="@(block.Authoring.FullLocked || block.Authoring.ContentLocked)"
                                title="@T(block.Visible ? "Hide" : "Show")"
                                aria-label="@T(block.Visible ? "Hide" : "Show")"
                                @onclick="() => ToggleVisibility(block)">
                            <i class="fas @(block.Visible
                                ? "fa-eye" : "fa-eye-slash")"></i>
                        </button>
                        <button class="btn-admin btn-danger"
                                style="padding:3px 8px"
                                disabled="@(block.Authoring.FullLocked || block.Authoring.ContentLocked || IsRequiredContainerSlot(block))"
                                title="@(IsRequiredContainerSlot(block) ? T("RequiredContainerSlotCannotDelete") : T("Delete"))"
                                @onclick="() => _confirmDelete = block">
                            <i class="fas fa-trash"></i>
                        </button>
                        <i class="fas @(block.Id == _activePanelBlockId
                            ? "fa-chevron-up" : "fa-chevron-down")"
                           style="color:var(--text-muted);font-size:.8rem"></i>
                    </div>
                </div>

                @if (block.Id == _activePanelBlockId)
                {
                    <div class="block-card-body">
                        @if (_fullBlock is null)
                        {
                            <div style="text-align:center;padding:1rem">
                                <div class="spinner" style="margin:0 auto"></div>
                            </div>
                        }
                        else
                        {
                            <div class="block-focused-inspector">
                                <div class="block-focused-inspector__head">
                                    <div>
                                        <span>@T("BlockInspector")</span>
                                        <strong><i class="fas @BlockIconClass(_fullBlock.Type)"></i> @T(BlockLabelKey(_fullBlock.Type))</strong>
                                    </div>
                                    <div class="block-focused-inspector__badges">
                                        <span class="@(_fullBlock.Visible ? "is-visible" : "is-hidden")">
                                            <i class="fas @(_fullBlock.Visible ? "fa-eye" : "fa-eye-slash")"></i>
                                            @T(_fullBlock.Visible ? "Visible" : "Hidden")
                                        </span>
                                        @if (_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.ContentLocked || _fullBlock.Authoring.GeometryLocked)
                                        {
                                            <span class="is-locked"><i class="fas fa-lock"></i> @T("Governed")</span>
                                        }
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_fullBlock.Authoring.PresetSlotName))
                                {
                                    <div class="block-focused-inspector__preset">
                                        <i class="fas fa-shield-alt"></i>
                                        <span>@T("PresetSlot"): <strong>@_fullBlock.Authoring.PresetSlotName</strong></span>
                                    </div>
                                }

                                @if (!UseArrangeWorkspace)
                                {
                                <div class="block-focused-inspector__actions">
                                    <button type="button" class="btn-admin btn-ghost"
                                            disabled="@(_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.ContentLocked)"
                                            @onclick="ToggleSelectedVisibility">
                                        <i class="fas @(_fullBlock.Visible ? "fa-eye-slash" : "fa-eye")"></i>
                                        @T(_fullBlock.Visible ? "Hide" : "Show")
                                    </button>
                                    <button type="button" class="btn-admin btn-danger"
                                            disabled="@(_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.ContentLocked || IsRequiredContainerSlot(_fullBlock))"
                                            @onclick="() => _confirmDelete = _fullBlock">
                                        <i class="fas fa-trash"></i> @T("Delete")
                                    </button>
                                </div>
                                }

                                <details class="block-focused-inspector__governance">
                                    <summary><i class="fas fa-shield-alt"></i> @T("LocksGovernance")</summary>
                                    <div class="block-focused-inspector__lock-grid">
                                        <label><input type="checkbox" @bind="_fullBlock.Authoring.ContentLocked" disabled="@(!Auth.IsAdminAdmin)" /> @T("ContentLocked")</label>
                                        <label><input type="checkbox" @bind="_fullBlock.Authoring.GeometryLocked" disabled="@(!Auth.IsAdminAdmin)" /> @T("GeometryLocked")</label>
                                    </div>
                                </details>
                            </div>

                            @if (UseArrangeWorkspace && AddTargetContainer is not null)
                            {
                                <section class="container-owned-manager">
                                    <header>
                                        <span>
                                            <strong>@T("ContainerOwnedBlocks")</strong>
                                            <small>@T("ContainerOwnedBlocksHint")</small>
                                        </span>
                                        <b>@AddTargetChildCount/@AddTargetCapacity</b>
                                    </header>
                                    <div class="container-owned-manager__capacity" aria-label="@string.Format(T("ContainerCapacityStatus"), AddTargetChildCount, AddTargetCapacity)">
                                        <span style="width:@ContainerCapacityPercent%"></span>
                                    </div>
                                    <div class="container-owned-manager__preset">
                                        <span>
                                            <strong>@ContainerPresetDisplayName</strong>
                                            <small>@ContainerPresetPolicyLabel</small>
                                        </span>
                                        <b>@ContainerAvailableSlotsLabel</b>
                                    </div>
                                    @if (ContainerSlotStatuses.Count > 0)
                                    {
                                        <div class="container-owned-manager__slots" aria-label="@T("AvailableSlots")">
                                            @foreach (var slot in ContainerSlotStatuses)
                                            {
                                                <span class="@(slot.Child is null ? "is-empty" : "is-filled") @(slot.Required ? "is-required" : null)"
                                                      title="@SlotStatusTitle(slot)">
                                                    <i class="fas @(slot.Child is null ? "fa-plus" : BlockIconClass(slot.Child.Type))"></i>
                                                    <small>@slot.Label</small>
                                                </span>
                                            }
                                        </div>
                                    }
                                    @if (ContainerChildren.Count == 0)
                                    {
                                        <p>@T("NoContainerBlocks")</p>
                                    }
                                    else
                                    {
                                        <div class="container-owned-manager__list">
                                            @foreach (var child in ContainerChildren)
                                            {
                                                <button type="button"
                                                        class="@(child.Id == _activeBlockId ? "is-active" : null)"
                                                        @onclick="() => ToggleBlock(child.Id)">
                                                    <i class="fas @BlockIconClass(child.Type)"></i>
                                                    <span><strong>@BlockDisplayName(child)</strong><small>@ChildSummary(child)</small></span>
                                                    <i class="fas fa-chevron-right"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                    <button type="button" class="btn-admin btn-primary"
                                            disabled="@(!AddTargetHasCapacity)"
                                            title="@AddTargetTitle"
                                            @onclick="TogglePicker">
                                        <i class="fas fa-plus"></i> @T("AddBlockToContainer")
                                    </button>
                                </section>
                            }

                            @* Replaced advanced BlockEditor controls were removed intentionally.
                               A future Advanced modal system is postponed until after Notification Overhaul. *@

                            @if (_fullBlock.Authoring.FullLocked || _fullBlock.Authoring.ContentLocked)
                            {
                                <div class="block-layout-panel__lock-notice"><i class="fas fa-lock"></i> @T("ContentLockedHint")</div>
                            }
                            else
                            {
                            @switch (_fullBlock.Type)
                            {
                                case "text":
                                    <TextBlockEditor Block="_fullBlock"
                                                     PageId="@PageId"
                                                     SectionId="@SectionId"
                                                     Languages="Languages"
                                                     OnSaved="HandleBlockSaved" />
                                    break;
                                case "image":
                                    <ImageBlockEditor Block="_fullBlock"
                                                      PageId="@PageId"
                                                      SectionId="@SectionId"
                                                      Languages="Languages"
                                                      OnSaved="HandleBlockSaved" />
                                    break;
                                case "video":
                                    <VideoBlockEditor Block="_fullBlock"
                                                      PageId="@PageId"
                                                      SectionId="@SectionId"
                                                      Languages="Languages"
                                                      OnSaved="HandleBlockSaved" />
                                    break;
                                case "file":
                                    <FileBlockEditor Block="_fullBlock"
                                                     PageId="@PageId"
                                                     SectionId="@SectionId"
                                                     OnSaved="HandleBlockSaved" />
                                    break;
                                case "map":
                                    <MapBlockEditor Block="_fullBlock"
                                                    PageId="@PageId"
                                                    SectionId="@SectionId"
                                                    OnSaved="HandleBlockSaved" />
                                    break;
                                case "form":
                                    <FormBlockEditor Block="_fullBlock"
                                                     PageId="@PageId"
                                                     SectionId="@SectionId"
                                                     Languages="Languages"
                                                     OnSaved="HandleBlockSaved" />
                                    break;
                                case "card":
                                case "button":
                                case "metric":
                                case "bullet-list":
                                case "step":
                                case "icon":
                                case "container":
                                    <DesignBlockEditor Block="_fullBlock"
                                                       PageId="@PageId"
                                                       SectionId="@SectionId"
                                                       Languages="Languages"
                                                       OnSaved="HandleBlockSaved" />
                                    break;
                                default:
                                    <p class="text-muted">@T("UnknownBlockType")</p>
                                    break;
                            }
                            }
                        }
                    </div>
                }
            </div>
            </div>
        }
        </div>
    }
}

<BlockDeleteDialog Block="_confirmDelete"
                   DescendantCount="@DeleteDescendantCount"
                   NestedContainerCount="@DeleteNestedContainerCount"
                   ConfirmTitle="@T("ConfirmDelete")"
                   CancelText="@T("Cancel")"
                   DeleteText="@T("Delete")"
                   OnCancel="ClearDelete"
                   OnConfirm="ConfirmDelete" />

<style>
    .block-sort-list {
        display: grid;
        gap: .5rem;
    }
    .block-sort-item {
        min-width: 0;
        margin-left: calc(var(--block-depth, 0) * 18px);
    }
    .block-sort-item--nested {
        position: relative;
    }
    .block-sort-item--nested::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: -10px;
        border-left: 2px solid color-mix(in srgb, var(--primary) 28%, var(--border));
    }
    .block-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        margin-bottom: 0;
        overflow: hidden;
        transition: border-color .15s;
    }
    .block-card.active { border-color: var(--primary-light); }
    .block-card-drag {
        padding: .25rem;
        font-size: .8rem;
        cursor: grab;
        touch-action: none;
    }
    .block-card-drag:active { cursor: grabbing; }
    .block-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .625rem .875rem;
        cursor: pointer;
        user-select: none;
    }
    .block-card-header:hover { background: var(--bg); }
    .block-card-body {
        padding: 1rem;
        border-top: 1px solid var(--border);
        background: #fafbfd;
    }
    .block-focused-inspector {
        display: grid;
        gap: .8rem;
        margin-bottom: 1rem;
        padding: .9rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #fff;
    }
    .block-focused-inspector__head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .75rem;
    }
    .block-focused-inspector__head > div:first-child {
        display: grid;
        gap: .18rem;
    }
    .block-focused-inspector__head > div:first-child > span,
    .block-focused-inspector__organization label > span,
    .block-focused-inspector__path > span {
        color: var(--text-muted);
        font-size: .68rem;
        font-weight: 750;
        letter-spacing: .04em;
        text-transform: uppercase;
    }
    .block-focused-inspector__head strong {
        display: flex;
        align-items: center;
        gap: .45rem;
        color: var(--primary);
        font-size: .9rem;
    }
    .block-focused-inspector__workspace-note {
        display: flex;
        align-items: flex-start;
        gap: .65rem;
        padding: .7rem .75rem;
        border: 1px solid #c7d2fe;
        border-radius: 8px;
        background: #eef2ff;
        color: var(--primary);
    }
    .block-focused-inspector__workspace-note > i { margin-top: .12rem; }
    .block-focused-inspector__workspace-note > span { display: grid; gap: .15rem; }
    .block-focused-inspector__workspace-note strong { font-size: .76rem; }
    .block-focused-inspector__workspace-note small { color: var(--text-muted); font-size: .7rem; line-height: 1.4; }
    .block-create-modal { width:min(760px,calc(100vw - 32px)); max-height:min(760px,calc(100vh - 32px)); overflow:auto; padding:1rem; }
    .block-create-modal .block-create-wizard { margin:0; box-shadow:none; }
    .container-owned-manager { display:grid; gap:.75rem; margin:0 0 1rem; padding:.9rem; border:1px solid #c7d2fe; border-radius:10px; background:#f8faff; }
    .container-owned-manager > header { display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; }
    .container-owned-manager > header > span { display:grid; gap:.15rem; }
    .container-owned-manager > header strong { color:var(--text); font-size:.8rem; }
    .container-owned-manager > header small,
    .container-owned-manager > p { margin:0; color:var(--text-muted); font-size:.7rem; line-height:1.4; }
    .container-owned-manager > header b { padding:.2rem .45rem; border-radius:999px; background:#e0e7ff; color:var(--primary); font-size:.68rem; }
    .container-owned-manager__capacity { height:6px; overflow:hidden; border-radius:999px; background:#e2e8f0; }
    .container-owned-manager__capacity span { display:block; height:100%; border-radius:inherit; background:var(--primary); }
    .container-owned-manager__preset { display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; padding:.65rem .7rem; border:1px solid #dbeafe; border-radius:8px; background:#fff; }
    .container-owned-manager__preset span { display:grid; gap:.1rem; min-width:0; }
    .container-owned-manager__preset strong { color:var(--text); font-size:.76rem; }
    .container-owned-manager__preset small { color:var(--text-muted); font-size:.64rem; line-height:1.35; }
    .container-owned-manager__preset b { flex:0 0 auto; color:var(--primary); font-size:.64rem; }
    .container-owned-manager__slots { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.35rem; }
    .container-owned-manager__slots > span { display:grid; grid-template-columns:18px minmax(0,1fr); align-items:center; gap:.35rem; padding:.42rem .5rem; border:1px solid #bfdbfe; border-radius:7px; background:#eff6ff; color:#1d4ed8; }
    .container-owned-manager__slots > span.is-filled { border-color:#bbf7d0; background:#f0fdf4; color:#15803d; }
    .container-owned-manager__slots > span.is-required { box-shadow:inset 3px 0 0 #f59e0b; }
    .container-owned-manager__slots i { text-align:center; font-size:.68rem; }
    .container-owned-manager__slots small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:.62rem; font-weight:700; }
    .container-owned-manager__list { display:grid; gap:.35rem; }
    .container-owned-manager__list > button { display:grid; grid-template-columns:22px minmax(0,1fr) 14px; align-items:center; gap:.45rem; padding:.5rem .6rem; border:1px solid var(--border); border-radius:7px; background:#fff; color:var(--text); text-align:left; cursor:pointer; }
    .container-owned-manager__list > button:hover { border-color:var(--primary-light); background:#f8fafc; }
    .container-owned-manager__list > button.is-active { border-color:var(--primary); background:#eef2ff; box-shadow:0 0 0 1px rgba(67,56,202,.12); }
    .container-owned-manager__list > button > i:first-child { color:var(--primary); text-align:center; }
    .container-owned-manager__list > button > i:last-child { color:var(--text-muted); font-size:.6rem; }
    .container-owned-manager__list span { display:grid; gap:.08rem; min-width:0; }
    .container-owned-manager__list strong { overflow:hidden; font-size:.72rem; text-overflow:ellipsis; white-space:nowrap; }
    .container-owned-manager__list small { color:var(--text-muted); font-size:.62rem; }
    .block-focused-inspector__badges {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: .35rem;
    }
    .block-focused-inspector__badges > span {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .25rem .45rem;
        border-radius: 999px;
        background: #eef2f7;
        color: var(--text-muted);
        font-size: .65rem;
        font-weight: 750;
    }
    .block-focused-inspector__badges .is-visible { background: #eaf8ef; color: #18753c; }
    .block-focused-inspector__badges .is-hidden { background: #fff4e5; color: #9a5b00; }
    .block-focused-inspector__badges .is-locked { background: #f2edff; color: #6240a5; }
    .block-focused-inspector__organization {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: .65rem;
    }
    .block-focused-inspector__organization label,
    .block-focused-inspector__path {
        display: grid;
        gap: .28rem;
    }
    .block-focused-inspector__organization select {
        min-height: 36px;
        padding: .3rem .5rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: #fff;
        color: var(--text);
    }
    .block-focused-inspector__path strong {
        min-height: 36px;
        display: flex;
        align-items: center;
        padding: .3rem .55rem;
        border-radius: 6px;
        background: var(--bg);
        color: var(--text);
        font-size: .74rem;
    }
    .block-focused-inspector__preset {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .55rem .65rem;
        border-radius: 7px;
        background: #f2edff;
        color: #6240a5;
        font-size: .72rem;
    }
    .block-focused-inspector__actions {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
    }
    .block-focused-inspector__governance {
        padding-top: .65rem;
        border-top: 1px solid var(--border);
    }
    .block-focused-inspector__governance summary {
        color: var(--text-muted);
        cursor: pointer;
        font-size: .72rem;
        font-weight: 750;
    }
    .block-focused-inspector__lock-grid {
        display: flex;
        flex-wrap: wrap;
        gap: .65rem 1rem;
        margin: .7rem 0;
    }
    .block-focused-inspector__lock-grid label {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        color: var(--text-muted);
        font-size: .72rem;
    }
    .block-layout-panel {
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fff;
        padding: .875rem;
        margin-bottom: 1rem;
    }
    .block-layout-panel__title {
        color: var(--primary);
        font-size: .84rem;
        font-weight: 700;
        margin-bottom: .75rem;
    }
    .block-layout-panel__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
        gap: .75rem;
    }
    .block-layout-panel__grid label {
        display: flex;
        flex-direction: column;
        gap: .3rem;
        font-size: .75rem;
        font-weight: 600;
        color: var(--text-muted);
    }
    .block-layout-panel__grid select,
    .block-layout-panel__grid input {
        min-height: 34px;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: .25rem .45rem;
        color: var(--text);
        background: #fff;
    }
    .block-layout-panel__icon-field {
        display: grid;
        align-content: start;
        gap: .35rem;
    }
    .block-layout-panel__icon-field > span {
        color: var(--text-muted);
        font-size: .7rem;
        font-weight: 700;
    }
    .block-layout-panel__icon-options {
        display: inline-flex;
        width: fit-content;
        padding: 2px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: #fff;
    }
    .block-layout-panel__icon-options button {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 4px;
