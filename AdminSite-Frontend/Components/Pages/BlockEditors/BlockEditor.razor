    private bool CanRedoVisualChange => !_savingLayout && !VisualEditingLocked && _visualRedoHistory.Count > 0;
    private IReadOnlyList<BlockModel> ContainerChildren => AddTargetContainer is null
        ? Array.Empty<BlockModel>()
        : _blocks.Where(block => string.Equals(block.ParentBlockId, AddTargetContainer.Id, StringComparison.Ordinal))
            .OrderBy(block => block.Order)
