    private async Task ConfirmDelete()
    {
        if (_confirmDelete is null) return;
        var deletingIds = OwnedDescendantIds(_confirmDelete.Id);
        deletingIds.Add(_confirmDelete.Id);
        var res = await BlockService.DeleteAsync(PageId, SectionId, _confirmDelete.Id);
        Http.Notify(res, T("NotificationBlockDeleted"));
        if (res.Success)
        {
            if (_activeBlockId is not null && deletingIds.Contains(_activeBlockId))
            {
                _activeBlockId = null;
                _activePanelBlockId = null;
                _fullBlock     = null;
                await ActiveBlockChanged.InvokeAsync(null);
            }
            await ReloadBlocks();
            await NotifyChangedAsync();
        }
        _confirmDelete = null;
    }

    private void ClearDelete() => _confirmDelete = null;

    private HashSet<string> OwnedDescendantIds(string containerId)
    {
        var pending = new Queue<string>([containerId]);
        var descendants = new HashSet<string>(StringComparer.Ordinal);
        while (pending.Count > 0)
        {
            var parentId = pending.Dequeue();
            foreach (var child in _blocks.Where(block => block.ParentBlockId == parentId))
            {
                if (!descendants.Add(child.Id)) continue;
                if (child.Type == "container") pending.Enqueue(child.Id);
            }
        }
        return descendants;
    }

    private IReadOnlyList<BlockListEntry> BuildRootEntries()
    {
        var blockIds = _blocks.Select(block => block.Id).ToHashSet(StringComparer.Ordinal);
        return _blocks
            .Where(block => string.IsNullOrWhiteSpace(block.ParentBlockId) || !blockIds.Contains(block.ParentBlockId))
            .OrderBy(block => block.Order)
            .ThenBy(block => NormalizeBlockZone(block.BlockZone), StringComparer.Ordinal)
            .ThenBy(block => block.Id, StringComparer.Ordinal)
            .Select(block => new BlockListEntry(block, 0))
            .ToList();
    }

    [JSInvokable]
    public async Task<bool> OnBlocksReordered(
        string parentId,
        string zone,
        string slotId,
        List<string> orderedIds)
    {
        if (_reorderingBlock) return false;

        var cleanIds = orderedIds
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Distinct(StringComparer.Ordinal)
            .ToList();
        var peers = _blocks
            .Where(block => NormalizeParent(block.ParentBlockId) == NormalizeParent(parentId))
            .Where(block => NormalizeBlockZone(block.BlockZone) == NormalizeBlockZone(zone))
            .Where(block => NormalizeSlot(block.ColumnSlotId) == NormalizeSlot(slotId))
            .ToList();
        if (cleanIds.Count != peers.Count ||
            !cleanIds.ToHashSet(StringComparer.Ordinal).SetEquals(peers.Select(block => block.Id)))
            return false;
        if (peers.Any(block => block.Authoring.FullLocked || block.Authoring.GeometryLocked))
        {
            Http.Toast(T("GeometryLockedHint"), 400);
            return false;
        }
        if (peers.Any(block => !PresetAllowsChildReorder(block)))
            return false;

        _reorderingBlock = true;
        try
        {
            var res = await BlockService.ReorderAsync(PageId, SectionId, cleanIds);
            if (!res.Success)
            {
                Http.Notify(res, failureFallback: T("NotificationReorderFailed"));
                await ReloadBlocks();
                await InvokeAsync(StateHasChanged);
                return false;
            }

            for (var index = 0; index < cleanIds.Count; index++)
            {
                var block = peers.First(candidate => candidate.Id == cleanIds[index]);
                block.Order = index;
            }
            _blockSortableInitialized = false;
            await InvokeAsync(StateHasChanged);
            await NotifyChangedAsync();
            return true;
        }
        finally
        {
            _reorderingBlock = false;
        }
    }

