    private string BlockDisplayName(BlockModel block)
    {
        var title = LangValue(block.Title)
            ?? LangValue(block.Label)
            ?? LangValue(block.StepLabel)
            ?? LangValue(block.ButtonLabel)
            ?? (!string.IsNullOrWhiteSpace(block.FileName) ? block.FileName : null)
            ?? (!string.IsNullOrWhiteSpace(block.Asset?.FileName) ? block.Asset.FileName : null)
            ?? LangValue(block.Caption)
            ?? LangValue(block.AltText)
            ?? block.Pins?.Select(pin => pin.Label).FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
        return string.IsNullOrWhiteSpace(title) ? $"{T("Untitled")} {BlockTypeOrdinal(block)}" : title;
    }

    private int BlockTypeOrdinal(BlockModel block)
    {
        var peers = _blocks
            .Where(candidate => candidate.Type == block.Type)
            .OrderBy(candidate => candidate.Order)
            .ThenBy(candidate => candidate.Id, StringComparer.Ordinal)
            .ToList();
        return Math.Max(0, peers.FindIndex(candidate => candidate.Id == block.Id)) + 1;
    }

    private string ChildSummary(BlockModel child)
    {
        var label = T(BlockLabelKey(child.Type));
        if (string.IsNullOrWhiteSpace(child.Authoring?.PresetSlotName))
            return label;

        var parent = _blocks.FirstOrDefault(block => block.Id == child.ParentBlockId && block.Type == "container");
        var slotName = ContainerCapacityPolicy.SlotDisplayName(parent?.PresetKey, child.Authoring.PresetSlotName);
        return string.IsNullOrWhiteSpace(slotName) ? label : $"{label} · {slotName}";
    }

    private string SlotStatusTitle(ContainerSlotStatus slot) =>
        slot.Child is null
            ? string.Format(T("ContainerSlotAvailable"), slot.Label)
            : string.Format(T("ContainerSlotFilled"), slot.Label, BlockDisplayName(slot.Child));

    private string? LangValue(Dictionary<string, string>? values)
    {
        if (values is null || values.Count == 0)
            return null;

        if (values.TryGetValue(AdminLanguage, out var localized) && !string.IsNullOrWhiteSpace(localized))
            return localized;

        if (values.TryGetValue("en", out var en) && !string.IsNullOrWhiteSpace(en))
            return en;

        return values.Values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));
    }

