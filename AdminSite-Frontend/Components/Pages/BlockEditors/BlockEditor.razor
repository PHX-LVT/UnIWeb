    private IReadOnlyList<BlockListEntry> BuildHierarchy()
    {
        var result = new List<BlockListEntry>(_blocks.Count);
        var visited = new HashSet<string>(StringComparer.Ordinal);
        var byParent = _blocks
            .GroupBy(block => NormalizeParent(block.ParentBlockId), StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.ToList(), StringComparer.Ordinal);

        void AppendChildren(string parentId, int depth)
        {
            if (!byParent.TryGetValue(parentId, out var children)) return;
            foreach (var child in children
                         .OrderBy(block => block.Order)
                         .ThenBy(block => NormalizeBlockZone(block.BlockZone), StringComparer.Ordinal)
                         .ThenBy(block => block.Id, StringComparer.Ordinal))
            {
                if (!visited.Add(child.Id)) continue;
                result.Add(new BlockListEntry(child, Math.Min(depth, 12)));
                AppendChildren(child.Id, depth + 1);
            }
        }

        AppendChildren(string.Empty, 0);
        foreach (var orphan in _blocks
                     .Where(block => !visited.Contains(block.Id))
                     .OrderBy(block => block.Order)
                     .ThenBy(block => block.Id, StringComparer.Ordinal))
        {
            if (!visited.Add(orphan.Id)) continue;
            result.Add(new BlockListEntry(orphan, 0));
            AppendChildren(orphan.Id, 1);
        }

        return result;
    }

    [JSInvokable]
    public async Task<bool> OnBlocksReordered(
        string parentId,
        string zone,
        string slotId,
        List<string> orderedIds)
    {
        if (_reorderingBlock) return false;

        var cleanIds = orderedIds
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Distinct(StringComparer.Ordinal)
            .ToList();
        var peers = _blocks
            .Where(block => NormalizeParent(block.ParentBlockId) == NormalizeParent(parentId))
            .Where(block => NormalizeBlockZone(block.BlockZone) == NormalizeBlockZone(zone))
            .Where(block => NormalizeSlot(block.ColumnSlotId) == NormalizeSlot(slotId))
            .ToList();
        if (cleanIds.Count != peers.Count ||
            !cleanIds.ToHashSet(StringComparer.Ordinal).SetEquals(peers.Select(block => block.Id)))
            return false;
        if (peers.Any(block => block.Authoring.FullLocked || block.Authoring.GeometryLocked))
        {
            Http.Toast(T("GeometryLockedHint"), 400);
            return false;
        }

        _reorderingBlock = true;
        try
        {
            var res = await BlockService.ReorderAsync(PageId, SectionId, cleanIds);
            if (!res.Success)
            {
                Http.Toast(res.Message, res.StatusCode);
                await ReloadBlocks();
                await InvokeAsync(StateHasChanged);
                return false;
            }

            for (var index = 0; index < cleanIds.Count; index++)
            {
                var block = peers.First(candidate => candidate.Id == cleanIds[index]);
                block.Order = index;
            }
            _blockSortableInitialized = false;
            await InvokeAsync(StateHasChanged);
            await NotifyChangedAsync();
            return true;
        }
        finally
        {
            _reorderingBlock = false;
        }
    }

