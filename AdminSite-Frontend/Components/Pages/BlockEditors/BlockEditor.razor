    private void BringLayerForward() => _layoutZIndex = Math.Min(1000, _layoutZIndex + 1);

    private void SendLayerBackward() => _layoutZIndex = Math.Max(0, _layoutZIndex - 1);

    private void BringLayerToFront() => _layoutZIndex = Math.Min(1000, HighestPeerLayer() + 1);

    private void SendLayerToBack() => _layoutZIndex = 0;

    private int HighestPeerLayer()
    {
        if (_fullBlock is null)
            return _layoutZIndex;

        var parent = NormalizeParent(_fullBlock.ParentBlockId);
        var zone = NormalizeBlockZone(_fullBlock.BlockZone);
        return _blocks
            .Where(b => NormalizeParent(b.ParentBlockId) == parent)
            .Where(b => NormalizeBlockZone(b.BlockZone) == zone)
            .Select(b => Math.Clamp(b.Layout?.ZIndex ?? 1, 0, 1000))
            .DefaultIfEmpty(_layoutZIndex)
            .Max();
    }

    private async Task SaveBlockLayout()
    {
        if (_fullBlock is null || _savingLayout)
            return;

        if (!ValidateVisualSettings(out var validationMessage))
        {
            _visualValidationMessage = validationMessage;
            Http.Toast(validationMessage, 400);
            return;
        }

        _visualValidationMessage = null;

        _savingLayout = true;
        try
        {
            var before = CloneUpdateDto(_savedVisualSnapshot ?? BlockUpdateDtoMapper.Build(_fullBlock));
            var dto = CloneUpdateDto(BlockUpdateDtoMapper.Build(_fullBlock));
            var res = await BlockService.UpdateAsync(PageId, SectionId, _fullBlock.Id, dto);
            Http.Toast(res.Message, res.StatusCode);
            if (res.Success)
            {
                if (!UpdateDtosEqual(before, dto))
                {
                    _visualUndoHistory.Push(new VisualHistoryEntry(before, CloneUpdateDto(dto)));
                    _visualRedoHistory.Clear();
                }

                _savedVisualSnapshot = CloneUpdateDto(dto);
                var blockId = _fullBlock.Id;
                await ReloadBlocks();
                await LoadFullBlock(blockId, preserveVisualHistory: true);
                await NotifyChangedAsync();
            }
        }
        finally
        {
            _savingLayout = false;
        }
    }

    private Task UndoVisualChange() => ApplyVisualHistoryAsync(undo: true);

    private Task RedoVisualChange() => ApplyVisualHistoryAsync(undo: false);

    private async Task ApplyVisualHistoryAsync(bool undo)
    {
        if (_fullBlock is null || _savingLayout || VisualEditingLocked)
            return;

        var source = undo ? _visualUndoHistory : _visualRedoHistory;
        if (source.Count == 0)
            return;

        var entry = source.Peek();
        var target = CloneUpdateDto(undo ? entry.Before : entry.After);
        _savingLayout = true;
        try
        {
            var blockId = _fullBlock.Id;
            var res = await BlockService.UpdateAsync(PageId, SectionId, blockId, target);
            if (!res.Success)
            {
                Http.Toast(res.Message, res.StatusCode);
                return;
            }

            source.Pop();
            (undo ? _visualRedoHistory : _visualUndoHistory).Push(entry);
            _savedVisualSnapshot = CloneUpdateDto(target);
            await ReloadBlocks();
            await LoadFullBlock(blockId, preserveVisualHistory: true);
            await NotifyChangedAsync();
        }
        finally
        {
            _savingLayout = false;
        }
    }

    private static BlockUpdateDto CloneUpdateDto(BlockUpdateDto source)
    {
        var type = source.GetType();
        var json = System.Text.Json.JsonSerializer.Serialize(source, type);
        return (BlockUpdateDto)(System.Text.Json.JsonSerializer.Deserialize(json, type)
            ?? throw new InvalidOperationException("Could not clone the Block update snapshot."));
    }

    private static bool UpdateDtosEqual(BlockUpdateDto left, BlockUpdateDto right)
    {
        var leftJson = System.Text.Json.JsonSerializer.Serialize(left, left.GetType());
        var rightJson = System.Text.Json.JsonSerializer.Serialize(right, right.GetType());
        return string.Equals(leftJson, rightJson, StringComparison.Ordinal);
    }

    private bool ValidateVisualSettings(out string message)
    {
        message = string.Empty;
        if (_fullBlock is null) return true;

        foreach (var color in new[] { Appearance.BackgroundColor, Appearance.TextColor, Appearance.BorderColor })
        {
            if (!IsValidColor(color))
            {
                message = T("InvalidBlockColor");
                return false;
            }
        }

        if (Appearance.Shape == "circle" && Appearance.AspectRatio != "square")
        {
            message = T("CircleRequiresSquareRatio");
            return false;
        }

        if (_fullBlock.Type == "image" && !Appearance.Decorative &&
            !(_fullBlock.AltText?.Values.Any(value => !string.IsNullOrWhiteSpace(value)) ?? false))
        {
            message = T("ImageAltTextRequired");
            return false;
        }

        if (TryContrastRatio(Appearance.BackgroundColor, Appearance.TextColor, out var ratio) && ratio < 4.5)
        {
            message = T("BlockColorContrastTooLow");
            return false;
        }

        return true;
    }

    private static bool IsValidColor(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Equals("transparent", StringComparison.OrdinalIgnoreCase))
            return true;
        return System.Text.RegularExpressions.Regex.IsMatch(value.Trim(), "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?([0-9a-fA-F]{2})?$");
    }

    private static bool TryContrastRatio(string? background, string? foreground, out double ratio)
    {
        ratio = 0;
        if (!TryLuminance(background, out var backgroundLuminance) || !TryLuminance(foreground, out var foregroundLuminance))
            return false;
        var lighter = Math.Max(backgroundLuminance, foregroundLuminance);
        var darker = Math.Min(backgroundLuminance, foregroundLuminance);
        ratio = (lighter + 0.05) / (darker + 0.05);
        return true;
    }

    private static bool TryLuminance(string? color, out double luminance)
    {
        luminance = 0;
        if (string.IsNullOrWhiteSpace(color)) return false;
        var hex = color.TrimStart('#');
        if (hex.Length == 3) hex = string.Concat(hex.Select(character => $"{character}{character}"));
        if (hex.Length is not 6 and not 8 || !int.TryParse(hex[..6], System.Globalization.NumberStyles.HexNumber, null, out var rgb))
            return false;
        var channels = new[] { (rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255 }
            .Select(channel => channel / 255d)
            .Select(channel => channel <= 0.03928 ? channel / 12.92 : Math.Pow((channel + 0.055) / 1.055, 2.4))
            .ToArray();
        luminance = 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
        return true;
    }

