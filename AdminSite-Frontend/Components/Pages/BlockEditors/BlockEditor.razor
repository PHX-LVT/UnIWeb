    private static string NormalizeParent(string? parentBlockId) =>
        string.IsNullOrWhiteSpace(parentBlockId) ? string.Empty : parentBlockId;

    private static string NormalizeSlot(string? columnSlotId) =>
        string.IsNullOrWhiteSpace(columnSlotId) ? string.Empty : columnSlotId;

    private string BlockDisplayName(BlockModel block)
    {
        var title = LangValue(block.Title);
        return string.IsNullOrWhiteSpace(title) ? $"Container {block.Order + 1}" : title;
    }

    private string LangValue(Dictionary<string, string>? values)
    {
        if (values is null || values.Count == 0)
            return string.Empty;

        if (values.TryGetValue(AdminLanguage, out var localized) && !string.IsNullOrWhiteSpace(localized))
            return localized;

        return values.TryGetValue("en", out var en) ? en : values.Values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? string.Empty;
    }

    private string BlockHierarchyPath(BlockModel block)
    {
        var segments = new Stack<string>();
        var visited = new HashSet<string>(StringComparer.Ordinal);
        var parentId = block.ParentBlockId;
        while (!string.IsNullOrWhiteSpace(parentId) && visited.Add(parentId))
        {
            var parent = _blocks.FirstOrDefault(candidate => candidate.Id == parentId);
            if (parent is null)
                break;
            segments.Push(BlockDisplayName(parent));
            parentId = parent.ParentBlockId;
        }

        return segments.Count == 0
            ? T("TopLevel")
            : $"{T("TopLevel")} / {string.Join(" / ", segments)}";
    }

