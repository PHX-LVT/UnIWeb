    private IReadOnlyList<ContainerSlotStatus> ContainerSlotStatuses
    {
        get
        {
            var container = AddTargetContainer;
            var preset = ActiveContainerPreset;
            if (container is null || preset is null || preset.Slots.Count == 0)
                return Array.Empty<ContainerSlotStatus>();

            var childrenBySlot = ContainerChildren
                .Where(child => !string.IsNullOrWhiteSpace(child.Authoring?.PresetSlotName))
                .GroupBy(child => child.Authoring.PresetSlotName!, StringComparer.Ordinal)
                .ToDictionary(group => group.Key, group => group.OrderBy(child => child.Order).First(), StringComparer.Ordinal);

            return preset.Slots
                .Select(slot => new ContainerSlotStatus(
                    slot.Key,
                    slot.DisplayName,
                    slot.Required,
                    childrenBySlot.TryGetValue(slot.Key, out var child) ? child : null))
                .ToList();
        }
    }
