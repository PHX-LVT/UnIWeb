    private async Task RestoreActiveBlock(string? activeBlockId)
    {
        if (!string.IsNullOrEmpty(activeBlockId) &&
            _blocks.Any(b => b.Id == activeBlockId))
        {
            _activeBlockId = activeBlockId;
            _activePanelBlockId = ResolvePanelBlockId(activeBlockId);
            await LoadFullBlock(activeBlockId);
            return;
        }

        _activeBlockId = null;
        _activePanelBlockId = null;
        _fullBlock = null;
    }

    private async Task LoadFullBlock(string blockId, bool preserveVisualHistory = false)
    {
        var res = await BlockService.GetByIdAsync(PageId, SectionId, blockId);
        _fullBlock = res.Data;
        if (_fullBlock is not null)
        {
            _fullBlock.Layout ??= new BlockLayoutModel();
            _fullBlock.Appearance ??= new BlockAppearanceModel();
            _fullBlock.Responsive ??= new BlockResponsiveSettingsModel();
            _fullBlock.Animation ??= new BlockAnimationSettingsModel();
            _fullBlock.ContainerLayout ??= new ContainerLayoutSettingsModel();
            _fullBlock.ContainerLayout.Diagram ??= new ContainerDiagramSettingsModel();
            if (_fullBlock.Authoring.FullLocked)
            {
                _fullBlock.Authoring.ContentLocked = true;
                _fullBlock.Authoring.GeometryLocked = true;
                _fullBlock.Authoring.FullLocked = false;
            }

            if (!preserveVisualHistory || !string.Equals(_visualHistoryBlockId, blockId, StringComparison.Ordinal))
            {
                _visualUndoHistory.Clear();
                _visualRedoHistory.Clear();
            }

            _visualHistoryBlockId = blockId;
            _savedVisualSnapshot = CloneUpdateDto(BlockUpdateDtoMapper.Build(_fullBlock));
        }
    }

