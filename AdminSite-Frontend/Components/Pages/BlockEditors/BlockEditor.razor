    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);
    private bool IsRequiredContainerSlot(BlockModel block)
    {
        if (string.IsNullOrWhiteSpace(block.ParentBlockId) ||
            string.IsNullOrWhiteSpace(block.Authoring?.PresetSlotName))
            return false;

        var parent = _blocks.FirstOrDefault(candidate =>
            candidate.Id == block.ParentBlockId && candidate.Type == "container");
        return parent is not null &&
               ContainerCapacityPolicy.IsRequiredSlot(parent.PresetKey, block.Authoring.PresetSlotName);
    }

    private bool PresetAllowsChildReorder(BlockModel block)
    {
        if (string.IsNullOrWhiteSpace(block.ParentBlockId)) return true;

        var parent = _blocks.FirstOrDefault(candidate =>
            candidate.Id == block.ParentBlockId && candidate.Type == "container");
        return parent is null ||
               !ContainerPresetCatalog.TryGetGoverned(parent.PresetKey, out var preset) ||
               preset.ChildOrderingAllowed;
    }

