        var initialBlockChanged = _loadedInitialBlockId != InitialBlockId;
        if (contextChanged)
        {
            _loadedPageId = PageId;
            _loadedSectionId = SectionId;
            _loadedSlotId = SlotId;
            _activeBlockId = null;
            _activePanelBlockId = null;
