            if (!preserveVisualHistory || !string.Equals(_visualHistoryBlockId, blockId, StringComparison.Ordinal))
            {
                _visualUndoHistory.Clear();
                _visualRedoHistory.Clear();
            }

            _visualHistoryBlockId = blockId;
            _savedVisualSnapshot = CloneUpdateDto(BlockUpdateDtoMapper.Build(_fullBlock));
        }
    }

