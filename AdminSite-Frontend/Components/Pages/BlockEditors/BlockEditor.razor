    private IReadOnlyCollection<string>? AddTargetAllowedTypes
    {
        get
        {
            var target = AddTargetContainer;
            if (target is null) return null;
            var lockedType = target.ContainerLayout?.AllowedChildType;
            return NormalizeContainerPurpose(target.ContainerLayout?.Purpose) == "collection" &&
                   ContainerCapacityPolicy.CanOwn(lockedType)
                ? new[] { lockedType! }
                : ContainerCapacityPolicy.AllowedChildTypes(target.PresetKey);
        }
