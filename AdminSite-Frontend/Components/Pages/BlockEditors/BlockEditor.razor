        var byId = _blocks.ToDictionary(block => block.Id, StringComparer.Ordinal);
        if (!byId.TryGetValue(blockId, out var current))
            return blockId;

        var visited = new HashSet<string>(StringComparer.Ordinal);
        while (!string.IsNullOrWhiteSpace(current.ParentBlockId) && visited.Add(current.Id))
        {
            if (!byId.TryGetValue(current.ParentBlockId, out var parent))
                break;
            current = parent;
        }

        return current.Id;
    }

