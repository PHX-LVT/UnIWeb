    private async Task AddBlock(BlockStarterSelection selection)
    {
        if (!AddTargetHasCapacity) return;
        _creatingBlock = true;
        try
        {
            var dto = BlockStarterVariantCatalog.CreateDto(selection.Type, selection.VariantKey);
            dto.ParentBlockId = AddTargetContainer?.Id;
            // Use slotted create only when SlotId is set.
            var res = string.IsNullOrEmpty(SlotId)
                ? await BlockService.CreateAsync(PageId, SectionId, dto)
                : await BlockService.CreateInSlotAsync(PageId, SectionId, SlotId, dto);

            Http.Notify(res, T("NotificationBlockCreated"));
            if (!res.Success)
            {
                return;
            }

            _showPicker = false;
            await ReloadBlocks();
            if (res.Data is not null)
            {
                await ToggleBlock(res.Data.Id);
            }
            await NotifyChangedAsync();
        }
        finally
        {
            _creatingBlock = false;
        }
    }

