@inject AdminBlockService BlockService
@inject DirectResourceUploadService DirectUploads
@inject IHttpService Http
@using Contracts.Admin

<div class="form-group">
    <label class="form-label">@T("Image")</label>
    @if (!string.IsNullOrWhiteSpace(_asset.Url))
    {
        <div class="block-media-selection">
            <div class="image-focal-preview">
                <img src="@_asset.Url" alt="" style="@PreviewImageStyle" />
            </div>
            <button type="button" class="btn-admin btn-ghost" @onclick="ClearImage">
                <i class="fas fa-times"></i> @T("Remove")
            </button>
        </div>
    }
    <div class="block-media-actions">
        <InputFile id="image-block-upload" OnChange="OnFileSelected" accept="image/*" style="display:none" />
        <label class="btn-admin btn-ghost" for="image-block-upload">
            <i class="fas fa-image"></i> @T("UploadNew")
        </label>
        <button type="button" class="btn-admin btn-ghost" @onclick="() => _resourcePickerOpen = true">
            <i class="fas fa-photo-film"></i> @T("ChooseFromResourceLibrary")
        </button>
        <MediaCropField ImageUrl="@(_asset.Url ?? string.Empty)"
                        Value="_imagePlacement"
                        ValueChanged="SetImagePlacement"
                        AspectRatio="@ImageAspectRatio" />
    </div>
    <div class="form-hint">@T("UploadImageHint")</div>
</div>

<ResourcePickerModal Open="_resourcePickerOpen" Kind="image"
                     ResourceSelected="SelectResourceImage"
                     Closed="() => _resourcePickerOpen = false" />

<div class="form-group">
    <label class="form-label">@T("AltText")</label>
    @if (_decorative)
    {
        <div class="form-hint">@T("DecorativeImageAltTextHint")</div>
    }
    else
    {
        <LangField @bind-Value="_altText" Languages="Languages" NullText="@T("AltTextHint")" />
    }
</div>
<div class="form-group">
    <label class="form-label">@T("Caption")</label>
    <LangField @bind-Value="_caption" Languages="Languages" />
</div>
<label class="block-layout-panel__check">
    <input type="checkbox" @bind="_openInLightbox" disabled="@_decorative" />
    <span>@T("OpenImageInLightbox")</span>
</label>
<label class="block-layout-panel__check">
    <input type="checkbox" @bind="_decorative" @bind:after="ApplyDecorativeRules" />
    <span>@T("DecorativeImage")</span>
</label>

<div class="ez-editor-actions">
    <button class="btn-admin btn-primary" @onclick="Save" disabled="@_saving">
        <i class="fas fa-save"></i> @(_saving ? T("Saving") : T("Save"))
    </button>
</div>

@code {

    [Parameter] public BlockModel Block { get; set; } = new();
    [Parameter] public string PageId { get; set; } = string.Empty;
    [Parameter] public string SectionId { get; set; } = string.Empty;
    [Parameter] public List<string> Languages { get; set; } = new() { "en" };
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";

    private BlockAssetReferenceModel _asset = new();
    private Dictionary<string, string> _altText = new();
    private Dictionary<string, string> _caption = new();
    private bool _openInLightbox;
    private MediaPlacementModel _imagePlacement = MediaCropEditor.DefaultPlacement();
    private bool _decorative;
    private bool _saving;
    private bool _uploading;
    private bool _resourcePickerOpen;
    private string? _loadedBlockId;
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);
    private string PreviewImageStyle => FormattableString.Invariant($"object-fit:{_imagePlacement.Fit};object-position:{_imagePlacement.FocalPointX:0.##}% {_imagePlacement.FocalPointY:0.##}%;transform:scale({_imagePlacement.Zoom:0.###});transform-origin:{_imagePlacement.FocalPointX:0.##}% {_imagePlacement.FocalPointY:0.##}%");
    private double ImageAspectRatio => ParseAspectRatio(Block.Appearance.AspectRatio);

    protected override void OnParametersSet()
    {
        if (_loadedBlockId == Block.Id) return;
        _loadedBlockId = Block.Id;
        _asset = CopyAsset(Block.Asset);
        _altText = new(Block.AltText ?? new());
        _caption = new(Block.Caption ?? new());
        _openInLightbox = Block.OpenInLightbox;
        _imagePlacement = Block.ImagePlacement is null
            ? new MediaPlacementModel
            {
                FocalPointX = Math.Clamp(Block.FocalPointX, 0, 100),
                FocalPointY = Math.Clamp(Block.FocalPointY, 0, 100)
            }
            : MediaCropEditor.Normalize(MediaCropEditor.Clone(Block.ImagePlacement));
        _decorative = Block.Appearance.Decorative;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (_uploading) return;
        _uploading = true;
        try
        {
            var response = await DirectUploads.UploadInputAsync(
                "image-block-upload",
                "image",
                uploadContext: ResourceUploadContextCodes.ContentBlockImage);
            if (!response.Success || response.Data is null)
            {
                Http.Notify(response, failureFallback: T("ImageUploadFailed"));
                return;
            }
            _asset = ManagedAsset(response.Data);
            _imagePlacement = MediaCropEditor.DefaultPlacement();
            Http.Notify(T("ImageUploaded"), response.StatusCode);
        }
        finally { _uploading = false; }
    }

    private void SelectResourceImage(ManagedResourceModel resource)
    {
        _asset = ManagedAsset(resource);
        _imagePlacement = MediaCropEditor.DefaultPlacement();
        if (!_altText.Values.Any(value => !string.IsNullOrWhiteSpace(value)))
            _altText = new(resource.Name);
    }

    private void ClearImage() { _asset = new BlockAssetReferenceModel { SchemaVersion = 1 }; _imagePlacement = MediaCropEditor.DefaultPlacement(); }
    private void SetImagePlacement(MediaPlacementModel? value) => _imagePlacement = MediaCropEditor.Normalize(MediaCropEditor.Clone(value));

    private void ApplyDecorativeRules()
    {
        if (!_decorative) return;
        _openInLightbox = false;
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var appearance = BlockUpdateDtoMapper.ToAppearanceDto(Block.Appearance);
            appearance.Decorative = _decorative;
            var response = await BlockService.UpdateAsync(PageId, SectionId, Block.Id, new ImageBlockUpdateDto
            {
                Asset = AssetDto(_asset),
                AltText = _decorative ? new() : _altText,
                Caption = _caption,
                OpenInLightbox = _openInLightbox,
                FocalPointX = _imagePlacement.FocalPointX,
                FocalPointY = _imagePlacement.FocalPointY,
                ImagePlacement = MediaPlacementModelMapper.ToAdmin(_imagePlacement),
                Visible = Block.Visible,
                Appearance = appearance,
                Authoring = BlockUpdateDtoMapper.ToAuthoringDto(Block.Authoring)
            });
            Http.Notify(response);
            if (response.Success) await OnSaved.InvokeAsync();
        }
        finally { _saving = false; }
    }

    private static BlockAssetReferenceModel CopyAsset(BlockAssetReferenceModel? value) => new()
    {
        SchemaVersion = 1,
        Url = value?.Url,
        ResourceId = value?.ResourceId,
        ResourceSource = value?.ResourceSource ?? "DirectUpload",
        StorageKey = value?.StorageKey,
        FileName = value?.FileName,
        ContentType = value?.ContentType,
        SizeBytes = value?.SizeBytes ?? 0
    };

    private static BlockAssetReferenceModel ManagedAsset(ManagedResourceModel resource) => new()
    {
        SchemaVersion = 1, Url = resource.Url, ResourceId = resource.Id,
        ResourceSource = "ManagedResource", StorageKey = resource.StorageKey,
        FileName = resource.FileName, ContentType = resource.ContentType,
        SizeBytes = resource.SizeBytes
    };

    private static BlockAssetReferenceDto AssetDto(BlockAssetReferenceModel value) => new()
    {
        SchemaVersion = 1, Url = value.Url, ResourceId = value.ResourceId,
        ResourceSource = value.ResourceSource, StorageKey = value.StorageKey,
        FileName = value.FileName, ContentType = value.ContentType, SizeBytes = value.SizeBytes
    };

    private static double ParseAspectRatio(string? value) => value?.Trim().ToLowerInvariant() switch
    {
        "1:1" or "square" => 1d,
        "4:3" => 4d / 3d,
        "3:2" => 3d / 2d,
        "16:9" or "wide" => 16d / 9d,
        "21:9" => 21d / 9d,
        _ => 16d / 10d
    };
}

<style>
    .image-focal-preview { position:relative; width:180px; height:112px; overflow:hidden; border-radius:7px; background:#e2e8f0; }
    .image-focal-preview img { width:100%; height:100%; object-fit:cover; }
</style>
