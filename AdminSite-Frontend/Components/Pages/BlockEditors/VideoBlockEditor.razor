@inject AdminBlockService BlockService
@inject IHttpService Http
@using Contracts.Admin
@using SharedComponents.Helpers

<div class="form-group">
    <label class="form-label">@T("VideoSource")</label>
    <div class="block-source-toggle">
        <button type="button" class="@SourceButtonClass("upload")" @onclick="SelectUploadSource">@T("UploadVideo")</button>
        <button type="button" class="@SourceButtonClass("youtube")" @onclick="SelectYouTubeSource">@T("YouTubeLink")</button>
    </div>
</div>

@if (_sourceType == "upload")
{
    <div class="form-group">
        <div class="block-media-actions">
            <InputFile id="video-block-upload" OnChange="OnVideoSelected" accept="video/mp4,video/webm,video/quicktime" style="display:none" />
            <label class="btn-admin btn-ghost" for="video-block-upload"><i class="fas fa-video"></i> @T("UploadNew")</label>
            <button type="button" class="btn-admin btn-ghost" @onclick="() => _resourcePickerOpen = true">
                <i class="fas fa-photo-film"></i> @T("ChooseFromResourceLibrary")
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_asset.Url))
        {
            <div class="form-hint">@(_asset.FileName ?? T("UploadedVideo"))</div>
        }
    </div>
}
else
{
    <div class="form-group">
        <label class="form-label">@T("YouTubeLink")</label>
        <DxTextBox @bind-Text="_youtubeUrl" CssClass="w-100" NullText="https://www.youtube.com/watch?v=..." />
        <div class="form-hint">@T("FullYouTubeLinkHint")</div>
    </div>
}

<ResourcePickerModal Open="_resourcePickerOpen" Kind="video"
                     ResourceSelected="SelectResourceVideo"
                     Closed="() => _resourcePickerOpen = false" />

<div class="form-group">
    <label class="form-label">@T("Title")</label>
    <LangField @bind-Value="_title" Languages="Languages" />
</div>

@if (!string.IsNullOrWhiteSpace(PreviewUrl))
{
    <div class="block-video-preview">
        @if (_sourceType == "upload")
        {
            <video src="@PreviewUrl" controls muted playsinline></video>
        }
        else
        {
            <iframe src="@PreviewUrl" title="Video preview" allowfullscreen></iframe>
        }
    </div>
}

<div class="block-media-settings block-media-settings--checks">
    @if (_sourceType == "upload")
    {
        <label class="block-layout-panel__check"><input type="checkbox" @bind="_showControls" /><span>@T("ShowVideoControls")</span></label>
        <label class="block-layout-panel__check"><input type="checkbox" @bind="_autoplay" @bind:after="EnsureMutedAutoplay" /><span>@T("Autoplay")</span></label>
        <label class="block-layout-panel__check"><input type="checkbox" @bind="_muted" disabled="@_autoplay" /><span>@T("Muted")</span></label>
        <label class="block-layout-panel__check"><input type="checkbox" @bind="_loop" /><span>@T("Loop")</span></label>
    }
</div>

<div class="ez-editor-actions">
    <button class="btn-admin btn-primary" @onclick="Save" disabled="@_saving">
        <i class="fas fa-save"></i> @(_saving ? T("Saving") : T("Save"))
    </button>
</div>

@code {
    private const long MaxVideoBytes = 250L * 1024 * 1024;

    [Parameter] public BlockModel Block { get; set; } = new();
    [Parameter] public string PageId { get; set; } = string.Empty;
    [Parameter] public string SectionId { get; set; } = string.Empty;
    [Parameter] public List<string> Languages { get; set; } = new() { "en" };
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";

    private BlockAssetReferenceModel _asset = new();
    private string _sourceType = "youtube";
    private string? _youtubeUrl;
    private Dictionary<string, string> _title = new();
    private bool _showControls = true;
    private bool _autoplay;
    private bool _muted;
    private bool _loop;
    private bool _saving;
    private bool _resourcePickerOpen;
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);
    private string? PreviewUrl => _sourceType == "upload" ? _asset.Url : VideoUrlHelper.ToEmbedUrl(_youtubeUrl);

    protected override void OnParametersSet()
    {
        _asset = CopyAsset(Block.Asset, Block.EmbedUrl);
        _sourceType = Block.SourceType == "upload" || !VideoUrlHelper.IsYouTubeVideoUrl(Block.EmbedUrl) ? "upload" : "youtube";
        _youtubeUrl = _sourceType == "youtube" ? Block.EmbedUrl : null;
        _title = new(Block.Title ?? new());
        _showControls = Block.ShowControls;
        _autoplay = Block.Autoplay;
        _muted = Block.Autoplay || Block.Muted;
        _loop = Block.Loop;
    }

    private void SetSource(string source)
    {
        if (string.Equals(_sourceType, source, StringComparison.Ordinal)) return;
        _sourceType = source;
        _asset = new BlockAssetReferenceModel
        {
            SchemaVersion = 1,
            ResourceSource = source == "youtube" ? "ExternalUrl" : "DirectUpload"
        };
        _youtubeUrl = null;
    }

    private void SelectUploadSource() => SetSource("upload");
    private void SelectYouTubeSource() => SetSource("youtube");

    private async Task OnVideoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxVideoBytes)
        {
            Http.Toast(T("VideoTooLarge"), 400);
            return;
        }
        var response = await Http.PostFileAsync<AssetUploadModel>(
            "api/admin/assets/upload?folder=video-blocks", file, maxBytes: MaxVideoBytes);
        if (!response.Success || response.Data is null)
        {
            Http.Toast(response.Message ?? T("VideoUploadFailed"), response.StatusCode);
            return;
        }
        _asset = DirectAsset(response.Data);
        _sourceType = "upload";
        Http.Toast(T("VideoUploaded"), response.StatusCode);
    }

    private void SelectResourceVideo(ManagedResourceModel resource)
    {
        _asset = ManagedAsset(resource);
        _sourceType = VideoUrlHelper.IsYouTubeVideoUrl(resource.Url) ? "youtube" : "upload";
        _youtubeUrl = _sourceType == "youtube" ? resource.Url : null;
    }

    private void EnsureMutedAutoplay() { if (_autoplay) _muted = true; }
    private string SourceButtonClass(string value) => _sourceType == value ? "btn-admin btn-primary" : "btn-admin btn-ghost";

    private async Task Save()
    {
        _saving = true;
        try
        {
            var asset = _sourceType == "youtube"
                ? new BlockAssetReferenceDto { SchemaVersion = 1, Url = _youtubeUrl, ResourceSource = _asset.ResourceId is null ? "ExternalUrl" : "ManagedResource", ResourceId = _asset.ResourceId }
                : AssetDto(_asset);
            var response = await BlockService.UpdateAsync(PageId, SectionId, Block.Id, new VideoBlockUpdateDto
            {
                Asset = asset,
                EmbedUrl = asset.Url ?? string.Empty,
                SourceType = _sourceType,
                Title = _title,
                ShowControls = _showControls,
                Autoplay = _sourceType == "upload" && _autoplay,
                Muted = _sourceType == "upload" && (_autoplay || _muted),
                Loop = _sourceType == "upload" && _loop,
                Visible = Block.Visible,
                Authoring = BlockUpdateDtoMapper.ToAuthoringDto(Block.Authoring)
            });
            Http.Toast(response.Message, response.StatusCode);
            if (response.Success) await OnSaved.InvokeAsync();
        }
        finally { _saving = false; }
    }

    private static BlockAssetReferenceModel CopyAsset(BlockAssetReferenceModel? value, string? legacyUrl) => new()
    {
        SchemaVersion = 1, Url = value?.Url ?? legacyUrl, ResourceId = value?.ResourceId,
        ResourceSource = value?.ResourceSource ?? "DirectUpload", StorageKey = value?.StorageKey,
        FileName = value?.FileName, ContentType = value?.ContentType, SizeBytes = value?.SizeBytes ?? 0
    };
    private static BlockAssetReferenceModel DirectAsset(AssetUploadModel upload) => new()
    {
        SchemaVersion = 1, Url = upload.Url, ResourceSource = "DirectUpload", StorageKey = upload.StorageKey,
        FileName = upload.FileName, ContentType = upload.ContentType, SizeBytes = upload.Size
    };
    private static BlockAssetReferenceModel ManagedAsset(ManagedResourceModel resource) => new()
    {
        SchemaVersion = 1, Url = resource.Url, ResourceId = resource.Id, ResourceSource = "ManagedResource",
        StorageKey = resource.StorageKey, FileName = resource.FileName, ContentType = resource.ContentType, SizeBytes = resource.SizeBytes
    };
    private static BlockAssetReferenceDto AssetDto(BlockAssetReferenceModel value) => new()
    {
        SchemaVersion = 1, Url = value.Url, ResourceId = value.ResourceId, ResourceSource = value.ResourceSource,
        StorageKey = value.StorageKey, FileName = value.FileName, ContentType = value.ContentType, SizeBytes = value.SizeBytes
    };
}
