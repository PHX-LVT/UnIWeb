@using Contracts.Icons
@inject AdminContentService Content
@inject IHttpService Http

<div class="icon-picker-field">
    <button type="button" class="icon-picker-field__current" @onclick="Open" aria-label="@Label" disabled="@Disabled">
        <span class="icon-picker-field__preview" aria-hidden="true">
            @if (IsCustom && !string.IsNullOrWhiteSpace(Visual?.Url))
            {
                <img src="@Visual.Url" alt="" />
            }
            else
            {
                <i class="@(string.IsNullOrWhiteSpace(BuiltInClass) ? "fa-solid fa-icons" : BuiltInClass)"></i>
            }
        </span>
        <span class="icon-picker-field__label">@(HasSelection ? SelectionLabel : T("ChooseIcon"))</span>
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
    </button>
    @if (HasSelection)
    {
        <button type="button" class="icon-picker-field__clear" title="@T("Clear")" aria-label="@T("Clear")" @onclick="Clear" disabled="@Disabled">
            <i class="fa-solid fa-xmark"></i>
        </button>
    }
</div>

@if (_open)
{
    <div class="icon-catalog-backdrop" @onclick="Close">
        <section class="icon-catalog" role="dialog" aria-modal="true" aria-label="@T("ChooseIcon")" @onclick:stopPropagation="true">
            <header class="icon-catalog__header">
                <div>
                    <h3>@T("ChooseIcon")</h3>
                    <p>@T("IconCatalogueHint")</p>
                </div>
                <button type="button" class="icon-catalog__close" @onclick="Close" aria-label="@T("Close")"><i class="fa-solid fa-xmark"></i></button>
            </header>

            <nav class="icon-catalog__tabs" aria-label="@T("IconSource")">
                <button type="button" class="@BuiltInTabClass" @onclick="ShowBuiltIns"><i class="fa-solid fa-icons"></i> @T("BuiltInIcons")</button>
                @if (AllowCustom)
                {
                    <button type="button" class="@CustomTabClass" @onclick="ShowCustom"><i class="fa-solid fa-image"></i> @T("CustomIcons")</button>
                    <button type="button" class="@UploadTabClass" @onclick="ShowUpload"><i class="fa-solid fa-upload"></i> @T("UploadIcon")</button>
                }
            </nav>

            @if (_tab == "built-in")
            {
                <div class="icon-catalog__filters">
                    <label>
                        <span class="sr-only">@T("Search")</span>
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input class="form-control" @bind="_search" @bind:event="oninput" placeholder="@T("SearchIcons")" />
                    </label>
                    <select class="form-control" @bind="_category" aria-label="@T("Category")">
                        <option value="">@T("AllCategories")</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <div class="icon-catalog__grid">
                    @foreach (var icon in VisibleBuiltIns)
                    {
                        <button type="button" class="icon-catalog__item" title="@icon.Label" @onclick="() => SelectBuiltIn(icon)">
                            <i class="@icon.ClassName" aria-hidden="true"></i>
                            <span>@icon.Label</span>
                        </button>
                    }
                </div>
                @if (!VisibleBuiltIns.Any())
                {
                    <div class="icon-catalog__empty">@T("NoIconsFound")</div>
                }
            }
            else if (_tab == "custom")
            {
                <div class="icon-catalog__filters icon-catalog__filters--custom">
                    <label>
                        <span class="sr-only">@T("Search")</span>
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input class="form-control" @bind="_customSearch" @bind:event="oninput" placeholder="@T("SearchCustomIcons")" />
                    </label>
                    <select class="form-control" @bind="_usage" @bind:after="LoadCustomIcons" aria-label="@T("Usage")">
                        <option value="">@T("All")</option>
                        <option value="in-use">@T("InUse")</option>
                        <option value="unused">@T("Unused")</option>
                    </select>
                </div>
                @if (_loading)
                {
                    <div class="icon-catalog__empty"><i class="fa-solid fa-spinner fa-spin"></i> @T("Loading")</div>
                }
                else if (VisibleCustomIcons.Count == 0)
                {
                    <div class="icon-catalog__empty">@T("NoCustomIcons")</div>
                }
                else
                {
                    <div class="icon-catalog__grid icon-catalog__grid--custom">
                        @foreach (var resource in VisibleCustomIcons)
                        {
                            <div class="icon-catalog__custom" @key="resource.Id">
                                <button type="button" class="icon-catalog__item" title="@ResourceName(resource)" @onclick="() => SelectCustom(resource)">
                                    <img src="@resource.Url" alt="" />
                                    <span>@ResourceName(resource)</span>
                                </button>
                                <div class="icon-catalog__custom-meta">
                                    <span class="@(resource.IsInUse ? "is-used" : "is-unused")">@(resource.IsInUse ? T("InUse") : T("Unused"))</span>
                                    @if (!resource.IsInUse)
                                    {
                                        <button type="button" title="@T("Delete")" aria-label="@T("Delete")" disabled="@_deleting" @onclick="() => DeleteCustom(resource)"><i class="fa-solid fa-trash"></i></button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="icon-upload">
                    <div class="icon-upload__drop">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        <strong>@T("UploadCustomIcon")</strong>
                        <span>@T("CustomIconRequirements")</span>
                        <InputFile OnChange="Upload" accept=".png,.jpg,.jpeg,.webp,.svg,image/png,image/jpeg,image/webp,image/svg+xml" disabled="@_uploading" />
                    </div>
                    <div class="icon-upload__metadata">
                        <label>@T("OriginalSourceUrl")<input class="form-control" @bind="_sourceUrl" /></label>
                        <label>@T("License")<input class="form-control" @bind="_license" /></label>
                        <label>@T("Attribution")<input class="form-control" @bind="_attribution" /></label>
                    </div>
                    @if (_uploading)
                    {
                        <div class="icon-upload__status"><i class="fa-solid fa-spinner fa-spin"></i> @T("Uploading")</div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IconReferenceModel? Visual { get; set; }
    [Parameter] public EventCallback<IconReferenceModel?> VisualChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Icon";
    [Parameter] public IconContext Context { get; set; } = IconContext.GeneralContent;
    [Parameter] public bool AllowCustom { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string Language { get; set; } = "en";

    private bool _open;
    private string _tab = "built-in";
    private string _search = string.Empty;
    private string _customSearch = string.Empty;
    private string _category = string.Empty;
    private string _usage = string.Empty;
    private bool _loading;
    private bool _uploading;
    private bool _deleting;
    private string? _sourceUrl;
    private string? _license;
    private string? _attribution;
    private List<ManagedResourceModel> _customIcons = new();

    private string T(string key) => AdminUiLocalizer.T(key, Language);
    private bool IsCustom => string.Equals(Visual?.Source, IconSources.Custom, StringComparison.OrdinalIgnoreCase);
    private string BuiltInClass => IconCatalog.Normalize(Visual?.ClassName ?? Value, Context);
    private bool HasSelection => IsCustom ? !string.IsNullOrWhiteSpace(Visual?.Url) : !string.IsNullOrWhiteSpace(BuiltInClass);
    private string SelectionLabel => IsCustom ? (Visual?.FileName ?? T("CustomIcon")) : IconCatalog.TryResolve(BuiltInClass, out var icon) ? icon.Label : Label;
    private IReadOnlyList<string> Categories => IconCatalog.ForContext(Context).Select(icon => icon.Category).Distinct().Order().ToList();
    private IEnumerable<IconDefinition> VisibleBuiltIns => IconCatalog.Search(_search, Context).Where(icon => string.IsNullOrWhiteSpace(_category) || icon.Category == _category);
    private List<ManagedResourceModel> VisibleCustomIcons => _customIcons
        .Where(resource => string.IsNullOrWhiteSpace(_customSearch) || ResourceName(resource).Contains(_customSearch, StringComparison.OrdinalIgnoreCase) || resource.Tags.Any(tag => tag.Contains(_customSearch, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private void Open()
    {
        if (Disabled) return;
        _open = true;
        _tab = IsCustom && AllowCustom ? "custom" : "built-in";
        if (_tab == "custom") _ = LoadCustomIcons();
    }

    private void Close() => _open = false;
    private string BuiltInTabClass => _tab == "built-in" ? "is-active" : string.Empty;
    private string CustomTabClass => _tab == "custom" ? "is-active" : string.Empty;
    private string UploadTabClass => _tab == "upload" ? "is-active" : string.Empty;
    private Task ShowBuiltIns() => SetTab("built-in");
    private Task ShowCustom() => SetTab("custom");
    private Task ShowUpload() => SetTab("upload");

    private async Task SetTab(string tab)
    {
        _tab = tab;
        if (tab == "custom") await LoadCustomIcons();
    }

    private async Task SelectBuiltIn(IconDefinition icon)
    {
        var visual = new IconReferenceModel { Source = IconSources.BuiltIn, ClassName = icon.ClassName };
        await VisualChanged.InvokeAsync(visual);
        await ValueChanged.InvokeAsync(icon.ClassName);
        _open = false;
    }

    private async Task SelectCustom(ManagedResourceModel resource)
    {
        var visual = new IconReferenceModel
        {
            Source = IconSources.Custom,
            ResourceId = resource.Id,
            ResourceSource = "ManagedResource",
            Url = resource.Url,
            StorageKey = resource.StorageKey,
            FileName = resource.FileName,
            ContentType = resource.ContentType,
            SizeBytes = resource.SizeBytes
        };
        await VisualChanged.InvokeAsync(visual);
        await ValueChanged.InvokeAsync(string.Empty);
        _open = false;
    }

    private async Task Clear()
    {
        await VisualChanged.InvokeAsync(null);
        await ValueChanged.InvokeAsync(string.Empty);
    }

    private async Task LoadCustomIcons()
    {
        _loading = true;
        try
        {
            var response = await Content.GetResourcesAsync("image", null, true, null, "custom-icon", _usage);
            _customIcons = response.Success && response.Data is not null
                ? response.Data.Where(resource => string.IsNullOrWhiteSpace(resource.DeletionState)).ToList()
                : new();
            if (!response.Success) Http.Notify(response.Message, response.StatusCode);
        }
        finally { _loading = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task Upload(InputFileChangeEventArgs args)
    {
        var extension = Path.GetExtension(args.File.Name).ToLowerInvariant();
        var maximum = extension == ".svg" || string.Equals(args.File.ContentType, "image/svg+xml", StringComparison.OrdinalIgnoreCase)
            ? 512L * 1024
            : 2L * 1024 * 1024;
        if (extension is not (".png" or ".jpg" or ".jpeg" or ".webp" or ".svg") || args.File.Size <= 0 || args.File.Size > maximum)
        {
            Http.Notify(T("CustomIconRequirements"), 422);
            return;
        }
        _uploading = true;
        try
        {
            var response = await Content.UploadCustomIconAsync(args.File, _sourceUrl, _license, _attribution);
            if (response.Success && response.Data is not null)
            {
                Http.Notify(response.Message, response.StatusCode);
                await SelectCustom(response.Data);
            }
            else Http.Notify(response.Message, response.StatusCode);
        }
        finally { _uploading = false; }
    }

    private async Task DeleteCustom(ManagedResourceModel resource)
    {
        if (resource.IsInUse) return;
        _deleting = true;
        try
        {
            var response = await Content.DeleteResourceAsync(resource.Id);
            Http.Notify(response.Message, response.StatusCode);
            if (response.Success) await LoadCustomIcons();
        }
        finally { _deleting = false; }
    }

    private string ResourceName(ManagedResourceModel resource)
    {
        if (resource.Name.TryGetValue(Language, out var localized) && !string.IsNullOrWhiteSpace(localized)) return localized;
        if (resource.Name.TryGetValue("en", out var english) && !string.IsNullOrWhiteSpace(english)) return english;
        return Path.GetFileNameWithoutExtension(resource.FileName);
    }
}

<style>
    .icon-picker-field{display:grid;grid-template-columns:minmax(0,1fr) 38px;gap:.4rem;align-items:center}.icon-picker-field__current{min-height:42px;display:grid;grid-template-columns:42px minmax(0,1fr) 18px;align-items:center;gap:.55rem;text-align:left;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--text);padding:0 .65rem 0 0;cursor:pointer}.icon-picker-field__current:hover{border-color:var(--primary)}.icon-picker-field__preview{width:42px;height:40px;display:grid;place-items:center;border-right:1px solid var(--border);color:var(--primary)}.icon-picker-field__preview img{width:24px;height:24px;object-fit:contain}.icon-picker-field__label{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.icon-picker-field__clear{width:38px;height:38px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--text-muted)}
    .icon-catalog-backdrop{position:fixed;inset:0;z-index:2400;background:rgba(15,23,42,.55);display:grid;place-items:center;padding:24px}.icon-catalog{width:min(980px,96vw);height:min(760px,92vh);background:#fff;border-radius:14px;box-shadow:0 24px 70px rgba(15,23,42,.3);display:grid;grid-template-rows:auto auto auto minmax(0,1fr);overflow:hidden}.icon-catalog__header{display:flex;justify-content:space-between;gap:1rem;padding:1.2rem 1.35rem .85rem;border-bottom:1px solid var(--border)}.icon-catalog__header h3{margin:0;font-size:1.15rem}.icon-catalog__header p{margin:.25rem 0 0;color:var(--text-muted);font-size:.85rem}.icon-catalog__close{width:38px;height:38px;border:0;border-radius:8px;background:transparent}.icon-catalog__tabs{display:flex;gap:.25rem;padding:.65rem 1.35rem 0;border-bottom:1px solid var(--border)}.icon-catalog__tabs button{border:0;border-bottom:3px solid transparent;background:transparent;padding:.7rem .85rem;color:var(--text-muted)}.icon-catalog__tabs button.is-active{color:var(--primary);border-bottom-color:var(--primary)}.icon-catalog__filters{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:.75rem;padding:1rem 1.35rem}.icon-catalog__filters label{position:relative}.icon-catalog__filters label>i{position:absolute;left:.8rem;top:50%;transform:translateY(-50%);color:var(--text-muted)}.icon-catalog__filters label input{padding-left:2.35rem}.icon-catalog__grid{overflow:auto;padding:0 1.35rem 1.35rem;display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:.6rem;align-content:start}.icon-catalog__item{min-height:92px;border:1px solid var(--border);border-radius:9px;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.55rem;padding:.65rem;color:var(--text);cursor:pointer}.icon-catalog__item:hover{border-color:var(--primary);background:color-mix(in srgb,var(--primary) 5%,white)}.icon-catalog__item i{font-size:1.45rem;color:var(--primary)}.icon-catalog__item img{width:42px;height:42px;object-fit:contain}.icon-catalog__item span{font-size:.76rem;text-align:center;line-height:1.2}.icon-catalog__empty{display:grid;place-items:center;color:var(--text-muted);padding:3rem}.icon-catalog__grid--custom{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}.icon-catalog__custom{border:1px solid var(--border);border-radius:9px;overflow:hidden}.icon-catalog__custom .icon-catalog__item{border:0;border-radius:0;width:100%}.icon-catalog__custom-meta{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border);padding:.35rem .55rem;font-size:.72rem}.icon-catalog__custom-meta .is-used{color:#087f5b}.icon-catalog__custom-meta .is-unused{color:var(--text-muted)}.icon-catalog__custom-meta button{border:0;background:transparent;color:#c92a2a}.icon-upload{overflow:auto;padding:1.25rem 1.35rem}.icon-upload__drop{border:2px dashed var(--border);border-radius:12px;padding:2rem;display:flex;flex-direction:column;align-items:center;gap:.55rem;text-align:center}.icon-upload__drop>i{font-size:2rem;color:var(--primary)}.icon-upload__drop span{color:var(--text-muted);font-size:.83rem}.icon-upload__metadata{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem;margin-top:1rem}.icon-upload__metadata label{font-size:.78rem;color:var(--text-muted)}.icon-upload__metadata input{margin-top:.3rem}.icon-upload__status{text-align:center;padding:1rem;color:var(--primary)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @@media(max-width:700px){.icon-catalog-backdrop{padding:0}.icon-catalog{width:100vw;height:100vh;border-radius:0}.icon-catalog__tabs{overflow:auto}.icon-catalog__filters{grid-template-columns:1fr}.icon-upload__metadata{grid-template-columns:1fr}}
</style>
