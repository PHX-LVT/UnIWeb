@inject AdminBlockService BlockService
@inject IHttpService Http
@using Contracts.Admin

<div class="block-media-settings">
    <label class="form-group">
        <span class="form-label">@T("CenterLatitude")</span>
        <input class="form-control" type="number" min="-90" max="90" step="0.0001" @bind="_centerLat" />
    </label>
    <label class="form-group">
        <span class="form-label">@T("CenterLongitude")</span>
        <input class="form-control" type="number" min="-180" max="180" step="0.0001" @bind="_centerLng" />
    </label>
    <label class="form-group">
        <span class="form-label">@T("DefaultZoom")</span>
        <input class="form-control" type="number" min="1" max="18" @bind="_defaultZoom" />
    </label>
</div>

<div class="form-group">
    <label class="form-label">@T("Pins") (@_pins.Count)</label>
    <MapPinListEditor Pins="_pins"
                      DefaultLatitude="_centerLat"
                      DefaultLongitude="_centerLng"
                      Language="AdminLanguage" />
</div>

<div class="ez-editor-actions">
    <button class="btn-admin btn-primary" @onclick="Save" disabled="@_saving">
        <i class="fas fa-save"></i> @(_saving ? T("Saving") : T("Save"))
    </button>
</div>

@code {
    [Parameter] public BlockModel Block { get; set; } = new();
    [Parameter] public string PageId { get; set; } = string.Empty;
    [Parameter] public string SectionId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";

    private double _centerLat = 10.7769;
    private double _centerLng = 106.7009;
    private int _defaultZoom = 12;
    private List<MapPinModel> _pins = new();
    private bool _saving;
    private string? _loadedBlockId;
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    protected override void OnParametersSet()
    {
        if (_loadedBlockId == Block.Id) return;
        _loadedBlockId = Block.Id;
        _centerLat = Block.CenterLat ?? 10.7769;
        _centerLng = Block.CenterLng ?? 106.7009;
        _defaultZoom = Math.Clamp(Block.DefaultZoom ?? 12, 1, 18);
        _pins = Block.Pins?.Select(pin => new MapPinModel
        {
            Id = pin.Id,
            Lat = pin.Lat,
            Lng = pin.Lng,
            Label = pin.Label,
            Href = pin.Href,
            Visible = pin.Visible,
            Order = pin.Order
        }).OrderBy(pin => pin.Order).ToList() ?? new();
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var response = await BlockService.UpdateAsync(PageId, SectionId, Block.Id, new MapBlockUpdateDto
            {
                CenterLat = _centerLat,
                CenterLng = _centerLng,
                DefaultZoom = _defaultZoom,
                Pins = _pins.Select((pin, index) => new MapPinDto
                {
                    Id = pin.Id,
                    Label = pin.Label ?? string.Empty,
                    Lat = pin.Lat,
                    Lng = pin.Lng,
                    Href = pin.Href,
                    Visible = pin.Visible,
                    Order = index
                }).ToList(),
                Visible = Block.Visible,
                Authoring = BlockUpdateDtoMapper.ToAuthoringDto(Block.Authoring)
            });
            Http.Notify(response.Message, response.StatusCode);
            if (response.Success) await OnSaved.InvokeAsync();
        }
        finally { _saving = false; }
    }
}
