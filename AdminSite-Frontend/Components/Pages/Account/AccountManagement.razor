@page "/account"
@inject AdminUserService Users
@inject AdminAuthService Auth
@inject IHttpService Http
@inject AdminSessionInvalidationService Invalidations
@inject IJSRuntime JS

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-user-circle"></i> @T("AccountManagement")</h1>
</div>

<div style="display:grid;grid-template-columns:minmax(280px,420px) minmax(0,1fr);gap:1rem;align-items:start">
    <div class="admin-card">
        <div class="admin-card-title">@T("Profile")</div>
        <div style="display:grid;gap:.5rem">
            <div><strong>@T("Name"):</strong> @Auth.CurrentUser?.FullName</div>
            <div><strong>@T("Email"):</strong> @Auth.CurrentUser?.Email</div>
            <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
                <strong>@T("Role"):</strong>
                <span>@Auth.CurrentUser?.RoleName</span>
                <button type="button"
                        class="btn-admin btn-ghost"
                        style="padding:.3rem .55rem;min-height:auto"
                        title="@T("ViewPermissions")"
                        @onclick="() => _showPermissions = true">
                    <i class="fas fa-shield-halved"></i>
                    @T("ViewPermissions")
                </button>
            </div>
        </div>

        <hr />

        <div class="admin-card-title">@T("ChangePassword")</div>
        <div style="display:grid;gap:.75rem">
            <input class="form-control" type="password" placeholder="@T("CurrentPassword")" @bind="_currentPassword" />
            <input class="form-control" type="password" placeholder="@T("NewPassword")" @bind="_newPassword" />
            <button class="btn-admin btn-primary" disabled="@_saving" @onclick="ChangePassword">
                <i class="fas fa-key"></i> @(_saving ? T("Saving") : T("ChangePassword"))
            </button>
            <p class="text-muted" style="margin:0">@T("ChangePasswordSignsOutHint")</p>
        </div>

        <hr />

        <div class="admin-card-title">@T("RememberedDevices")</div>
        <p class="text-muted" style="margin:.25rem 0 .75rem">@T("RememberedDevicesDescription")</p>
        @if (_loadingDevices)
        {
            <p class="text-muted">@T("Loading")</p>
        }
        else if (!ActiveRememberedDevices.Any())
        {
            <p class="text-muted">@T("NoRememberedDevices")</p>
        }
        else
        {
            <div style="display:grid;gap:.6rem">
                @foreach (var device in ActiveRememberedDevices)
                {
                    var current = string.Equals(device.Id, Auth.CurrentUser?.RememberedDeviceId, StringComparison.Ordinal);
                    <div style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.75rem;align-items:center;padding:.7rem;border:1px solid var(--border);border-radius:8px">
                        <div>
                            <strong>@DisplayDevice(device)</strong>
                            @if (current) { <span class="content-status-pill is-published" style="margin-left:.35rem">@T("CurrentDevice")</span> }
                            <div class="text-muted" style="font-size:.8rem;margin-top:.2rem">@T("LastUsed"): @FormatDate(device.LastUsedAt) · @T("Expires"): @FormatDate(device.ExpiresAt)</div>
                        </div>
                        <button type="button" class="btn-admin btn-danger" disabled="@_revokingDevice" @onclick="() => ForgetDeviceAsync(device.Id)">
                            <i class="fas fa-ban"></i> @T("ForgetDevice")
                        </button>
                    </div>
                }
            </div>
        }
        <button type="button" class="btn-admin btn-ghost" style="margin-top:.8rem" disabled="@_signingOutAll" @onclick="SignOutAllDevicesAsync">
            <i class="fas fa-right-from-bracket"></i> @T("SignOutAllDevices")
        </button>
        <p class="text-muted" style="margin:.4rem 0 0">@T("SignOutAllDevicesHint")</p>
    </div>

    <div class="admin-card">
        <div class="admin-card-title">@T("MyLoginActivity")</div>
        @if (_loading)
        {
            <p class="text-muted">@T("Loading")</p>
        }
        else if (!_activity.Any())
        {
            <p class="text-muted">@T("NoSessions")</p>
        }
        else
        {
            <div style="overflow:auto">
                <table class="table" style="width:100%">
                    <thead>
                        <tr>
                            <th>@T("LoginTime")</th>
                            <th>@T("Action")</th>
                            <th>@T("IpAddress")</th>
                            <th>@T("Device")</th>
                            <th>@T("Status")</th>
                            <th>@T("Message")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _activity)
                        {
                            <tr>
                                <td>@FormatDate(item.OccurredAt)</td>
                                <td>@item.EventType</td>
                                <td>@item.IpAddress</td>
                                <td>@DisplayDevice(item)</td>
                                <td>
                                    @if (item.Success)
                                    {
                                        <span class="content-status-pill is-published">@T("Success")</span>
                                    }
                                    else
                                    {
                                        <span class="content-status-pill is-rejected">@T("Denied")</span>
                                    }
                                </td>
                                <td>@item.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (_showPermissions)
{
    <div class="modal-backdrop" @onclick="ClosePermissions">
        <div class="modal-box"
             style="width:min(760px,calc(100vw - 2rem));max-height:min(760px,calc(100vh - 2rem));display:flex;flex-direction:column"
             role="dialog"
             aria-modal="true"
             aria-labelledby="account-permissions-title"
             @onclick:stopPropagation="true">
            <div class="modal-header" style="display:flex;align-items:center;justify-content:space-between;gap:1rem">
                <div>
                    <div id="account-permissions-title">@T("AccountPermissions")</div>
                    <div class="text-muted" style="font-size:.82rem;font-weight:500;margin-top:.2rem">
                        @T("Role"): @Auth.CurrentUser?.RoleName · @string.Format(T("PermissionCount"), EffectivePermissions.Count)
                    </div>
                </div>
                <button type="button" class="btn-admin btn-ghost content-icon-btn" title="@T("Close")" @onclick="ClosePermissions">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body" style="overflow:auto">
                <p class="text-muted" style="margin-top:0">@T("EffectivePermissionsHint")</p>

                @if (EffectivePermissions.Count == 0)
                {
                    <div class="admin-data-empty">@T("NoAssignedPermissions")</div>
                }
                else
                {
                    <div style="display:grid;gap:.65rem">
                        @foreach (var permission in EffectivePermissions)
                        {
                            <article style="display:grid;grid-template-columns:28px minmax(0,1fr);gap:.7rem;padding:.8rem;border:1px solid var(--border);border-radius:8px;background:var(--surface)">
                                <span style="width:28px;height:28px;display:grid;place-items:center;border-radius:999px;background:#e8f5ee;color:#166534">
                                    <i class="fas fa-check"></i>
                                </span>
                                <div>
                                    <strong>@PermissionLabel(permission)</strong>
                                    <div class="text-muted" style="font-size:.85rem;margin-top:.2rem">@PermissionDescription(permission)</div>
                                </div>
                            </article>
                        }
                    </div>
                }

                @if (Auth.IsAdminAdmin)
                {
                    <div style="font-weight:750;margin:1.25rem 0 .35rem">@T("AdminExclusivePermissions")</div>
                    <p class="text-muted" style="margin:.2rem 0 .75rem">@T("AdminExclusiveAccountHint")</p>
                    <div style="display:grid;gap:.65rem">
                        @foreach (var capability in AdminExclusiveCapabilityKeys.All)
                        {
                            <article style="display:grid;grid-template-columns:28px minmax(0,1fr);gap:.7rem;padding:.8rem;border:1px solid #cbd5e1;border-radius:8px;background:#f8fafc">
                                <span style="width:28px;height:28px;display:grid;place-items:center;border-radius:999px;background:#dbeafe;color:#1d4ed8">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <div>
                                    <strong>@AdminExclusiveLabel(capability)</strong>
                                    <div class="text-muted" style="font-size:.85rem;margin-top:.2rem">@AdminExclusiveDescription(capability)</div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-admin btn-primary" @onclick="ClosePermissions">@T("Close")</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";

    private readonly List<AdminLoginActivityResponse> _activity = new();
    private readonly List<AdminRememberedDeviceResponse> _devices = new();
    private bool _loading = true;
    private bool _saving;
    private bool _showPermissions;
    private bool _loadingDevices = true;
    private bool _revokingDevice;
    private bool _signingOutAll;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        await Auth.RefreshSessionAsync();
        await Task.WhenAll(LoadActivityAsync(), LoadDevicesAsync());
    }

    private async Task LoadDevicesAsync()
    {
        var res = await Users.GetMyRememberedDevicesAsync();
        _devices.Clear();
        if (res.Success && res.Data is not null)
            _devices.AddRange(res.Data);
        else
            Http.Notify(res.Message, res.StatusCode);
        _loadingDevices = false;
    }

    private async Task ForgetDeviceAsync(string id)
    {
        _revokingDevice = true;
        var res = await Users.RevokeMyRememberedDevicesAsync([id]);
        Http.Notify(res.Message, res.StatusCode);
        if (res.Success) await LoadDevicesAsync();
        _revokingDevice = false;
    }

    private async Task SignOutAllDevicesAsync()
    {
        _signingOutAll = true;
        var res = await Users.SignOutAllMyDevicesAsync();
        Http.Notify(res.Message, res.StatusCode);
        if (res.Success)
        {
            await JS.InvokeVoidAsync("adminAuth.submitSignOut", "signed-out", true);
            return;
        }
        _signingOutAll = false;
    }

    private async Task LoadActivityAsync()
    {
        var res = await Users.GetMyLoginActivityAsync();
        if (res.Success && res.Data is not null)
            _activity.AddRange(res.Data);
        else
            Http.Notify(res.Message, res.StatusCode);

        _loading = false;
    }

    private async Task ChangePassword()
    {
        var adminId = Auth.CurrentUser?.AdminId;
        _saving = true;
        var res = await Users.UpdatePasswordAsync(_currentPassword, _newPassword);
        Http.Notify(res.Message, res.StatusCode);
        _saving = false;

        if (!res.Success) return;

        if (!string.IsNullOrWhiteSpace(adminId))
            Invalidations.InvalidateAccount(adminId, "password-changed");
    }

    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    private List<string> EffectivePermissions =>
        AdminPermissionKeys.All.Where(Auth.HasPermission).ToList();

    private IEnumerable<AdminRememberedDeviceResponse> ActiveRememberedDevices =>
        _devices.Where(item => !item.IsRevoked && item.ExpiresAt > DateTime.UtcNow);

    private void ClosePermissions() => _showPermissions = false;

    private string PermissionLabel(string permission) => permission switch
    {
        AdminPermissionKeys.PageBuilder => T("PermissionPageBuilder"),
        AdminPermissionKeys.ViewContent => T("PermissionViewContent"),
        AdminPermissionKeys.CreateEditContent => T("PermissionCreateEditContent"),
        AdminPermissionKeys.ApproveContent => T("PermissionApproveContent"),
        AdminPermissionKeys.ManageUsers => T("PermissionManageUsers"),
        AdminPermissionKeys.ManageSettings => T("PermissionManageSettings"),
        AdminPermissionKeys.ViewAuditTrail => T("PermissionViewAuditTrail"),
        AdminPermissionKeys.ViewLoginActivity => T("PermissionViewLoginActivity"),
        AdminPermissionKeys.ViewWebsiteActivity => T("PermissionViewWebsiteActivity"),
        AdminPermissionKeys.ExportLogs => T("PermissionExportLogs"),
        AdminPermissionKeys.ViewFormDefinitions => T("PermissionViewFormDefinitions"),
        AdminPermissionKeys.EditFormDefinitions => T("PermissionEditFormDefinitions"),
        AdminPermissionKeys.ViewFormSubmissions => T("PermissionViewFormSubmissions"),
        AdminPermissionKeys.ManageFormSubmissions => T("PermissionManageFormSubmissions"),
        AdminPermissionKeys.ExportFormSubmissions => T("PermissionExportFormSubmissions"),
        _ => permission
    };

    private string PermissionDescription(string permission) => permission switch
    {
        AdminPermissionKeys.PageBuilder => T("PermissionPageBuilderDescription"),
        AdminPermissionKeys.ViewContent => T("PermissionViewContentDescription"),
        AdminPermissionKeys.CreateEditContent => T("PermissionCreateEditContentDescription"),
        AdminPermissionKeys.ApproveContent => T("PermissionApproveContentDescription"),
        AdminPermissionKeys.ManageUsers => T("PermissionManageUsersDescription"),
        AdminPermissionKeys.ManageSettings => T("PermissionManageSettingsDescription"),
        AdminPermissionKeys.ViewAuditTrail => T("PermissionViewAuditTrailDescription"),
        AdminPermissionKeys.ViewLoginActivity => T("PermissionViewLoginActivityDescription"),
        AdminPermissionKeys.ViewWebsiteActivity => T("PermissionViewWebsiteActivityDescription"),
        AdminPermissionKeys.ExportLogs => T("PermissionExportLogsDescription"),
        AdminPermissionKeys.ViewFormDefinitions => T("PermissionViewFormDefinitionsDescription"),
        AdminPermissionKeys.EditFormDefinitions => T("PermissionEditFormDefinitionsDescription"),
        AdminPermissionKeys.ViewFormSubmissions => T("PermissionViewFormSubmissionsDescription"),
        AdminPermissionKeys.ManageFormSubmissions => T("PermissionManageFormSubmissionsDescription"),
        AdminPermissionKeys.ExportFormSubmissions => T("PermissionExportFormSubmissionsDescription"),
        _ => permission
    };

    private string AdminExclusiveLabel(string capability) => capability switch
    {
        AdminExclusiveCapabilityKeys.ManageContentConfiguration => T("AdminExclusiveManageContentConfiguration"),
        AdminExclusiveCapabilityKeys.ViewEditAnyDraft => T("AdminExclusiveViewEditAnyDraft"),
        AdminExclusiveCapabilityKeys.DirectPublishDraft => T("AdminExclusiveDirectPublishDraft"),
        AdminExclusiveCapabilityKeys.ForceReturnContentToDraft => T("AdminExclusiveForceReturnContentToDraft"),
        AdminExclusiveCapabilityKeys.DeleteAnyEligibleContent => T("AdminExclusiveDeleteAnyEligibleContent"),
        AdminExclusiveCapabilityKeys.ViewDeletedContent => T("AdminExclusiveViewDeletedContent"),
        AdminExclusiveCapabilityKeys.RestoreDeletedContent => T("AdminExclusiveRestoreDeletedContent"),
        AdminExclusiveCapabilityKeys.PermanentlyDeleteContent => T("AdminExclusivePermanentlyDeleteContent"),
        AdminExclusiveCapabilityKeys.ManageContentWorkflowHistory => T("AdminExclusiveManageContentWorkflowHistory"),
        AdminExclusiveCapabilityKeys.ManageRoleDefinitions => T("AdminExclusiveManageRoleDefinitions"),
        AdminExclusiveCapabilityKeys.ManageProtectedAdminAccounts => T("AdminExclusiveManageProtectedAdminAccounts"),
        AdminExclusiveCapabilityKeys.ManageLogRetention => T("AdminExclusiveManageLogRetention"),
        _ => capability
    };

    private string AdminExclusiveDescription(string capability) => capability switch
    {
        AdminExclusiveCapabilityKeys.ManageContentConfiguration => T("AdminExclusiveManageContentConfigurationDescription"),
        AdminExclusiveCapabilityKeys.ViewEditAnyDraft => T("AdminExclusiveViewEditAnyDraftDescription"),
        AdminExclusiveCapabilityKeys.DirectPublishDraft => T("AdminExclusiveDirectPublishDraftDescription"),
        AdminExclusiveCapabilityKeys.ForceReturnContentToDraft => T("AdminExclusiveForceReturnContentToDraftDescription"),
        AdminExclusiveCapabilityKeys.DeleteAnyEligibleContent => T("AdminExclusiveDeleteAnyEligibleContentDescription"),
        AdminExclusiveCapabilityKeys.ViewDeletedContent => T("AdminExclusiveViewDeletedContentDescription"),
        AdminExclusiveCapabilityKeys.RestoreDeletedContent => T("AdminExclusiveRestoreDeletedContentDescription"),
        AdminExclusiveCapabilityKeys.PermanentlyDeleteContent => T("AdminExclusivePermanentlyDeleteContentDescription"),
        AdminExclusiveCapabilityKeys.ManageContentWorkflowHistory => T("AdminExclusiveManageContentWorkflowHistoryDescription"),
        AdminExclusiveCapabilityKeys.ManageRoleDefinitions => T("AdminExclusiveManageRoleDefinitionsDescription"),
        AdminExclusiveCapabilityKeys.ManageProtectedAdminAccounts => T("AdminExclusiveManageProtectedAdminAccountsDescription"),
        AdminExclusiveCapabilityKeys.ManageLogRetention => T("AdminExclusiveManageLogRetentionDescription"),
        _ => capability
    };

    private static string FormatDate(DateTime? value) =>
        value?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "-";

    private static string DisplayDevice(AdminLoginActivityResponse item)
    {
        var browser = string.IsNullOrWhiteSpace(item.BrowserName) ? "Browser" : item.BrowserName;
        var os = string.IsNullOrWhiteSpace(item.OperatingSystem) ? "Unknown OS" : item.OperatingSystem;
        return $"{browser} / {os}";
    }

    private static string DisplayDevice(AdminRememberedDeviceResponse item)
    {
        var browser = string.IsNullOrWhiteSpace(item.BrowserName) ? "Browser" : item.BrowserName;
        var os = string.IsNullOrWhiteSpace(item.OperatingSystem) ? "Unknown OS" : item.OperatingSystem;
        return $"{browser} / {os}";
    }
}
