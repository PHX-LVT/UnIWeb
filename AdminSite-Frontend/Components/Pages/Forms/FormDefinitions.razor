    }

    private void MarkInputActivity() => _hasInputActivity = true;
    private void CommitInputActivity() => _hasInputActivity = false;

    private void ApplyDefinitionOrder(IReadOnlyList<string> definitionIds)
    {
        if (definitionIds.Count == 0) return;
        var byId = _definitions.ToDictionary(definition => definition.Id, StringComparer.Ordinal);
        var ordered = definitionIds.Where(byId.ContainsKey).Select(id => byId[id]).ToList();
        var seen = ordered.Select(definition => definition.Id).ToHashSet(StringComparer.Ordinal);
        ordered.AddRange(_definitions.Where(definition => seen.Add(definition.Id)).OrderBy(definition => definition.Key, StringComparer.OrdinalIgnoreCase));
        _definitions = ordered;
    }

    [JSInvokable]
    public async Task<bool> OnDefinitionOrderDropped(string[] orderedDefinitionIds)
    {
        if (!CanReorderDefinitions || _definitionOrder is null) return false;
        var byId = _definitions.ToDictionary(definition => definition.Id, StringComparer.Ordinal);
        if (orderedDefinitionIds.Length != _definitions.Count ||
            orderedDefinitionIds.Distinct(StringComparer.Ordinal).Count() != _definitions.Count ||
            orderedDefinitionIds.Any(id => !byId.ContainsKey(id))) return false;

        var previous = _definitions.ToList();
        _definitions = orderedDefinitionIds.Select(id => byId[id]).ToList();
        await InvokeAsync(StateHasChanged);

        var result = await FormService.ReorderDefinitionsAsync(_definitionOrder.Revision, orderedDefinitionIds);
        if (result.Success && result.Data is not null)
        {
            _definitionOrder = result.Data;
            ApplyDefinitionOrder(result.Data.DefinitionIds);
            return true;
        }

        _definitions = previous;
        if (result.Data is not null) _definitionOrder = result.Data;
        _definitionSortableRefreshPending = true;
        Http.Notify(result);
        await InvokeAsync(StateHasChanged);
        return false;
    }

    private async Task MoveDefinition(string definitionId, int delta)
    {
        if (!CanReorderDefinitions) return;
        var index = _definitions.FindIndex(definition => definition.Id == definitionId);
        var next = index + delta;
        if (index < 0 || next < 0 || next >= _definitions.Count) return;
        await ReorderDefinitionAsync(definitionId, null, next);
    }

    private async Task ReorderDefinitionAsync(string sourceId, string? targetId, int? targetIndex)
    {
        if (!CanReorderDefinitions || _definitionOrder is null) return;
        var previous = _definitions.ToList();
        var sourceIndex = _definitions.FindIndex(definition => definition.Id == sourceId);
        var destination = targetIndex ?? _definitions.FindIndex(definition => definition.Id == targetId);
        if (sourceIndex < 0 || destination < 0 || sourceIndex == destination) return;

        var moving = _definitions[sourceIndex];
        _definitions.RemoveAt(sourceIndex);
        if (targetIndex is null && sourceIndex < destination) destination--;
        destination = Math.Clamp(destination, 0, _definitions.Count);
        _definitions.Insert(destination, moving);
        await InvokeAsync(StateHasChanged);

        var result = await FormService.ReorderDefinitionsAsync(_definitionOrder.Revision, _definitions.Select(definition => definition.Id));
        if (result.Success && result.Data is not null)
        {
            _definitionOrder = result.Data;
            ApplyDefinitionOrder(result.Data.DefinitionIds);
            return;
        }

        _definitions = previous;
        if (result.Data is not null) _definitionOrder = result.Data;
        _definitionSortableRefreshPending = true;
        Http.Notify(result);
    }

    private Task HandleDefinitionKeyDown(KeyboardEventArgs args, string definitionId)
    {
        if (!args.AltKey) return Task.CompletedTask;
        return args.Key switch
        {
            "ArrowUp" => MoveDefinition(definitionId, -1),
            "ArrowDown" => MoveDefinition(definitionId, 1),
            _ => Task.CompletedTask
        };
    }

