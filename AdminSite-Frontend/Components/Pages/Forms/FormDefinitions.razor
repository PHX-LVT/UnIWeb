    private static string DefinitionSnapshot(FormDefinitionModel definition)
    {
        var design = ToDesignDto(definition.Design);
        design.V2 = design.V2 is null ? null : FormDesignV2Policy.Normalize(design.V2);
        var snapshot = new
        {
            Key = definition.Key?.Trim() ?? string.Empty,
            Name = CanonicalMap(definition.Name),
            Introduction = CanonicalMap(definition.Introduction),
            SubmitButtonLabel = CanonicalMap(definition.SubmitButtonLabel),
            InformationItems = definition.InformationItems.OrderBy(item => item.Order).Select(item => new
            {
                item.Id,
                item.Icon,
                Text = CanonicalMap(item.Text),
                Target = CanonicalTarget(item.Target),
                item.Order
            }),
            AuxiliaryActions = definition.AuxiliaryActions.OrderBy(action => action.Order).Select(action => new
            {
                action.Id,
                Label = CanonicalMap(action.Label),
                Target = CanonicalTarget(action.Target),
                action.Order
            }),
            Design = design,
            definition.Active,
            Fields = definition.Fields.OrderBy(field => field.Order).Select(field => new
            {
                Key = field.Key?.Trim() ?? string.Empty,
                Type = FormInputTypeCatalog.NormalizeType(field.Type),
                Label = CanonicalMap(field.Label),
                Placeholder = CanonicalMap(field.Placeholder),
                field.Required,
                field.MinLength,
                field.MaxLength,
                field.InputBoxSize,
                Options = field.Options.OrderBy(option => option.Order).Select(option => new
                {
                    option.Value,
                    Label = CanonicalMap(option.Label),
                    option.Order
                }),
                field.Order
            })
        };
        return JsonSerializer.Serialize(snapshot);
    }

    private static string DesignStateSnapshot(FormDefinitionModel definition)
    {
        var design = ToDesignDto(definition.Design);
        design.V2 = design.V2 is null ? null : FormDesignV2Policy.Normalize(design.V2);
        var snapshot = new
        {
            InformationItems = definition.InformationItems.OrderBy(item => item.Order).Select(item => new
            {
                item.Id,
                item.Icon,
                Text = CanonicalMap(item.Text),
                Target = CanonicalTarget(item.Target),
                item.Order
            }),
            AuxiliaryActions = definition.AuxiliaryActions.OrderBy(action => action.Order).Select(action => new
            {
                action.Id,
                Label = CanonicalMap(action.Label),
                Target = CanonicalTarget(action.Target),
                action.Order
            }),
            Design = design
        };
        return JsonSerializer.Serialize(snapshot);
    }

    private static SortedDictionary<string, string> CanonicalMap(Dictionary<string, string>? source) =>
        new((source ?? new())
            .Where(pair => !string.IsNullOrWhiteSpace(pair.Key))
            .GroupBy(pair => pair.Key.Trim().ToLowerInvariant(), StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.Last().Value ?? string.Empty),
            StringComparer.Ordinal);

    private static object? CanonicalTarget(FormActionTargetDto? target) => target is null
        ? null
        : new
        {
            target.Type,
            PageId = target.PageId?.Trim(),
            Path = target.Path?.Trim(),
            Url = target.Url?.Trim(),
            ResourceId = target.ResourceId?.Trim(),
            Phone = target.Phone?.Trim(),
            Email = target.Email?.Trim()
        };

