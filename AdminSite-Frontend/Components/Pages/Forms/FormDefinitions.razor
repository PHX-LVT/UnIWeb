    private enum PendingTransitionKind
    {
        New,
        Select,
        Delete,
        Navigate
    }

    private sealed record PendingTransition(PendingTransitionKind Kind, string Value)
    {
        public static PendingTransition New() => new(PendingTransitionKind.New, string.Empty);
        public static PendingTransition Select(string id) => new(PendingTransitionKind.Select, id);
        public static PendingTransition Delete(string id) => new(PendingTransitionKind.Delete, id);
        public static PendingTransition Navigate(string location) => new(PendingTransitionKind.Navigate, location);
    }

