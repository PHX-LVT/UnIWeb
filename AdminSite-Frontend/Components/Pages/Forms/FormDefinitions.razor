    {
        if (!Auth.CanEditFormDefinitions || _editingDefinition is null) return;

        if (_newUnsavedFields.Contains(field))
        {
            RemoveField(field);
            return;
        }

        _fieldPendingRemoval = field;
    }

    private void CancelFieldRemoval() => _fieldPendingRemoval = null;

    private void ConfirmFieldRemoval()
    {
        if (_fieldPendingRemoval is null) return;

        var field = _fieldPendingRemoval;
        _fieldPendingRemoval = null;
        RemoveField(field);
    }

    private void RemoveField(FormFieldDefinitionModel field)
    {
        if (!Auth.CanEditFormDefinitions) return;
        if (_editingDefinition is null) return;
        _expandedOptionFields.Remove(field);
        _newUnsavedFields.Remove(field);
        _fieldsCreatingNewKey.Remove(field);
        RemoveFieldKeyFromRows(field.Key);
        _editingDefinition.Fields.Remove(field);
        for (var i = 0; i < _editingDefinition.Fields.Count; i++)
            _editingDefinition.Fields[i].Order = i;
    }

    private string FieldDisplayName(FormFieldDefinitionModel field)
    {
        var label = Text(field.Label, string.Empty);
        return !string.IsNullOrWhiteSpace(label)
            ? label
            : !string.IsNullOrWhiteSpace(field.Key)
                ? field.Key
                : T("Field");
    }

    private async Task SaveCurrentDefinition()
    {
        await SaveDefinitionAsync();
    }

    private async Task<bool> SaveDefinitionAsync()
    {
        if (!Auth.CanEditFormDefinitions || _editingDefinition is null || _saving) return false;
        _fieldErrors = null;

        NormalizeEditingFields();
        EnsureEditingV2Coverage();
        var validationErrors = ValidateDefinition(_editingDefinition);
        if (validationErrors.Count > 0)
        {
            Http.Notify($"{T("PleaseCompleteRequiredFields")} {string.Join(" | ", validationErrors)}", 400);
            return false;
        }

        _saving = true;
        try
        {
            var res = await FormService.SaveDefinitionAsync(_editingDefinition);
            Http.Notify(res);
            if (res.StatusCode is not (>= 200 and < 300))
            {
                _fieldErrors = res.FieldErrors;
                return false;
            }
            await LoadDefinitionsAsync(res.Data?.Id);
            return true;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task RequestDeleteDefinition()
    {
        if (!CanDeleteDefinition || _editingDefinition is null) return Task.CompletedTask;
        return RequestTransitionAsync(PendingTransition.Delete(_editingDefinition.Id));
    }

    private async Task DeleteCurrentDefinition()
    {
        if (!CanDeleteDefinition || _editingDefinition is null) return;
        var res = await FormService.DeleteDefinitionAsync(_editingDefinition.Id);
        Http.Notify(res);
        if (res.StatusCode is >= 200 and < 300)
        {
            _editingDefinition = null;
            await LoadDefinitionsAsync();
        }
    }

    private List<string> ValidateDefinition(FormDefinitionModel definition)
    {
        var errors = new List<string>();
        var key = definition.Key?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(key))
            errors.Add($"{T("FormKey")}: {T("FormKeyRequired")}");
        else if (!System.Text.RegularExpressions.Regex.IsMatch(key, "^[a-z][a-z0-9-]{1,63}$"))
            errors.Add($"{T("FormKey")}: {T("FormKeyInvalid")}");
        else if (_definitions.Any(item =>
            !string.Equals(item.Id, definition.Id, StringComparison.Ordinal) &&
            string.Equals(item.Key, key, StringComparison.OrdinalIgnoreCase)))
            errors.Add($"{T("FormKey")}: {T("FormKeyAlreadyExists")}");
        if (!definition.Name.Values.Any(value => !string.IsNullOrWhiteSpace(value)))
            errors.Add("Form name is required.");
        if (!definition.SubmitButtonLabel.Values.Any(value => !string.IsNullOrWhiteSpace(value)))
            errors.Add("Submit button label is required.");
        if (definition.Fields.Count == 0)
            errors.Add("Add at least one form field.");
        foreach (var field in definition.Fields.OrderBy(field => field.Order))
        {
            var fieldKey = field.Key?.Trim() ?? string.Empty;
            var fieldLabel = FieldValidationLabel(field);
            if (string.IsNullOrWhiteSpace(fieldKey))
            {
                errors.Add($"{fieldLabel}: {T("FieldKeyRequired")}");
            }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(fieldKey, "^[A-Za-z][A-Za-z0-9_-]{0,99}$"))
            {
                errors.Add($"{fieldLabel}: {T("FieldKeyInvalid")}");
            }
        }

        foreach (var duplicate in definition.Fields
            .Where(field => !string.IsNullOrWhiteSpace(field.Key))
            .GroupBy(field => field.Key.Trim(), StringComparer.OrdinalIgnoreCase)
            .Where(group => group.Count() > 1))
        {
            errors.Add(string.Format(T("DuplicateFieldKeyInForm"), duplicate.First().Key.Trim()));
        }
        if (definition.Fields.Any(field => !IsSupported(field.Type)))
            errors.Add("Every field must use a supported field type.");
        if (definition.Fields.Any(field => !field.Label.Values.Any(value => !string.IsNullOrWhiteSpace(value))))
            errors.Add("Every field must have a label.");
        AddCapabilityValidation(definition.Fields, errors);
        var designDto = ToDesignDto(definition.Design);
        if (designDto.V2 is null)
        {
            errors.Add("A schema-v2 Form Design is required.");
        }
        else
        {
            errors.AddRange(FormDesignV2Policy.Validate(
                designDto.V2,
                definition.Fields.Select(ToFieldDto),
                definition.InformationItems,
                definition.AuxiliaryActions));
            var requiredHeight = FormDesignV2Policy.CalculateRequiredHeight(
                designDto,
                designDto.V2,
                definition.Fields.Select(ToFieldDto),
                definition.Name,
                definition.Introduction,
                definition.SubmitButtonLabel,
                definition.InformationItems,
                definition.AuxiliaryActions);
            if (requiredHeight > FormDesignPolicy.MaximumHeightPx)
            {
                errors.Add(string.Format(T("FormDesignTooTall"), FormDesignPolicy.MaximumHeightPx));
            }
        }

        return errors;
    }

    private string FieldValidationLabel(FormFieldDefinitionModel field)
    {
        var label = Text(field.Label, field.Key);
        return string.Format(T("FieldNumberLabel"), field.Order + 1, string.IsNullOrWhiteSpace(label) ? T("Field") : label);
    }

    private string Text(Dictionary<string, string>? values, string fallback) =>
        values?.GetValueOrDefault(AdminLanguage) is { Length: > 0 } localized
            ? localized
            : values?.GetValueOrDefault(AdminUiLocalizer.FallbackLanguage) is { Length: > 0 } configuredFallback
                ? configuredFallback
                : fallback;

    private string TypeName(FormInputTypeModel type) =>
        type.Name.GetValueOrDefault(AdminLanguage) is { Length: > 0 } localized
            ? localized
            : T(type.LabelKey);

    private void SetText(Dictionary<string, string> values, object? value) =>
        values[AdminLanguage] = value?.ToString() ?? string.Empty;

    private bool CanEditFieldIdentity(FormFieldDefinitionModel field) =>
        Auth.CanEditFormDefinitions &&
        (_editingDefinition is null ||
         string.IsNullOrWhiteSpace(_editingDefinition.Id) ||
         _newUnsavedFields.Contains(field));

    private void SetFieldKey(FormFieldDefinitionModel field, object? value)
    {
        if (!CanEditFieldIdentity(field)) return;
        var previous = field.Key;
        field.Key = value?.ToString()?.Trim() ?? string.Empty;
        ReplaceFieldKeyInRows(previous, field.Key);
    }

    private void SelectFieldKey(FormFieldDefinitionModel field, string? selection)
    {
        if (!CanEditFieldIdentity(field)) return;

        if (string.Equals(selection, CreateNewFieldKeySelection, StringComparison.Ordinal))
        {
            field.Key = string.Empty;
            _fieldsCreatingNewKey.Add(field);
            return;
        }

        _fieldsCreatingNewKey.Remove(field);
        var previous = field.Key;
        field.Key = selection?.Trim() ?? string.Empty;
        ReplaceFieldKeyInRows(previous, field.Key);
    }

    private void ReturnToExistingFieldKeys(FormFieldDefinitionModel field)
    {
        if (!CanEditFieldIdentity(field)) return;
        RemoveFieldKeyFromRows(field.Key);
        field.Key = string.Empty;
        _fieldsCreatingNewKey.Remove(field);
    }

    private bool IsCreatingNewFieldKey(FormFieldDefinitionModel field) =>
        CanEditFieldIdentity(field) && _fieldsCreatingNewKey.Contains(field);

    private string FieldKeySelection(FormFieldDefinitionModel field)
    {
        if (_fieldsCreatingNewKey.Contains(field))
            return CreateNewFieldKeySelection;

        return field.Key?.Trim() ?? string.Empty;
    }

    private IEnumerable<FieldKeySuggestion> FieldKeySuggestions(FormFieldDefinitionModel field)
    {
        var currentType = FormInputTypeCatalog.NormalizeType(field.Type);
        var currentKey = field.Key?.Trim() ?? string.Empty;
        var keysUsedByOtherFields = (_editingDefinition?.Fields ?? [])
            .Where(item => !ReferenceEquals(item, field) && !string.IsNullOrWhiteSpace(item.Key))
            .Select(item => item.Key.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return _definitions
            .SelectMany(definition => definition.Fields
                .Where(item =>
                    string.Equals(FormInputTypeCatalog.NormalizeType(item.Type), currentType, StringComparison.OrdinalIgnoreCase) &&
                    !string.IsNullOrWhiteSpace(item.Key) &&
                    (!keysUsedByOtherFields.Contains(item.Key.Trim()) ||
                     string.Equals(item.Key.Trim(), currentKey, StringComparison.OrdinalIgnoreCase)))
                .Select(item => new { definition.Id, Key = item.Key.Trim() }))
            .GroupBy(item => item.Key, StringComparer.OrdinalIgnoreCase)
            .Select(group => new FieldKeySuggestion(
                group.First().Key,
                group.Select(item => item.Id).Where(id => !string.IsNullOrWhiteSpace(id)).Distinct(StringComparer.Ordinal).Count()))
            .OrderByDescending(suggestion => suggestion.FormCount)
            .ThenBy(suggestion => suggestion.Key);
    }

    private bool FieldKeyExists(FormFieldDefinitionModel field)
    {
        var key = field.Key?.Trim();
        if (string.IsNullOrWhiteSpace(key))
            return false;

        var currentType = FormInputTypeCatalog.NormalizeType(field.Type);
        return _definitions.Any(definition => definition.Fields.Any(item =>
            string.Equals(FormInputTypeCatalog.NormalizeType(item.Type), currentType, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(item.Key?.Trim(), key, StringComparison.OrdinalIgnoreCase)));
    }

    private string FieldKeyBadgeText(FormFieldDefinitionModel field) =>
        FieldKeyExists(field) ? T("Existed") : T("New");

    private string FieldKeyBadgeClass(FormFieldDefinitionModel field) =>
        FieldKeyExists(field) ? "field-key-badge--existed" : "field-key-badge--new";

    private void ChangeFieldType(FormFieldDefinitionModel field, string? type)
    {
        if (!CanEditFieldIdentity(field)) return;
        if (!Auth.CanEditFormDefinitions) return;
        var oldCapability = Capability(field);
        var nextType = FormInputTypeCatalog.NormalizeType(type);
        if (FormDesignPolicy.IsWideField(nextType) && FieldSharesRow(field.Key))
        {
            Http.Notify(T("WideFieldMustUseOwnRow"), 400);
            return;
        }
        if (!string.Equals(field.Type, nextType, StringComparison.OrdinalIgnoreCase))
        {
            RemoveFieldKeyFromRows(field.Key);
            field.Key = string.Empty;
            _fieldsCreatingNewKey.Remove(field);
        }
        field.Type = nextType;
        var newCapability = Capability(field);
        ApplyFieldDefaults(field);

        if (!oldCapability.SupportsOptions && newCapability.SupportsOptions && field.Options.Count == 0)
            AddOption(field);
    }

    private void AddOption(FormFieldDefinitionModel field)
    {
        if (!Auth.CanEditFormDefinitions) return;
        _expandedOptionFields.Add(field);
        var order = field.Options.Count;
        field.Options.Add(new FormFieldOptionModel
        {
            Value = $"option-{order + 1}",
            Label = new() { [AdminLanguage] = $"Option {order + 1}" },
            Order = order
        });
    }

    private bool OptionsExpanded(FormFieldDefinitionModel field) =>
        _expandedOptionFields.Contains(field);

    private void ToggleOptions(FormFieldDefinitionModel field)
    {
        if (!_expandedOptionFields.Add(field))
            _expandedOptionFields.Remove(field);
    }

    private void RemoveOption(FormFieldDefinitionModel field, FormFieldOptionModel option)
    {
        if (!Auth.CanEditFormDefinitions) return;
        field.Options.Remove(option);
        for (var i = 0; i < field.Options.Count; i++)
            field.Options[i].Order = i;
    }

    private void BeginFieldDrag(FormFieldDefinitionModel field)
    {
        if (!Auth.CanEditFormDefinitions) return;
        _draggedField = field;
    }

    private void EndFieldDrag() => _draggedField = null;

    private void DropField(FormFieldDefinitionModel target)
    {
        if (!Auth.CanEditFormDefinitions) return;
        if (_editingDefinition is null || _draggedField is null || ReferenceEquals(_draggedField, target))
            return;

        EnsureEditingV2Coverage();
        var rows = _editingDefinition.Design.V2?.FieldRows;
        var sourceSlot = rows?.SelectMany(row => row.FieldKeys.Select((key, index) => new { row, key, index }))
            .FirstOrDefault(slot => string.Equals(slot.key, _draggedField.Key, StringComparison.OrdinalIgnoreCase));
        var targetSlot = rows?.SelectMany(row => row.FieldKeys.Select((key, index) => new { row, key, index }))
            .FirstOrDefault(slot => string.Equals(slot.key, target.Key, StringComparison.OrdinalIgnoreCase));
        if (sourceSlot is null || targetSlot is null) return;
        var sourceKey = sourceSlot.row.FieldKeys[sourceSlot.index];
        var targetKey = targetSlot.row.FieldKeys[targetSlot.index];
        sourceSlot.row.FieldKeys[sourceSlot.index] = targetKey;
        targetSlot.row.FieldKeys[targetSlot.index] = sourceKey;
        var v2Errors = FormDesignV2Policy.Validate(
            _editingDefinition.Design.V2,
            _editingDefinition.Fields.Select(ToFieldDto),
            _editingDefinition.InformationItems,
            _editingDefinition.AuxiliaryActions);
        if (v2Errors.Count > 0)
        {
            sourceSlot.row.FieldKeys[sourceSlot.index] = sourceKey;
            targetSlot.row.FieldKeys[targetSlot.index] = targetKey;
            Http.Notify(v2Errors[0], 400);
            return;
        }
        NormalizeFieldOrderFromRows();
        _draggedField = null;
    }

    private void EnsureEditingV2Coverage()
    {
        if (_editingDefinition is null) return;
        _editingDefinition.Design ??= CreateDefaultDesign(FormDesignShapeModel.Stacked);
        _editingDefinition.Design.V2 ??= FormDesignV2Policy.CreateDefault(
            _editingDefinition.Id,
            ToDesignDto(_editingDefinition.Design),
            _editingDefinition.Fields.Select(ToFieldDto));

        var fieldKeys = _editingDefinition.Fields
            .Where(field => !string.IsNullOrWhiteSpace(field.Key))
            .OrderBy(field => field.Order)
            .Select(field => field.Key.Trim())
            .ToList();
        var valid = fieldKeys.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var rows = _editingDefinition.Design.V2.FieldRows
            .OrderBy(row => row.Order)
            .Select(row => new FormFieldRowDto
            {
                Id = string.IsNullOrWhiteSpace(row.Id) ? NewEditorId("row") : row.Id,
                FieldKeys = (row.FieldKeys ?? new())
                    .Where(key => valid.Contains(key) && seen.Add(key))
                    .ToList()
            })
            .Where(row => row.FieldKeys.Count > 0)
            .ToList();
        foreach (var key in fieldKeys.Where(key => seen.Add(key)))
            rows.Add(new FormFieldRowDto { Id = NewEditorId("row"), FieldKeys = [key] });
        for (var index = 0; index < rows.Count; index++) rows[index].Order = index;
        _editingDefinition.Design.V2.FieldRows = rows;
        var actionIds = _editingDefinition.AuxiliaryActions.Select(action => action.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _editingDefinition.Design.V2.AuxiliaryActionLayouts = _editingDefinition.Design.V2.AuxiliaryActionLayouts
            .Where(layout => actionIds.Contains(layout.ActionId))
            .GroupBy(layout => layout.ActionId, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();
        foreach (var action in _editingDefinition.AuxiliaryActions.Where(action =>
                     _editingDefinition.Design.V2.AuxiliaryActionLayouts.All(layout => !string.Equals(layout.ActionId, action.Id, StringComparison.OrdinalIgnoreCase))))
        {
            _editingDefinition.Design.V2.AuxiliaryActionLayouts.Add(new FormAuxiliaryActionLayoutDto
            {
                ActionId = action.Id,
                Style = FormAuxiliaryActionStyle.Outline,
                Placement = FormAuxiliaryActionPlacement.BelowFields
            });
        }
        var normalizedV2 = FormDesignV2Policy.Normalize(_editingDefinition.Design.V2);
        _editingDefinition.Design.V2 = normalizedV2;
        NormalizeFieldOrderFromRows();
    }

    private void ReplaceFieldKeyInRows(string? previous, string? next)
    {
        if (_editingDefinition?.Design.V2 is null) return;
        var oldKey = previous?.Trim() ?? string.Empty;
        var newKey = next?.Trim() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(oldKey))
        {
            foreach (var row in _editingDefinition.Design.V2.FieldRows)
            {
                var index = row.FieldKeys.FindIndex(key => string.Equals(key, oldKey, StringComparison.OrdinalIgnoreCase));
                if (index >= 0)
                {
                    if (string.IsNullOrWhiteSpace(newKey)) row.FieldKeys.RemoveAt(index);
                    else row.FieldKeys[index] = newKey;
                    break;
                }
            }
            _editingDefinition.Design.V2.FieldRows.RemoveAll(row => row.FieldKeys.Count == 0);
        }
        if (!string.IsNullOrWhiteSpace(newKey) &&
            _editingDefinition.Design.V2.FieldRows.All(row => row.FieldKeys.All(key => !string.Equals(key, newKey, StringComparison.OrdinalIgnoreCase))))
        {
            _editingDefinition.Design.V2.FieldRows.Add(new FormFieldRowDto
            {
                Id = NewEditorId("row"),
                Order = _editingDefinition.Design.V2.FieldRows.Count,
                FieldKeys = [newKey]
            });
        }
        NormalizeV2RowOrders();
    }

    private void RemoveFieldKeyFromRows(string? key)
    {
        if (_editingDefinition?.Design.V2 is null || string.IsNullOrWhiteSpace(key)) return;
        foreach (var row in _editingDefinition.Design.V2.FieldRows)
            row.FieldKeys.RemoveAll(value => string.Equals(value, key, StringComparison.OrdinalIgnoreCase));
        _editingDefinition.Design.V2.FieldRows.RemoveAll(row => row.FieldKeys.Count == 0);
        NormalizeV2RowOrders();
    }

    private bool FieldSharesRow(string? key) =>
        _editingDefinition?.Design.V2?.FieldRows.Any(row =>
            row.FieldKeys.Count > 1 &&
            row.FieldKeys.Any(value => string.Equals(value, key, StringComparison.OrdinalIgnoreCase))) == true;

    private void NormalizeV2RowOrders()
    {
        if (_editingDefinition?.Design.V2 is null) return;
        var rows = _editingDefinition.Design.V2.FieldRows.OrderBy(row => row.Order).ToList();
        for (var index = 0; index < rows.Count; index++) rows[index].Order = index;
        _editingDefinition.Design.V2.FieldRows = rows;
    }

    private void NormalizeFieldOrderFromRows()
    {
        if (_editingDefinition?.Design.V2 is null) return;
        var flattened = _editingDefinition.Design.V2.FieldRows
            .OrderBy(row => row.Order)
            .SelectMany(row => row.FieldKeys)
            .Select((key, index) => new { key, index })
            .ToDictionary(pair => pair.key, pair => pair.index, StringComparer.OrdinalIgnoreCase);
        var next = flattened.Count;
        foreach (var field in _editingDefinition.Fields)
            field.Order = flattened.TryGetValue(field.Key, out var index) ? index : next++;
        _editingDefinition.Fields = _editingDefinition.Fields.OrderBy(field => field.Order).ToList();
    }

    private void NormalizeEditingFields()
    {
        if (_editingDefinition is null) return;
        var ordered = _editingDefinition.Fields.OrderBy(field => field.Order).ToList();
        for (var i = 0; i < ordered.Count; i++)
        {
            ordered[i].Order = i;
            ApplyFieldDefaults(ordered[i]);
            NormalizeOptionOrders(ordered[i]);
        }

        _editingDefinition.Fields = ordered;
        EnsureEditingV2Coverage();
    }

    private void ApplyFieldDefaults(FormFieldDefinitionModel field)
    {
        field.Type = FormInputTypeCatalog.NormalizeType(field.Type);
        var capability = Capability(field);
        field.MaxLength = FormInputTypeCatalog.MaximumInputLength(capability);
        field.InputBoxSize = FormInputTypeCatalog.NormalizeInputBoxSize(capability, field.InputBoxSize);

        if (!capability.SupportsOptions)
        {
            field.Options.Clear();
            _expandedOptionFields.Remove(field);
        }
    }

    private static void NormalizeOptionOrders(FormFieldDefinitionModel field)
    {
        var options = field.Options.OrderBy(option => option.Order).ToList();
        for (var i = 0; i < options.Count; i++)
            options[i].Order = i;
        field.Options = options;
    }

    private void AddCapabilityValidation(IEnumerable<FormFieldDefinitionModel> fields, List<string> errors)
    {
        foreach (var field in fields)
        {
            var label = Text(field.Label, field.Key);
            var capability = Capability(field);
            var optionsWithData = field.Options
                .Where(option => !string.IsNullOrWhiteSpace(option.Value) ||
                                 option.Label.Values.Any(value => !string.IsNullOrWhiteSpace(value)))
                .ToList();

            if (capability.SupportsInputBoxSize)
            {
                if (field.InputBoxSize is < FormInputTypeCatalog.MinInputBoxSize or > FormInputTypeCatalog.MaxInputBoxSize)
                    errors.Add($"{label}: input box size must be between {FormInputTypeCatalog.MinInputBoxSize} and {FormInputTypeCatalog.MaxInputBoxSize}.");
            }
            else if (field.InputBoxSize > 1)
            {
                errors.Add($"{label}: input box size is not supported for this field type.");
            }

            if (capability.SupportsOptions)
            {
                if (optionsWithData.Count == 0)
                    errors.Add($"{label}: add at least one option.");
                if (optionsWithData.Any(option => string.IsNullOrWhiteSpace(option.Value)))
                    errors.Add($"{label}: every option needs a value.");
                if (optionsWithData.GroupBy(option => option.Value, StringComparer.OrdinalIgnoreCase).Any(group => group.Count() > 1))
                    errors.Add($"{label}: option values must be unique.");
            }
            else if (optionsWithData.Count > 0)
            {
                errors.Add($"{label}: options are not supported for this field type.");
            }
        }
    }

    private string DefaultFieldType =>
        _fieldTypes.FirstOrDefault(type => type.Active && type.Type == "text")?.Type
        ?? _fieldTypes.FirstOrDefault(type => type.Active)?.Type
        ?? "text";

    private IEnumerable<FormInputTypeModel> AvailableFieldTypes(FormFieldDefinitionModel field)
    {
        var currentType = FormInputTypeCatalog.NormalizeType(field.Type);
        return _fieldTypes
            .Where(type => type.Active || type.Type.Equals(currentType, StringComparison.OrdinalIgnoreCase))
            .OrderBy(type => type.Order);
    }

    private bool IsSupported(string? type)
    {
        var normalized = FormInputTypeCatalog.NormalizeType(type);
        return _fieldTypes.Any(item => item.Type.Equals(normalized, StringComparison.OrdinalIgnoreCase));
    }

    private FormInputTypeCapability Capability(string? type)
    {
        var normalized = FormInputTypeCatalog.NormalizeType(type);
        var configured = _fieldTypes.FirstOrDefault(item =>
            item.Type.Equals(normalized, StringComparison.OrdinalIgnoreCase));
        if (configured is null)
            return FormInputTypeCatalog.Get(normalized);

        return new FormInputTypeCapability(
            configured.Type,
            configured.LabelKey,
            configured.SupportsMaxCharacters,
            configured.SupportsOptions,
            configured.SupportsInputBoxSize,
            configured.UsesMultilineInput,
            configured.DefaultMaxCharacters,
            configured.DefaultInputBoxSize);
    }

    private static List<FormInputTypeModel> BuildFallbackTypes() =>
        FormInputTypeCatalog.EditorTypes.Select((type, index) => new FormInputTypeModel
        {
            Type = type.Type,
            LabelKey = type.LabelKey,
            Active = true,
            SupportsMaxCharacters = type.SupportsMaxCharacters,
            SupportsOptions = type.SupportsOptions,
            SupportsInputBoxSize = type.SupportsInputBoxSize,
            UsesMultilineInput = type.UsesMultilineInput,
            DefaultMaxCharacters = type.DefaultMaxCharacters,
            DefaultInputBoxSize = type.DefaultInputBoxSize,
            Order = index
        }).ToList();

