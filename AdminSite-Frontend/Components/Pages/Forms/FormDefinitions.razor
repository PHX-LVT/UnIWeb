@page "/forms/definitions"
@implements IAsyncDisposable
@using Contracts.Api
@using Contracts.Forms
@using System.Text.Json
@inject AdminFormSubmissionService FormService
@inject IHttpService Http
@inject AdminAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<FormDefinitions> Logger

<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="HandleInternalNavigation" />

<div class="page-header">
    <h1 class="page-title">@T("FormDefinitions")</h1>
</div>

@if (!_hasAccess)
{
    <div class="admin-data-empty">
        <strong>@T("NoPermission")</strong>
        <div>@T("AccessDeniedHint")</div>
    </div>
}
else
{
<div class="admin-card form-definition-card">
    <div class="definition-toolbar">
        <div>
            <h2>@T("FormDefinitions")</h2>
        </div>
        <div class="definition-editor-toolbar">
            <div class="definition-usage">
                <button type="button" class="definition-usage__button" disabled="@(!CanShowUsage)" @onclick="ToggleUsage">
                    @UsageSummary
                </button>
                @if (_usageExpanded && _usage is not null)
                {
                    <div class="definition-usage__menu">
                        @if (_usage.TotalCount == 0)
                        {
                            <div class="definition-usage__empty">@T("NotUsedAnywhereSafeToDelete")</div>
                            @if (_usage.SubmissionCount > 0)
                            {
                                <div class="definition-usage__empty">@string.Format(T("HistoricalSubmissionsKept"), _usage.SubmissionCount)</div>
                            }
                        }
                        else
                        {
                            <strong>@string.Format(T("UsedInPlaces"), _usage.TotalCount, _usage.TotalCount == 1 ? string.Empty : "s")</strong>
                            @foreach (var item in _usage.Items.Take(8))
                            {
                                <div class="definition-usage__item">
                                    <span>@item.Location</span>
                                    <small>@item.Source</small>
                                </div>
                            }
                            @if (_usage.TotalCount > 8)
                            {
                                <div class="definition-usage__empty">@string.Format(T("MoreCount"), _usage.TotalCount - 8)</div>
                            }
                            @if (_usage.SubmissionCount > 0)
                            {
                                <div class="definition-usage__empty">@string.Format(T("HistoricalSubmissionsKept"), _usage.SubmissionCount)</div>
                            }
                        }
                    </div>
                }
            </div>
            <div class="definition-toolbar__actions">
                <button class="btn-admin btn-primary" disabled="@(!Auth.CanEditFormDefinitions)" @onclick="RequestNewDefinition">@T("NewForm")</button>
                <button class="btn-admin btn-danger" disabled="@(!CanDeleteDefinition)" @onclick="RequestDeleteDefinition">@T("PermanentDelete")</button>
            </div>
        </div>
    </div>

    <AdminInlineStatus TargetId="form-types-load" Retry="LoadInputTypesAsync" RetryText="@T("Retry")" />
    <AdminInlineStatus TargetId="form-definitions-load" Retry="() => LoadDefinitionsAsync()" Retrying="_loading" RetryText="@T("Retry")" />
    <AdminValidationSummary Errors="_fieldErrors" Title="@T("ValidationFailed")" />
    @if (_loading)
    {
        <div class="admin-data-empty">@T("Loading")</div>
    }
    else
    {
        <div class="definition-shell @(DesignSettingsOpen ? "definition-shell--settings-open" : null)">
            <div class="definition-rail"
                 aria-hidden="@(DesignSettingsOpen ? "true" : null)"
                 inert="@(DesignSettingsOpen ? "inert" : null)">
                <div class="definition-list" tabindex="0" aria-label="@T("FormDefinitions")" @ref="_definitionListElement">
                @if (_definitions.Count == 0)
                {
                    <div class="definition-list__empty">@T("NoFormDefinitionsYet")</div>
                }
                @foreach (var definition in _definitions)
                {
                    <div class="definition-row-shell"
                         data-definition-id="@definition.Id"
                         @key="definition.Id">
                        <button class="definition-row @(_editingDefinition?.Id == definition.Id ? "active" : null)"
                                title="@(CanReorderDefinitions ? T("DragToReorderDefinitions") : null)"
                                @onkeydown="args => HandleDefinitionKeyDown(args, definition.Id)"
                                @onclick="() => RequestEditDefinition(definition)">
                            <strong>@Text(definition.Name, definition.Key)</strong>
                            <span>@definition.Key - @(definition.Active ? T("Active") : T("Disabled"))</span>
                        </button>
                    </div>
                }
                </div>
                @if (_definitionOrder is not null && !_definitionOrder.WritesEnabled && Auth.CanEditFormDefinitions)
                {
                    <div class="definition-order-status">@T("DefinitionOrderingUnavailable")</div>
                }
            </div>

            @if (_editingDefinition is not null)
            {
                <div class="definition-editor" @oninput="MarkInputActivity" @onchange="CommitInputActivity">
                    <div class="definition-editor__tabs" role="tablist" aria-label="@T("FormDefinitionEditor")">
                        <button type="button" class="definition-editor__tab @(_editorTab == "content" ? "active" : null)" @onclick="ShowContentTab">@T("Content")</button>
                        <button type="button" class="definition-editor__tab @(_editorTab == "design" ? "active" : null)" @onclick="ShowDesignTab">@T("FormDesign")</button>
                    </div>
                    @if (_editorTab == "content")
                    {
                    <div class="definition-editor__identity">
                        <label class="form-filter">
                            <span>@T("FormKey") <strong class="required-mark">*</strong></span>
                            <input class="form-control"
                                   required
                                   disabled="@FormKeyLocked"
                                   @bind="_editingDefinition.Key" />
                        </label>
                        <div class="form-filter">
                            <span>@T("Name") <strong class="required-mark">*</strong></span>
                            <div class="definition-name-control">
                                <input class="form-control" required value="@Text(_editingDefinition.Name, string.Empty)" @onchange="e => SetText(_editingDefinition.Name, e.Value)" />
                                <button type="button"
                                        class="definition-active-toggle @(_editingDefinition.Active ? "active" : "disabled")"
                                        aria-pressed="@_editingDefinition.Active"
                                        @onclick="ToggleDefinitionActive">
                                    <span class="definition-active-toggle__dot"></span>
                                    @(_editingDefinition.Active ? T("Active") : T("Disabled"))
                                </button>
                            </div>
                        </div>
                    </div>

                    <label class="form-filter" style="margin-top:.75rem">
                        <span>@T("Introduction")</span>
                        <textarea class="form-control" rows="2" @onchange="e => SetText(_editingDefinition.Introduction, e.Value)">@Text(_editingDefinition.Introduction, string.Empty)</textarea>
                    </label>

                    <div class="definition-settings-row definition-settings-row--single">
                        <label class="form-filter">
                            <span>@T("SubmitButtonLabel") <strong class="required-mark">*</strong></span>
                            <input class="form-control" required value="@Text(_editingDefinition.SubmitButtonLabel, string.Empty)" @onchange="e => SetText(_editingDefinition.SubmitButtonLabel, e.Value)" />
                        </label>
                    </div>

                    <div class="definition-section-heading">
                        <h3>@T("Fields")</h3>
                    </div>

                    <div class="definition-field-grid">
                        @foreach (var field in _editingDefinition.Fields.OrderBy(f => f.Order))
                        {
                            var capability = Capability(field);
                            <div class="field-card"
                                 @key="field"
                                 @ondragover:preventDefault
                                 @ondrop="() => DropField(field)">
                                <div class="field-card__drag"
                                     draggable="true"
                                     title="@T("DragToReorder")"
                                     @ondragstart="() => BeginFieldDrag(field)"
                                     @ondragend="EndFieldDrag">
                                    <span></span><span></span><span></span><span></span><span></span><span></span>
                                </div>
                                <div class="field-card__controls">
                                    <label class="form-filter">
                                        <span>@T("FormFieldType")</span>
                                        <select class="form-control"
                                                disabled="@(!CanEditFieldIdentity(field))"
                                                value="@field.Type"
                                                @onchange="e => ChangeFieldType(field, e.Value?.ToString())">
                                            @foreach (var type in AvailableFieldTypes(field))
                                            {
                                                <option value="@type.Type">@TypeName(type)</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="form-filter">
                                        <span>@T("FieldKey") <strong class="required-mark">*</strong></span>
                                        @if (IsCreatingNewFieldKey(field))
                                        {
                                            <span class="field-key-create-row">
                                                <span class="field-key-create-input">
                                                    <input class="form-control"
                                                           required
                                                           placeholder="name"
                                                           value="@field.Key"
                                                           @onchange="e => SetFieldKey(field, e.Value)" />
                                                    @if (!string.IsNullOrWhiteSpace(field.Key))
                                                    {
                                                        <span class="field-key-badge @FieldKeyBadgeClass(field)">
                                                            @FieldKeyBadgeText(field)
                                                        </span>
                                                    }
                                                </span>
                                                <button type="button"
                                                        class="field-key-existing-button"
                                                        @onclick="() => ReturnToExistingFieldKeys(field)">
                                                    @T("ExistingFieldKeys")
                                                </button>
                                            </span>
                                        }
                                        else
                                        {
                                            <select class="form-control"
                                                    disabled="@(!CanEditFieldIdentity(field))"
                                                    value="@FieldKeySelection(field)"
                                                    @onchange="e => SelectFieldKey(field, e.Value?.ToString())">
                                                <option value="">@T("SelectExistingFieldKey")</option>
                                                @foreach (var suggestion in FieldKeySuggestions(field))
                                                {
                                                    <option value="@suggestion.Key">@($"{suggestion.Key} ({suggestion.FormCount})")</option>
                                                }
                                                <option value="@CreateNewFieldKeySelection">@T("CreateBrandNewFieldKey")</option>
                                            </select>
                                        }
                                    </label>
                                    <label class="form-filter field-card__label-input">
                                        <span>@T("Label") <strong class="required-mark">*</strong></span>
                                        <input class="form-control" required placeholder="@T("Label")" value="@Text(field.Label, string.Empty)" @onchange="e => SetText(field.Label, e.Value)" />
                                    </label>
                                    <label class="field-card__required">
                                        <input type="checkbox" @bind="field.Required" />
                                        @T("Required")
                                    </label>
                                    <button type="button"
                                            class="btn-admin btn-danger field-card__delete"
                                            disabled="@(!Auth.CanEditFormDefinitions)"
                                            title="@T("Delete")"
                                            aria-label="@T("Delete")"
                                            @onclick="() => RequestRemoveField(field)">
                                        <i class="fas fa-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                                @if (capability.SupportsInputBoxSize)
                                {
                                    <div class="field-card__settings">
                                        <label class="form-filter">
                                            <span>@T("InputBoxSize")</span>
                                            <input class="form-control" type="number" min="1" max="5" @bind="field.InputBoxSize" />
                                            <small class="form-helper">@T("InputBoxSizeHint")</small>
                                        </label>
                                    </div>
                                }
                                @if (capability.SupportsOptions)
                                {
                                    <div class="field-options">
                                        <div class="field-options__header">
                                            <button type="button" class="field-options__toggle" @onclick="() => ToggleOptions(field)">
                                                <i class="fas @(OptionsExpanded(field) ? "fa-chevron-down" : "fa-chevron-right")" aria-hidden="true"></i>
                                                <strong>@T("Options") (@field.Options.Count)</strong>
                                            </button>
                                            <button type="button" class="btn-admin btn-secondary" disabled="@(!Auth.CanEditFormDefinitions)" @onclick="() => AddOption(field)">@T("AddOption")</button>
                                        </div>
                                        @if (OptionsExpanded(field))
                                        {
                                            <div class="field-options__items">
                                                @foreach (var option in field.Options.OrderBy(option => option.Order))
                                                {
                                                    <div class="field-option-row" @key="option">
                                                        <label class="form-filter">
                                                            <span>@T("OptionValue")</span>
                                                            <input class="form-control" @bind="option.Value" />
                                                        </label>
                                                        <label class="form-filter">
                                                            <span>@T("OptionLabel")</span>
                                                            <input class="form-control" value="@Text(option.Label, string.Empty)" @onchange="e => SetText(option.Label, e.Value)" />
                                                        </label>
                                                        <button type="button"
                                                                class="btn-admin btn-danger field-card__delete"
                                                                disabled="@(!Auth.CanEditFormDefinitions)"
                                                                title="@T("Delete")"
                                                                aria-label="@T("Delete")"
                                                                @onclick="() => RemoveOption(field, option)">
                                                            <i class="fas fa-trash" aria-hidden="true"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    }
                    else
                    {
                        <FormDesignEditor Definition="@_editingDefinition"
                                          AdminLanguage="@AdminLanguage"
                                          UsageCount="@(_usage?.TotalCount ?? 0)"
                                          Disabled="@(!Auth.CanEditFormDefinitions)"
                                          ResetDisabled="@(!CanResetDesign)"
                                          SettingsOpen="@DesignSettingsOpen"
                                          Changed="HandleDesignChanged"
                                          SettingsOpenChanged="HandleDesignSettingsOpenChanged"
                                          ResetRequested="ResetDesignToLastSaved" />
                    }

                    <div class="definition-save-row">
                        <button class="btn-admin btn-primary" disabled="@(!Auth.CanEditFormDefinitions || _saving)" @onclick="SaveCurrentDefinition">@T("SaveDefinition")</button>
                        @if (_editorTab == "content")
                        {
                            <button class="btn-admin btn-secondary" disabled="@(!Auth.CanEditFormDefinitions)" @onclick="AddField">@T("AddField")</button>
                        }
                        @if (IsDirty)
                        {
                            <span class="definition-dirty-indicator" role="status">@T("UnsavedChanges")</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
}

@if (_pendingTransition is not null)
{
    <div class="modal-backdrop" @onclick="CancelPendingTransition">
        <div class="modal-box" style="max-width:500px" role="alertdialog" aria-modal="true" aria-labelledby="unsaved-form-title" @onclick:stopPropagation="true">
            <div class="modal-header" id="unsaved-form-title">@T("UnsavedFormChanges")</div>
            <div class="modal-body">
                <p>@T("UnsavedFormChangesHint")</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-admin btn-ghost" disabled="@_saving" @onclick="CancelPendingTransition">@T("Cancel")</button>
                <button type="button" class="btn-admin btn-secondary" disabled="@_saving" @onclick="DiscardAndContinue">@T("DiscardAndContinue")</button>
                <button type="button" class="btn-admin btn-primary" disabled="@_saving" @onclick="SaveAndContinue">@T("SaveAndContinue")</button>
            </div>
        </div>
    </div>
}

@if (_fieldPendingRemoval is not null)
{
    <div class="modal-backdrop" @onclick="CancelFieldRemoval">
        <div class="modal-box" style="max-width:460px" @onclick:stopPropagation="true">
            <div class="modal-header">@T("RemoveSavedFieldTitle")</div>
            <div class="modal-body">
                <p>@string.Format(T("RemoveSavedFieldPrompt"), FieldDisplayName(_fieldPendingRemoval))</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-admin btn-ghost" @onclick="CancelFieldRemoval">@T("Cancel")</button>
                <button type="button" class="btn-admin btn-danger" @onclick="ConfirmFieldRemoval">@T("Delete")</button>
            </div>
        </div>
    </div>
}

<style>
    .form-definition-card h2,
    .definition-section-heading h3 { font-size:1.05rem; margin:0; }
    .definition-toolbar { display:grid; grid-template-columns:280px 1fr; gap:1rem; align-items:center; margin-bottom:1rem; }
    .definition-editor-toolbar { position:relative; display:flex; justify-content:space-between; align-items:center; gap:1rem; min-width:0; }
    .definition-toolbar__actions { display:flex; gap:.5rem; align-items:center; }
    .definition-usage { position:relative; min-width:0; }
    .definition-usage__button { border:1px solid #dbe3ef; border-radius:999px; background:#fff; color:#0f172a; padding:.45rem .75rem; font-weight:700; cursor:pointer; }
    .definition-usage__button:disabled { opacity:.55; cursor:not-allowed; }
    .definition-usage__menu { position:absolute; z-index:20; top:calc(100% + 8px); left:0; width:min(420px, 80vw); padding:.75rem; border:1px solid #dbe3ef; border-radius:8px; background:#fff; box-shadow:0 16px 38px rgba(15,23,42,.18); display:grid; gap:.45rem; }
    .definition-usage__item { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.75rem; align-items:center; padding:.35rem 0; border-top:1px solid #eef2f7; }
    .definition-usage__item span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .definition-usage__item small,
    .definition-usage__empty,
    .definition-list__empty { color:#64748b; font-size:.8rem; }
    .definition-shell { display:grid; grid-template-columns:280px minmax(0, 1fr); gap:1rem; }
    .definition-list { display:flex; flex-direction:column; gap:.5rem; }
    .definition-list__empty { border:1px dashed #cbd5e1; border-radius:8px; padding:.9rem; background:#f8fafc; }
    .definition-row { text-align:left; border:1px solid var(--primary, #0d47a1); border-left-width:4px; border-radius:8px; padding:.75rem; background:#fff; display:flex; flex-direction:column; gap:.25rem; }
    .definition-row.active { border-color:var(--primary, #0d47a1); box-shadow:0 0 0 2px rgba(13,71,161,.16); }
    .definition-row span { color:#64748b; font-size:.8rem; }
    .definition-editor { border:1px solid #dbe3ef; border-radius:8px; padding:1rem; background:#f8fafc; min-width:0; }
    .definition-editor__identity { display:grid; grid-template-columns:160px 1fr; gap:.75rem; }
    .required-mark { color:#dc2626; font-weight:800; }
    .definition-name-control { display:flex; gap:.5rem; align-items:stretch; }
    .definition-name-control .form-control { flex:1 1 auto; min-width:0; }
    .definition-active-toggle { min-width:112px; border:1px solid #94a3b8; border-radius:6px; padding:.5rem .7rem; display:inline-flex; align-items:center; justify-content:center; gap:.45rem; background:#fff; color:#475569; font-weight:700; cursor:pointer; }
    .definition-active-toggle.active { border-color:#16a34a; background:#f0fdf4; color:#166534; }
    .definition-active-toggle__dot { width:9px; height:9px; border-radius:50%; background:currentColor; flex:0 0 auto; }
    .definition-settings-row { display:grid; grid-template-columns:minmax(0,1fr) 180px; gap:.75rem; margin-top:.75rem; }
    .definition-section-heading { display:flex; justify-content:space-between; align-items:center; margin:1rem 0 .5rem; }
    .definition-field-grid { display:grid; grid-template-columns:1fr; gap:.75rem; }
    .field-card { position:relative; width:100%; max-width:100%; min-width:0; box-sizing:border-box; border:1px solid #dbe3ef; border-radius:8px; background:#fff; padding:.75rem .75rem .75rem 2.35rem; overflow:hidden; }
    .field-card__drag { position:absolute; left:.65rem; top:.95rem; width:18px; display:grid; grid-template-columns:repeat(2, 5px); gap:4px; padding:.2rem; cursor:grab; }
    .field-card__drag:active { cursor:grabbing; }
    .field-card__drag span { width:4px; height:4px; border-radius:50%; background:#94a3b8; display:block; }
    .field-card__controls { display:grid; grid-template-columns:minmax(150px,170px) minmax(190px,240px) minmax(180px,1fr) minmax(94px,auto) 38px; gap:.5rem; align-items:start; min-width:0; }
    .field-card__label-input { min-width:0; }
    .field-key-create-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.4rem; align-items:center; min-width:0; }
    .field-key-create-input { position:relative; min-width:0; }
    .field-key-create-input .form-control { padding-right:4.6rem; }
    .field-key-create-input .field-key-badge { position:absolute; top:50%; right:.4rem; transform:translateY(-50%); pointer-events:none; }
    .field-key-existing-button { min-height:38px; padding:.45rem .6rem; border:1px solid #cbd5e1; border-radius:6px; background:#f8fafc; color:#334155; font:inherit; font-size:.76rem; font-weight:700; white-space:nowrap; cursor:pointer; }
    .field-key-existing-button:hover { border-color:var(--primary, #0d47a1); color:var(--primary, #0d47a1); background:#fff; }
    .field-key-badge { display:inline-flex; align-items:center; justify-content:center; min-height:26px; padding:.25rem .5rem; border-radius:999px; font-size:.68rem; font-weight:800; white-space:nowrap; }
    .field-key-badge--new { background:#fef3c7; color:#92400e; border:1px solid #fde68a; }
    .field-key-badge--existed { background:#dcfce7; color:#166534; border:1px solid #bbf7d0; }
    .field-card__required { display:flex; gap:.35rem; align-items:center; align-self:end; color:#334155; font-size:.9rem; min-height:38px; padding:0 .2rem; }
    .field-card__required input { margin:0; }
    .field-card__delete { width:38px; height:38px; min-width:38px; margin-top:0; padding:0; display:inline-flex; align-items:center; justify-content:center; align-self:end; }
    .field-card__settings { display:grid; grid-template-columns:minmax(160px,240px); margin-top:.75rem; padding-top:.75rem; border-top:1px solid #eef2f7; }
    .field-options { width:100%; max-width:100%; box-sizing:border-box; margin:.75rem 0 0; padding:.65rem .75rem; border:1px solid #dbe3ef; border-left:4px solid #b99a4a; border-radius:8px; background:#f8fafc; display:grid; gap:.65rem; }
    .field-options__header { display:flex; justify-content:space-between; align-items:center; gap:.75rem; }
    .field-options__header strong { color:#334155; font-size:.9rem; }
    .field-options__toggle { display:inline-flex; align-items:center; gap:.5rem; min-width:0; padding:.35rem 0; border:0; background:transparent; color:#334155; cursor:pointer; }
    .field-options__toggle i { width:12px; color:#64748b; }
    .field-options__items { display:grid; gap:.5rem; }
    .field-option-row { display:grid; grid-template-columns:minmax(140px,180px) minmax(0,1fr) 38px; gap:.5rem; align-items:end; min-width:0; padding:.55rem; border:1px solid #e2e8f0; border-radius:7px; background:#fff; }
    .field-option-row .field-card__delete { margin-top:0; align-self:end; }
    .form-filter span { font-size:.78rem; color:#64748b; }
    .form-filter { display:flex; flex-direction:column; gap:.25rem; }
    .form-control { width:100%; max-width:100%; min-width:0; box-sizing:border-box; border:1px solid #cbd5e1; border-radius:6px; padding:.55rem .65rem; background:#fff; min-height:38px; }
    .form-helper { color:#64748b; font-size:.74rem; line-height:1.25; }
    .definition-save-row { display:flex; gap:.5rem; margin-top:1rem; }
    @@media (max-width: 1250px) {
        .definition-toolbar,
        .definition-shell,
        .definition-editor__identity { grid-template-columns:1fr; }
        .definition-editor-toolbar { align-items:flex-start; flex-direction:column; }
        .field-card__controls,
        .field-option-row { grid-template-columns:1fr; }
        .field-card__required { padding-top:0; }
        .field-card__delete { width:100%; margin-top:0; }
        .field-card__settings { grid-template-columns:1fr; }
    }
</style>

@code {
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";

    private List<FormInputTypeModel> _fieldTypes = new();
    private const string CreateNewFieldKeySelection = "__create_new_field_key__";
    private List<FormDefinitionModel> _definitions = new();
    private FormDefinitionModel? _editingDefinition;
    private ElementReference _definitionListElement;
    private DotNetObjectReference<FormDefinitions>? _sortableReference;
    private FormFieldDefinitionModel? _draggedField;
    private FormFieldDefinitionModel? _fieldPendingRemoval;
    private readonly HashSet<FormFieldDefinitionModel> _expandedOptionFields = new();
    private readonly HashSet<FormFieldDefinitionModel> _newUnsavedFields = new();
    private readonly HashSet<FormFieldDefinitionModel> _fieldsCreatingNewKey = new();
    private FormDefinitionUsageModel? _usage;
    private bool _hasAccess = true;
    private bool _loading = true;
    private IReadOnlyList<ApiFieldError>? _fieldErrors;
    private bool _usageExpanded;
    private bool _usageLoading;
    private bool _saving;
    private bool _allowNavigation;
    private bool _hasInputActivity;
    private bool _definitionSortableRefreshPending = true;
    private bool _designSettingsOpen;
    private string _editorTab = "content";
    private string? _savedSnapshot;
    private FormDefinitionOrderResponse? _definitionOrder;
    private PendingTransition? _pendingTransition;

    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);
    private bool DesignSettingsOpen => _editorTab == "design" && _designSettingsOpen;
    private void ShowContentTab()
    {
        _designSettingsOpen = false;
        _editorTab = "content";
    }
    private void ShowDesignTab() => _editorTab = "design";
    private Task HandleDesignSettingsOpenChanged(bool open)
    {
        _designSettingsOpen = open;
        return InvokeAsync(StateHasChanged);
    }
    private bool IsDirty => _editingDefinition is not null &&
        (_hasInputActivity || _savedSnapshot is null || !string.Equals(_savedSnapshot, DefinitionSnapshot(_editingDefinition), StringComparison.Ordinal));
    private bool CanReorderDefinitions => Auth.CanEditFormDefinitions && _definitionOrder?.WritesEnabled == true;
    private bool CanResetDesign => Auth.CanEditFormDefinitions &&
        SavedDefinition is { } saved &&
        _editingDefinition is not null &&
        !string.Equals(DesignStateSnapshot(saved), DesignStateSnapshot(_editingDefinition), StringComparison.Ordinal);
    private FormDefinitionModel? SavedDefinition => _editingDefinition is null
        ? null
        : _definitions.FirstOrDefault(definition => string.Equals(definition.Id, _editingDefinition.Id, StringComparison.Ordinal));

    private bool CanShowUsage => _editingDefinition is not null && !string.IsNullOrWhiteSpace(_editingDefinition.Id);

    private string UsageSummary => !CanShowUsage
        ? T("UsageNotSaved")
        : _usageLoading
            ? T("UsageLoading")
            : _usage is null
                ? T("UsageNotLoaded")
                : _usage.TotalCount == 0
                    ? T("UsageNotUsed")
                    : string.Format(T("UsageUsedInPlaces"), _usage.TotalCount, _usage.TotalCount == 1 ? string.Empty : "s");

    private FormInputTypeCapability Capability(FormFieldDefinitionModel field) => Capability(field.Type);
    private bool FormKeyLocked => _editingDefinition is not null && !string.IsNullOrWhiteSpace(_editingDefinition.Id);

    private bool CanDeleteDefinition => Auth.CanEditFormDefinitions
        && _editingDefinition is not null
        && !string.IsNullOrWhiteSpace(_editingDefinition.Id)
        && !_usageLoading
        && _usage is { TotalCount: 0 };

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        await Auth.RefreshSessionAsync();
        _hasAccess = Auth.CanAccessFormDefinitions;
        if (!_hasAccess)
        {
            _loading = false;
            return;
        }

        await LoadInputTypesAsync();
        await LoadDefinitionsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_hasAccess || _loading || !_definitionSortableRefreshPending) return;
        _definitionSortableRefreshPending = false;
        _sortableReference ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync(
                "formDesignEditor.initDefinitionSortable",
                _definitionListElement,
                _sortableReference,
                CanReorderDefinitions);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Form Definition drag sorting failed to initialize.");
            Http.Notify(T("NotificationDefinitionSortingInitFailed"), 500);
        }
    }

    private async Task LoadInputTypesAsync()
    {
        Http.ClearInlineStatus("form-types-load");
        var result = await FormService.GetInputTypesAsync();
        if (result.Success && result.Data is { Count: > 0 })
        {
            _fieldTypes = result.Data.OrderBy(type => type.Order).ToList();
            return;
        }

        _fieldTypes = BuildFallbackTypes();
        Http.NotifyInline(result, "form-types-load");
    }

    private async Task LoadDefinitionsAsync(string? preferredDefinitionId = null)
    {
        Http.ClearInlineStatus("form-definitions-load");
        _fieldErrors = null;
        _loading = true;
        var definitions = await FormService.GetDefinitionsAsync();
        if (!definitions.Success)
        {
            Http.NotifyInline(definitions, "form-definitions-load");
            if (definitions.StatusCode is 401 or 403)
                _hasAccess = false;
            _loading = false;
            return;
        }

        _definitions = definitions.Data ?? new();
        var orderResult = await FormService.GetDefinitionOrderAsync();
        if (orderResult.Success && orderResult.Data is not null)
        {
            _definitionOrder = orderResult.Data;
            ApplyDefinitionOrder(orderResult.Data.DefinitionIds);
        }
        else
        {
            _definitionOrder = new FormDefinitionOrderResponse
            {
                Revision = 0,
                DefinitionIds = _definitions.Select(definition => definition.Id).ToList(),
                PersistentOrderAvailable = false,
                WritesEnabled = false
            };
            Http.NotifyInline(orderResult, "form-definitions-load");
        }
        _expandedOptionFields.Clear();
        _newUnsavedFields.Clear();
        _fieldsCreatingNewKey.Clear();
        _fieldPendingRemoval = null;

        var selectedId = preferredDefinitionId ?? _editingDefinition?.Id;
        var selectedDefinition = string.IsNullOrWhiteSpace(selectedId)
            ? _definitions.FirstOrDefault()
            : _definitions.FirstOrDefault(definition => definition.Id == selectedId) ?? _definitions.FirstOrDefault();
        _editingDefinition = selectedDefinition is null ? null : Clone(selectedDefinition);
        NormalizeEditingFields();
        _savedSnapshot = _editingDefinition is null ? null : DefinitionSnapshot(_editingDefinition);
        _hasInputActivity = false;
        _definitionSortableRefreshPending = true;
        _loading = false;
        await LoadUsageAsync();
    }

    private Task RequestNewDefinition()
    {
        if (!Auth.CanEditFormDefinitions) return Task.CompletedTask;
        return RequestTransitionAsync(PendingTransition.New());
    }

    private void StartNewDefinition()
    {
        if (!Auth.CanEditFormDefinitions) return;
        _usage = null;
        _usageExpanded = false;
        _usageLoading = false;
        _expandedOptionFields.Clear();
        _newUnsavedFields.Clear();
        _fieldsCreatingNewKey.Clear();
        _fieldPendingRemoval = null;
        var initialField = new FormFieldDefinitionModel
        {
            Key = string.Empty,
            Type = DefaultFieldType,
            Label = new() { [AdminLanguage] = "Name" },
            Placeholder = new() { [AdminLanguage] = "Name" },
            Required = true,
            MaxLength = 150,
            InputBoxSize = 1,
            Order = 0
        };
        _newUnsavedFields.Add(initialField);
        _editingDefinition = new FormDefinitionModel
        {
            Active = true,
            Design = CreateDefaultDesign(FormDesignShapeModel.Stacked),
            SubmitButtonLabel = new() { [AdminLanguage] = "Submit" },
            Name = new() { [AdminLanguage] = "New form" },
            Fields = [initialField]
        };
        NormalizeEditingFields();
        _savedSnapshot = null;
        _hasInputActivity = false;
        _designSettingsOpen = false;
        _editorTab = "content";
    }

    private Task RequestEditDefinition(FormDefinitionModel definition)
    {
        if (string.Equals(_editingDefinition?.Id, definition.Id, StringComparison.Ordinal))
            return Task.CompletedTask;
        return RequestTransitionAsync(PendingTransition.Select(definition.Id));
    }

    private async Task SelectDefinition(FormDefinitionModel definition)
    {
        _usageExpanded = false;
        _expandedOptionFields.Clear();
        _newUnsavedFields.Clear();
        _fieldsCreatingNewKey.Clear();
        _fieldPendingRemoval = null;
        _editingDefinition = Clone(definition);
        NormalizeEditingFields();
        _savedSnapshot = DefinitionSnapshot(_editingDefinition);
        _hasInputActivity = false;
        _designSettingsOpen = false;
        await LoadUsageAsync();
    }

    private async Task RequestTransitionAsync(PendingTransition transition)
    {
        if (!IsDirty)
        {
            await ExecuteTransitionAsync(transition);
            return;
        }

        _pendingTransition = transition;
    }

    private async Task HandleInternalNavigation(LocationChangingContext context)
    {
        if (_allowNavigation || !IsDirty) return;
        context.PreventNavigation();
        _pendingTransition = PendingTransition.Navigate(context.TargetLocation);
        await InvokeAsync(StateHasChanged);
    }

    private void CancelPendingTransition() => _pendingTransition = null;

    private async Task DiscardAndContinue()
    {
        if (_pendingTransition is null) return;
        var transition = _pendingTransition;
        _pendingTransition = null;
        await ExecuteTransitionAsync(transition);
    }

    private async Task SaveAndContinue()
    {
        if (_pendingTransition is null) return;
        var transition = _pendingTransition;
        if (!await SaveDefinitionAsync()) return;
        _pendingTransition = null;
        await ExecuteTransitionAsync(transition);
    }

    private async Task ExecuteTransitionAsync(PendingTransition transition)
    {
        switch (transition.Kind)
        {
            case PendingTransitionKind.New:
                StartNewDefinition();
                break;
            case PendingTransitionKind.Select:
            {
                var definition = _definitions.FirstOrDefault(item => item.Id == transition.Value);
                if (definition is not null) await SelectDefinition(definition);
                break;
            }
            case PendingTransitionKind.Delete:
            {
                var definition = _definitions.FirstOrDefault(item => item.Id == transition.Value);
                if (definition is not null && !string.Equals(_editingDefinition?.Id, definition.Id, StringComparison.Ordinal))
                    await SelectDefinition(definition);
                await DeleteCurrentDefinition();
                break;
            }
            case PendingTransitionKind.Navigate:
                _allowNavigation = true;
                Nav.NavigateTo(transition.Value);
                break;
        }
    }

    private Task HandleDesignChanged() => InvokeAsync(StateHasChanged);

    private async Task ResetDesignToLastSaved()
    {
        if (!Auth.CanEditFormDefinitions || _editingDefinition is null || SavedDefinition is not { } saved) return;
        var savedClone = Clone(saved);
        _editingDefinition.Design = savedClone.Design;
        _editingDefinition.InformationItems = savedClone.InformationItems;
        _editingDefinition.AuxiliaryActions = savedClone.AuxiliaryActions;
        EnsureEditingV2Coverage();
