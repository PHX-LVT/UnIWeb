    private Task ToggleThemeDefaults(ChangeEventArgs e)
    {
        Definition.Design.UseThemeDefaults = e.Value is true;
        if (Definition.Design.UseThemeDefaults)
        {
            var scale = ThemeSpacingScale(_theme?.SpacingScale);
            Definition.Design.PaddingPx = Math.Clamp((int)Math.Round(32d * scale), FormDesignPolicy.MinimumPaddingPx, FormDesignPolicy.MaximumPaddingPx);
            Definition.Design.FieldGapPx = Math.Clamp((int)Math.Round(16d * scale), FormDesignV2Policy.MinimumFieldGapPx, FormDesignV2Policy.MaximumFieldGapPx);
        }
        return ApplyChange();
    }

    private static double ThemeSpacingScale(string? value)
    {
        value = value?.Trim().ToLowerInvariant();
        if (value == "compact") return .85d;
        if (value == "spacious") return 1.2d;
        return double.TryParse(value, System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? Math.Clamp(parsed, .5d, 2d)
            : 1d;
    }

    private Task SetTargetType(FormActionTargetDto target, object? value, bool allowManagedResource)
    {
        if (!Enum.TryParse<FormActionTargetType>(value?.ToString(), out var parsed)) return Task.CompletedTask;
        if (!allowManagedResource && parsed == FormActionTargetType.ManagedResource) return Task.CompletedTask;
        target.Type = parsed;
        target.PageId = null;
        target.Path = null;
        target.Url = null;
        target.ResourceId = null;
        target.Phone = null;
        target.Email = null;
        target.ResolvedHref = null;
        return ApplyChange();
    }

    private Task SetTargetValue(FormActionTargetDto target, object? value)
    {
        var text = value?.ToString()?.Trim() ?? string.Empty;
        switch (target.Type)
        {
            case FormActionTargetType.InternalLink: target.Path = text; break;
            case FormActionTargetType.ExternalUrl: target.Url = text; break;
            case FormActionTargetType.Phone: target.Phone = text; break;
            case FormActionTargetType.Email: target.Email = text; break;
        }
        return ApplyChange();
    }

    private string TargetValue(FormActionTargetDto target) => target.Type switch
    {
        FormActionTargetType.InternalLink => target.Path ?? string.Empty,
        FormActionTargetType.ExternalUrl => target.Url ?? string.Empty,
        FormActionTargetType.Phone => target.Phone ?? string.Empty,
        FormActionTargetType.Email => target.Email ?? string.Empty,
        _ => string.Empty
    };

    private static bool HasConfiguredTarget(FormActionTargetDto target) => target.Type switch
    {
        FormActionTargetType.InternalLink => !string.IsNullOrWhiteSpace(target.Path) || !string.IsNullOrWhiteSpace(target.PageId),
        FormActionTargetType.ExternalUrl => !string.IsNullOrWhiteSpace(target.Url),
        FormActionTargetType.ManagedResource => !string.IsNullOrWhiteSpace(target.ResourceId),
        FormActionTargetType.Phone => !string.IsNullOrWhiteSpace(target.Phone),
        FormActionTargetType.Email => !string.IsNullOrWhiteSpace(target.Email),
        _ => false
    };

    private Task OpenResourcePicker(FormAuxiliaryActionDto action)
    {
        _resourceActionId = action.Id;
        _resourcePickerOpen = true;
        return Task.CompletedTask;
    }

    private async Task SelectManagedResource(ManagedResourceModel resource)
    {
        var action = Definition.AuxiliaryActions.FirstOrDefault(value => value.Id == _resourceActionId);
        if (action is not null)
        {
            action.Target.Type = FormActionTargetType.ManagedResource;
            action.Target.ResourceId = resource.Id;
            action.Target.PageId = null;
            action.Target.Path = null;
            action.Target.Url = null;
            action.Target.Phone = null;
            action.Target.Email = null;
            action.Target.ResolvedHref = null;
            await ApplyChange();
        }
        await CloseResourcePicker();
    }

    private Task CloseResourcePicker()
    {
        _resourcePickerOpen = false;
        _resourceActionId = null;
        return Task.CompletedTask;
    }

