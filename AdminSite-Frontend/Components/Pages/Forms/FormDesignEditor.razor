@implements IAsyncDisposable
@using Contracts.Forms
@using Contracts.Public
@using Microsoft.AspNetCore.Components.Rendering
@inject IJSRuntime JS
@inject IHttpService Http
@inject ThemeService ThemeService
@inject ILogger<FormDesignEditor> Logger

@if (_theme is not null)
{
    <style>@((MarkupString)ThemeService.ToScopedCssVariables(_theme, ".form-design-preview-theme"))</style>
}

<div class="form-design-editor">
    <section class="form-design-preview-panel form-design-preview-theme" aria-labelledby="form-design-preview-title">
        <div class="form-design-preview-panel__heading">
            <strong id="form-design-preview-title">@T("LivePreview")</strong>
            <div class="form-design-preview-toolbar">
                <button type="button"
                        class="btn-admin btn-secondary form-design-settings-trigger"
                        disabled="@Disabled"
                        aria-haspopup="dialog"
                        aria-expanded="@SettingsOpen"
                        @onclick="OpenDrawer">
                    <i class="fas fa-sliders" aria-hidden="true"></i>
                    @T("DesignSettings")
                </button>
                <button type="button"
                        class="btn-admin btn-ghost form-design-reset-trigger"
                        disabled="@(Disabled || ResetDisabled)"
                        title="@T("Reset")"
                        aria-label="@T("Reset")"
                        @onclick="RequestReset">
                    <i class="fas fa-rotate-left" aria-hidden="true"></i>
                </button>
                <div class="form-design-dimensions" aria-live="polite">
                    <span>@T("Width"): <strong>@PreviewWidthPx px</strong></span>
                    <span>@T("Height"): <strong>@PreviewHeightPx px</strong> · @T("Automatic")</span>
                </div>
            </div>
        </div>
        @if (UsageCount > 0)
        {
            <div class="form-design-usage-warning">
                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                @string.Format(T("FormDesignUsageWarning"), UsageCount)
            </div>
        }
        <div class="form-design-preview-stage" @ref="_previewStageElement">
            <div class="form-design-preview-track" style="--form-design-preview-width:@(PreviewWidthPx)px">
            <div class="form-design-preview-canvas"
                 style="--form-design-preview-width:@(PreviewWidthPx)px;--form-design-split:@(V2.SplitPanelPercent)%">
                <PublicFormRenderer Block="@PreviewBlock" Lang="@AdminLanguage" Context="preview" PreviewOnly="true" />
                @if (V2.OuterLayout == FormOuterLayout.SplitPanel)
                {
                    <button type="button"
                            class="form-design-split-handle"
                            disabled="@Disabled"
                            title="@T("DragSplitDivider")"
                            aria-label="@T("DragSplitDivider")"
                            @onpointerdown="BeginSplitDrag"></button>
                }
                <button type="button"
                        class="form-design-width-handle form-design-width-handle--left"
                        disabled="@Disabled"
                        title="@T("DragLeftEdgeToResize")"
                        aria-label="@T("DragLeftEdgeToResize")"
                        @onpointerdown="args => BeginWidthDrag(args, -1)"></button>
                <button type="button"
                        class="form-design-width-handle form-design-width-handle--right"
                        disabled="@Disabled"
                        title="@T("DragRightEdgeToResize")"
                        aria-label="@T("DragRightEdgeToResize")"
                        @onpointerdown="args => BeginWidthDrag(args, 1)"></button>
            </div>
            </div>
        </div>
    </section>

    @if (SettingsOpen)
    {
        <aside class="form-design-drawer"
               @ref="_drawerElement"
               tabindex="-1"
               aria-labelledby="form-design-drawer-title">
            <header class="form-design-drawer__header">
                <button type="button" class="btn-admin btn-ghost" @onclick="CloseDrawer">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    @T("Back")
                </button>
                <div>
                    <strong id="form-design-drawer-title">@T("DesignSettings")</strong>
                    <span>@DefinitionName</span>
                </div>
            </header>

            <div class="form-design-drawer__body">
                <section class="form-design-drawer__section" aria-labelledby="form-layout-heading">
                    <h3 id="form-layout-heading">@T("Layout")</h3>
                    <div class="form-design-layouts">
                        @foreach (var layout in Enum.GetValues<FormOuterLayout>())
                        {
                            <button type="button"
                                    class="form-design-layout @(V2.OuterLayout == layout ? "active" : null)"
                                    disabled="@Disabled"
                                    aria-pressed="@(V2.OuterLayout == layout)"
                                    @onclick="() => SetOuterLayout(layout)">
                                <span class="form-design-layout__diagram form-design-layout__diagram--@LayoutToken(layout)" aria-hidden="true"><i></i><i></i><i></i></span>
                                <strong>@T(LayoutKey(layout))</strong>
                            </button>
                        }
                    </div>
                    <label class="form-filter">
                        <span>@T("FormWidth")</span>
                        <input class="form-control"
                               type="number"
                               min="@FormDesignV2Policy.MinimumWidth(V2.OuterLayout)"
                               max="@FormDesignV2Policy.MaximumWidth(V2.OuterLayout)"
                               value="@PreviewWidthPx"
                               disabled="@Disabled"
                               @onchange="SetDesignWidthFromInput" />
                    </label>
                    @if (V2.OuterLayout == FormOuterLayout.SplitPanel)
                    {
                        <label class="form-design-slider">
                            <span>@T("SplitRatio"): @V2.SplitPanelPercent%</span>
                            <input type="range"
                                   min="@FormDesignV2Policy.MinimumSplitPanelPercent"
                                   max="@FormDesignV2Policy.MaximumSplitPanelPercent"
                                   value="@V2.SplitPanelPercent"
                                   disabled="@Disabled"
                                   @oninput="SetSplitPercent" />
                        </label>
                    }
                </section>

                <section class="form-design-drawer__section" aria-labelledby="form-rows-heading">
                    <div class="form-design-section-heading">
                        <div>
                            <h3 id="form-rows-heading">@T("FieldRows")</h3>
                            <span>@T("FieldRowsHint")</span>
                        </div>
                        <button type="button"
                                class="btn-admin btn-secondary"
                                disabled="@(Disabled || !CanGroupSelectedFields)"
                                @onclick="GroupSelectedFields">
                            @T("GroupOnOneLine")
                        </button>
                    </div>
                    @if (Rows.Count == 0)
                    {
                        <div class="form-design-empty">@T("FieldRowsEmpty")</div>
                    }
                    else
                    {
                        <div class="form-design-rows" @ref="_rowsElement">
                            @foreach (var row in Rows)
                            {
                                <article class="form-design-row"
                                         data-row-id="@row.Id"
                                         tabindex="0"
                                         title="@T("DragRowToReorder")"
                                         @onkeydown="args => HandleRowKeyDown(args, row)"
                                         @key="row.Id">
                                    <header>
                                        <strong>@string.Format(T("FieldRowNumber"), row.Order + 1)</strong>
                                        @if (row.FieldKeys.Count > 1)
                                        {
                                            <button type="button"
                                                    class="form-design-row__ungroup"
                                                    disabled="@Disabled"
                                                    title="@T("Ungroup")"
                                                    @onclick="() => UngroupRow(row)">
                                                <i class="fas fa-object-ungroup" aria-hidden="true"></i>
                                                @T("Ungroup")
                                            </button>
                                        }
                                    </header>
                                    <div class="form-design-row__fields"
                                         data-row-id="@row.Id"
                                         style="--form-design-field-count:@row.FieldKeys.Count">
                                        @foreach (var fieldKey in row.FieldKeys)
                                        {
                                            var field = FindField(fieldKey);
                                            if (field is null) continue;
                                            <div class="form-design-field-chip"
                                                 data-field-key="@fieldKey"
                                                 tabindex="0"
                                                 title="@T("DragFieldToReorder")"
                                                 @onkeydown="args => HandleFieldKeyDown(args, row, fieldKey)"
                                                 @key="fieldKey">
                                                <label>
                                                    <input type="checkbox"
                                                           disabled="@Disabled"
                                                           checked="@_selectedFieldKeys.Contains(fieldKey)"
                                                           @onchange="e => ToggleFieldSelection(fieldKey, e.Value)" />
                                                    <span>@FieldName(field)</span>
                                                </label>
                                                @if (FormDesignPolicy.IsWideField(field.Type))
                                                {
                                                    <em>@T("FullRow")</em>
                                                }
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>

                @if (V2.OuterLayout == FormOuterLayout.SplitPanel)
                {
                <section class="form-design-drawer__section" aria-labelledby="information-heading">
                    <div class="form-design-section-heading">
                        <div>
                            <h3 id="information-heading">@T("InformationPanel")</h3>
                            <span>@T("InformationPanelHint")</span>
                        </div>
                        <button type="button" class="btn-admin btn-secondary" disabled="@Disabled" @onclick="AddInformationItem">@T("AddInformationItem")</button>
                    </div>
                    @if (Definition.InformationItems.Count == 0)
                    {
                        <div class="form-design-empty">@T("NoInformationItems")</div>
                    }
                    @if (Definition.InformationItems.Count > 0)
                    {
                    <div class="form-design-card-list" @ref="_informationItemsElement">
                    @foreach (var item in Definition.InformationItems.OrderBy(item => item.Order))
                    {
                        <article class="form-design-item-card"
                                 data-info-id="@item.Id"
                                 tabindex="0"
                                 title="@T("DragInformationItemToReorder")"
                                 @onkeydown="args => HandleInformationItemKeyDown(args, item)"
                                 @key="item.Id">
                            <header>
                                <strong>@string.Format(T("InformationItemNumber"), item.Order + 1)</strong>
                                @DeleteButton(() => RemoveInformationItem(item))
                            </header>
                            <div class="form-design-control-grid">
                                <label class="form-filter">
                                    <span>@T("Icon")</span>
                                    <IconPickerField Value="@item.Icon"
                                                     ValueChanged="value => SetInformationIcon(item, value)"
                                                     Label="@T("Icon")"
                                                     Context="Contracts.Icons.IconContext.FormInformation"
                                                     AllowCustom="false"
                                                     Disabled="@Disabled" />
                                </label>
                                <label class="form-filter">
                                    <span>@T("Text")</span>
                                    <input class="form-control" value="@Localized(item.Text)" disabled="@Disabled" @onchange="e => SetLocalized(item.Text, e.Value)" />
                                </label>
                            </div>
                            <label class="form-design-check">
                                <input type="checkbox" checked="@(item.Target is not null)" disabled="@Disabled" @onchange="e => ToggleInformationTarget(item, e.Value)" />
                                <span>@T("MakeInformationItemClickable")</span>
                            </label>
                            @if (item.Target is not null)
                            {
                                <div class="form-design-target-grid">
                                    <label class="form-filter">
                                        <span>@T("TargetType")</span>
                                        <select class="form-control" value="@item.Target.Type" disabled="@Disabled" @onchange="e => SetTargetType(item.Target, e.Value, false)">
                                            @foreach (var targetType in InformationTargetTypes)
                                            {
                                                <option value="@targetType">@T(TargetTypeKey(targetType))</option>
                                            }
                                        </select>
                                    </label>
                                    @TargetValueEditor(item.Target, null)
                                </div>
                            }
                        </article>
                    }
                    </div>
                    }
                </section>
                }

                <section class="form-design-drawer__section" aria-labelledby="primary-buttons-heading">
                    <h3 id="primary-buttons-heading">@T("PrimaryButtons")</h3>
                    <div class="form-design-submit-card">
                        <div>
                            <strong>@T("SubmitButton")</strong>
                            <span>@T("SubmitSemanticHint")</span>
                        </div>
                        <label class="form-filter">
                            <span>@T("SubmitPlacement")</span>
                            <select class="form-control" value="@V2.SubmitLayout" disabled="@Disabled" @onchange="SetSubmitLayout">
                                @foreach (var submitLayout in Enum.GetValues<FormSubmitLayout>())
                                {
                                    <option value="@(submitLayout)">@T(SubmitLayoutKey(submitLayout))</option>
                                }
                            </select>
                        </label>
                    </div>
                </section>

                <section class="form-design-drawer__section" aria-labelledby="auxiliary-buttons-heading">
                    <div class="form-design-section-heading">
                        <div>
                            <h3 id="auxiliary-buttons-heading">@T("AuxiliaryButtons")</h3>
                            <span>@T("AuxiliaryActionsHint")</span>
                        </div>
                        <button type="button"
                                class="btn-admin btn-secondary"
                                disabled="@(Disabled || Definition.AuxiliaryActions.Count >= FormDesignV2Policy.MaximumAuxiliaryActions)"
                                @onclick="AddAuxiliaryAction">@T("AddAuxiliaryAction")</button>
                    </div>
                    @if (Definition.AuxiliaryActions.Count == 0)
                    {
                        <div class="form-design-empty">@T("NoAuxiliaryActions")</div>
                    }
                    @if (Definition.AuxiliaryActions.Count > 0)
                    {
                    <div class="form-design-card-list" @ref="_auxiliaryActionsElement">
                    @foreach (var action in Definition.AuxiliaryActions.OrderBy(action => action.Order))
                    {
                        var actionLayout = LayoutFor(action.Id);
                        <article class="form-design-item-card"
                                 data-action-id="@action.Id"
                                 tabindex="0"
                                 title="@T("DragAuxiliaryActionToReorder")"
                                 @onkeydown="args => HandleAuxiliaryActionKeyDown(args, action)"
                                 @key="action.Id">
                            <header>
                                <strong>@string.Format(T("AuxiliaryActionNumber"), action.Order + 1)</strong>
                                @DeleteButton(() => RemoveAuxiliaryAction(action))
                            </header>
                            <label class="form-filter">
                                <span>@T("Label")</span>
                                <input class="form-control" value="@Localized(action.Label)" disabled="@Disabled" @onchange="e => SetLocalized(action.Label, e.Value)" />
                            </label>
                            <div class="form-design-target-grid">
                                <label class="form-filter">
                                    <span>@T("TargetType")</span>
                                    <select class="form-control" value="@action.Target.Type" disabled="@Disabled" @onchange="e => SetTargetType(action.Target, e.Value, true)">
                                        @foreach (var targetType in AuxiliaryTargetTypes)
                                        {
                                            <option value="@targetType">@T(TargetTypeKey(targetType))</option>
                                        }
                                    </select>
                                </label>
                                @TargetValueEditor(action.Target, action)
                            </div>
                            @if (!HasConfiguredTarget(action.Target))
                            {
                                <span class="form-design-validation-hint" role="status">
                                    <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                                    @T("ActionTargetRequired")
                                </span>
                            }
                            <div class="form-design-control-grid">
                                <label class="form-filter">
                                    <span>@T("ActionStyle")</span>
                                    <select class="form-control" value="@actionLayout.Style" disabled="@Disabled" @onchange="e => SetActionStyle(actionLayout, e.Value)">
                                        @foreach (var style in Enum.GetValues<FormAuxiliaryActionStyle>())
                                        {
                                            <option value="@style">@T(style.ToString())</option>
                                        }
                                    </select>
                                </label>
                                @if (V2.OuterLayout == FormOuterLayout.SplitPanel)
                                {
                                    <label class="form-filter">
                                        <span>@T("Placement")</span>
                                        <select class="form-control" value="@actionLayout.Placement" disabled="@Disabled" @onchange="e => SetActionPlacement(actionLayout, e.Value)">
                                            <option value="@FormAuxiliaryActionPlacement.BelowFields">@T("BelowFields")</option>
                                            <option value="@FormAuxiliaryActionPlacement.InformationPanel">@T("InformationPanel")</option>
                                        </select>
                                    </label>
                                }
                            </div>
                        </article>
                    }
                    </div>
                    }
                </section>

                <section class="form-design-drawer__section" aria-labelledby="appearance-heading">
                    <h3 id="appearance-heading">@T("Appearance")</h3>
                    <label class="form-design-check form-design-theme-defaults">
                        <input type="checkbox"
                               checked="@Definition.Design.UseThemeDefaults"
                               disabled="@Disabled"
                               @onchange="ToggleThemeDefaults" />
                        <span>
                            <strong>@T("UseThemeDefaults")</strong>
                            <small>@T("UseThemeDefaultsHint")</small>
                        </span>
                    </label>
                    @if (V2.OuterLayout == FormOuterLayout.SplitPanel)
                    {
                        <div class="form-design-control-grid">
                            @ColorInput("InformationBackgroundColor", V2.InformationBackgroundColor, value => SetV2Color(nameof(FormDesignV2SettingsDto.InformationBackgroundColor), value), Definition.Design.UseThemeDefaults)
                            @ColorInput("InformationTextColor", V2.InformationTextColor, value => SetV2Color(nameof(FormDesignV2SettingsDto.InformationTextColor), value), Definition.Design.UseThemeDefaults)
                            @ColorInput("FormBackgroundColor", V2.FormBackgroundColor, value => SetV2Color(nameof(FormDesignV2SettingsDto.FormBackgroundColor), value), Definition.Design.UseThemeDefaults)
                            @ColorInput("FormTextColor", V2.FormTextColor, value => SetV2Color(nameof(FormDesignV2SettingsDto.FormTextColor), value), Definition.Design.UseThemeDefaults)
                        </div>
                    }
                    else
                    {
                        <div class="form-design-control-grid">
                            <label class="form-filter">
                                <span>@T("FormBackground")</span>
                                <select class="form-control" value="@Definition.Design.BackgroundMode" disabled="@(Disabled || Definition.Design.UseThemeDefaults)" @onchange="SetBackgroundMode">
                                    <option value="@FormDesignBackgroundModeModel.Solid">@T("Solid")</option>
                                    <option value="@FormDesignBackgroundModeModel.Transparent">@T("Transparent")</option>
                                </select>
                            </label>
                            @ColorInput("BackgroundColor", Definition.Design.BackgroundColor, value => SetLegacyColor(nameof(FormDesignSettingsModel.BackgroundColor), value), Definition.Design.UseThemeDefaults || Definition.Design.BackgroundMode == FormDesignBackgroundModeModel.Transparent)
                            @ColorInput("TextColor", Definition.Design.TextColor, value => SetLegacyColor(nameof(FormDesignSettingsModel.TextColor), value), Definition.Design.UseThemeDefaults)
                        </div>
                    }
                    <div class="form-design-control-grid">
                        @ColorInput("AccentColor", Definition.Design.AccentColor, value => SetLegacyColor(nameof(FormDesignSettingsModel.AccentColor), value), Definition.Design.UseThemeDefaults)
                        @ColorInput("BorderColor", Definition.Design.BorderColor, value => SetLegacyColor(nameof(FormDesignSettingsModel.BorderColor), value), Definition.Design.UseThemeDefaults)
                        <label class="form-filter">
                            <span>@T("TextAlignment")</span>
                            <select class="form-control" value="@Definition.Design.TextAlign" disabled="@Disabled" @onchange="SetTextAlign">
                                <option value="@FormDesignTextAlignModel.Left">@T("Left")</option>
                                <option value="@FormDesignTextAlignModel.Center">@T("Center")</option>
                            </select>
                        </label>
                        <label class="form-filter">
                            <span>@T("LabelStyle")</span>
                            <select class="form-control" value="@Definition.Design.LabelMode" disabled="@Disabled" @onchange="SetLabelMode">
                                <option value="@FormLabelModeModel.Visible">@T("VisibleLabels")</option>
                                <option value="@FormLabelModeModel.InsideInputs">@T("LabelsInsideInputs")</option>
                            </select>
                        </label>
                        <label class="form-filter">
                            <span>@T("ButtonStyle")</span>
                            <select class="form-control" value="@Definition.Design.ButtonStyle" disabled="@(Disabled || Definition.Design.UseThemeDefaults)" @onchange="e => SetLegacyString(nameof(FormDesignSettingsModel.ButtonStyle), e.Value)">
                                <option value="filled">@T("Filled")</option>
                                <option value="outline">@T("Outline")</option>
                                <option value="ghost">@T("Ghost")</option>
                            </select>
                        </label>
                        <label class="form-filter">
                            <span>@T("Shadow")</span>
                            <select class="form-control" value="@Definition.Design.Shadow" disabled="@(Disabled || Definition.Design.UseThemeDefaults)" @onchange="e => SetLegacyString(nameof(FormDesignSettingsModel.Shadow), e.Value)">
                                <option value="none">@T("None")</option>
                                <option value="small">@T("Small")</option>
                                <option value="medium">@T("Medium")</option>
                                <option value="large">@T("Large")</option>
                            </select>
                        </label>
                    </div>
                </section>

                <section class="form-design-drawer__section" aria-labelledby="spacing-heading">
                    <h3 id="spacing-heading">@T("SpacingAndBorder")</h3>
                    <div class="form-design-sliders">
                        @Slider("BorderWidth", Definition.Design.BorderWidthPx, 0, 4, nameof(FormDesignSettingsModel.BorderWidthPx))
                        @Slider("CornerRadius", Definition.Design.BorderRadiusPx, 0, 40, nameof(FormDesignSettingsModel.BorderRadiusPx))
                        @Slider("InnerPadding", Definition.Design.PaddingPx, FormDesignPolicy.MinimumPaddingPx, FormDesignPolicy.MaximumPaddingPx, nameof(FormDesignSettingsModel.PaddingPx))
                        @Slider("FieldSpacing", Definition.Design.FieldGapPx, FormDesignV2Policy.MinimumFieldGapPx, FormDesignV2Policy.MaximumFieldGapPx, nameof(FormDesignSettingsModel.FieldGapPx))
                    </div>
                </section>
            </div>

            <ResourcePickerModal Open="@_resourcePickerOpen"
                                 Kind="file"
                                 ResourceSelected="SelectManagedResource"
                                 Closed="CloseResourcePicker" />
        </aside>
    }

    @if (_resetConfirmationOpen)
    {
        <div class="modal-backdrop" @onclick="CancelReset">
            <div class="modal-box" style="max-width:460px" role="alertdialog" aria-modal="true" aria-labelledby="reset-form-design-title" @onclick:stopPropagation="true">
                <div class="modal-header" id="reset-form-design-title">@T("ResetFormDesignTitle")</div>
                <div class="modal-body">
                    <p>@T("ResetFormDesignPrompt")</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-admin btn-ghost" @onclick="CancelReset">@T("Cancel")</button>
                    <button type="button" class="btn-admin btn-danger" @onclick="ConfirmReset">@T("Reset")</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public FormDefinitionModel Definition { get; set; } = default!;
    [Parameter] public string AdminLanguage { get; set; } = "en";
    [Parameter] public int UsageCount { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ResetDisabled { get; set; }
    [Parameter] public bool SettingsOpen { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<bool> SettingsOpenChanged { get; set; }
    [Parameter] public EventCallback ResetRequested { get; set; }

    private static readonly (string Value, string LabelKey)[] InformationIcons =
    [
        ("fas fa-circle-info", "Information"),
        ("fas fa-phone", "Phone"),
        ("fas fa-envelope", "Email"),
        ("fas fa-location-dot", "Location"),
        ("fas fa-clock", "Hours"),
        ("fas fa-link", "Link")
    ];
    private static readonly FormActionTargetType[] InformationTargetTypes =
    [
        FormActionTargetType.InternalLink,
        FormActionTargetType.ExternalUrl,
        FormActionTargetType.Phone,
        FormActionTargetType.Email
    ];
    private static readonly FormActionTargetType[] AuxiliaryTargetTypes = Enum.GetValues<FormActionTargetType>();

    private readonly HashSet<string> _selectedFieldKeys = new(StringComparer.OrdinalIgnoreCase);
    private DotNetObjectReference<FormDesignEditor>? _reference;
    private ElementReference _drawerElement;
    private ElementReference _rowsElement;
    private ElementReference _informationItemsElement;
    private ElementReference _auxiliaryActionsElement;
    private ElementReference _previewStageElement;
    private ThemeModel? _theme;
    private FormDefinitionModel? _activeDefinition;
    private bool _drawerFocusPending;
    private bool _sortablesRefreshPending;
    private bool _resetConfirmationOpen;
    private bool _resourcePickerOpen;
    private string? _resourceActionId;
    private bool _previewRecenteringPending = true;

    private FormDesignV2SettingsDto V2 => Definition.Design.V2!;
    private List<FormFieldRowDto> Rows => V2.FieldRows.OrderBy(row => row.Order).ToList();
    private int PreviewWidthPx => Math.Clamp(Definition.Design.WidthPx, FormDesignV2Policy.MinimumWidth(V2.OuterLayout), FormDesignV2Policy.MaximumWidth(V2.OuterLayout));
    private int PreviewHeightPx => FormDesignV2Policy.CalculateHeight(
        ToDto(Definition.Design),
        V2,
        Definition.Fields.Select(ToDto),
        Definition.Name,
        Definition.Introduction,
        Definition.SubmitButtonLabel,
        Definition.InformationItems,
        Definition.AuxiliaryActions);
    private string DefinitionName => Localized(Definition.Name, Definition.Key);
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    protected override async Task OnInitializedAsync()
    {
        var response = await ThemeService.GetAsync();
        _theme = response.Data ?? new ThemeModel();
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_activeDefinition, Definition))
        {
            _activeDefinition = Definition;
            _previewRecenteringPending = true;
            _selectedFieldKeys.Clear();
            _sortablesRefreshPending = true;
        }
        EnsureDesignState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _reference ??= DotNetObjectReference.Create(this);
        if (_drawerFocusPending)
        {
            _drawerFocusPending = false;
            try
            {
                await JS.InvokeVoidAsync("formDesignEditor.openDrawer", _drawerElement, _reference);
            }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "Form Design settings drawer failed to initialize.");
                Http.Notify(T("NotificationFormDesignInitFailed"), 500);
            }
        }
        if (SettingsOpen && _sortablesRefreshPending)
        {
            _sortablesRefreshPending = false;
