    private async Task ApplyChange()
    {
        NormalizeDesign(authoringChange: true);
        await Changed.InvokeAsync();
    }

    private void NormalizeDesign(bool authoringChange)
    {
        var normalizedV2 = FormDesignV2Policy.Normalize(Definition.Design.V2);
        Definition.Design.V2 = normalizedV2;
        if (authoringChange)
        {
            Definition.Design.SchemaVersion = FormDesignV2Policy.TargetSchemaVersion;
            Definition.Design.Shape = (FormDesignShapeModel)FormDesignV2Policy.ShapeForOuterLayout(normalizedV2.OuterLayout);
            Definition.Design.WidthPx = Math.Clamp(
                Definition.Design.WidthPx,
                FormDesignV2Policy.MinimumWidth(normalizedV2.OuterLayout),
                FormDesignV2Policy.MaximumWidth(normalizedV2.OuterLayout));
            Definition.Design.PaddingPx = Math.Clamp(Definition.Design.PaddingPx, FormDesignPolicy.MinimumPaddingPx, FormDesignPolicy.MaximumPaddingPx);
            Definition.Design.FieldGapPx = Math.Clamp(Definition.Design.FieldGapPx, FormDesignV2Policy.MinimumFieldGapPx, FormDesignV2Policy.MaximumFieldGapPx);
            Definition.Design.ButtonWidth = normalizedV2.SubmitLayout == FormSubmitLayout.Full
                ? FormDesignButtonWidthModel.Full
                : FormDesignButtonWidthModel.Content;
            Definition.Design.CalculatedHeightPx = PreviewHeightPx;
        }
        Definition.InformationItems = Definition.InformationItems.OrderBy(item => item.Order).ToList();
        Definition.AuxiliaryActions = Definition.AuxiliaryActions.OrderBy(action => action.Order).ToList();
    }

    private FormFieldDefinitionModel? FindField(string key) => Definition.Fields.FirstOrDefault(field => string.Equals(field.Key, key, StringComparison.OrdinalIgnoreCase));
    private string FieldName(FormFieldDefinitionModel field) => Localized(field.Label, field.Key);
    private string Localized(Dictionary<string, string>? values, string fallback = "") =>
        values?.GetValueOrDefault(AdminLanguage) is { Length: > 0 } localized
            ? localized
            : values?.GetValueOrDefault(AdminUiLocalizer.FallbackLanguage) is { Length: > 0 } configuredFallback
                ? configuredFallback
                : fallback;

    private static bool Move<T>(List<T> values, T value, int delta)
    {
        var index = values.IndexOf(value);
        var next = index + delta;
        if (index < 0 || next < 0 || next >= values.Count) return false;
        (values[index], values[next]) = (values[next], values[index]);
        return true;
    }

    private static void NormalizeOrders<T>(IReadOnlyList<T> values, Action<T, int> setOrder)
    {
        for (var index = 0; index < values.Count; index++) setOrder(values[index], index);
    }

