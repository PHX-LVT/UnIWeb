    private void ToggleFieldSelection(string key, object? value)
    {
        if (value is not true)
        {
            _selectedFieldKeys.Remove(key);
            return;
        }
        if (FindField(key) is { } field && FormDesignPolicy.IsWideField(field.Type))
        {
            Http.Notify(T("WideFieldsUseOwnRow"), 400);
            return;
        }
        if (_selectedFieldKeys.Count >= FormDesignV2Policy.MaximumFieldsPerRow)
        {
            Http.Notify(T("MaximumThreeFieldsPerRow"), 400);
            return;
        }
        _selectedFieldKeys.Add(key);
    }

    private bool CanGroupSelectedFields => _selectedFieldKeys.Count is >= 2 and <= FormDesignV2Policy.MaximumFieldsPerRow &&
        _selectedFieldKeys.All(key => FindField(key) is { } field && !FormDesignPolicy.IsWideField(field.Type));

    private async Task GroupSelectedFields()
    {
        if (Disabled || !CanGroupSelectedFields) return;
        var selected = FlattenedFieldKeys().Where(_selectedFieldKeys.Contains).ToList();
        var insertionIndex = Rows
            .Select((row, index) => new { row, index })
            .Where(pair => pair.row.FieldKeys.Any(_selectedFieldKeys.Contains))
            .Select(pair => pair.index)
            .DefaultIfEmpty(Rows.Count)
            .Min();
        var rows = Rows;
        foreach (var row in rows) row.FieldKeys.RemoveAll(_selectedFieldKeys.Contains);
        rows.RemoveAll(row => row.FieldKeys.Count == 0);
        insertionIndex = Math.Clamp(insertionIndex, 0, rows.Count);
        rows.Insert(insertionIndex, new FormFieldRowDto { Id = NewId("row"), FieldKeys = selected });
        SetRows(rows);
        _selectedFieldKeys.Clear();
        _sortablesRefreshPending = true;
        await ApplyChange();
    }

    private async Task UngroupRow(FormFieldRowDto row)
    {
        if (Disabled || row.FieldKeys.Count <= 1) return;
        var rows = Rows;
        var current = rows.First(item => item.Id == row.Id);
        var index = rows.IndexOf(current);
        rows.RemoveAt(index);
        var ungrouped = current.FieldKeys.Select((fieldKey, fieldIndex) => new FormFieldRowDto
        {
            Id = fieldIndex == 0 ? current.Id : NewId("row"),
            FieldKeys = [fieldKey]
        }).ToList();
        rows.InsertRange(index, ungrouped);
        SetRows(rows);
        _selectedFieldKeys.ExceptWith(current.FieldKeys);
        _sortablesRefreshPending = true;
        await ApplyChange();
    }

    [JSInvokable]
