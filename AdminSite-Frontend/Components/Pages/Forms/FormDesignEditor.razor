    private Task SetLegacyColor(string property, object? value) => SetLegacyString(property, value);

    private Task SetLegacyString(string property, object? value)
    {
        var text = value?.ToString() ?? string.Empty;
        switch (property)
        {
            case nameof(FormDesignSettingsModel.BackgroundColor):
                Definition.Design.BackgroundColor = text;
                V2.FormBackgroundColor = text;
                break;
            case nameof(FormDesignSettingsModel.TextColor):
                Definition.Design.TextColor = text;
                V2.FormTextColor = text;
                break;
            case nameof(FormDesignSettingsModel.AccentColor): Definition.Design.AccentColor = text; break;
            case nameof(FormDesignSettingsModel.BorderColor): Definition.Design.BorderColor = text; break;
            case nameof(FormDesignSettingsModel.ButtonStyle): Definition.Design.ButtonStyle = text; break;
            case nameof(FormDesignSettingsModel.Shadow): Definition.Design.Shadow = text; break;
        }
        return ApplyChange();
    }

    private Task SetV2Color(string property, object? value)
    {
        var text = value?.ToString() ?? string.Empty;
        switch (property)
        {
            case nameof(FormDesignV2SettingsDto.InformationBackgroundColor): V2.InformationBackgroundColor = text; break;
            case nameof(FormDesignV2SettingsDto.InformationTextColor): V2.InformationTextColor = text; break;
            case nameof(FormDesignV2SettingsDto.FormBackgroundColor):
                V2.FormBackgroundColor = text;
                Definition.Design.BackgroundColor = text;
                break;
            case nameof(FormDesignV2SettingsDto.FormTextColor):
                V2.FormTextColor = text;
                Definition.Design.TextColor = text;
                break;
        }
        return ApplyChange();
    }

    private Task SetLegacyInt(string property, object? value)
    {
        if (!int.TryParse(value?.ToString(), out var number)) return Task.CompletedTask;
        switch (property)
        {
            case nameof(FormDesignSettingsModel.BorderWidthPx): Definition.Design.BorderWidthPx = number; break;
            case nameof(FormDesignSettingsModel.BorderRadiusPx): Definition.Design.BorderRadiusPx = number; break;
            case nameof(FormDesignSettingsModel.PaddingPx): Definition.Design.PaddingPx = number; break;
            case nameof(FormDesignSettingsModel.FieldGapPx): Definition.Design.FieldGapPx = number; break;
        }
        return ApplyChange();
    }

