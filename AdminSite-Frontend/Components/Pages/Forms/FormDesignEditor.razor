    [JSInvokable]
    public async Task<bool> OnFieldMovedToNewRow(string fieldKey, int insertionIndex)
    {
        if (Disabled || string.IsNullOrWhiteSpace(fieldKey)) return false;
        var rows = Rows;
        var sourceIndex = rows.FindIndex(row => row.FieldKeys.Any(key => string.Equals(key, fieldKey, StringComparison.OrdinalIgnoreCase)));
        if (sourceIndex < 0) return false;

        var source = rows[sourceIndex];
        FormFieldRowDto newRow;
        if (source.FieldKeys.Count == 1)
        {
            rows.RemoveAt(sourceIndex);
            if (sourceIndex < insertionIndex) insertionIndex--;
            newRow = source;
        }
        else
        {
            source.FieldKeys.RemoveAll(key => string.Equals(key, fieldKey, StringComparison.OrdinalIgnoreCase));
            newRow = new FormFieldRowDto { Id = NewId("row"), FieldKeys = [fieldKey] };
        }

        insertionIndex = Math.Clamp(insertionIndex, 0, rows.Count);
        rows.Insert(insertionIndex, newRow);
        SetRows(rows);
        _selectedFieldKeys.Remove(fieldKey);
        _sortablesRefreshPending = true;
        await ApplyChange();
        return true;
    }

    private async Task MoveFieldInRow(FormFieldRowDto row, string fieldKey, int delta)
    {
        if (Disabled) return;
        var targetRow = V2.FieldRows.First(item => item.Id == row.Id);
        var index = targetRow.FieldKeys.FindIndex(key => string.Equals(key, fieldKey, StringComparison.OrdinalIgnoreCase));
        var next = index + delta;
        if (index < 0 || next < 0 || next >= targetRow.FieldKeys.Count) return;
        (targetRow.FieldKeys[index], targetRow.FieldKeys[next]) = (targetRow.FieldKeys[next], targetRow.FieldKeys[index]);
        NormalizeFieldOrderFromRows();
        _sortablesRefreshPending = true;
        await ApplyChange();
    }

    private async Task MoveRow(FormFieldRowDto row, int delta)
    {
        if (Disabled) return;
        var rows = Rows;
        var index = rows.FindIndex(item => item.Id == row.Id);
        var next = index + delta;
        if (index < 0 || next < 0 || next >= rows.Count) return;
        (rows[index], rows[next]) = (rows[next], rows[index]);
        SetRows(rows);
        _sortablesRefreshPending = true;
        await ApplyChange();
    }

    private Task HandleRowKeyDown(KeyboardEventArgs args, FormFieldRowDto row)
    {
        if (!args.AltKey) return Task.CompletedTask;
        return args.Key switch
        {
            "ArrowUp" => MoveRow(row, -1),
            "ArrowDown" => MoveRow(row, 1),
            _ => Task.CompletedTask
        };
    }

    private Task HandleFieldKeyDown(KeyboardEventArgs args, FormFieldRowDto row, string fieldKey)
    {
        if (!args.AltKey) return Task.CompletedTask;
        return args.Key switch
        {
            "ArrowLeft" => MoveFieldInRow(row, fieldKey, -1),
            "ArrowRight" => MoveFieldInRow(row, fieldKey, 1),
            _ => Task.CompletedTask
        };
    }

    private Task HandleInformationItemKeyDown(KeyboardEventArgs args, FormInformationItemDto item)
    {
        if (!args.AltKey) return Task.CompletedTask;
