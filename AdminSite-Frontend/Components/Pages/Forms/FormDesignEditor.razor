    private Task HandleAuxiliaryActionKeyDown(KeyboardEventArgs args, FormAuxiliaryActionDto action)
    {
        if (!args.AltKey) return Task.CompletedTask;
        return args.Key switch
        {
            "ArrowUp" => MoveAuxiliaryAction(action, -1),
            "ArrowDown" => MoveAuxiliaryAction(action, 1),
            _ => Task.CompletedTask
        };
    }

    private void SetRows(List<FormFieldRowDto> rows)
    {
        for (var index = 0; index < rows.Count; index++) rows[index].Order = index;
        V2.FieldRows = rows;
        NormalizeFieldOrderFromRows();
    }

    private void NormalizeFieldOrderFromRows()
    {
        var order = FlattenedFieldKeys()
            .Select((key, index) => new { key, index })
            .ToDictionary(pair => pair.key, pair => pair.index, StringComparer.OrdinalIgnoreCase);
        var next = order.Count;
        foreach (var field in Definition.Fields)
            field.Order = order.TryGetValue(field.Key, out var index) ? index : next++;
        Definition.Fields = Definition.Fields.OrderBy(field => field.Order).ToList();
    }

    private List<string> FlattenedFieldKeys() => V2.FieldRows.OrderBy(row => row.Order).SelectMany(row => row.FieldKeys).ToList();

