    private void EnsureDesignState()
    {
        Definition.Design ??= new FormDesignSettingsModel();
        Definition.InformationItems ??= new();
        Definition.AuxiliaryActions ??= new();
        Definition.Design.V2 ??= FormDesignV2Policy.CreateDefault(Definition.Id, ToDto(Definition.Design), Definition.Fields.Select(ToDto));
        EnsureRowCoverage();
        EnsureActionLayouts();
        NormalizeDesign(authoringChange: false);
    }

    private void EnsureRowCoverage()
    {
        if (Definition.Design.V2 is null) return;
        var fieldKeys = Definition.Fields
            .Where(field => !string.IsNullOrWhiteSpace(field.Key))
            .OrderBy(field => field.Order)
            .Select(field => field.Key.Trim())
            .ToList();
        var validKeys = fieldKeys.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var rows = Definition.Design.V2.FieldRows
            .OrderBy(row => row.Order)
            .Select(row => new FormFieldRowDto
            {
                Id = string.IsNullOrWhiteSpace(row.Id) ? NewId("row") : row.Id,
                FieldKeys = (row.FieldKeys ?? new())
                    .Where(key => validKeys.Contains(key) && seen.Add(key))
                    .ToList()
            })
            .Where(row => row.FieldKeys.Count > 0)
            .ToList();
        foreach (var key in fieldKeys.Where(key => seen.Add(key)))
        {
            rows.Add(new FormFieldRowDto { Id = NewId("row"), FieldKeys = [key] });
        }
        for (var index = 0; index < rows.Count; index++) rows[index].Order = index;
        Definition.Design.V2.FieldRows = rows;
        NormalizeFieldOrderFromRows();
        _selectedFieldKeys.RemoveWhere(key => !validKeys.Contains(key));
    }

    private void EnsureActionLayouts()
    {
        if (Definition.Design.V2 is null) return;
        var actionIds = Definition.AuxiliaryActions.Select(action => action.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var layouts = Definition.Design.V2.AuxiliaryActionLayouts
            .Where(layout => actionIds.Contains(layout.ActionId))
            .GroupBy(layout => layout.ActionId, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();
        foreach (var action in Definition.AuxiliaryActions.Where(action => layouts.All(layout => !string.Equals(layout.ActionId, action.Id, StringComparison.OrdinalIgnoreCase))))
        {
            layouts.Add(new FormAuxiliaryActionLayoutDto
            {
                ActionId = action.Id,
                Style = FormAuxiliaryActionStyle.Theme,
                Placement = FormAuxiliaryActionPlacement.BelowFields
            });
        }
        Definition.Design.V2.AuxiliaryActionLayouts = layouts;
    }

