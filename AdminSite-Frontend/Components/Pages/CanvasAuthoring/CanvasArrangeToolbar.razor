    public sealed record CanvasBlockSelectorItem(string Id, string SectionId, string SectionLabel, string Label, string Type, int Depth, int Order, string PeerKey, bool Visible, bool Locked, bool CanReorder);
    public sealed record CanvasBlockReorderRequest(string SectionId, IReadOnlyList<string> OrderedIds);
    private sealed record AnimationEffectCard(string Value, string LabelKey, string HintKey, string PreviewClass);
    private sealed record TimingPreset(string Key, string LabelKey, string HintKey, int DurationMs, string Easing);
    private sealed record EasingOption(string Value, string LabelKey);
    public sealed record CanvasBlockVisualState(string SelectionKey, string Shape, string BackgroundMode, string? BackgroundColor, string? TextColor, int BorderWidth, string BorderStyle, string? BorderColor, string BorderRadius, string AnimationEffect, string AnimationTrigger, int DurationMs, int DelayMs, string AnimationEasing, bool PlayOnce, int StaggerMs, string ContinuousEffect, double Opacity, string Shadow, string TextAlign, string Padding);
    public sealed record CanvasBlockVisualUpdate(string Scope, string Shape, string BackgroundMode, string? BackgroundColor, string? TextColor, int BorderWidth, string BorderStyle, string? BorderColor, string BorderRadius, string AnimationEffect, string AnimationTrigger, int DurationMs, int DelayMs, string AnimationEasing, bool PlayOnce, int StaggerMs, string ContinuousEffect, double Opacity, string Shadow, string TextAlign, string Padding);

    public async ValueTask DisposeAsync()
    {
        _rotationHoldCts?.Cancel();
        _rotationHoldCts?.Dispose();
        if (_selectorOpen)
        {
            try
            {
                await JS.InvokeVoidAsync("destroyBlockSelectorSortables", _selectorListRef);
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _selfReference?.Dispose();
    }
}
