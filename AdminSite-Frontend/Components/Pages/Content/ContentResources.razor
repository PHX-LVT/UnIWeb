    private string GetValue(Dictionary<string, string> values, string lang, bool fallback = false) =>
        ResourceLibraryUiHelper.GetValue(values, lang, fallback);

    private static void SetValue(Dictionary<string, string> values, string lang, string? value)
    {
        values[lang] = value ?? string.Empty;
    }

    private Dictionary<string, string> LocalizedResourceValue(string? value)
    {
        var clean = value?.Trim() ?? string.Empty;
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var lang in _languages)
            result[lang] = clean;

        result.TryAdd("en", clean);
        result.TryAdd("vi", clean);
        result.TryAdd("cn", clean);
        return result;
    }

    private Dictionary<string, string> EnsureLangs(Dictionary<string, string>? source)
    {
        var result = source is null ? new() : new Dictionary<string, string>(source, StringComparer.OrdinalIgnoreCase);
        foreach (var lang in _languages)
            result.TryAdd(lang, string.Empty);
        return result;
    }

    private static string NormalizeKind(string? value) =>
        ResourceLibraryUiHelper.NormalizeKind(value);

    private static string NormalizeLang(string? lang) =>
        ResourceLibraryUiHelper.NormalizeLang(lang);

    private ManagedResourceRequest NewRequest(string kind = "file") => new()
    {
        Kind = NormalizeKind(kind),
        Name = EnsureLangs(null),
        Description = EnsureLangs(null),
        Source = "managed-upload",
        Active = true
    };

    private static ResourceUploadCapabilitiesDto DefaultUploadCapabilities() => new()
    {
        DirectUploadEnabled = false,
        MaxImageBytes = DefaultMaxImageUploadBytes,
        MaxFileBytes = DefaultMaxFileUploadBytes,
        MaxVideoBytes = DefaultMaxVideoUploadBytes,
        AllowedImageFormats = ["jpg", "jpeg", "png", "webp", "gif"],
        AllowedFileFormats = ["pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt"],
        AllowedVideoFormats = ["mp4", "webm", "mov"],
        MultipartThresholdBytes = 100L * 1024 * 1024,
        MultipartPartSizeBytes = 10L * 1024 * 1024,
        MaxConcurrentUploads = 2,
        PendingLifetimeMinutes = 30
    };

    private async Task ReleaseCompletedBrowserFilesAsync(IEnumerable<ResourceUploadQueueItem> items)
    {
        foreach (var item in items.Where(value => value.IsComplete && !string.IsNullOrWhiteSpace(value.BrowserToken)))
            await ReleaseBrowserFileAsync(item, preserveResourcePreview: true);
    }

    private async Task ReleaseBrowserFileAsync(ResourceUploadQueueItem item, bool preserveResourcePreview = false)
    {
        if (string.IsNullOrWhiteSpace(item.BrowserToken)) return;
        var replacementPreview = preserveResourcePreview
            ? item.Resource?.ThumbnailUrl ?? item.Resource?.Url
            : null;
        try { await JS.InvokeVoidAsync("resourceUploadClient.release", item.BrowserToken); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        item.BrowserToken = null;
        item.PreviewUrl = replacementPreview;
    }

    private static string NormalizeUploadContentType(string? contentType) =>
        string.IsNullOrWhiteSpace(contentType) ? "application/octet-stream" : contentType.Trim();

    private async Task ReleaseUploadQueueAsync(IEnumerable<ResourceUploadQueueItem> items)
    {
        var tokens = items.Select(item => item.BrowserToken).Where(token => !string.IsNullOrWhiteSpace(token)).ToList();
        if (tokens.Count == 0) return;
        try { await JS.InvokeVoidAsync("resourceUploadClient.releaseMany", tokens); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        foreach (var item in items)
        {
            item.BrowserToken = null;
            item.PreviewUrl = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await ReleaseUploadQueueAsync(_uploadQueue);
        _uploadDotNetRef?.Dispose();
    }

    private static class UploadQueueStatus
    {
        public const string Queued = "Queued";
        public const string Uploading = "Uploading";
        public const string Done = "Done";
        public const string Failed = "Failed";
        public const string Blocked = "Blocked";
        public const string Cancelled = "Cancelled";
    }

    private static class VideoUploadModes
    {
        public const string File = "file";
        public const string YouTube = "youtube";
    }

    private sealed class ResourceUploadQueueItem
    {
        public string Id { get; } = Guid.NewGuid().ToString("N");
        public string OriginalFileName { get; set; } = string.Empty;
        public string ResourceName { get; set; } = string.Empty;
        public long SizeBytes { get; set; }
        public string ContentType { get; set; } = "application/octet-stream";
        public string Kind { get; set; } = "file";
        public string? AlbumId { get; set; }
        public string? ReplaceResourceId { get; set; }
        public string Status { get; set; } = UploadQueueStatus.Queued;
        public string? Error { get; set; }
        public string? BrowserToken { get; set; }
        public string? PreviewKind { get; set; }
        public string? PreviewUrl { get; set; }
        public string? SessionId { get; set; }
        public string? ResourceId { get; set; }
        public double ProgressPercent { get; set; }
        public long ProgressBaseBytes { get; set; }
        public bool CancelRequested { get; set; }
        public ManagedResourceModel? Resource { get; set; }
        public bool IsComplete => string.Equals(Status, UploadQueueStatus.Done, StringComparison.OrdinalIgnoreCase);
        public bool IsUploading => string.Equals(Status, UploadQueueStatus.Uploading, StringComparison.OrdinalIgnoreCase);
        public bool IsFailed =>
            string.Equals(Status, UploadQueueStatus.Failed, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Status, UploadQueueStatus.Cancelled, StringComparison.OrdinalIgnoreCase);
        public bool CanUpload =>
            string.Equals(Status, UploadQueueStatus.Queued, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Status, UploadQueueStatus.Failed, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Status, UploadQueueStatus.Cancelled, StringComparison.OrdinalIgnoreCase);
    }

