                }
            </div>
            <div class="modal-footer">
                <button class="btn-admin btn-ghost" @onclick="CancelDeleteAlbum">@T("Cancel")</button>
                <button class="btn-admin btn-danger"
                        disabled="@(_deleteAlbumLoading || _deleteAlbum.ResourceCount > 0)"
                        @onclick="ConfirmDeleteAlbum">
                    @T("Delete")
                </button>
            </div>
        </div>
