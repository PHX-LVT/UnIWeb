    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);
    private string CurrentLang => NormalizeLang(AdminLanguage);
    private bool CanViewResourceLibrary => Auth.CanManageContent;
    private bool CanUploadResources => Auth.CanManageContent;
    private bool CanManageResources => Auth.IsAdminAdmin || Auth.CanApproveContent;

    private bool IsAlbumMode => string.Equals(_libraryMode, "albums", StringComparison.OrdinalIgnoreCase);
    private bool ShowingAlbumRoot => IsAlbumMode && string.IsNullOrWhiteSpace(_selectedAlbumId);
    private ResourceAlbumModel? SelectedAlbum =>
        string.IsNullOrWhiteSpace(_selectedAlbumId)
            ? null
            : _albums.FirstOrDefault(a => string.Equals(a.Id, _selectedAlbumId, StringComparison.OrdinalIgnoreCase));
    private string? ActiveAlbumId => IsAlbumMode ? _selectedAlbumId : null;
    private IEnumerable<ManagedResourceModel> FilteredResources => _resources;
    private IEnumerable<ResourceAlbumModel> FilteredAlbums => _albums.Where(MatchesAlbumFilters);
    private int FilteredResourceCount => FilteredResources.Count();
    private int FilteredAlbumCount => FilteredAlbums.Count();
    private int VisibleItemCount => ShowingAlbumRoot ? FilteredAlbumCount : FilteredResourceCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(VisibleItemCount / (double)PageSize));
    private int PageStart => VisibleItemCount == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(VisibleItemCount, _page * PageSize);
    private IEnumerable<ManagedResourceModel> PagedResources => FilteredResources.Skip((_page - 1) * PageSize).Take(PageSize);
    private IEnumerable<ResourceAlbumModel> PagedAlbums => FilteredAlbums.Skip((_page - 1) * PageSize).Take(PageSize);
    private IEnumerable<ManagedResourceModel> SelectablePagedResources => PagedResources;
    private List<ManagedResourceModel> BulkDeleteResources =>
        CanManageResources
            ? _resources.Where(r => _selectedResourceIds.Contains(r.Id) && !r.IsInUse).ToList()
            : new();
    private int SelectedBlockedCount =>
        CanManageResources
            ? _resources.Count(r => _selectedResourceIds.Contains(r.Id) && r.IsInUse)
            : 0;
    private bool AllPagedBulkSelected =>
        CanUploadResources &&
        SelectablePagedResources.Any() &&
        SelectablePagedResources.All(r => _selectedResourceIds.Contains(r.Id));
    private IEnumerable<ResourceAlbumModel> BulkMoveAlbums
    {
        get
        {
            var selected = _resources.Where(resource => _selectedResourceIds.Contains(resource.Id)).ToList();
            if (selected.Count == 0) return [];
            var scopes = selected.Select(resource => AlbumScopeForKind(resource.Kind))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            return scopes.Count == 1
                ? _albums.Where(album => string.Equals(album.Scope, scopes[0], StringComparison.OrdinalIgnoreCase))
                : [];
        }
    }
    private ManagedResourceUsageModel? SelectedUsage =>
        _selectedResource is null ? null : _usageByResourceId.GetValueOrDefault(_selectedResource.Id);
    private string UploadAccept => NormalizeKind(_edit.Kind) switch
    {
        "image" => "image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif",
        "video" => "video/mp4,video/webm,video/quicktime,.mp4,.webm,.mov",
        _ => ".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation"
    };
    private List<ResourceUploadQueueItem> UploadableQueueItems =>
        _uploadQueue.Where(item => item.CanUpload).ToList();
    private IEnumerable<ManagedResourceModel> AlbumExistingCandidates =>
        _albumExistingResources
            .Where(CanAssignExistingResourceToSelectedAlbum)
            .Where(MatchesAlbumExistingSearch)
            .OrderBy(ResourceName, StringComparer.OrdinalIgnoreCase);
    private int AlbumExistingSelectedCount =>
        AlbumExistingCandidates.Count(resource => _albumExistingSelectedIds.Contains(resource.Id));
    private ResourceAlbumModel? UploadAlbum =>
        string.IsNullOrWhiteSpace(_uploadAlbumId)
            ? null
            : _albums.FirstOrDefault(a => string.Equals(a.Id, _uploadAlbumId, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<string> AvailableUploadKinds
    {
        get
        {
            var album = SelectedAlbum ?? UploadAlbum;
            if (album is not null)
                return NormalizeAlbumScope(album.Scope) == "file"
                    ? ["file"]
                    : ["image", "video"];

            return ["image", "video", "file"];
        }
    }
    private bool IsUploadKindLocked => AvailableUploadKinds.Count() == 1;
    private bool IsUploadAlbumLocked => SelectedAlbum is not null;
    private string UploadLimitHint =>
        IsYoutubeLinkMode
            ? T("YouTubeNoFileUploadHint")
            : _uploadKind switch
            {
                "image" => string.Format(T("UploadMaxHint"), FormatBytes(_uploadCapabilities.MaxImageBytes)),
                "video" => string.Format(T("UploadMaxHint"), FormatBytes(_uploadCapabilities.MaxVideoBytes)),
                _ => string.Format(T("UploadMaxHint"), FormatBytes(_uploadCapabilities.MaxFileBytes))
            };
    private bool IsYoutubeLinkMode =>
        string.Equals(_uploadKind, "video", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(_videoUploadMode, VideoUploadModes.YouTube, StringComparison.OrdinalIgnoreCase);
    private bool IsSaveDisabled =>
        _editingId is null &&
        string.IsNullOrWhiteSpace(_edit.StorageKey);

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        await Auth.RefreshSessionAsync();
        await AdminLanguageState.LoadSettingsAsync();
        _languages = AdminLanguageState.SupportedLanguages.ToList();
        _edit = NewRequest();
        if (!CanViewResourceLibrary)
        {
            _loading = false;
            return;
        }

        await LoadAdminUsers();
        await LoadUploadCapabilities();
        await LoadAlbums();
        await LoadResources();
    }

    private async Task LoadUploadCapabilities()
    {
        var response = await ContentService.GetResourceUploadCapabilitiesAsync();
        if (response.Success && response.Data is not null)
            _uploadCapabilities = response.Data;
    }

    private async Task LoadAdminUsers()
    {
        _adminUsers.Clear();
        if (!Auth.CanManageUsers) return;

        var res = await Users.GetUsersAsync();
        if (res.Success && res.Data is not null)
            _adminUsers.AddRange(res.Data);
    }

    private async Task LoadResources()
    {
        if (!CanViewResourceLibrary)
        {
            _resources = new();
            _selectedResource = null;
            _loading = false;
            return;
        }

        _loading = true;
        var previousSelectedId = _selectedResource?.Id;
        var res = await ContentService.GetResourcesAsync(_kindFilter, _search, includeInactive: true, albumId: ActiveAlbumId);
        _resources = res.Data ?? new();
        PruneSelection();
        ClampPage();
        _selectedResource = FilteredResources.FirstOrDefault(r => r.Id == previousSelectedId)
            ?? PagedResources.FirstOrDefault()
            ?? FilteredResources.FirstOrDefault();
        await LoadUsageDetails(_selectedResource);
        _loading = false;
    }

    private async Task LoadAlbums()
    {
        _albumLoading = true;
        var res = await ContentService.GetResourceAlbumsAsync();
        _albums = res.Data ?? new();
        if (SelectedAlbum is null)
            _selectedAlbumId = null;
        _albumLoading = false;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _page = 1;
        if (ShowingAlbumRoot)
        {
            ClampPage();
            return;
        }

        await LoadResources();
    }

    private async Task SetKindFilter(string kind)
    {
        _kindFilter = kind;
        _page = 1;
        EnsureSelectedAlbumMatchesKind();
        if (ShowingAlbumRoot)
        {
            ClampPage();
            return;
        }

        await LoadResources();
    }

    private async Task SetLibraryMode(string mode)
    {
        _libraryMode = string.Equals(mode, "albums", StringComparison.OrdinalIgnoreCase) ? "albums" : "resources";
        _selectedAlbumId = null;
        _selectedResource = null;
        _selectedResourceIds.Clear();
        _page = 1;
        await LoadAlbums();
        if (!ShowingAlbumRoot)
            await LoadResources();
        else
            ClampPage();
    }

    private async Task OpenAlbum(ResourceAlbumModel album)
    {
        _libraryMode = "albums";
        _selectedAlbumId = album.Id;
        _selectedResource = null;
        _selectedResourceIds.Clear();
        _page = 1;
        await LoadResources();
    }

    private void BackToAlbums()
    {
        _selectedAlbumId = null;
        _selectedResource = null;
        _selectedResourceIds.Clear();
        _page = 1;
        ClampPage();
    }

    private void SetViewMode(string mode)
    {
        _viewMode = mode == "list" ? "list" : "grid";
    }

    private async Task SelectResource(ManagedResourceModel resource)
    {
        _selectedResource = resource;
        await LoadUsageDetails(resource);
    }

    private bool IsSelected(ManagedResourceModel resource) =>
        string.Equals(resource.Id, _selectedResource?.Id, StringComparison.OrdinalIgnoreCase);

    private bool IsBulkSelected(ManagedResourceModel resource) =>
        _selectedResourceIds.Contains(resource.Id);

    private string BulkSelectTitle(ManagedResourceModel resource) =>
        T("Select");

    private async Task HandleResourceClick(ManagedResourceModel resource, MouseEventArgs e)
    {
        if (CanUploadResources && (e.ShiftKey || e.CtrlKey || e.MetaKey))
        {
            HandleBulkSelectionClick(resource, e);
            return;
        }
        _selectionAnchorId = resource.Id;
        await SelectResource(resource);
    }

    private void HandleBulkSelectionClick(ManagedResourceModel resource, MouseEventArgs e)
    {
        if (!CanUploadResources) return;

        var page = PagedResources.ToList();
        if (e.ShiftKey && !string.IsNullOrWhiteSpace(_selectionAnchorId))
        {
            var anchorIndex = page.FindIndex(item => item.Id == _selectionAnchorId);
            var targetIndex = page.FindIndex(item => item.Id == resource.Id);
            if (anchorIndex >= 0 && targetIndex >= 0)
            {
                var start = Math.Min(anchorIndex, targetIndex);
                var end = Math.Max(anchorIndex, targetIndex);
                for (var index = start; index <= end; index++)
                    _selectedResourceIds.Add(page[index].Id);
                _selectionAnchorId = resource.Id;
                return;
            }
        }

        if (!_selectedResourceIds.Add(resource.Id))
            _selectedResourceIds.Remove(resource.Id);
        _selectionAnchorId = resource.Id;
    }

    private void ToggleAllPagedBulk(ChangeEventArgs e)
    {
        if (!CanUploadResources) return;

        var selected = e.Value is bool value && value;
        foreach (var resource in SelectablePagedResources)
        {
            if (selected)
                _selectedResourceIds.Add(resource.Id);
            else
                _selectedResourceIds.Remove(resource.Id);
        }
        _selectionAnchorId = selected ? SelectablePagedResources.LastOrDefault()?.Id : null;
    }

    private void ClearSelection()
    {
        _selectedResourceIds.Clear();
        _selectionAnchorId = null;
    }

    private void PruneSelection()
    {
        if (!CanUploadResources)
        {
            ClearSelection();
            return;
        }

        var ids = _resources.Select(r => r.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _selectedResourceIds.RemoveWhere(id => !ids.Contains(id));
        if (!string.IsNullOrWhiteSpace(_selectionAnchorId) && !ids.Contains(_selectionAnchorId))
            _selectionAnchorId = null;
    }

    private async Task PreviousPage()
    {
        if (_page <= 1) return;
        _page--;
        _selectedResource = PagedResources.FirstOrDefault() ?? _selectedResource;
        await LoadUsageDetails(_selectedResource);
    }

    private async Task NextPage()
    {
        if (_page >= TotalPages) return;
        _page++;
        _selectedResource = PagedResources.FirstOrDefault() ?? _selectedResource;
        await LoadUsageDetails(_selectedResource);
    }

    private void ClampPage()
    {
        if (_page < 1) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private async Task NewResource()
    {
        if (!EnsureCanUploadResources()) return;

        _uploadKind = DefaultUploadKind();
        _uploadAlbumId = SelectedAlbum?.Id ?? string.Empty;
        ApplyUploadAlbumConstraints();
        await ReleaseUploadQueueAsync(_uploadQueue);
        _uploadQueue.Clear();
        _videoUploadMode = VideoUploadModes.File;
        ResetYouTubeDraft();
        _albumExistingSearch = string.Empty;
        _albumExistingResources.Clear();
        _albumExistingSelectedIds.Clear();
        _showUploadModal = true;
        _showEditor = false;
        _editingId = null;

        if (SelectedAlbum is not null)
            await LoadAlbumExistingResources();
    }

    private async Task CloseUploadModal()
    {
        if (_uploadingQueue || _savingYoutubeResource) return;

        _showUploadModal = false;
        await ReleaseUploadQueueAsync(_uploadQueue);
        _uploadQueue.Clear();
        _albumExistingResources.Clear();
        _albumExistingSelectedIds.Clear();
        _albumExistingSearch = string.Empty;
        ResetYouTubeDraft();
    }

    private void OnUploadKindChanged(ChangeEventArgs e)
    {
        if (_uploadingQueue || _savingYoutubeResource || _uploadQueue.Any()) return;

        var nextKind = NormalizeKind(e.Value?.ToString());
        if (!AvailableUploadKinds.Contains(nextKind, StringComparer.OrdinalIgnoreCase))
            nextKind = AvailableUploadKinds.FirstOrDefault() ?? "image";

        _uploadKind = nextKind;
        if (UploadAlbum is null ||
            !string.Equals(UploadAlbum.Scope, AlbumScopeForKind(_uploadKind), StringComparison.OrdinalIgnoreCase))
        {
            _uploadAlbumId = string.Empty;
        }

        ApplyUploadAlbumConstraints();
        if (_uploadKind != "video")
            _videoUploadMode = VideoUploadModes.File;
        ResetYouTubeDraft();
    }

    private void OnUploadAlbumChanged(ChangeEventArgs e)
    {
        if (_uploadingQueue || _savingYoutubeResource || IsUploadAlbumLocked) return;

        _uploadAlbumId = e.Value?.ToString() ?? string.Empty;
        ApplyUploadAlbumConstraints();

        var albumId = EmptyToNull(_uploadAlbumId);
        foreach (var item in _uploadQueue.Where(item => !item.IsUploading && !item.IsComplete))
            item.AlbumId = albumId;
    }

    private void SetVideoUploadMode(string mode)
    {
        if (_uploadingQueue || _savingYoutubeResource || _uploadQueue.Any()) return;

        _videoUploadMode = string.Equals(mode, VideoUploadModes.YouTube, StringComparison.OrdinalIgnoreCase)
            ? VideoUploadModes.YouTube
            : VideoUploadModes.File;
        if (!IsYoutubeLinkMode)
            ResetYouTubeDraft();
    }

    private async Task QueueUploadFiles(InputFileChangeEventArgs _)
    {
        if (!EnsureCanUploadResources()) return;

        var remainingCapacity = Math.Max(0, MaxQueuedFiles - _uploadQueue.Count);
        BrowserCaptureBatch capture;
        try
        {
            capture = await JS.InvokeAsync<BrowserCaptureBatch>(
                "resourceUploadClient.captureFiles",
                "resource-upload-input",
                remainingCapacity);
        }
        catch (JSException)
        {
            Http.Notify(T("UploadFailed"), 500);
            return;
        }

        if (capture.SelectedCount > capture.Files.Count)
            Http.Notify(string.Format(T("TooManyQueuedFiles"), MaxQueuedFiles), 422);

        foreach (var browserFile in capture.Files)
        {
            if (string.IsNullOrWhiteSpace(browserFile.Token))
                continue;

            var item = new ResourceUploadQueueItem
            {
                OriginalFileName = browserFile.Name,
                ResourceName = DefaultResourceName(browserFile.Name),
                SizeBytes = browserFile.Size,
                ContentType = NormalizeUploadContentType(browserFile.ContentType),
                Kind = NormalizeKind(_uploadKind),
                AlbumId = EmptyToNull(_uploadAlbumId),
                BrowserToken = browserFile.Token,
                PreviewKind = browserFile.PreviewKind,
                PreviewUrl = browserFile.PreviewUrl
            };

            var validationError = ValidateQueuedFile(item.OriginalFileName, item.SizeBytes, _uploadKind);
            if (!string.IsNullOrWhiteSpace(validationError))
            {
                item.Status = UploadQueueStatus.Blocked;
                item.Error = validationError;
            }

            _uploadQueue.Add(item);
        }
    }

    private async Task UploadQueuedResources()
    {
        if (!EnsureCanUploadResources()) return;

        var items = UploadableQueueItems;
        if (items.Count == 0)
        {
            Http.Notify(T("NoQueuedFiles"), 422);
            return;
        }

        await UploadQueueItemsAsync(items);
    }

    private async Task RetryUpload(ResourceUploadQueueItem item)
    {
        if (_uploadingQueue || item.IsComplete) return;

        item.Status = UploadQueueStatus.Queued;
        item.Error = ValidateQueuedFile(item.OriginalFileName, item.SizeBytes, _uploadKind);
        if (!string.IsNullOrWhiteSpace(item.Error))
        {
            item.Status = UploadQueueStatus.Blocked;
            return;
        }

        await UploadQueueItemsAsync([item]);
    }

    private async Task UploadQueueItemsAsync(List<ResourceUploadQueueItem> items)
    {
        if (items.Count == 0) return;

        _uploadingQueue = true;
        var closeAfterSuccess = false;
        try
        {
            using var gate = new SemaphoreSlim(Math.Clamp(_uploadCapabilities.MaxConcurrentUploads, 1, 6));
            var jobs = items.Select(async item =>
            {
                await gate.WaitAsync();
                try
                {
                    await UploadQueueItemAsync(item);
                }
                finally
                {
                    gate.Release();
                }
            }).ToList();
            await Task.WhenAll(jobs);

            ApplyCompletedUploads(items);
            await ReleaseCompletedBrowserFilesAsync(items);

            var lastUploaded = items.LastOrDefault(item => item.IsComplete)?.Resource;
            if (lastUploaded is not null && ResourceMatchesCurrentView(lastUploaded))
                _selectedResource = _resources.FirstOrDefault(resource => resource.Id == lastUploaded.Id) ?? lastUploaded;

            var successful = items.Count(item => item.IsComplete);
            var failed = items.Count - successful;
            Http.Notify(failed == 0
                ? $"Uploaded {successful} resource(s)."
                : $"Uploaded {successful} resource(s); {failed} failed or were cancelled.",
                failed == 0 ? 200 : 422);
            closeAfterSuccess = failed == 0 &&
                _uploadQueue.All(item => item.Status == UploadQueueStatus.Done);
        }
        finally
        {
            _uploadingQueue = false;
        }
        if (closeAfterSuccess)
            await CloseUploadModal();
    }

    private async Task UploadQueueItemAsync(ResourceUploadQueueItem item)
    {
        item.Status = UploadQueueStatus.Uploading;
        item.Error = null;
        item.ProgressPercent = 0;
        item.CancelRequested = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (!_uploadCapabilities.DirectUploadEnabled)
                throw new InvalidOperationException("Direct R2 upload is not available. Check the API storage configuration.");
            await UploadQueueItemDirectAsync(item);

            if (item.CancelRequested)
                throw new OperationCanceledException("Upload cancelled.");
            item.ProgressPercent = 100;
            item.Status = UploadQueueStatus.Done;
        }
        catch (OperationCanceledException)
        {
            item.Status = UploadQueueStatus.Cancelled;
            item.Error = "Upload cancelled.";
        }
        catch (Exception exception)
        {
            item.Status = UploadQueueStatus.Failed;
            item.Error = string.IsNullOrWhiteSpace(exception.Message) ? T("UploadFailed") : exception.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UploadQueueItemDirectAsync(ResourceUploadQueueItem item)
    {
        if (string.IsNullOrWhiteSpace(item.BrowserToken))
            throw new InvalidOperationException("The selected browser file is no longer available. Select it again.");

        var initiated = await InitiateUploadWithRetryAsync(item, new ResourceUploadInitiateRequest
        {
            FileName = item.OriginalFileName,
            ResourceName = CleanQueueResourceName(item),
            Kind = item.Kind,
            ContentType = item.ContentType,
            SizeBytes = item.SizeBytes,
            AlbumId = item.AlbumId,
            ReplaceResourceId = item.ReplaceResourceId
        });
        if (!initiated.Success || initiated.Data is null)
            throw new InvalidOperationException(string.IsNullOrWhiteSpace(initiated.Message) ? T("UploadFailed") : initiated.Message);

        var upload = initiated.Data;
        item.SessionId = upload.SessionId;
        _uploadDotNetRef ??= DotNetObjectReference.Create(this);

        try
        {
            List<ResourceUploadCompletedPartDto> completedParts = [];
            if (upload.Mode == "multipart")
            {
                completedParts = await UploadMultipartAsync(item, upload);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(upload.UploadUrl))
                    throw new InvalidOperationException("The upload URL was not returned.");
                item.ProgressBaseBytes = 0;
                await JS.InvokeAsync<BrowserUploadResult>(
                    "resourceUploadClient.upload",
                    item.BrowserToken,
                    upload.UploadUrl,
                    upload.RequiredHeaders,
                    item.Id,
                    _uploadDotNetRef,
                    null,
                    null,
                    UploadTimeoutMilliseconds(item.SizeBytes));
            }

            if (item.CancelRequested) throw new OperationCanceledException();
            var completed = await CompleteUploadWithRetryAsync(item, upload.SessionId, completedParts);
            if (!completed.Success || completed.Data is null || completed.Data.Status != "ready")
                throw new InvalidOperationException(completed.Data?.ErrorMessage ?? completed.Message ?? T("UploadFailed"));
            item.ResourceId = completed.Data.ResourceId;
            item.Resource = MapUploadedResource(completed.Data.Resource);
        }
        catch
        {
            await ContentService.AbortResourceUploadAsync(upload.SessionId);
            throw;
        }
    }

    private async Task<List<ResourceUploadCompletedPartDto>> UploadMultipartAsync(
        ResourceUploadQueueItem item,
        ResourceUploadInitiateResponse upload)
    {
        var completed = new List<ResourceUploadCompletedPartDto>(upload.PartCount);
        var allPartNumbers = Enumerable.Range(1, upload.PartCount).ToList();
        foreach (var batch in allPartNumbers.Chunk(100))
        {
            var urls = await GetPartUrlsWithRetryAsync(item, upload.SessionId, batch);
            if (!urls.Success || urls.Data is null)
                throw new InvalidOperationException(urls.Message ?? "Upload part URLs could not be created.");

            foreach (var part in urls.Data.Parts.OrderBy(value => value.PartNumber))
            {
                if (item.CancelRequested) throw new OperationCanceledException();
                var start = (part.PartNumber - 1L) * upload.PartSizeBytes;
                var end = Math.Min(item.SizeBytes, start + upload.PartSizeBytes);
                item.ProgressBaseBytes = start;
                var result = await JS.InvokeAsync<BrowserUploadResult>(
                    "resourceUploadClient.upload",
                    item.BrowserToken,
                    part.UploadUrl,
                    upload.RequiredHeaders,
                    item.Id,
                    _uploadDotNetRef,
                    start,
                    end,
                    UploadTimeoutMilliseconds(end - start));
                if (string.IsNullOrWhiteSpace(result.ETag))
                    throw new InvalidOperationException("R2 did not expose the ETag response header required for multipart upload.");
                completed.Add(new ResourceUploadCompletedPartDto { PartNumber = part.PartNumber, ETag = result.ETag });
                item.ProgressPercent = Math.Min(99, end * 100d / item.SizeBytes);
            }
        }
        return completed;
    }

    private async Task<ApiResponse<ResourceUploadInitiateResponse>> InitiateUploadWithRetryAsync(
        ResourceUploadQueueItem item,
        ResourceUploadInitiateRequest request)
    {
        ApiResponse<ResourceUploadInitiateResponse>? response = null;
        for (var attempt = 0; attempt < 4; attempt++)
        {
            if (item.CancelRequested) throw new OperationCanceledException();
            response = await ContentService.InitiateResourceUploadAsync(request);
            if (response.StatusCode != 429) return response;
            await DelayForRateLimitAsync(item, response.RetryAfterSeconds, attempt);
        }
        return response ?? ApiResponse<ResourceUploadInitiateResponse>.Fail(T("UploadFailed"), 500);
    }

    private async Task<ApiResponse<ResourceUploadPartUrlsResponse>> GetPartUrlsWithRetryAsync(
        ResourceUploadQueueItem item,
        string sessionId,
        IEnumerable<int> partNumbers)
    {
        ApiResponse<ResourceUploadPartUrlsResponse>? response = null;
        var numbers = partNumbers.ToList();
        for (var attempt = 0; attempt < 4; attempt++)
        {
            if (item.CancelRequested) throw new OperationCanceledException();
            response = await ContentService.GetResourceUploadPartUrlsAsync(sessionId, numbers);
            if (response.StatusCode != 429) return response;
            await DelayForRateLimitAsync(item, response.RetryAfterSeconds, attempt);
        }
        return response ?? ApiResponse<ResourceUploadPartUrlsResponse>.Fail(T("UploadFailed"), 500);
    }

    private async Task<ApiResponse<ResourceUploadSessionDto>> CompleteUploadWithRetryAsync(
        ResourceUploadQueueItem item,
        string sessionId,
        IEnumerable<ResourceUploadCompletedPartDto> completedParts)
    {
        ApiResponse<ResourceUploadSessionDto>? response = null;
        var parts = completedParts.ToList();
        for (var attempt = 0; attempt < 4; attempt++)
        {
            if (item.CancelRequested) throw new OperationCanceledException();
            response = await ContentService.CompleteResourceUploadAsync(sessionId, parts);
            if (response.StatusCode != 429) return response;
            await DelayForRateLimitAsync(item, response.RetryAfterSeconds, attempt);
        }
        return response ?? ApiResponse<ResourceUploadSessionDto>.Fail(T("UploadFailed"), 500);
    }

    private static async Task DelayForRateLimitAsync(ResourceUploadQueueItem item, int? retryAfterSeconds, int attempt)
    {
        if (item.CancelRequested) throw new OperationCanceledException();
        var seconds = Math.Clamp(retryAfterSeconds ?? (attempt + 1), 1, 30);
        await Task.Delay(TimeSpan.FromSeconds(seconds));
        if (item.CancelRequested) throw new OperationCanceledException();
    }

    private void ApplyCompletedUploads(IEnumerable<ResourceUploadQueueItem> items)
    {
        foreach (var item in items.Where(value => value.IsComplete && value.Resource is not null))
        {
            var resource = item.Resource!;
            if (ResourceMatchesCurrentView(resource))
            {
                var index = _resources.FindIndex(existing => existing.Id == resource.Id);
                if (index >= 0) _resources[index] = resource;
                else _resources.Insert(0, resource);
            }

            if (!string.IsNullOrWhiteSpace(resource.AlbumId))
            {
                var album = _albums.FirstOrDefault(value => value.Id == resource.AlbumId);
                if (album is not null) album.ResourceCount++;
            }
        }
        PruneSelection();
        ClampPage();
    }

    private bool ResourceMatchesCurrentView(ManagedResourceModel resource)
    {
        if (ShowingAlbumRoot) return false;
        if (!string.IsNullOrWhiteSpace(_kindFilter) &&
            !string.Equals(NormalizeKind(resource.Kind), NormalizeKind(_kindFilter), StringComparison.OrdinalIgnoreCase))
            return false;
        if (!string.IsNullOrWhiteSpace(ActiveAlbumId) &&
            !string.Equals(resource.AlbumId, ActiveAlbumId, StringComparison.OrdinalIgnoreCase))
            return false;
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var term = _search.Trim();
        return ResourceName(resource).Contains(term, StringComparison.OrdinalIgnoreCase) ||
               ResourceFileName(resource).Contains(term, StringComparison.OrdinalIgnoreCase) ||
               resource.ContentType.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private static ManagedResourceModel? MapUploadedResource(ResourceUploadResourceDto? resource) => resource is null ? null : new()
    {
        Id = resource.Id,
        AssetId = resource.AssetId,
        AssetVersion = resource.AssetVersion,
        StorageSchemaVersion = resource.StorageSchemaVersion,
        Kind = resource.Kind,
        Purpose = resource.Purpose,
        Name = new Dictionary<string, string>(resource.Name),
        Description = new Dictionary<string, string>(resource.Description),
        Url = resource.Url,
        StorageKey = resource.StorageKey,
        ThumbnailUrl = resource.ThumbnailUrl,
        FileName = resource.FileName,
        ContentType = resource.ContentType,
        SizeBytes = resource.SizeBytes,
        Source = resource.Source,
        OriginalSourceUrl = resource.OriginalSourceUrl,
        LicenseName = resource.LicenseName,
        Attribution = resource.Attribution,
        DeletionState = resource.DeletionState,
        Tags = [.. resource.Tags],
        AlbumId = resource.AlbumId,
        Active = resource.Active,
        UsageCount = resource.UsageCount,
        IsInUse = resource.IsInUse,
        CreatedById = resource.CreatedById,
        UpdatedById = resource.UpdatedById,
        CreatedAt = resource.CreatedAt,
        UpdatedAt = resource.UpdatedAt
    };

    [JSInvokable]
    public Task UpdateResourceUploadProgress(string itemId, long loaded, long total)
    {
        var item = _uploadQueue.FirstOrDefault(value => value.Id == itemId);
        if (item is null || item.SizeBytes <= 0) return Task.CompletedTask;
        item.ProgressPercent = Math.Clamp((item.ProgressBaseBytes + loaded) * 100d / item.SizeBytes, 0, 99);
        return Task.CompletedTask;
    }

    private async Task CancelUpload(ResourceUploadQueueItem item)
    {
        if (!item.IsUploading) return;
        item.CancelRequested = true;
        await JS.InvokeVoidAsync("resourceUploadClient.abort", item.Id);
        if (!string.IsNullOrWhiteSpace(item.SessionId))
            await ContentService.AbortResourceUploadAsync(item.SessionId);
    }

    private static int UploadTimeoutMilliseconds(long bytes) =>
        (int)Math.Clamp(60_000d + bytes / (256d * 1024) * 1000d, 120_000d, 30 * 60_000d);

