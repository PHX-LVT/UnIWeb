    {
        if (!EnsureCanUploadResources() || _selectedResourceIds.Count == 0) return;
        _bulkMoveLoading = true;
        try
        {
            var response = await ContentService.BulkMoveResourcesAsync(
                _selectedResourceIds,
                string.IsNullOrWhiteSpace(_bulkMoveAlbumId) ? null : _bulkMoveAlbumId);
            Http.Notify(response.Message, response.StatusCode);
            if (!response.Success) return;

            _showBulkMove = false;
            ClearSelection();
            await LoadAlbums();
            await LoadResources();
