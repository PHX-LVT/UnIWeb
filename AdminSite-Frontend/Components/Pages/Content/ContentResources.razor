    {
        if (!EnsureCanUploadResources()) return;

        if (string.IsNullOrWhiteSpace(_youtubeUrl))
        {
            Http.Notify(T("YouTubeLinkRequired"), 422);
            return;
        }

        _savingYoutubeResource = true;
        try
        {
            var cleanName = string.IsNullOrWhiteSpace(_youtubeName)
                ? T("DefaultYouTubeVideoName")
                : _youtubeName.Trim();

            var request = new ManagedResourceRequest
            {
                Kind = "video",
                Name = LocalizedResourceValue(cleanName),
                Description = LocalizedResourceValue(_youtubeDescription.Trim()),
                Url = _youtubeUrl.Trim(),
                Source = "external-url",
                AlbumId = EmptyToNull(_uploadAlbumId),
                Active = true
            };

            var res = await ContentService.CreateResourceAsync(request);
            Http.Notify(res.Message, res.StatusCode);
            if (!res.Success) return;

            ResetYouTubeDraft();
            await LoadAlbums();
            await LoadResources();
            if (!string.IsNullOrWhiteSpace(res.Data?.Id))
                _selectedResource = _resources.FirstOrDefault(r => r.Id == res.Data.Id) ?? _selectedResource;
