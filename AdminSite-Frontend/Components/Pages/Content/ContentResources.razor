            <div class="modal-header">@T("DeleteAlbum")</div>
            <div style="padding:1rem">
                <p style="margin-top:0">
                    @string.Format(T("DeleteAlbumPrompt"), _deleteAlbum.Name)
                </p>
                @if (_deleteAlbumLoading)
                {
                    <p class="text-muted">@T("Loading")</p>
                }
                else if (_deleteAlbum.ResourceCount > 0)
                {
                    <div class="alert alert-warning" style="margin-bottom:.75rem">
                        @string.Format(T("DeleteAlbumBlocked"), _deleteAlbum.ResourceCount)
                    </div>
                    @if (_deleteAlbumResourceNames.Any())
                    {
                        <ul style="margin:.5rem 0 0;padding-left:1.2rem">
                            @foreach (var name in _deleteAlbumResourceNames.Take(5))
                            {
                                <li>@name</li>
