    private void OpenBulkMove()
    {
        if (!EnsureCanUploadResources() || _selectedResourceIds.Count == 0) return;
        var currentAlbums = _resources
            .Where(resource => _selectedResourceIds.Contains(resource.Id))
            .Select(resource => resource.AlbumId ?? string.Empty)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        _bulkMoveAlbumId = currentAlbums.Count == 1 ? currentAlbums[0] : string.Empty;
        if (!string.IsNullOrWhiteSpace(_bulkMoveAlbumId) && !BulkMoveAlbums.Any(album => album.Id == _bulkMoveAlbumId))
            _bulkMoveAlbumId = string.Empty;
        _showBulkMove = true;
    }

