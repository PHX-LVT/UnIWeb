@inject AdminContentService ContentService
@inject IHttpService Http

@if (Open)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-box content-resource-picker" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span>@PickerTitle</span>
                <button type="button" class="btn-admin btn-ghost content-icon-btn" @onclick="Close" title="@T("Close")">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="content-resource-picker__toolbar">
                    <input class="form-control content-resource-picker__search"
                           placeholder="@T("SearchResources")"
                           value="@_search"
                           @oninput="OnSearchChanged" />
                    <select class="form-control content-resource-picker__album"
                            value="@_albumId"
                            disabled="@_albumLoadFailed"
                            aria-label="@T("Album")"
                            @onchange="OnAlbumChanged">
                        <option value="">@T("AllAlbums")</option>
                        @foreach (var album in _albums)
                        {
                            <option value="@album.Id">@album.Name</option>
                        }
                    </select>
                    <a class="btn-admin btn-ghost content-resource-picker__open"
                       href="/content/resources"
                       target="_blank"
                       rel="noopener"
                       title="@T("ResourceLibrary")">
                        <i class="fas fa-up-right-from-square"></i>
                        <span>@T("ResourceLibrary")</span>
                    </a>
                </div>
                <div class="form-hint">@T("ResourcePickerHint")</div>
                <AdminInlineStatus TargetId="resource-picker-albums-load" Retry="LoadAlbums" RetryText="@T("Retry")" />
                <AdminInlineStatus TargetId="resource-picker-items-load" Retry="LoadResources" Retrying="_loading" RetryText="@T("Retry")" />

                @if (_loading)
                {
                    <p class="text-muted">@T("Loading")</p>
                }
                else if (!_resourceLoadFailed && !FilteredResources.Any())
                {
                    <p class="text-muted">@T("NoMatchingResources")</p>
                }
                else
                {
                    <div class="content-resource-picker__grid">
                        @foreach (var resource in FilteredResources)
                        {
                            <button type="button"
                                    class="content-resource-picker__item @(IsSelected(resource) ? "content-resource-picker__item--selected" : "")"
                                    @key="resource.Id"
                                    @onclick="() => SelectResource(resource)"
                                    @ondblclick="() => Choose(resource)">
                                <span class="content-resource-picker__thumb">
                                    @if (ResourceThumbnailUrl(resource) is { Length: > 0 } thumbnail)
                                    {
                                        <img src="@thumbnail" alt="" />
                                    }
                                    else
                                    {
                                        <i class="fas @ResourceIcon(resource)"></i>
                                    }
                                </span>
                                <span class="content-resource-picker__meta">
                                    <strong>@ResourceName(resource)</strong>
                                    <small>@DisplayResourceKind(resource.Kind)</small>
                                    @if (!string.IsNullOrWhiteSpace(ResourceDescription(resource)))
                                    {
                                        <em>@ResourceDescription(resource)</em>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-admin btn-ghost" @onclick="Close">@T("Cancel")</button>
                <button type="button"
                        class="btn-admin btn-primary"
                        disabled="@(_selectedResource is null)"
                        @onclick="ChooseSelected">
                    @T("Choose")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Kind { get; set; } = "file";
    [Parameter] public EventCallback<ManagedResourceModel> ResourceSelected { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";

    private bool _wasOpen;
    private bool _loading;
    private bool _resourceLoadFailed;
    private bool _albumLoadFailed;
    private string _loadedKind = string.Empty;
    private string _search = string.Empty;
    private string _albumId = string.Empty;
    private ManagedResourceModel? _selectedResource;
    private List<ManagedResourceModel> _resources = new();
    private List<ResourceAlbumModel> _albums = new();

    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);
    private string CurrentLang => NormalizeLang(AdminLanguage);
    private IEnumerable<ManagedResourceModel> FilteredResources => _resources;
    private string PickerTitle => NormalizeKind(Kind) switch
    {
        "image" => T("ChooseImageResource"),
        "video" => T("ChooseVideoResource"),
        _ => T("ChooseFileResource")
    };

    protected override async Task OnParametersSetAsync()
    {
        var normalizedKind = NormalizeKind(Kind);
        if (Open && (!_wasOpen || !string.Equals(_loadedKind, normalizedKind, StringComparison.OrdinalIgnoreCase)))
        {
            _loadedKind = normalizedKind;
            _search = string.Empty;
            _albumId = string.Empty;
            _selectedResource = null;
            await LoadAlbums();
            await LoadResources();
        }

        if (!Open)
        {
            _resources = new();
            _albums = new();
            _selectedResource = null;
            Http.ClearInlineStatus("resource-picker-albums-load");
            Http.ClearInlineStatus("resource-picker-items-load");
        }

        _wasOpen = Open;
    }

    private async Task LoadResources()
    {
        Http.ClearInlineStatus("resource-picker-items-load");
        _loading = true;
        var res = await ContentService.GetResourcesAsync(
            _loadedKind,
            _search,
            includeInactive: false,
            albumId: string.IsNullOrWhiteSpace(_albumId) ? null : _albumId);
        if (res.Success)
        {
            _resourceLoadFailed = false;
            _resources = (res.Data ?? new()).Where(r => r.Active).ToList();
            if (_selectedResource is not null &&
                !_resources.Any(r => string.Equals(r.Id, _selectedResource.Id, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedResource = null;
            }
        }
        else
        {
            _resourceLoadFailed = true;
            _resources = new();
            _selectedResource = null;
            Http.NotifyInline(res, "resource-picker-items-load");
        }
        _loading = false;
    }

    private async Task LoadAlbums()
    {
        Http.ClearInlineStatus("resource-picker-albums-load");
        var scope = string.Equals(_loadedKind, "file", StringComparison.OrdinalIgnoreCase) ? "file" : "media";
        var response = await ContentService.GetResourceAlbumsAsync(scope);
        if (response.Success)
        {
            _albumLoadFailed = false;
            _albums = (response.Data ?? [])
                .OrderBy(album => album.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            if (!string.IsNullOrWhiteSpace(_albumId) && !_albums.Any(album => album.Id == _albumId))
                _albumId = string.Empty;
            return;
        }

        _albums = [];
        _albumLoadFailed = true;
        _albumId = string.Empty;
        Http.NotifyInline(response, "resource-picker-albums-load");
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        await LoadResources();
    }

    private async Task OnAlbumChanged(ChangeEventArgs e)
    {
        _albumId = e.Value?.ToString() ?? string.Empty;
        _selectedResource = null;
        await LoadResources();
    }

    private void SelectResource(ManagedResourceModel resource)
    {
        _selectedResource = resource;
    }

    private async Task ChooseSelected()
    {
        if (_selectedResource is null) return;
        await Choose(_selectedResource);
    }

    private async Task Choose(ManagedResourceModel resource)
    {
        await ResourceSelected.InvokeAsync(resource);
        await Close();
    }

    private async Task Close()
    {
        _loading = false;
        _selectedResource = null;
        await Closed.InvokeAsync();
    }

    private bool IsSelected(ManagedResourceModel resource) =>
        _selectedResource is not null &&
        string.Equals(_selectedResource.Id, resource.Id, StringComparison.OrdinalIgnoreCase);

    private string ResourceName(ManagedResourceModel resource) =>
        ResourceLibraryUiHelper.ResourceName(resource, CurrentLang);

    private string ResourceDescription(ManagedResourceModel resource) =>
        ResourceLibraryUiHelper.ResourceDescription(resource, CurrentLang);

    private static string ResourceThumbnailUrl(ManagedResourceModel resource) =>
        ResourceLibraryUiHelper.ResourceThumbnailUrl(resource);

    private static string ResourceIcon(ManagedResourceModel resource) =>
        ResourceLibraryUiHelper.ResourceIcon(resource);

    private string DisplayResourceKind(string kind) => NormalizeKind(kind) switch
    {
        "image" => T("ImageResource"),
        "video" => T("VideoResource"),
        _ => T("FileResource")
    };

    private static string NormalizeKind(string? value) =>
        ResourceLibraryUiHelper.NormalizeKind(value);

    private static string NormalizeLang(string? lang) =>
        ResourceLibraryUiHelper.NormalizeLang(lang);
}
