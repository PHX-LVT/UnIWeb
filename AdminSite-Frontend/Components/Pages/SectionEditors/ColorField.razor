<label class="section-design-field">
    <span class="section-design-field__label">@Label</span>
    <span class="section-design-color">
        <input type="color" value="@Value" @oninput="OnChanged" aria-label="@Label" />
        <code>@Value</code>
    </span>
</label>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = "#ffffff";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task OnChanged(ChangeEventArgs args) =>
        ValueChanged.InvokeAsync(args.Value?.ToString() ?? Value);
}
