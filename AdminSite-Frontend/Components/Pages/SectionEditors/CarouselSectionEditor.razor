@inject AdminSectionService SectionService
@using Contracts.Admin
@inject IHttpService Http
@inject DirectResourceUploadService DirectUploads

<section class="ez-content-editor__text">
    <h3>@T("SectionText")</h3>
    <div class="form-group"><label class="form-label">@T("SectionTitle")</label><LangField @bind-Value="_title" Languages="Languages" /></div>
</section>

<ContentEditorGroup Title="@T("Slides")" Summary="@($"{_items.Count} slides · {_layout}")" @bind-Expanded="_slidesExpanded">
    <div class="ez-content-editor__settings">
        <div class="form-group"><label class="form-label">@T("Layout")</label><DxComboBox Data="@_layouts" Value="_layout" ValueChanged="@((string? value) => ChangeLayout(value))" CssClass="w-100" /></div>
        <div class="form-group"><label class="form-label">@T("Columns")</label><DxSpinEdit @bind-Value="_columns" MinValue="1" MaxValue="5" CssClass="w-100" /></div>
        <label class="form-group ez-content-check"><span class="form-label">@T("Playback")</span><span><DxCheckBox @bind-Checked="_autoplay" /> @T("Autoplay")</span></label>
        <label class="form-group ez-content-check"><span class="form-label">@T("Navigation")</span><span><DxCheckBox @bind-Checked="_showArrows" /> @T("Arrows")</span></label>
        <label class="form-group ez-content-check"><span class="form-label">@T("Pagination")</span><span><DxCheckBox @bind-Checked="_showDots" /> @T("Dots")</span></label>
    </div>

    <ContentSortableList Reordered="ReorderItems">
        @foreach (var item in _items.OrderBy(item => item.Order))
        {
            var number = item.Order + 1;
            var uploadId = ItemImageUploadId(item);
            <ContentItemAccordion @key="item.Id" ItemId="@item.Id" Number="@number" Title="@ItemTitle(item, number)" Summary="@ItemSummary(item)"
                                  Expanded="@(_openItemId == item.Id)" OnToggle="() => ToggleItem(item.Id)" OnDelete="() => RemoveItem(item)"
                                  Visible="@item.Visible" VisibleChanged="value => SetVisible(item, value)">
                <div class="form-group"><label class="form-label">@T("Tag")</label><LangField Value="@(item.Tag ?? new())" ValueChanged="value => item.Tag = value" Languages="Languages" /></div>
                <div class="form-group"><label class="form-label">@T("Title")</label><LangField Value="@(item.Title ?? new())" ValueChanged="value => item.Title = value" Languages="Languages" /></div>
                <div class="form-group"><label class="form-label">@T("Description")</label><LangField Value="@(item.Description ?? new())" ValueChanged="value => item.Description = value" Languages="Languages" Multiline="true" /></div>
                <div class="form-group"><label class="form-label">@T("Link")</label><DxTextBox @bind-Text="item.LinkHref" NullText="/insights-detail" CssClass="w-100" /></div>

                @if (_layout == "case-metrics")
                {
                    <ContentEditorGroup Title="@T("Metrics")" Summary="@($"{item.Metrics?.Count ?? 0} metrics")" Expanded="@(_openMetricsItemId == item.Id)" ExpandedChanged="value => ToggleMetrics(item.Id, value)">
                        @foreach (var metric in (item.Metrics ?? new()).OrderBy(metric => metric.Order))
                        {
                            <div class="ez-content-metric-row" @key="metric.Id">
                                <div><label class="form-label">@T("Value")</label><LangField Value="@(metric.Value ?? new())" ValueChanged="value => metric.Value = value" Languages="Languages" /></div>
                                <div><label class="form-label">@T("Label")</label><LangField Value="@(metric.Label ?? new())" ValueChanged="value => metric.Label = value" Languages="Languages" /></div>
                                <div><label class="form-label">@T("Tone")</label><DxComboBox Data="@_metricTones" @bind-Value="metric.Tone" CssClass="w-100" /></div>
                                <button type="button" class="ez-icon-btn ez-icon-btn--danger" title="@T("Delete")" @onclick="() => RemoveMetric(item, metric)"><i class="fas fa-trash"></i></button>
                            </div>
                        }
                        <button type="button" class="btn-admin btn-outline ez-content-add" @onclick="() => AddMetric(item)"><i class="fas fa-plus"></i> @T("AddMetric")</button>
                    </ContentEditorGroup>
                }

                <div class="form-group">
                    <label class="form-label">@T("Image")</label>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <div class="ez-content-media-preview"><img src="@item.ImageUrl" alt="" /><button type="button" class="btn-admin btn-ghost" @onclick="() => ClearItemImage(item)"><i class="fas fa-times"></i> @T("Remove")</button></div>
                    }
                    <div class="ez-content-media-actions">
                        <InputFile id="@uploadId" OnChange="args => OnItemImageSelected(args, item)" accept="image/*" style="display:none" />
                        <label class="btn-admin btn-ghost" for="@uploadId"><i class="fas fa-image"></i> @T("UploadNew")</label>
                        <button type="button" class="btn-admin btn-ghost" @onclick="() => OpenResourcePicker(item)"><i class="fas fa-photo-film"></i> @T("ChooseFromResourceLibrary")</button>
                        <MediaCropField ImageUrl="@(item.ImageUrl ?? string.Empty)" Value="item.ImagePlacement" ValueChanged="value => SetImagePlacement(item, value)" AspectRatio="@(16d / 10d)" />
                    </div>
                </div>
            </ContentItemAccordion>
        }
    </ContentSortableList>
    <button type="button" class="btn-admin btn-outline ez-content-add" @onclick="AddItem"><i class="fas fa-plus"></i> @T("AddSlide")</button>
</ContentEditorGroup>

<ResourcePickerModal Open="_resourcePickerOpen" Kind="image" ResourceSelected="SelectResourceImage" Closed="CloseResourcePicker" />

@code {
    [Parameter] public SectionModel Section { get; set; } = new();
    [Parameter] public string PageId { get; set; } = string.Empty;
    [Parameter] public List<string> Languages { get; set; } = new() { "en" };
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";
    [CascadingParameter] public SectionContentEditSession? ContentSession { get; set; }

    private int _columns = 3;
    private string _layout = "cards";
    private bool _autoplay;
    private bool _showArrows = true;
    private bool _showDots = true;
    private Dictionary<string, string> _title = new();
    private List<CarouselItemModel> _items = new();
    private bool _saving;
    private bool _slidesExpanded;
    private string? _openItemId;
    private string? _openMetricsItemId;
    private string? _loadedSectionId;
    private bool _resourcePickerOpen;
    private CarouselItemModel? _resourcePickerItem;
    private readonly string[] _layouts = { "cards", "case-metrics" };
    private readonly string[] _metricTones = { "positive", "negative", "neutral" };
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    protected override void OnParametersSet()
    {
        ContentSession?.Register(Save);
        if (_saving || _loadedSectionId == Section.Id) return;
        _loadedSectionId = Section.Id;
        _columns = Section.Columns ?? 3; _layout = string.IsNullOrWhiteSpace(Section.Layout) ? "cards" : Section.Layout;
        _autoplay = Section.Autoplay ?? false; _showArrows = Section.ShowArrows ?? true; _showDots = Section.ShowDots ?? true;
        _title = new(Section.SectionTitle ?? new());
        _items = Section.CarouselItems?.OrderBy(item => item.Order).Select((item, index) => new CarouselItemModel
        {
            Id = string.IsNullOrWhiteSpace(item.Id) ? ClientId() : item.Id, Tag = new(item.Tag ?? new()), Title = new(item.Title ?? new()),
            Description = new(item.Description ?? new()), LinkHref = item.LinkHref, ImageUrl = item.ImageUrl,
            ImagePlacement = MediaPlacementModelMapper.Clone(item.ImagePlacement),
            Metrics = item.Metrics?.OrderBy(metric => metric.Order).Select((metric, metricIndex) => new CarouselMetricModel
            {
                Id = string.IsNullOrWhiteSpace(metric.Id) ? MetricId() : metric.Id, Value = new(metric.Value ?? new()), Label = new(metric.Label ?? new()),
                Tone = string.IsNullOrWhiteSpace(metric.Tone) ? "positive" : metric.Tone, Order = metricIndex
            }).ToList() ?? new(), Visible = item.Visible, Order = index
        }).ToList() ?? new();
    }

    private void AddItem()
    {
        var item = new CarouselItemModel { Id = ClientId(), Tag = new(), Title = new(), Description = new(), Metrics = new(), Visible = true, Order = _items.Count };
        _items.Add(item); _slidesExpanded = true; _openItemId = item.Id; ContentSession?.MarkDirty();
    }
    private void RemoveItem(CarouselItemModel item) { _items.Remove(item); NormalizeOrder(); if (_openItemId == item.Id) _openItemId = null; ContentSession?.MarkDirty(); }
    private void SetVisible(CarouselItemModel item, bool value) { item.Visible = value; ContentSession?.MarkDirty(); }
    private void ToggleItem(string id) => _openItemId = _openItemId == id ? null : id;
    private void ToggleMetrics(string id, bool expanded) => _openMetricsItemId = expanded ? id : null;
    private Task ReorderItems(List<string> ids)
    {
        var byId = _items.ToDictionary(item => item.Id, StringComparer.Ordinal);
        if (ids.Count != _items.Count || ids.Any(id => !byId.ContainsKey(id))) return Task.CompletedTask;
        _items = ids.Select(id => byId[id]).ToList(); NormalizeOrder(); ContentSession?.MarkDirty(); return Task.CompletedTask;
    }
    private void NormalizeOrder() { for (var index = 0; index < _items.Count; index++) _items[index].Order = index; }
    private static string ClientId() => $"slide-{Guid.NewGuid():N}";
    private static string MetricId() => $"metric-{Guid.NewGuid():N}";
    private string ItemTitle(CarouselItemModel item, int number) => Localized(item.Title, $"Slide {number}");
    private string ItemSummary(CarouselItemModel item) => Localized(item.Tag, Localized(item.Description, "No description"));
    private string Localized(Dictionary<string, string>? values, string fallback) => values is not null && values.TryGetValue(AdminLanguage, out var value) && !string.IsNullOrWhiteSpace(value) ? value : values?.Values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? fallback;

    private void AddMetric(CarouselItemModel item)
    {
        item.Metrics ??= new(); item.Metrics.Add(new CarouselMetricModel { Id = MetricId(), Value = new(), Label = new(), Tone = "positive", Order = item.Metrics.Count });
        _openMetricsItemId = item.Id; ContentSession?.MarkDirty();
    }
    private void RemoveMetric(CarouselItemModel item, CarouselMetricModel metric) { item.Metrics?.Remove(metric); if (item.Metrics is not null) for (var i = 0; i < item.Metrics.Count; i++) item.Metrics[i].Order = i; ContentSession?.MarkDirty(); }
    private void ChangeLayout(string? value)
    {
        var normalized = string.IsNullOrWhiteSpace(value) ? "cards" : value;
        if (string.Equals(_layout, normalized, StringComparison.Ordinal)) return;
        _layout = normalized;
        ContentSession?.MarkDirty();
    }

    private async Task OnItemImageSelected(InputFileChangeEventArgs args, CarouselItemModel item)
    {
        var res = await DirectUploads.UploadInputAsync(
            ItemImageUploadId(item),
            "image",
            uploadContext: ResourceUploadContextCodes.ContentSectionCarousel);
        if (res.Success && res.Data is not null) { item.ImageUrl = res.Data.Url; item.ImagePlacement = MediaCropEditor.DefaultPlacement(); ContentSession?.MarkDirty(); Http.Notify(T("NotificationImageUploaded"), res.StatusCode); }
        else Http.Notify(res, failureFallback: T("NotificationImageUploadFailed"));
    }
    private void ClearItemImage(CarouselItemModel item) { item.ImageUrl = string.Empty; item.ImagePlacement = null; ContentSession?.MarkDirty(); }
    private static string ItemImageUploadId(CarouselItemModel item) => $"carousel-image-{item.Id}";
    private void SetImagePlacement(CarouselItemModel item, MediaPlacementModel? value) { item.ImagePlacement = MediaPlacementModelMapper.Clone(value); ContentSession?.MarkDirty(); }
    private void OpenResourcePicker(CarouselItemModel item) { _resourcePickerItem = item; _resourcePickerOpen = true; }
    private void CloseResourcePicker() { _resourcePickerOpen = false; _resourcePickerItem = null; }
    private void SelectResourceImage(ManagedResourceModel resource) { if (_resourcePickerItem is not null) { _resourcePickerItem.ImageUrl = resource.Url; _resourcePickerItem.ImagePlacement = MediaCropEditor.DefaultPlacement(); ContentSession?.MarkDirty(); } }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var res = await SectionService.UpdateAsync(PageId, Section.Id, new CarouselSectionUpdateDto
            {
                SectionTitle = _title, Layout = _layout, Columns = _columns, Autoplay = _autoplay, ShowDots = _showDots, ShowArrows = _showArrows,
                Items = _items.OrderBy(item => item.Order).Select(MapItem).ToList(), Visible = Section.Visible
            });
            Http.Notify(res);
            if (res.Success) await OnSaved.InvokeAsync();
        }
        finally { _saving = false; }
    }
    private static CarouselItemDto MapItem(CarouselItemModel item) => new()
    {
        Tag = item.Tag ?? new(), Title = item.Title ?? new(), Description = item.Description ?? new(), ImageUrl = item.ImageUrl, ImagePlacement = MediaPlacementModelMapper.ToAdmin(item.ImagePlacement), LinkHref = item.LinkHref,
        Metrics = item.Metrics?.OrderBy(metric => metric.Order).Select((metric, index) => new CarouselMetricDto
        {
            Value = metric.Value ?? new(), Label = metric.Label ?? new(), Tone = string.IsNullOrWhiteSpace(metric.Tone) ? "positive" : metric.Tone, Order = index
        }).ToList() ?? new(), Visible = item.Visible, Order = item.Order
    };
}
