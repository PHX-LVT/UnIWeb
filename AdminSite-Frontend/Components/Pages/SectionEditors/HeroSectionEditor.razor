@inject AdminSectionService SectionService
@inject IHttpService Http
@inject AdminFormSubmissionService FormService

<section class="ez-content-editor__text">
    <h3>@T("SectionText")</h3>
    <div class="form-group"><label class="form-label">@T("Eyebrow")</label><LangField @bind-Value="_eyebrow" Languages="Languages" /></div>
    <div class="form-group"><label class="form-label">@T("Heading")</label><LangField @bind-Value="_heading" Languages="Languages" /></div>
    <div class="form-group"><label class="form-label">@T("Subheading")</label><LangField @bind-Value="_subheading" Languages="Languages" Multiline="true" /></div>
</section>

<ContentEditorGroup Title="@T("BannerLayout")" Summary="@_layout" @bind-Expanded="_layoutExpanded">
<div class="ez-content-editor__settings">
<div class="form-group">
    <label class="form-label">@T("Layout")</label>
    <DxComboBox Data="_layouts" Value="_layout" ValueChanged="@((string? value) => ChangeLayout(value))" CssClass="w-100" />
</div>

<div class="form-group">
    <label class="form-label">@T("HeadingSize")</label>
    <DxComboBox Data="_sizes" @bind-Value="_headingSize" CssClass="w-100" />
</div>

<div class="form-group">
    <label class="form-label">@T("ContentAlignment")</label>
    <DxComboBox Data="_alignments" @bind-Value="_alignment" CssClass="w-100" />
</div>
</div>
</ContentEditorGroup>

<ContentEditorGroup Title="@T("Media")" Summary="@(string.IsNullOrWhiteSpace(_imageUrl) ? T("NoImage") : T("ImageSelected"))" @bind-Expanded="_mediaExpanded">
<div class="form-group">
    <label class="form-label">@T("HeroImage")</label>
    @if (!string.IsNullOrEmpty(_imageUrl))
    {
        <div class="media-crop-inline-selection">
            <div class="media-crop-inline-preview" style="@ImagePreviewStyle">
                <img src="@_imageUrl" alt="" />
            </div>
            <button type="button" class="btn-admin btn-ghost" @onclick="RemoveImage">
                <i class="fas fa-times"></i> @T("Remove")
            </button>
        </div>
    }
    <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
        <InputFile id="hero-section-image-upload"
                   OnChange="OnImageSelected"
                   accept="image/*"
                   style="display:none" />
        <label class="btn-admin btn-ghost" for="hero-section-image-upload">
            <i class="fas fa-image"></i> @T("UploadNew")
        </label>
        <button type="button" class="btn-admin btn-ghost" @onclick="OpenResourcePicker">
            <i class="fas fa-photo-film"></i> @T("ChooseFromResourceLibrary")
        </button>
        @if (!string.IsNullOrWhiteSpace(_imageUrl))
        {
            <button type="button" class="btn-admin btn-ghost" @onclick="OpenCropEditor">
                <i class="fas fa-crop-simple"></i> @T("AdjustCrop")
            </button>
        }
    </div>
</div>
</ContentEditorGroup>

<ResourcePickerModal Open="_resourcePickerOpen"
                     Kind="image"
                     ResourceSelected="SelectResourceImage"
                     Closed="CloseResourcePicker" />

<MediaCropEditor Open="_cropEditorOpen"
                 ImageUrl="@(_imageUrl ?? string.Empty)"
                 Value="_imagePlacement"
                 Title="@T("AdjustHeroImage")"
                 DesktopAspectRatio="@(4d / 3d)"
                 MobileAspectRatio="@(4d / 3d)"
                 RecommendedWidth="960"
                 RecommendedMobileWidth="750"
                 MinimumWidth="480"
                 MinimumMobileWidth="375"
                 Applied="ApplyImagePlacement"
                 Closed="CloseCropEditor" />

<ContentEditorGroup Title="@T("Actions")" Summary="@($"{_buttons.Count} buttons")" @bind-Expanded="_actionsExpanded">
    <ContentSortableList Reordered="ReorderButtons">
    @foreach (var (btn, i) in _buttons.Select((b, i) => (b, i)))
    {
        <ContentItemAccordion @key="btn.Id" ItemId="@btn.Id" Number="@(i + 1)" Title="@ButtonTitle(btn, i + 1)" Summary="@btn.Action"
                              Visible="@btn.Visible" VisibleChanged="value => SetButtonVisible(btn, value)"
                              Expanded="@(_openButtonId == btn.Id)" OnToggle="() => ToggleButton(btn.Id)" OnDelete="() => RemoveButton(btn)">
        <div class="section-button-editor">
            <div class="section-button-cell section-button-cell--label">
                <span class="section-button-cell__label">@T("Label")</span>
                <LangField Value="@(btn.Label ?? new())"
                           ValueChanged="@(v => btn.Label = v)"
                           Languages="Languages"
                           NullText="@T("ButtonLabel")" />
            </div>
            <ButtonActionFields @bind-Action="btn.Action"
                                @bind-Href="btn.Href"
                                @bind-FormDefinitionId="btn.FormDefinitionId"
                                FormDefinitions="_formDefinitions"
                                AdminLanguage="AdminLanguage" />
            <div class="section-button-editor__footer">
                <div class="section-button-cell">
                    <span class="section-button-cell__label">@T("Style")</span>
                    <DxComboBox Data="_btnStyles" @bind-Value="btn.Style"
                                CssClass="w-100" />
                </div>
            </div>
        </div>
        </ContentItemAccordion>
    }
    </ContentSortableList>
    @if (_buttons.Count < 4)
    {
        <button class="btn-admin btn-outline"
                @onclick="AddButton">
            <i class="fas fa-plus"></i> @T("AddButton")
        </button>
    }
</ContentEditorGroup>

<style>
    .section-button-editor {
        display: grid;
        grid-template-columns: 1fr;
        gap: .55rem;
        align-items: stretch;
        margin-bottom: .6rem;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: .6rem;
    }

    .section-button-editor__footer {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 42px;
        gap: .5rem;
        align-items: end;
    }

    .section-button-cell {
        min-width: 0;
        display: grid;
        gap: 6px;
    }

    .section-button-cell__label {
        min-height: 18px;
        font-size: .75rem;
        color: var(--text-muted);
    }

    .section-button-editor .btn-danger {
        min-width: 42px;
        width: 42px;
        padding-inline: 0;
        justify-content: center;
        align-self: end;
    }

    @@media (max-width: 720px) {
        .section-button-editor {
            grid-template-columns: 1fr;
        }

        .section-button-editor__footer {
            grid-template-columns: 1fr;
        }

        .section-button-editor .btn-danger {
            width: 100%;
        }
    }
</style>

@code {
    [Parameter] public SectionModel  Section   { get; set; } = new();
    [Parameter] public string        PageId    { get; set; } = string.Empty;
    [Parameter] public List<string>  Languages { get; set; } = new() { "en" };
    [Parameter] public EventCallback OnSaved   { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";
    [CascadingParameter] public SectionContentEditSession? ContentSession { get; set; }

    private string   _layout      = "centered";
    private string   _headingSize = "large";
    private string   _alignment   = "center";
    private string?  _imageUrl;
    private MediaPlacementModel _imagePlacement = MediaCropEditor.DefaultPlacement();
    private Dictionary<string, string> _eyebrow    = new();
    private Dictionary<string, string> _heading    = new();
    private Dictionary<string, string> _subheading = new();
    private List<SectionButtonModel>   _buttons    = new();
    private bool _saving;
    private string? _loadedSectionId;
    private bool _resourcePickerOpen;
    private bool _cropEditorOpen;
    private List<FormDefinitionModel> _formDefinitions = new();
    private bool _layoutExpanded;
    private bool _mediaExpanded;
    private bool _actionsExpanded;
    private string? _openButtonId;

    private List<string> _layouts = new() { "centered", "split-left", "split-right", "compact" };
    private List<string> _sizes = new() { "small", "medium", "large", "xl" };
    private List<string> _alignments = new() { "left","center","right" };
    private List<string> _btnStyles = new() { "filled", "outline", "ghost" };
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    protected override async Task OnInitializedAsync()
    {
        var forms = await FormService.GetDefinitionsAsync();
        _formDefinitions = forms.Data ?? new();
    }

    protected override void OnParametersSet()
    {
        ContentSession?.Register(Save);
        if (_saving || _loadedSectionId == Section.Id) return;
        _loadedSectionId = Section.Id;

        _layout       = Section.Layout       ?? "centered";
        _headingSize  = Section.HeadingSize  ?? "large";
        _alignment    = Section.ContentAlignment ?? "center";
        _imageUrl = Section.ImageUrl;
        _imagePlacement = MediaCropEditor.Normalize(MediaCropEditor.Clone(Section.ImagePlacement));
        _eyebrow      = new(Section.Eyebrow    ?? new());
        _heading      = new(Section.Heading    ?? new());
        _subheading   = new(Section.Subheading ?? new());
        _buttons      = Section.Buttons?.Select(b => new SectionButtonModel
        {
            Id = string.IsNullOrWhiteSpace(b.Id) ? ButtonId() : b.Id, Label = b.Label, Action = NormalizeButtonAction(b.Action), Href = b.Href,
            FormDefinitionId = b.FormDefinitionId, Style = b.Style, Visible = b.Visible, Order = b.Order
        }).ToList() ?? new();
    }

    private void AddButton()
    {
        var button = new SectionButtonModel { Id = ButtonId(), Label = new() { ["en"] = "Learn More" }, Action = "linkToPage", Style = "filled", Visible = true, Order = _buttons.Count };
        _buttons.Add(button);
        _actionsExpanded = true;
        _openButtonId = button.Id;
        ContentSession?.MarkDirty();
    }

    private void RemoveButton(SectionButtonModel button)
    {
        _buttons.Remove(button);
        for (var index = 0; index < _buttons.Count; index++) _buttons[index].Order = index;
        ContentSession?.MarkDirty();
    }

    private void ToggleButton(string id) => _openButtonId = _openButtonId == id ? null : id;
    private void ChangeLayout(string? value)
    {
        var normalized = string.IsNullOrWhiteSpace(value) ? "centered" : value;
        if (string.Equals(_layout, normalized, StringComparison.Ordinal)) return;
        _layout = normalized;
        ContentSession?.MarkDirty();
    }
    private void SetButtonVisible(SectionButtonModel button, bool visible) { button.Visible = visible; ContentSession?.MarkDirty(); }
    private Task ReorderButtons(List<string> orderedIds)
    {
        var byId = _buttons.ToDictionary(button => button.Id, StringComparer.Ordinal);
        if (orderedIds.Count != _buttons.Count || orderedIds.Any(id => !byId.ContainsKey(id))) return Task.CompletedTask;
        _buttons = orderedIds.Select(id => byId[id]).ToList();
        for (var index = 0; index < _buttons.Count; index++) _buttons[index].Order = index;
        ContentSession?.MarkDirty();
        return Task.CompletedTask;
    }
    private string ButtonTitle(SectionButtonModel button, int number) => button.Label?.GetValueOrDefault(AdminLanguage) is { Length: > 0 } value ? value : button.Label?.Values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? $"Button {number}";
    private static string ButtonId() => $"button-{Guid.NewGuid():N}";

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 5 * 1024 * 1024) return;

        var res = await Http.PostFileAsync<AssetUploadModel>("api/admin/assets/upload?folder=hero", file, maxBytes: 5 * 1024 * 1024);
        if (res.Success && res.Data is not null)
        {
            _imageUrl = res.Data.Url;
            _imagePlacement = MediaCropEditor.DefaultPlacement();
            _cropEditorOpen = true;
            ContentSession?.MarkDirty();
            Http.Notify(T("NotificationImageUploaded"), res.StatusCode);
        }
        else
        {
            Http.Notify(res.Message ?? T("NotificationImageUploadFailed"), res.StatusCode);
        }
    }

    private void RemoveImage()
    {
        _imageUrl = string.Empty;
        _imagePlacement = MediaCropEditor.DefaultPlacement();
        _cropEditorOpen = false;
        ContentSession?.MarkDirty();
    }

    private void OpenResourcePicker()
    {
        _resourcePickerOpen = true;
    }

    private void CloseResourcePicker()
    {
        _resourcePickerOpen = false;
    }

    private void SelectResourceImage(ManagedResourceModel resource)
    {
        _imageUrl = resource.Url;
        _imagePlacement = MediaCropEditor.DefaultPlacement();
        _resourcePickerOpen = false;
        _cropEditorOpen = true;
        ContentSession?.MarkDirty();
    }

    private void OpenCropEditor() => _cropEditorOpen = !string.IsNullOrWhiteSpace(_imageUrl);
    private void CloseCropEditor() => _cropEditorOpen = false;

    private void ApplyImagePlacement(MediaPlacementModel placement)
    {
        var normalized = MediaCropEditor.Normalize(MediaCropEditor.Clone(placement));
        if (PlacementEquals(_imagePlacement, normalized)) return;
        _imagePlacement = normalized;
        ContentSession?.MarkDirty();
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var dto = new HeroSectionUpdateDto
            {
                Layout = _layout,
                HeadingSize = _headingSize,
                ContentAlignment = _alignment,
                Eyebrow = _eyebrow,
                Heading = _heading,
                Subheading = _subheading,
                ImageUrl = _imageUrl,
                ImagePlacement = ToDto(_imagePlacement),
                Buttons = _buttons.Select(MapButton).ToList(),
                Visible = Section.Visible
            };
            var res = await SectionService.UpdateAsync(PageId, Section.Id, dto);
            Http.Notify(res.Message, res.StatusCode);
            if (res.Success) await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private static string NormalizeButtonAction(string? action) => IsOpenFormAction(action) ? "openForm" : "linkToPage";

    private static bool IsOpenFormAction(string? action) =>
        string.Equals(action, "openForm", StringComparison.OrdinalIgnoreCase)
        || string.Equals(action, "OpenForm", StringComparison.OrdinalIgnoreCase)
        || string.Equals(action, "OpenModal", StringComparison.OrdinalIgnoreCase);

    private static SectionButtonDto MapButton(SectionButtonModel button) => new()
    {
        Label = button.Label ?? new(),
        Action = NormalizeButtonAction(button.Action),
        Href = IsOpenFormAction(button.Action) ? null : button.Href,
        FormDefinitionId = IsOpenFormAction(button.Action) ? button.FormDefinitionId : null,
        Style = button.Style ?? "filled",
        Visible = button.Visible,
        Order = button.Order
    };

    private string ImagePreviewStyle => FormattableString.Invariant($"--media-crop-x:{_imagePlacement.FocalPointX:0.##}%;--media-crop-y:{_imagePlacement.FocalPointY:0.##}%;--media-crop-zoom:{_imagePlacement.Zoom:0.###};--media-crop-fit:{_imagePlacement.Fit}");

    private static MediaPlacementDto ToDto(MediaPlacementModel value) => new()
    {
        Fit = value.Fit,
        FocalPointX = value.FocalPointX,
        FocalPointY = value.FocalPointY,
        Zoom = value.Zoom,
        UseMobileOverride = value.UseMobileOverride,
        MobileFocalPointX = value.MobileFocalPointX,
        MobileFocalPointY = value.MobileFocalPointY,
        MobileZoom = value.MobileZoom
    };

    private static bool PlacementEquals(MediaPlacementModel left, MediaPlacementModel right) =>
        left.Fit == right.Fit
        && Math.Abs(left.FocalPointX - right.FocalPointX) < .001
        && Math.Abs(left.FocalPointY - right.FocalPointY) < .001
        && Math.Abs(left.Zoom - right.Zoom) < .001
        && left.UseMobileOverride == right.UseMobileOverride
        && NullableEquals(left.MobileFocalPointX, right.MobileFocalPointX)
        && NullableEquals(left.MobileFocalPointY, right.MobileFocalPointY)
        && NullableEquals(left.MobileZoom, right.MobileZoom);

    private static bool NullableEquals(double? left, double? right) =>
        left is null && right is null || left is not null && right is not null && Math.Abs(left.Value - right.Value) < .001;
}

