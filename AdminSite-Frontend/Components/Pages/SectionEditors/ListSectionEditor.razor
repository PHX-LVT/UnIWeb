@inject AdminSectionService SectionService
@using Contracts.Admin
@inject IHttpService Http
@inject DirectResourceUploadService DirectUploads

<section class="ez-content-editor__text">
    <h3>@T("SectionText")</h3>
    <div class="form-group"><label class="form-label">@T("SectionTitle")</label><LangField @bind-Value="_title" Languages="Languages" /></div>
</section>

<ContentEditorGroup Title="@T("Items")" Summary="@($"{_items.Count} items · {_layout}")" @bind-Expanded="_itemsExpanded">
    <div class="ez-content-editor__settings">
        <div class="form-group"><label class="form-label">@T("Layout")</label><DxComboBox Data="_layouts" Value="_layout" ValueChanged="@((string? value) => ChangeLayout(value))" CssClass="w-100" /></div>
        <div class="form-group"><label class="form-label">@T("Columns")</label><DxSpinEdit @bind-Value="_columns" MinValue="1" MaxValue="4" CssClass="w-100" /></div>
        <label class="form-group ez-content-check"><span class="form-label">@T("Icons")</span><span><DxCheckBox @bind-Checked="_showIcon" /> @T("ShowIcons")</span></label>
    </div>

    <ContentSortableList Reordered="ReorderItems">
        @foreach (var item in _items.OrderBy(item => item.Order))
        {
            var number = item.Order + 1;
            var uploadId = ItemImageUploadId(item);
            <ContentItemAccordion @key="item.Id" ItemId="@item.Id" Number="@number" Title="@ItemTitle(item, number)"
                                  Summary="@ItemSummary(item)" Expanded="@(_openItemId == item.Id)" OnToggle="() => ToggleItem(item.Id)"
                                  OnDelete="() => RemoveItem(item)" Visible="@item.Visible" VisibleChanged="value => SetVisible(item, value)">
                @if (_showIcon)
                {
                    <div class="form-group"><label class="form-label">@T("Icon")</label><IconPickerField Value="@(item.Icon ?? string.Empty)" ValueChanged="value => SetIconClass(item, value)" Visual="item.IconVisual" VisualChanged="value => SetIconVisual(item, value)" Label="@T("Icon")" /></div>
                }
                <div class="form-group"><label class="form-label">@T("Title")</label><LangField Value="@(item.Title ?? new())" ValueChanged="value => item.Title = value" Languages="Languages" /></div>
                <div class="form-group"><label class="form-label">@T("Description")</label><LangField Value="@(item.Description ?? new())" ValueChanged="value => item.Description = value" Languages="Languages" Multiline="true" /></div>
                <div class="form-group"><label class="form-label">@T("LinkUrl")</label><DxTextBox @bind-Text="item.LinkHref" CssClass="w-100" NullText="/page or https://example.com" /></div>
                <div class="form-group">
                    <label class="form-label">@T("Image")</label>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <div class="ez-content-media-preview"><img src="@item.ImageUrl" alt="" /><button type="button" class="btn-admin btn-ghost" @onclick="() => ClearItemImage(item)"><i class="fas fa-times"></i> @T("Remove")</button></div>
                    }
                    <div class="ez-content-media-actions">
                        <InputFile id="@uploadId" OnChange="args => OnItemImageSelected(args, item)" accept="image/*" style="display:none" />
                        <label class="btn-admin btn-ghost" for="@uploadId"><i class="fas fa-image"></i> @T("UploadNew")</label>
                        <button type="button" class="btn-admin btn-ghost" @onclick="() => OpenResourcePicker(item)"><i class="fas fa-photo-film"></i> @T("ChooseFromResourceLibrary")</button>
                        <MediaCropField ImageUrl="@(item.ImageUrl ?? string.Empty)" Value="item.ImagePlacement" ValueChanged="value => SetImagePlacement(item, value)" AspectRatio="@(16d / 10d)" />
                    </div>
                </div>
            </ContentItemAccordion>
        }
    </ContentSortableList>
    <button type="button" class="btn-admin btn-outline ez-content-add" @onclick="AddItem"><i class="fas fa-plus"></i> @T("AddItem")</button>
</ContentEditorGroup>

<ResourcePickerModal Open="_resourcePickerOpen" Kind="image" ResourceSelected="SelectResourceImage" Closed="CloseResourcePicker" />

@code {
    [Parameter] public SectionModel Section { get; set; } = new();
    [Parameter] public string PageId { get; set; } = string.Empty;
    [Parameter] public List<string> Languages { get; set; } = new() { "en" };
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";
    [CascadingParameter] public SectionContentEditSession? ContentSession { get; set; }

    private string _layout = "cards";
    private int _columns = 3;
    private bool _showIcon = true;
    private Dictionary<string, string> _title = new();
    private List<ListItemModel> _items = new();
    private readonly List<string> _layouts = new() { "cards", "rows", "numbered" };
    private bool _saving;
    private bool _itemsExpanded;
    private string? _openItemId;
    private string? _loadedSectionId;
    private bool _resourcePickerOpen;
    private ListItemModel? _resourcePickerItem;
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    protected override void OnParametersSet()
    {
        ContentSession?.Register(Save);
        if (_saving || _loadedSectionId == Section.Id) return;
        _loadedSectionId = Section.Id;
        _layout = Section.Layout ?? "cards";
        _columns = Section.Columns ?? 3;
        _showIcon = Section.ShowIcon ?? true;
        _title = new(Section.SectionTitle ?? new());
        _items = Section.Items?.OrderBy(item => item.Order).Select((item, index) => new ListItemModel
        {
            Id = string.IsNullOrWhiteSpace(item.Id) ? ClientId() : item.Id,
            Icon = item.Icon,
            IconVisual = CopyIcon(item.IconVisual),
            Visible = item.Visible,
            Order = index,
            Title = new(item.Title ?? new()),
            Description = new(item.Description ?? new()),
            ImageUrl = item.ImageUrl,
            ImagePlacement = MediaPlacementModelMapper.Clone(item.ImagePlacement),
            LinkHref = item.LinkHref
        }).ToList() ?? new();
    }

    private void AddItem()
    {
        var item = new ListItemModel { Id = ClientId(), Visible = true, Order = _items.Count, Title = new(), Description = new() };
        _items.Add(item); _itemsExpanded = true; _openItemId = item.Id; ContentSession?.MarkDirty();
    }
    private void RemoveItem(ListItemModel item) { _items.Remove(item); NormalizeOrder(); if (_openItemId == item.Id) _openItemId = null; ContentSession?.MarkDirty(); }
    private void SetVisible(ListItemModel item, bool value) { item.Visible = value; ContentSession?.MarkDirty(); }
    private void SetIconClass(ListItemModel item, string value) { item.Icon = value; ContentSession?.MarkDirty(); }
    private void SetIconVisual(ListItemModel item, IconReferenceModel? value) { item.IconVisual = value; ContentSession?.MarkDirty(); }
    private void ToggleItem(string id) => _openItemId = _openItemId == id ? null : id;
    private Task ReorderItems(List<string> ids)
    {
        var byId = _items.ToDictionary(item => item.Id, StringComparer.Ordinal);
        if (ids.Count != _items.Count || ids.Any(id => !byId.ContainsKey(id))) return Task.CompletedTask;
        _items = ids.Select(id => byId[id]).ToList(); NormalizeOrder(); ContentSession?.MarkDirty(); return Task.CompletedTask;
    }
    private void NormalizeOrder() { for (var index = 0; index < _items.Count; index++) _items[index].Order = index; }
    private static string ClientId() => $"item-{Guid.NewGuid():N}";
    private void ChangeLayout(string? value)
    {
        var normalized = string.IsNullOrWhiteSpace(value) ? "cards" : value;
        if (string.Equals(_layout, normalized, StringComparison.Ordinal)) return;
        _layout = normalized;
        ContentSession?.MarkDirty();
    }
    private string ItemTitle(ListItemModel item, int number) => Localized(item.Title, $"Item {number}");
    private string ItemSummary(ListItemModel item) => Localized(item.Description, string.IsNullOrWhiteSpace(item.LinkHref) ? "No description" : item.LinkHref!);
    private string Localized(Dictionary<string, string>? values, string fallback) => values is not null && values.TryGetValue(AdminLanguage, out var value) && !string.IsNullOrWhiteSpace(value) ? value : values?.Values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? fallback;

    private async Task OnItemImageSelected(InputFileChangeEventArgs args, ListItemModel item)
    {
        var res = await DirectUploads.UploadInputAsync(
            ItemImageUploadId(item),
            "image",
            uploadContext: ResourceUploadContextCodes.ContentSectionListItem);
        if (res.Success && res.Data is not null) { item.ImageUrl = res.Data.Url; item.ImagePlacement = MediaCropEditor.DefaultPlacement(); ContentSession?.MarkDirty(); Http.Notify(T("NotificationImageUploaded"), res.StatusCode); }
        else Http.Notify(res, failureFallback: T("NotificationImageUploadFailed"));
    }
    private void ClearItemImage(ListItemModel item) { item.ImageUrl = string.Empty; item.ImagePlacement = null; ContentSession?.MarkDirty(); }
    private static string ItemImageUploadId(ListItemModel item) => $"list-item-image-upload-{item.Id}";
    private void SetImagePlacement(ListItemModel item, MediaPlacementModel? value) { item.ImagePlacement = MediaPlacementModelMapper.Clone(value); ContentSession?.MarkDirty(); }
    private void OpenResourcePicker(ListItemModel item) { _resourcePickerItem = item; _resourcePickerOpen = true; }
    private void CloseResourcePicker() { _resourcePickerOpen = false; _resourcePickerItem = null; }
    private void SelectResourceImage(ManagedResourceModel resource) { if (_resourcePickerItem is not null) { _resourcePickerItem.ImageUrl = resource.Url; _resourcePickerItem.ImagePlacement = MediaCropEditor.DefaultPlacement(); ContentSession?.MarkDirty(); } }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var res = await SectionService.UpdateAsync(PageId, Section.Id, new ListSectionUpdateDto
            {
                Layout = _layout, Columns = _columns, SectionTitle = _title, ShowIcon = _showIcon,
                Items = _items.OrderBy(item => item.Order).Select(MapItem).ToList(), Visible = Section.Visible
            });
            Http.Notify(res);
            if (res.Success) await OnSaved.InvokeAsync();
        }
        finally { _saving = false; }
    }

    private static ListItemDto MapItem(ListItemModel item) => new()
    {
        Id = item.Id, Icon = item.Icon ?? string.Empty, IconVisual = BlockUpdateDtoMapper.ToIconDto(item.IconVisual),
        Title = item.Title ?? new(), Description = item.Description ?? new(), ImageUrl = item.ImageUrl, ImagePlacement = MediaPlacementModelMapper.ToAdmin(item.ImagePlacement), LinkHref = item.LinkHref,
        Visible = item.Visible, Order = item.Order
    };
    private static IconReferenceModel? CopyIcon(IconReferenceModel? value) => value is null ? null : new()
    {
        SchemaVersion = value.SchemaVersion, Source = value.Source, ClassName = value.ClassName, ResourceId = value.ResourceId,
        ResourceSource = value.ResourceSource, Url = value.Url, StorageKey = value.StorageKey, FileName = value.FileName,
        ContentType = value.ContentType, SizeBytes = value.SizeBytes, AltText = new(value.AltText),
        Appearance = IconReferenceModelMapper.CloneAppearance(value.Appearance)
    };
}
