@inject AdminSectionService SectionService
@inject IHttpService Http

<section class="ez-content-editor__text">
    <h3>@T("SectionText")</h3>
    <div class="form-group"><label class="form-label">@T("SectionTitle")</label><LangField @bind-Value="_title" Languages="Languages" /></div>
</section>

<ContentEditorGroup Title="@T("Locations")" Summary="@($"{_pins.Count} locations")" @bind-Expanded="_locationsExpanded">
    <div class="ez-content-editor__settings">
        <div class="form-group"><label class="form-label">@T("CenterLatitude")</label><DxSpinEdit @bind-Value="_centerLat" CssClass="w-100" /></div>
        <div class="form-group"><label class="form-label">@T("CenterLongitude")</label><DxSpinEdit @bind-Value="_centerLng" CssClass="w-100" /></div>
        <div class="form-group"><label class="form-label">@T("DefaultZoom")</label><DxSpinEdit @bind-Value="_zoom" MinValue="1" MaxValue="18" CssClass="w-100" /></div>
    </div>

    <ContentSortableList Reordered="ReorderPins">
        @foreach (var pin in _pins.OrderBy(pin => pin.Order))
        {
            var number = pin.Order + 1;
            <ContentItemAccordion @key="pin.Id" ItemId="@pin.Id" Number="@number"
                                  Title="@(string.IsNullOrWhiteSpace(pin.Label) ? $"Location {number}" : pin.Label)"
                                  Summary="@($"{pin.Lat:0.####}, {pin.Lng:0.####}")"
                                  Expanded="@(_openPinId == pin.Id)" OnToggle="() => TogglePin(pin.Id)"
                                  OnDelete="() => RemovePin(pin)" Visible="@pin.Visible" VisibleChanged="value => SetVisible(pin, value)">
                <div class="form-group"><label class="form-label">@T("Label")</label><DxTextBox @bind-Text="pin.Label" CssClass="w-100" NullText="Head Office" /></div>
                <div class="ez-content-editor__settings">
                    <div class="form-group"><label class="form-label">@T("Latitude")</label><DxSpinEdit @bind-Value="pin.Lat" CssClass="w-100" /></div>
                    <div class="form-group"><label class="form-label">@T("Longitude")</label><DxSpinEdit @bind-Value="pin.Lng" CssClass="w-100" /></div>
                </div>
                <div class="form-group"><label class="form-label">@T("LinkUrl")</label><DxTextBox @bind-Text="pin.Href" CssClass="w-100" NullText="/contact or https://maps.example.com" /></div>
            </ContentItemAccordion>
        }
    </ContentSortableList>
    <button type="button" class="btn-admin btn-outline ez-content-add" @onclick="AddPin"><i class="fas fa-plus"></i> @T("AddPin")</button>
</ContentEditorGroup>

@code {
    [Parameter] public SectionModel Section { get; set; } = new();
    [Parameter] public string PageId { get; set; } = string.Empty;
    [Parameter] public List<string> Languages { get; set; } = new() { "en" };
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";
    [CascadingParameter] public SectionContentEditSession? ContentSession { get; set; }

    private Dictionary<string, string> _title = new();
    private double _centerLat;
    private double _centerLng;
    private int _zoom = 4;
    private List<NetworkMapPinModel> _pins = new();
    private bool _saving;
    private bool _locationsExpanded;
    private string? _openPinId;
    private string? _loadedSectionId;
    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    protected override void OnParametersSet()
    {
        ContentSession?.Register(Save);
        if (_saving || _loadedSectionId == Section.Id) return;
        _loadedSectionId = Section.Id;
        _title = new(Section.SectionTitle ?? new());
        _centerLat = Section.CenterLat ?? 15.87;
        _centerLng = Section.CenterLng ?? 100.99;
        _zoom = Section.DefaultZoom ?? 4;
        _pins = Section.MapPins?.OrderBy(pin => pin.Order).Select((pin, index) => new NetworkMapPinModel
        {
            Id = string.IsNullOrWhiteSpace(pin.Id) ? ClientId() : pin.Id,
            Label = pin.Label, Lat = pin.Lat, Lng = pin.Lng, Href = pin.Href, Visible = pin.Visible, Order = index
        }).ToList() ?? new();
    }

    private void AddPin()
    {
        var pin = new NetworkMapPinModel { Id = ClientId(), Lat = _centerLat, Lng = _centerLng, Visible = true, Order = _pins.Count };
        _pins.Add(pin); _locationsExpanded = true; _openPinId = pin.Id; ContentSession?.MarkDirty();
    }
    private void RemovePin(NetworkMapPinModel pin) { _pins.Remove(pin); NormalizeOrder(); if (_openPinId == pin.Id) _openPinId = null; ContentSession?.MarkDirty(); }
    private void SetVisible(NetworkMapPinModel pin, bool value) { pin.Visible = value; ContentSession?.MarkDirty(); }
    private void TogglePin(string id) => _openPinId = _openPinId == id ? null : id;
    private Task ReorderPins(List<string> ids)
    {
        var byId = _pins.ToDictionary(pin => pin.Id, StringComparer.Ordinal);
        if (ids.Count != _pins.Count || ids.Any(id => !byId.ContainsKey(id))) return Task.CompletedTask;
        _pins = ids.Select(id => byId[id]).ToList(); NormalizeOrder(); ContentSession?.MarkDirty(); return Task.CompletedTask;
    }
    private void NormalizeOrder() { for (var index = 0; index < _pins.Count; index++) _pins[index].Order = index; }
    private static string ClientId() => $"pin-{Guid.NewGuid():N}";

    private async Task Save()
    {
        _saving = true;
        try
        {
            var res = await SectionService.UpdateAsync(PageId, Section.Id, new NetworkMapSectionUpdateDto
            {
                SectionTitle = _title, CenterLat = _centerLat, CenterLng = _centerLng, DefaultZoom = _zoom,
                Pins = _pins.OrderBy(pin => pin.Order).Select(pin => new NetworkMapPinDto
                {
                    Label = pin.Label ?? string.Empty, Lat = pin.Lat, Lng = pin.Lng, Href = pin.Href, Visible = pin.Visible, Order = pin.Order
                }).ToList(), Visible = Section.Visible
            });
            Http.Notify(res.Message, res.StatusCode);
            if (res.Success) await OnSaved.InvokeAsync();
        }
        finally { _saving = false; }
    }
}
