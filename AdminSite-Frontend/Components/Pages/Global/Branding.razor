@page "/global/branding"
@using Contracts.Admin
@inject BrandingService BrandingService
@inject DirectResourceUploadService DirectUploads
@inject IHttpService Http

<GlobalWorkspaceHeader />

<div class="global-workspace-content">
<div class="page-header global-workspace-section-header">
    <h2 class="global-workspace-section-title"><i class="fas fa-paint-brush"></i> @T("Branding")</h2>
    <div class="page-actions">
        <button class="btn-admin btn-primary" @onclick="Save" disabled="@_saving">
            <i class="fas fa-save"></i> @(_saving ? T("Saving") : T("Save"))
        </button>
    </div>
</div>

<AdminInlineStatus TargetId="branding-load" Retry="Load" Retrying="_loading" RetryText="@T("Retry")" />

@if (_loading)
{
    <div class="admin-card" style="text-align:center;padding:2rem">
        <div class="spinner" style="margin:0 auto"></div>
    </div>
}
else if (_model is not null)
{
    <div class="admin-card">
        <div class="admin-card-title">@T("CompanyInfo")</div>

        <div class="form-group">
            <label class="form-label">@T("CompanyName")</label>
            <DxTextBox @bind-Text="_model.CompanyName" CssClass="w-100" />
        </div>

        <div class="form-group">
            <label class="form-label">@T("UrlOrSlug")</label>
            <DxTextBox @bind-Text="_model.Href" CssClass="w-100" NullText="https://yoursite.com" />
        </div>
    </div>

    <div class="admin-card">
        <div class="admin-card-title">@T("Logo")</div>

        @if (!string.IsNullOrEmpty(_model.LogoUrl))
        {
            <div style="margin-bottom:1rem">
                <img src="@_model.LogoUrl"
                     style="max-height:80px;border:1px solid var(--border);border-radius:6px;padding:6px" />
            </div>
            <button class="btn-admin btn-danger" type="button" @onclick="ClearLogo">
                <i class="fas fa-trash"></i> @T("DeleteLogo")
            </button>
        }

        <InputFile id="branding-logo-upload"
                   OnChange="OnLogoSelected"
                   accept=".png,.jpg,.jpeg,.webp,.gif"
                   disabled="@_uploadingLogo" />
        <div class="form-hint">@T("LogoUploadHint")</div>
    </div>
}
</div>

@code {
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";

    private BrandingModel? _model;
    private bool _loading = true;
    private bool _saving = false;
    private bool _uploadingLogo;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        Http.ClearInlineStatus("branding-load");
        _loading = true;
        var res = await BrandingService.GetAsync();
        if (res.Success && res.Data is not null)
            _model = res.Data;
        else
        {
            _model = null;
            Http.NotifyInline(res, "branding-load");
        }
        _loading = false;
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        if (_uploadingLogo) return;

        _uploadingLogo = true;
        try
        {
            var res = await DirectUploads.UploadInputAsync(
                "branding-logo-upload",
                "image",
                uploadContext: ResourceUploadContextCodes.BrandLogo);
            if (res.Success && res.Data is not null)
            {
                _model!.LogoUrl = res.Data.Url;
                Http.Notify(T("LogoUploaded"), res.StatusCode);
            }
            else
            {
                Http.Notify(res, failureFallback: T("LogoUploadFailed"));
            }
        }
        finally
        {
            _uploadingLogo = false;
            StateHasChanged();
        }
    }

    private void ClearLogo()
    {
        if (_model is null) return;
        _model.LogoUrl = string.Empty;
    }

    private async Task Save()
    {
        if (_model is null) return;
        _saving = true;
        StateHasChanged();
        var res = await BrandingService.UpdateAsync(_model);
        if (res.Data is not null) _model = res.Data;
        Http.Notify(res, T("BrandingSaved"));
        _saving = false;
        StateHasChanged();
    }

    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);
}
