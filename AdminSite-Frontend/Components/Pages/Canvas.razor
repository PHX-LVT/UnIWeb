@using SharedComponents.Helpers
@using Contracts.Admin
@using Microsoft.AspNetCore.Components.Web
@using AdminSite.Components.Pages.CanvasAuthoring
@inject IJSRuntime JS
@inject AdminSectionService SectionService
@inject AdminPageService PageService
@inject AdminBlockService BlockService
@inject IHttpService Http
@inject AdminLanguageService AdminLanguageState
@implements IAsyncDisposable

<div class="ez-canvas">

    <div class="ez-canvas__toolbar">
        <div class="ez-canvas__toolbar-left">
            <span class="ez-canvas__page-title">
                @PageTitle(ParentPage ?? Page)
            </span>
            <div class="ez-canvas__child-picker">
                <span class="form-hint">@T("ChildPage"):</span>
                <DxComboBox Data="@PageChoices"
                            Value="@Page.Id"
                            ValueChanged="@((string id) => SelectPage(id))"
                            TextFieldName="Label"
                            ValueFieldName="Id"
                            CssClass="ez-child-page-select" />
                <button class="btn-admin btn-ghost btn-sm"
                        @onclick="() => OnManageChildPages.InvokeAsync()">
                    <i class="fas fa-list"></i>
                    <span>@T("ManageChildPages")</span>
                </button>
            </div>
        </div>
        <div class="ez-canvas__toolbar-right">
            @if (IsInteractivePreview)
            {
                <div class="ez-canvas__device-switcher" role="group" aria-label="@T("PreviewViewport")">
                    <button type="button"
                            class="@PreviewViewportButtonClass("desktop")"
                            title="@T("Desktop")"
                            @onclick='() => SetPreviewViewport("desktop")'>
                        <i class="fas fa-desktop"></i><span>@T("Desktop")</span>
                    </button>
                    <button type="button"
                            class="@PreviewViewportButtonClass("tablet")"
                            title="@T("Tablet")"
                            @onclick='() => SetPreviewViewport("tablet")'>
                        <i class="fas fa-tablet-alt"></i><span>@T("Tablet")</span>
                    </button>
                    <button type="button"
                            class="@PreviewViewportButtonClass("mobile")"
                            title="@T("Mobile")"
                            @onclick='() => SetPreviewViewport("mobile")'>
                        <i class="fas fa-mobile-alt"></i><span>@T("Mobile")</span>
                    </button>
                </div>
            }
            @if (CanModify)
            {
                <button class="btn-admin btn-ghost" @onclick="OnAddSection">
                    <i class="fas fa-plus"></i>
                    <span>@T("AddSection")</span>
                </button>
                <button class="btn-admin btn-ghost"
                        title="@AddChildTitle"
                        disabled="@(!CanAddChildPage)"
                        @onclick="OnAddChildPage">
                    <i class="fas fa-sitemap"></i>
                    <span>@T("AddChildPage")</span>
                </button>
                @if (Page.Status == PageStatus.Published)
                {
                    <button class="btn-admin btn-ghost"
                            @onclick="ResetPage"
                            disabled="@(_resetting || _publishing)">
                        @if (_resetting)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>@T("Resetting")</span>
                        }
                        else
                        {
                            <i class="fas fa-undo"></i>
                            <span>@T("Reset")</span>
                        }
                    </button>
                }
                <button class="btn-admin btn-primary"
                        @onclick="PublishPage"
                        disabled="@(_publishing || _resetting)">
                    @if (_publishing)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>@T("Publishing")</span>
                    }
                    else
                    {
                        <i class="fas fa-globe"></i>
                        <span>@T("Publish")</span>
                    }
                </button>
                @if (IsChildPage)
                {
                    <button class="btn-admin btn-ghost" title="Child page settings"
                            @onclick="() => OnOpenPageSettings.InvokeAsync(Page)">
                        <i class="fas fa-cog"></i>
                    </button>
                    <button class="btn-admin btn-ghost btn-danger" title="Delete child page"
                            @onclick="() => OnDeletePage.InvokeAsync(Page)">
                        <i class="fas fa-trash"></i>
                    </button>
                }
            }
        </div>
    </div>

    <div class="ez-canvas__feedback-row">
        <AdminInlineStatus TargetId="canvas-authoring" />
    </div>

    <CanvasArrangeToolbar Visible="CanArrange"
                          SelectionCount="_selectedBlockIds.Count"
                          SelectedLabel="@SelectedBlockLabel"
                          ActiveSectionLabel="@ActiveArrangeSectionLabel"
                          SelectedIds="_selectedBlockIds"
                          BlockItems="BlockSelectorItems"
                          VisualState="SelectedVisualState"
                          CanVisualEdit="CanEditVisualSelection"
                          CanStaggerSelection="CanStaggerAnimationSelection"
                          CanContinuousSelection="CanContinuousAnimationSelection"
                          CanDelete="CanDeleteSelection"
                          DeletingContainer="SelectionIncludesContainer"
                          DeleteDescendantCount="SelectedContainerDescendantCount"
                          DeleteNestedContainerCount="SelectedNestedContainerCount"
                          Busy="@ArrangeAuthoringBusy"
                          Breadcrumbs="SelectionBreadcrumbs"
                          CanAdd="ArrangeCreateHasCapacity"
                          AddTitle="@ArrangeAddTitle"
                          AddRequested="OpenArrangeBlockWizard"
                          DoneRequested="ExitArrangeBlocks"
                          BlockSelected="SelectBlockFromToolbar"
                          BlocksReordered="ReorderBlocksFromToolbar"
                          VisualChanged="ApplyToolbarVisualUpdate"
                          ShapePreviewChanged="PreviewToolbarShape"
                          VisualPreviewCancelled="RestoreToolbarVisualPreview"
                          RotationPreviewChanged="PreviewToolbarRotation"
                          RotationCommitted="CommitToolbarRotation"
                          DeleteRequested="DeleteArrangeSelection"
                          Command="RunAuthoringCommand"
                          BreadcrumbSelected="SelectBreadcrumb" />

    <div class="ez-canvas__viewport @(IsInteractivePreview ? "ez-canvas__viewport--interactive-preview" : "")">

        <div class="ez-canvas__preview-shell @(CanArrange ? "ez-canvas__preview-shell--arrange" : "") @(IsInteractivePreview ? "ez-canvas__preview-shell--interactive-preview" : "")"
             style="@PreviewShellStyle">
            <div class="ez-canvas__preview-scale"
                 style="@PreviewScaleStyle">

                <iframe id="ez-preview-iframe"
                        @key="PreviewUrl"
                        src="@PreviewUrl"
                        style="@PreviewIframeStyle"
                        scrolling="@PreviewIframeScrolling" />

                @if (!Sections.Any())
                {
                    <div class="ez-canvas-empty">
                        <i class="fas fa-layer-group"></i>
                        <strong>@T("NoSectionsYet")</strong>
                        <span>@T("AddSectionToStart")</span>
                    </div>
                }
                else if (!IsInteractivePreview && !_sectionPositions.Any())
                {
                    <div class="ez-canvas-empty ez-canvas-empty--loading">
                        <i class="fas fa-spinner fa-spin"></i>
                        <strong>@T("LoadingPreview")</strong>
                        <span>@T("PreviewStuckHint")</span>
                    </div>
                }

                @if (CanModify || CanArrange)
                {
                    <div @ref="_overlayRef"
                         class="ez-canvas-arrange-overlay @(CanArrange ? "ez-canvas-arrange-overlay--active" : "")"
                         style="position: absolute; top: 0; left: 0;
                                width: 100%; height: 100%;
                                pointer-events: @(CanArrange ? "auto" : "none"); z-index: 10;"
                         @onclick="SelectArrangeCanvasBackground">

                        @foreach (var pos in _sectionPositions)
                        {
                            var section = Sections.FirstOrDefault(s => s.Id == pos.Id);
                            if (section is null) continue;

                            <div class="ez-section-overlay @(!section.Visible ? "ez-section-overlay--hidden" : "") @(string.Equals(_selectedSectionId, section.Id, StringComparison.Ordinal) ? "ez-section-overlay--selected" : "")"
                                 data-section-id="@(section.Id)"
                                 style="position: absolute;
                                        top: @(pos.Top)px;
                                        left: 0;
                                        width: 100%;
                                        height: @(pos.Height)px;
                                        pointer-events: none;">

                                @if (CanModify)
                                {
                                    <div class="ez-section-controls"
                                         style="pointer-events: auto; position: relative; z-index: 2;"
                                         @onclick:stopPropagation="true">
                                        <button class="ez-section-btn ez-section-handle" title="Drag to reorder">
                                            <i class="fas fa-grip-vertical"></i>
                                        </button>
                                        <span class="ez-section-label">@(section.Type)</span>
                                        <button class="ez-section-btn" title="@T("Edit")"
                                                @onclick="() => SelectSection(section)">
                                            <i class="fas fa-pencil-alt"></i>
                                        </button>
                                        <button class="ez-section-btn" title="@(section.Visible ? T("Hide") : T("Show"))"
                                                @onclick="() => ToggleVisibility(section)">
                                            <i class="fas @(section.Visible ? "fa-eye" : "fa-eye-slash")"></i>
                                        </button>
                                        <button class="ez-section-btn ez-section-btn--danger" title="@T("Delete")"
                                                @onclick="() => DeleteSection(section)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>

                                    <div style="position: absolute; inset: 0;
                                                pointer-events: auto; cursor: pointer; z-index: 1;"
                                         data-section-select-id="@(section.Id)"
                                         @onclick="() => SelectSection(section)">
                                    </div>
                                }
                                else if (CanArrange && IsArrangeCompatible(section) && !IsArrangeScopeSection(section.Id))
                                {
                                    <div class="ez-arrange-section ez-arrange-section--target"
                                         style="position: absolute; inset: 6px; pointer-events: auto; cursor: pointer; z-index: 1;"
                                         @onclick="() => TargetArrangeSection(section.Id)"
                                         @onclick:stopPropagation="true">
                                        <span class="ez-arrange-section__label">@ArrangeSectionDisplayName(section)</span>
                                    </div>
                                }
                            </div>
                        }

                        @if (CanArrange)
                        {
                            @foreach (var zone in _zonePositions)
                            {
                                var zoneSection = Sections.FirstOrDefault(s => s.Id == zone.SectionId);
                                if (zoneSection is null || !IsArrangeCompatible(zoneSection) ||
                                    !IsArrangeScopeSection(zone.SectionId)) continue;

                                <div class="ez-arrange-zone-overlay @(IsArrangeTargetZone(zone) ? "ez-arrange-zone-overlay--active" : null)"
                                     data-section-id="@zone.SectionId"
                                     data-zone-id="@zone.Id"
                                     data-zone-kind="@zone.Kind"
                                     @onclick="() => TargetArrangeZone(zone)"
                                     @onclick:stopPropagation="true"
                                     style="position: absolute;
                                            top: @(zone.Top)px;
                                            left: @(zone.Left)px;
                                            width: @(zone.Width)px;
                                            height: @(zone.Height)px;
                                            pointer-events: auto;
                                            cursor: pointer;
                                            z-index: 4;">
                                    <span class="ez-arrange-zone-overlay__label">
                                        @(zone.Kind == "column" ? T("ColumnZone") : T("CanvasZone"))
                                    </span>
                                    @if (string.Equals(zone.Kind, "column", StringComparison.OrdinalIgnoreCase) &&
                                         IsArrangeScopeSection(zone.SectionId))
                                    {
                                        <div class="ez-arrange-zone-workspace" @onclick:stopPropagation="true">
                                            <button type="button"
                                                    class="ez-arrange-zone-workspace__button"
                                                    title="@T("ShrinkWorkspace")"
                                                    aria-label="@T("ShrinkWorkspace")"
                                                    @onclick="() => ResizeArrangeZoneWorkspaceAsync(zone, -ArrangeColumnWorkspaceStepPx)">
                                                <i class="fas fa-minus"></i>
                                            </button>
                                            <span class="ez-arrange-zone-workspace__value">
                                                @ArrangeZoneWorkspaceHeight(zone)px
                                            </span>
                                            <button type="button"
                                                    class="ez-arrange-zone-workspace__button"
                                                    title="@T("ExpandWorkspace")"
                                                    aria-label="@T("ExpandWorkspace")"
                                                    @onclick="() => ResizeArrangeZoneWorkspaceAsync(zone, ArrangeColumnWorkspaceStepPx)">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            @foreach (var block in _blockPositions.Where(block => IsArrangeScopeSection(block.SectionId)))
                            {
                                var blockSection = Sections.FirstOrDefault(s => s.Id == block.SectionId);
                                var canSelectBlock = blockSection is not null && IsArrangeCompatible(blockSection) &&
                                    IsArrangeScopeSection(block.SectionId);
                                var canMoveBlock = canSelectBlock &&
                                    string.Equals(block.PositionMode, "freeform", StringComparison.OrdinalIgnoreCase);
                                var arrangeBlock = ArrangeBlock(block.Id);
                                var arrangeAppearance = EffectiveArrangeAppearance(arrangeBlock);
                                var blockShape = NormalizeAuthoringShape(arrangeAppearance?.Shape);
                                var blockRadius = NormalizeAuthoringRadius(
                                    !string.IsNullOrWhiteSpace(arrangeAppearance?.BorderRadius)
                                        ? arrangeAppearance.BorderRadius
                                        : arrangeBlock?.Layout?.BorderRadius);
                                var blockRotation = double.IsFinite(arrangeAppearance?.RotationDeg ?? 0)
                                    ? arrangeAppearance?.RotationDeg ?? 0
                                    : 0;
                                var geometryLocked = arrangeBlock?.Authoring?.GeometryLocked == true ||
                                                     arrangeBlock?.Authoring?.FullLocked == true;
                                canMoveBlock = canMoveBlock && !geometryLocked;

                                <div class="ez-freeform-block-overlay ez-freeform-block-overlay--shape-@blockShape ez-freeform-block-overlay--radius-@blockRadius @(block.Type == "container" ? "ez-freeform-block-overlay--container" : "") @(!canMoveBlock ? "ez-freeform-block-overlay--readonly" : "") @(_selectedBlockIds.Contains(block.Id) ? "ez-freeform-block-overlay--selected" : "") @(IsSelectionParent(block.Id) ? "ez-freeform-block-overlay--selection-parent" : "") @(geometryLocked ? "ez-freeform-block-overlay--locked" : "")"
                                     data-section-id="@block.SectionId"
                                     data-block-id="@block.Id"
                                     data-block-parent-id="@block.ParentBlockId"
                                     data-block-type="@block.Type"
                                     data-block-shape="@blockShape"
                                     data-block-radius="@blockRadius"
                                     data-block-rotation="@blockRotation"
                                     data-block-min-scale="@(block.Type == "form" ? "0.5" : null)"
                                     data-block-grow-section="@(block.Type == "form" ? "true" : null)"
                                     data-geometry-locked="@geometryLocked.ToString().ToLowerInvariant()"
                                     data-section-left="@block.SectionLeft"
                                     data-section-top="@block.SectionTop"
                                     data-section-width="@block.SectionWidth"
                                     data-section-height="@block.SectionHeight"
                                     style="position: absolute;
                                            top: @(block.Top)px;
                                            left: @(block.Left)px;
                                            width: @(block.Width)px;
                                            height: @(block.Height)px;
                                            --ez-block-rotation: @(blockRotation)deg;
                                            pointer-events: @(canSelectBlock ? "auto" : "none");
                                            z-index: @(5 + Math.Clamp(block.ZIndex, 0, 1000));"
                                     @onclick="eventArgs => SelectArrangeBlock(block, eventArgs)"
                                     @onclick:stopPropagation="true">
                                    @if (canMoveBlock)
                                    {
                                        <button type="button"
                                                class="ez-freeform-block-handle"
                                                @onclick:stopPropagation="true"
                                                title="Move block">
                                            <i class="fas fa-arrows-alt"></i>
                                        </button>
                                        <span class="ez-freeform-block-resize" @onclick:stopPropagation="true" title="Resize block"></span>
                                    }
                                    <div class="ez-freeform-block-titlebar @(canMoveBlock ? null : "ez-freeform-block-titlebar--readonly")">
                                        <span class="ez-freeform-block-label">@BlockDisplayLabel(block.Id)</span>
                                        <button type="button"
                                                class="ez-freeform-block-edit"
                                                title="@T("Edit")"
                                                aria-label="@T("Edit")"
                                                disabled="@(arrangeBlock is null || arrangeBlock.Authoring.FullLocked || arrangeBlock.Authoring.ContentLocked)"
                                                @onclick="() => OpenArrangeContentEditor(block.Id)"
                                                @onclick:stopPropagation="true">
                                            <i class="fas fa-pencil-alt"></i>
                                        </button>
                                    </div>
                                    @if (block.Type == "container")
                                    {
                                        <span class="ez-freeform-container-policy">
                                            <i class="fas fa-layer-group"></i>@ContainerPolicyLabel(arrangeBlock)
                                        </span>
                                    }
                                    @if (geometryLocked)
                                    {
                                        <span class="ez-freeform-block-lock"><i class="fas fa-lock"></i></span>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (CanModify && SelectedSection is { } selectedSection)
{
    <aside class="ez-section-editor-window"
           role="complementary"
           aria-label="@T("SectionEditorTabs")"
           data-selected-section-id="@selectedSection.Id">
        <div class="ez-section-editor-window__body">
            <div class="ez-edit-window-shell">
                <EditPanel @ref="_editPanel"
                           Section="selectedSection"
                           PageId="@Page.Id"
                           InitialTab="@_editPanelInitialTab"
                           InitialBlockId="@_editPanelSelectedBlockId"
                           BlockEditorRefreshVersion="@_blockEditorRefreshVersion"
                           CanArrangeBlocks="@IsArrangeCompatible(selectedSection)"
                           OnClose="ClosePanel"
                           OnSectionSaved="HandleSectionSaved"
                           OnSectionsChanged="OnSectionsChanged"
                           OnBlocksChanged="HandleBlocksChanged"
                           OnActiveBlockChanged="HandleEditorActiveBlockChanged"
                           OnAddBlockRequested="OpenBlockCreationModal"
                           OnArrangeBlocksRequested="EnterArrangeBlocks"
                           OnDiscardAndArrangeRequested="DiscardSectionChangesAndEnterArrangeBlocks"
                           OnDiscardRequested="DiscardSectionChangesAndClose"
                           OnDesignPreviewChanged="PreviewSectionDesign"
                           OnDirtyChanged="HandleSectionEditorDirtyChanged"
                           OnSaveAsPresetRequested="OpenSectionPresetDialog" />
            </div>
        </div>
    </aside>
}

@if (_showArrangeBlockWizard && _blockCreationRequest is not null)
{
    <div class="ez-modal-overlay ez-arrange-create-modal-overlay" @onclick="CloseArrangeBlockWizard">
        <div class="ez-modal ez-arrange-create-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="ez-arrange-create-modal-title"
             @onclick:stopPropagation="true">
            <div class="ez-arrange-create-panel">
                <div class="ez-arrange-create-panel__target">
                    <i class="fas fa-crosshairs"></i>
                    <span id="ez-arrange-create-modal-title">@T("CreateBlockIn"): <strong>@_blockCreationRequest.TargetLabel</strong></span>
                </div>
                <BlockCreationWizard Open="true"
                                     Busy="_creatingArrangeBlock"
                                     AdminLanguage="@AdminLanguage"
                                     AllowedTypes="@_blockCreationRequest.AllowedTypes"
                                     ConstraintLabel="@_blockCreationRequest.ConstraintLabel"
                                     Confirmed="CreateArrangeBlock"
                                     Cancelled="CloseArrangeBlockWizard" />
            </div>
        </div>
    </div>
}

<DxWindow Visible="_showSectionSelectionGuard"
          VisibleChanged="OnSectionSelectionGuardVisibilityChanged"
          Width="440px"
          MaxWidth="calc(100vw - 32px)"
          ShowCloseButton="false"
          CloseOnEscape="@(!_sectionSwitchBusy)"
          AllowResize="false"
          HorizontalAlignment="HorizontalAlignment.Center"
          VerticalAlignment="VerticalAlignment.Center">
    <BodyTemplate>
        <div class="block-arrange-guard" role="alertdialog" aria-labelledby="section-selection-guard-title">
            <header id="section-selection-guard-title">
                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                <strong>@T("UnsavedSectionChanges")</strong>
            </header>
            <p>@T("UnsavedSectionSelectionHint")</p>
            <footer>
                <button type="button" class="btn-admin btn-ghost" disabled="@_sectionSwitchBusy" @onclick="KeepCurrentSection">@T("KeepEditing")</button>
                <button type="button" class="btn-admin btn-danger" disabled="@_sectionSwitchBusy" @onclick="DiscardAndSelectPendingSection">
                    <i class="fas @(_sectionSwitchBusy ? "fa-spinner fa-spin" : "fa-trash-alt")" aria-hidden="true"></i>@T("DiscardAndContinue")
                </button>
            </footer>
        </div>
    </BodyTemplate>
</DxWindow>

@if (_presetSection is not null)
{
    <SectionPresetSaveDialog Visible="true"
                             VisibleChanged="OnSectionPresetDialogVisibilityChanged"
                             Section="_presetSection"
                             PageId="@Page.Id" />
}

<DxWindow Visible="@(CanArrange && ArrangeEditBlock is not null)"
          VisibleChanged="OnArrangeContentEditorVisibilityChanged"
          Width="680px"
          MaxWidth="calc(100vw - 32px)"
          CssClass="ez-arrange-content-window"
          BodyCssClass="ez-arrange-content-window__body"
          AllowResize="false"
          CloseOnEscape="true"
          ShowCloseButton="false"
          HorizontalAlignment="HorizontalAlignment.Center"
          VerticalAlignment="VerticalAlignment.Center">
    <BodyTemplate>
        @if (ArrangeEditBlock is { } editBlock)
        {
            <div class="ez-arrange-content-editor" @key="editBlock.Id">
                <header class="ez-arrange-content-editor__header">
                    <span class="ez-arrange-content-editor__identity">
                        <span class="ez-arrange-content-editor__title-row" @onclick:stopPropagation="true">
                            <i class="fas @BlockIcon(editBlock.Type)" aria-hidden="true"></i>
                            @if (_arrangeRenamingBlockId == editBlock.Id)
                            {
                                <input class="ez-arrange-content-editor__name-input"
                                       value="@_arrangeRenameDraft"
                                       autofocus
                                       placeholder="@BlockDisplayLabel(editBlock.Id)"
                                       aria-label="@T("BlockName")"
                                       @oninput="SetArrangeBlockNameDraft"
                                       @onblur="() => FinishArrangeBlockNameEdit(editBlock)"
                                       @onkeydown="eventArgs => HandleArrangeBlockNameKey(eventArgs, editBlock)"
                                       @onkeydown:stopPropagation="true" />
                            }
                            else
                            {
                                <strong>@BlockDisplayLabel(editBlock.Id)</strong>
                                @if (SupportsArrangeBlockNameRename(editBlock))
                                {
                                    <button type="button"
                                            class="ez-arrange-content-editor__rename"
                                            title="@(CanRenameArrangeBlockName(editBlock) ? T("EditBlockName") : T("ContentLockedHint"))"
                                            aria-label="@T("EditBlockName")"
                                            disabled="@(!CanRenameArrangeBlockName(editBlock))"
                                            @onclick="() => StartArrangeBlockNameEdit(editBlock)">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                }
                            }
                        </span>
                        <small>@T("EditingLanguage"): @AdminLanguage.ToUpperInvariant()</small>
                    </span>
                    <button type="button" class="ez-icon-btn" @onclick="CloseArrangeContentEditor" aria-label="@T("Close")">
                        <i class="fas fa-times"></i>
                    </button>
                </header>

                @if (editBlock.Authoring.FullLocked || editBlock.Authoring.ContentLocked)
                {
                    <div class="block-layout-panel__lock-notice">
                        <i class="fas fa-lock"></i> @T("ContentLockedHint")
                    </div>
                }
                else
                {
                    <div class="ez-arrange-content-editor__body">
                        @switch (editBlock.Type)
                        {
                            case "text":
                                <TextBlockEditor Block="editBlock"
                                                 PageId="@Page.Id"
                                                 SectionId="@editBlock.SectionId"
                                                 Languages="_languages"
                                                 OnSaved="HandleArrangeContentSaved" />
                                break;
                            case "image":
                                <ImageBlockEditor Block="editBlock"
                                                  PageId="@Page.Id"
                                                  SectionId="@editBlock.SectionId"
                                                  Languages="_languages"
                                                  OnSaved="HandleArrangeContentSaved" />
                                break;
                            case "video":
                                <VideoBlockEditor Block="editBlock"
                                                  PageId="@Page.Id"
                                                  SectionId="@editBlock.SectionId"
                                                  Languages="_languages"
                                                  OnSaved="HandleArrangeContentSaved" />
                                break;
                            case "file":
                                <FileBlockEditor Block="editBlock"
                                                 PageId="@Page.Id"
                                                 SectionId="@editBlock.SectionId"
                                                 OnSaved="HandleArrangeContentSaved" />
                                break;
                            case "map":
                                <MapBlockEditor Block="editBlock"
                                                PageId="@Page.Id"
                                                SectionId="@editBlock.SectionId"
                                                OnSaved="HandleArrangeContentSaved" />
                                break;
                            case "form":
                                <FormBlockEditor Block="editBlock"
                                                 PageId="@Page.Id"
                                                 SectionId="@editBlock.SectionId"
                                                 Languages="_languages"
                                                 OnSaved="HandleArrangeContentSaved" />
                                break;
                            case "card":
                            case "button":
                            case "metric":
                            case "bullet-list":
                            case "step":
                            case "icon":
                                <DesignBlockEditor Block="editBlock"
                                                   PageId="@Page.Id"
                                                   SectionId="@editBlock.SectionId"
                                                   Languages="_languages"
                                                   OnSaved="HandleArrangeContentSaved" />
                                break;
                            case "container":
                                <ContainerBlockEditor Block="editBlock"
                                                      PageId="@Page.Id"
                                                      SectionId="@editBlock.SectionId"
                                                      Languages="_languages"
                                                      Children="ArrangeFormationChildren"
                                                      SlotSelected="OpenArrangeContentEditor"
                                                      OnSaved="HandleArrangeContentSaved" />
                                break;
                            default:
                                <p class="text-muted">@T("UnknownBlockType")</p>
                                break;
                        }
                    </div>
                }
            </div>
        }
    </BodyTemplate>
</DxWindow>

@code {
    [CascadingParameter(Name = "AdminLanguage")] public string AdminLanguage { get; set; } = "en";
