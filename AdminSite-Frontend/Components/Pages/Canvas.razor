                appearance.BackgroundMode,
                appearance.BackgroundColor,
                appearance.TextColor,
                appearance.BorderWidth,
                appearance.BorderStyle,
                appearance.BorderColor,
                appearance.BorderRadius,
                animation.Effect,
                animation.Trigger,
                animation.DurationMs,
                animation.DelayMs,
                animation.Easing,
                animation.PlayOnce,
                animation.StaggerMs,
                animation.ContinuousEffect,
                appearance.Opacity,
                appearance.Shadow,
