    private IEnumerable<PageChoice> PageChoices
    {
        get
        {
            var parent = ParentPage ?? Page;
            yield return new PageChoice(parent.Id, $"{T("Parent")}: {PageTitle(parent)}");

            foreach (var child in ChildPages.OrderBy(p => p.Order))
                yield return new PageChoice(child.Id, PageTitle(child));
        }
    }

    private string PageTitle(PageModel? page)
    {
        if (page?.Name is null) return "Untitled";
        if (page.Name.TryGetValue(AdminLanguage, out var localized) && !string.IsNullOrWhiteSpace(localized))
            return localized;
        if (page.Name.TryGetValue(AdminUiLocalizer.FallbackLanguage, out var configuredFallback) &&
            !string.IsNullOrWhiteSpace(configuredFallback))
            return configuredFallback;
        return "Untitled";
    }

    private string T(string key) => AdminUiLocalizer.T(key, AdminLanguage);

    private Task SelectPage(string id) => OnPageSelected.InvokeAsync(id);

    private string PreviewViewportButtonClass(string viewport) =>
        $"ez-canvas__device-button{(_previewViewport == viewport ? " is-active" : string.Empty)}";

    private async Task SetPreviewViewport(string viewport)
    {
        if (!IsInteractivePreview) return;
        var normalized = viewport is "tablet" or "mobile" ? viewport : "desktop";
        if (_previewViewport == normalized) return;
        _previewViewport = normalized;
        await ReloadPreviewSafelyAsync();
    }

    private IReadOnlyList<CanvasArrangeToolbar.CanvasBreadcrumbItem> SelectionBreadcrumbs
    {
        get
        {
            if (_selectedBlockIds.Count == 0) return Array.Empty<CanvasArrangeToolbar.CanvasBreadcrumbItem>();
            var current = ArrangeBlock(_selectedBlockIds.First());
            var chain = new List<BlockModel>();
            var visited = new HashSet<string>(StringComparer.Ordinal);
            while (current is not null && visited.Add(current.Id))
            {
                chain.Add(current);
                current = ArrangeBlock(current.ParentBlockId);
            }
            chain.Reverse();
            return chain.Select(block => new CanvasArrangeToolbar.CanvasBreadcrumbItem(
                block.Id,
                BlockDisplayLabel(block.Id))).ToList();
        }
    }

    private IReadOnlyList<CanvasArrangeToolbar.CanvasBlockSelectorItem> BuildBlockSelectorItems()
    {
        var result = new List<CanvasArrangeToolbar.CanvasBlockSelectorItem>();
        var section = Sections.FirstOrDefault(item => item.Id == ArrangeScopeSectionId && IsArrangeCompatible(item));
        if (section is null)
            return result;

        var sectionBlocks = _arrangeBlocks.Values
            .Where(block => block.SectionId == section.Id)
            .OrderByDescending(block => block.Order)
            .ThenBy(block => block.Id, StringComparer.Ordinal)
            .ToList();
        var visited = new HashSet<string>(StringComparer.Ordinal);
        string PeerKey(BlockModel block) => $"{section.Id}|{NormalizeParentId(block.ParentBlockId)}|{NormalizeBlockZone(block.BlockZone)}|{block.ColumnSlotId ?? string.Empty}";
        bool PeerHasLock(BlockModel block)
        {
            var key = PeerKey(block);
            return sectionBlocks.Any(peer => PeerKey(peer) == key && (peer.Authoring.FullLocked || peer.Authoring.GeometryLocked));
        }
        bool PresetAllowsReorder(BlockModel block)
        {
            if (string.IsNullOrWhiteSpace(block.ParentBlockId)) return true;
            var parent = sectionBlocks.FirstOrDefault(candidate => candidate.Id == block.ParentBlockId && candidate.Type == "container");
            return parent is null ||
                   !ContainerPresetCatalog.TryGetGoverned(parent.PresetKey, out var preset) ||
                   preset.ChildOrderingAllowed;
        }

        void Append(string? parentId, int depth)
        {
            foreach (var block in sectionBlocks.Where(item => NormalizeParentId(item.ParentBlockId) == NormalizeParentId(parentId)))
            {
                if (!visited.Add(block.Id)) continue;
                var peerKey = PeerKey(block);
                var locked = block.Authoring.FullLocked || block.Authoring.GeometryLocked;
                result.Add(new CanvasArrangeToolbar.CanvasBlockSelectorItem(
                    block.Id,
                    section.Id,
                    ArrangeSectionDisplayName(section),
                    BlockDisplayLabel(block.Id),
                    block.Type,
                    Math.Min(depth, 12),
                    block.Order,
                    peerKey,
                    block.Visible,
                    locked,
                    !locked && !PeerHasLock(block) && PresetAllowsReorder(block)));
                Append(block.Id, depth + 1);
            }
        }

        Append(null, 0);
        foreach (var orphan in sectionBlocks.Where(block => !visited.Contains(block.Id)))
        {
            var peerKey = PeerKey(orphan);
            var locked = orphan.Authoring.FullLocked || orphan.Authoring.GeometryLocked;
            result.Add(new CanvasArrangeToolbar.CanvasBlockSelectorItem(
                orphan.Id, section.Id, ArrangeSectionDisplayName(section), BlockDisplayLabel(orphan.Id), orphan.Type,
                0, orphan.Order, peerKey, orphan.Visible, locked,
                !locked && !PeerHasLock(orphan) && PresetAllowsReorder(orphan)));
        }
        return result;
    }

    private string ArrangeSectionDisplayName(SectionModel section)
    {
        var title = LangValue(section.SectionTitle);
        if (!string.IsNullOrWhiteSpace(title)) return title;
        var peers = Sections.Where(IsArrangeCompatible).OrderBy(item => item.Order).ThenBy(item => item.Id).ToList();
        var index = Math.Max(0, peers.FindIndex(item => item.Id == section.Id)) + 1;
        return $"{GetArrangeSectionLabel(section)} {index}";
    }

    protected override async Task OnInitializedAsync()
    {
        await AdminLanguageState.LoadSettingsAsync();
        _languages = AdminLanguageState.SupportedLanguages.Any()
            ? AdminLanguageState.SupportedLanguages.ToList()
            : new List<string> { "en" };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _dotNetRef = DotNetObjectReference.Create(this);

        if (CanArrange && _arrangeBlocksLoadedForPage != Page.Id && !_loadingArrangeBlocks)
        {
            await LoadArrangeBlocksAsync();
        }

        if (SelectedSection is not null && !_sectionEditorSizingInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("initSectionEditorPanelSizing");
                _sectionEditorSizingInitialized = true;
            }
            catch
            {
                // The editor remains usable at its governed default width.
            }
        }
        else if (SelectedSection is null && _sectionEditorSizingInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("destroySectionEditorPanelSizing");
            }
            catch (JSException)
            {
                // The editor DOM can disappear before its resize listeners are released.
            }
            _sectionEditorSizingInitialized = false;
        }

        if (!_overlayInitialized && _dotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("initCanvasOverlay", _dotNetRef);
                _overlayInitialized = true;
            }
            catch
            {
                Http.Notify(T("NotificationCanvasOverlayInitFailed"), 500);
            }
        }

        if (CanModify && !_sortableInitialized && _sectionPositions.Count > 0 && _dotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("initSortable", _overlayRef, _dotNetRef);
                _sortableInitialized = true;
            }
            catch
            {
                Http.Notify(T("NotificationSectionSortingInitFailed"), 500);
            }
        }

        if (CanArrange && !_arrangeEditorInitialized && _blockPositions.Count > 0 && _dotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("initFreeformBlockEditor", _overlayRef, _dotNetRef, CanvasScale);
                _arrangeEditorInitialized = true;
            }
            catch
            {
                Http.Notify(T("NotificationBlockArrangingInitFailed"), 500);
            }
        }

        if (CanArrange)
        {
            await SyncArrangeColumnWorkspacesAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(_selectedSectionId) && SelectedSection is null)
        {
            _selectedSectionId = null;
            _sectionEditorDirty = false;
            _pendingSectionSelectionId = null;
            _showSectionSelectionGuard = false;
        }

        var pageChanged = _currentPageId is not null && _currentPageId != Page.Id;
        if (pageChanged)
        {
            _arrangeBlocksActive = false;
            _restoreSectionEditorOnEdit = false;
            _arrangeReturnSectionId = null;
            _editPanelInitialTab = "design";
            _editPanelSelectedBlockId = null;
            _pendingArrangeSelectionId = null;
            _activeArrangeZoneId = null;
            _activeArrangeZoneKind = null;
            _activeArrangeColumnSlotId = null;
            _pendingArrangeExit = false;
        }

        if (!EditMode && _arrangeBlocksActive)
        {
            _editPanelSelectedBlockId = _selectedBlockIds.FirstOrDefault() ?? _editPanelSelectedBlockId;
            _arrangeBlocksActive = false;
            _restoreSectionEditorOnEdit = !string.IsNullOrWhiteSpace(_arrangeReturnSectionId);
        }

        SectionModel? sectionToRestore = null;
        if (EditMode && !ArrangeWorkspaceActive && _restoreSectionEditorOnEdit)
        {
            sectionToRestore = Sections.FirstOrDefault(section => section.Id == _arrangeReturnSectionId);
            _restoreSectionEditorOnEdit = false;
            _arrangeReturnSectionId = null;
            _editPanelInitialTab = "blocks";
        }

        var langChanged = _currentLang != AdminLanguage;
        var modeChanged = _currentCanModify != CanModify;
        var arrangeChanged = _currentCanArrange != CanArrange;
        var previewUrl = PreviewUrl;
        if (_currentPageId == Page.Id && _currentPreviewUrl == previewUrl &&
            !langChanged && !modeChanged && !arrangeChanged)
        {
            if (sectionToRestore is not null)
            {
                _selectedSectionId = sectionToRestore.Id;
                _sectionSelectionVersion++;
            }
            return;
        }

        if (langChanged)
        {
            _previewVersion++;
            _currentLang = AdminLanguage;
        }

        _currentPageId = Page.Id;
        _currentPreviewUrl = PreviewUrl;
        _currentCanModify = CanModify;
        _currentCanArrange = CanArrange;
        _sectionPositions = new();
        _blockPositions = new();
        _zonePositions = new();
        _iframeHeight = 2000;
        _selectedSectionId = sectionToRestore?.Id;
        _sectionSelectionVersion++;
        _selectedBlockIds.Clear();
        _activeArrangeSectionId = null;
        _activeArrangeZoneId = null;
        _activeArrangeZoneKind = null;
        _activeArrangeColumnSlotId = null;
        _pendingArrangeExit = false;
        _showArrangeBlockWizard = false;
        _blockCreationRequest = null;
        _arrangeBlocks.Clear();
        _arrangeBlocksLoadedForPage = null;
        _undoHistory.Clear();
        _redoHistory.Clear();
        _overlayInitialized = false;
        _sortableInitialized = false;
        _arrangeEditorInitialized = false;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("disposeCanvasOverlay");
            await JS.InvokeVoidAsync("destroySectionEditorPanelSizing");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        _dotNetRef?.Dispose();
    }

    // -- Called from overlay.js via postMessage -------------------

    [JSInvokable]
    public void UpdateSectionPositions(
        List<SectionPosition> positions,
        double documentHeight,
        List<BlockPosition>? blockPositions,
        List<ZonePosition>? zonePositions)
    {
        // Interactive Preview is a bounded browser viewport. Its document must
        // scroll inside the iframe so sticky, fixed and observer-driven content
        // behaves like the public site. Edit and Arrange still need the complete
        // document height for their coordinate overlays.
        if (IsInteractivePreview)
        {
            return;
        }

        var nextHeight = Math.Max(documentHeight, 400);
        blockPositions ??= new();
        zonePositions ??= new();
        if (Math.Abs(_iframeHeight - nextHeight) < 1 &&
            PositionsEqual(_sectionPositions, positions) &&
            BlockPositionsEqual(_blockPositions, blockPositions) &&
            ZonePositionsEqual(_zonePositions, zonePositions))
        {
            return;
        }

        _sectionPositions = positions;
        _blockPositions = blockPositions;
        _zonePositions = zonePositions;
        _iframeHeight = nextHeight;
        StateHasChanged();
    }

    private static bool PositionsEqual(List<SectionPosition> current, List<SectionPosition> next)
    {
        if (current.Count != next.Count) return false;

        for (var i = 0; i < current.Count; i++)
        {
            if (current[i].Id != next[i].Id) return false;
            if (Math.Abs(current[i].Top - next[i].Top) >= 1) return false;
            if (Math.Abs(current[i].Height - next[i].Height) >= 1) return false;
            if (Math.Abs(current[i].Width - next[i].Width) >= 1) return false;
        }

        return true;
    }

    private static bool BlockPositionsEqual(List<BlockPosition> current, List<BlockPosition> next)
    {
        if (current.Count != next.Count) return false;

        for (var i = 0; i < current.Count; i++)
        {
            if (current[i].Id != next[i].Id) return false;
            if (current[i].SectionId != next[i].SectionId) return false;
            if (current[i].PositionMode != next[i].PositionMode) return false;
            if (current[i].ParentBlockId != next[i].ParentBlockId) return false;
            if (current[i].Type != next[i].Type) return false;
            if (current[i].ZIndex != next[i].ZIndex) return false;
            if (Math.Abs(current[i].Top - next[i].Top) >= 1) return false;
            if (Math.Abs(current[i].Left - next[i].Left) >= 1) return false;
            if (Math.Abs(current[i].Height - next[i].Height) >= 1) return false;
            if (Math.Abs(current[i].Width - next[i].Width) >= 1) return false;
        }

        return true;
    }

    private static bool ZonePositionsEqual(List<ZonePosition> current, List<ZonePosition> next)
    {
        if (current.Count != next.Count) return false;

        for (var i = 0; i < current.Count; i++)
        {
            if (current[i].Id != next[i].Id) return false;
            if (current[i].SectionId != next[i].SectionId) return false;
            if (Math.Abs(current[i].Top - next[i].Top) >= 1) return false;
            if (Math.Abs(current[i].Left - next[i].Left) >= 1) return false;
            if (Math.Abs(current[i].Height - next[i].Height) >= 1) return false;
            if (Math.Abs(current[i].Width - next[i].Width) >= 1) return false;
        }

        return true;
    }

    [JSInvokable]
    public async Task<bool> SaveFreeformBlockLayout(
        string sectionId,
        string blockId,
        int x,
        int y,
        int w,
        int h,
        double leftPercent,
        double topPx,
        double widthPercent,
        double heightPx)
    {
        if (!CanArrange || !IsArrangeScopeSection(sectionId))
            return false;

        if (string.IsNullOrWhiteSpace(sectionId) || string.IsNullOrWhiteSpace(blockId))
            return false;

        var section = Sections.FirstOrDefault(s => s.Id == sectionId);
        if (section is null || !IsArrangeCompatible(section))
            return false;

        var position = _blockPositions.FirstOrDefault(item => item.Id == blockId && item.SectionId == sectionId);
        if (position is null) return false;
        var before = StateFromPosition(position);
        var after = new CanvasLayoutState(
            blockId, sectionId, x, y, w, h,
            leftPercent, topPx, widthPercent, heightPx, position.ZIndex);
        if (!await ApplyLayoutStatesAsync([after])) return false;
        PushHistory(new CanvasHistoryEntry(
            T("MoveOrResizeBlock"),
            () => ApplyLayoutStatesAsync([before]),
            () => ApplyLayoutStatesAsync([after])));
        _selectedBlockIds.Clear();
        _selectedBlockIds.Add(blockId);
        return true;
    }

    [JSInvokable]
    public async Task<bool> SaveFreeformBlockLayouts(List<CanvasLayoutMutation> items)
    {
        if (!CanArrange || items.Count < 2 || items.Any(item => !IsArrangeScopeSection(item.SectionId)))
            return false;
        var before = new List<CanvasLayoutState>();
        var after = new List<CanvasLayoutState>();
        foreach (var item in items)
        {
            var position = _blockPositions.FirstOrDefault(candidate =>
                candidate.Id == item.BlockId && candidate.SectionId == item.SectionId);
            if (position is null) return false;
            before.Add(StateFromPosition(position));
            after.Add(new CanvasLayoutState(
                item.BlockId, item.SectionId,
                item.X, item.Y, item.W, item.H,
                item.LeftPercent, item.TopPx, item.WidthPercent, item.HeightPx,
                position.ZIndex));
        }
        if (!await ApplyLayoutStatesAsync(after)) return false;
        PushHistory(new CanvasHistoryEntry(
            T("MoveBlocks"),
            () => ApplyLayoutStatesAsync(before),
            () => ApplyLayoutStatesAsync(after)));
        _selectedBlockIds.Clear();
        foreach (var item in items) _selectedBlockIds.Add(item.BlockId);
        return true;
    }

    private async Task LoadArrangeBlocksAsync()
    {
        _loadingArrangeBlocks = true;
        _arrangeBlocksLoadedForPage = Page.Id;
        try
        {
            var response = await BlockService.GetAllForPageAsync(Page.Id);
            _arrangeBlocks.Clear();
            foreach (var block in response.Data ?? new())
                _arrangeBlocks[block.Id] = block;
            _selectedBlockIds.RemoveWhere(id => !_arrangeBlocks.ContainsKey(id) || !IsArrangeScopeSection(_arrangeBlocks[id].SectionId));
            if (!string.IsNullOrWhiteSpace(_pendingArrangeSelectionId) &&
                _arrangeBlocks.TryGetValue(_pendingArrangeSelectionId, out var pendingBlock) &&
                IsArrangeScopeSection(pendingBlock.SectionId))
            {
                _selectedBlockIds.Clear();
                _selectedBlockIds.Add(_pendingArrangeSelectionId);
                _editPanelSelectedBlockId = _pendingArrangeSelectionId;
            }
            _pendingArrangeSelectionId = null;
            _activeArrangeSectionId = Sections.Any(section =>
                section.Id == ArrangeScopeSectionId && IsArrangeCompatible(section))
                    ? ArrangeScopeSectionId
                    : null;
        }
        finally
        {
            _loadingArrangeBlocks = false;
        }
    }

    private BlockModel? ArrangeBlock(string? blockId) =>
        !string.IsNullOrWhiteSpace(blockId) && _arrangeBlocks.TryGetValue(blockId, out var block)
            ? block
            : null;

    private string BlockDisplayLabel(string blockId)
    {
        var block = ArrangeBlock(blockId);
        if (block is null) return T("Block");
        var title = LangValue(block.EditorLabel)
            ?? LangValue(block.Title)
            ?? LangValue(block.Label)
            ?? LangValue(block.StepLabel)
            ?? LangValue(block.ButtonLabel)
            ?? (!string.IsNullOrWhiteSpace(block.FileName) ? block.FileName : null)
            ?? (!string.IsNullOrWhiteSpace(block.Asset?.FileName) ? block.Asset.FileName : null)
            ?? LangValue(block.Caption)
            ?? LangValue(block.AltText)
            ?? block.Pins?.Select(pin => pin.Label).FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
        if (!string.IsNullOrWhiteSpace(title)) return title;

        return $"{T("Untitled")} {BlockTypeOrdinal(block)}";
    }

    private int BlockTypeOrdinal(BlockModel block)
    {
        var peers = _arrangeBlocks.Values
            .Where(candidate => candidate.SectionId == block.SectionId && candidate.Type == block.Type)
            .OrderBy(candidate => candidate.Order)
            .ThenBy(candidate => candidate.Id, StringComparer.Ordinal)
            .ToList();
        return Math.Max(0, peers.FindIndex(candidate => candidate.Id == block.Id)) + 1;
    }

    private string? LangValue(Dictionary<string, string>? values)
    {
        if (values is null || values.Count == 0) return null;
        if (values.TryGetValue(AdminLanguage, out var localized) && !string.IsNullOrWhiteSpace(localized))
            return localized;
        if (values.TryGetValue(AdminUiLocalizer.FallbackLanguage, out var configuredFallback) &&
            !string.IsNullOrWhiteSpace(configuredFallback))
            return configuredFallback;
        return null;
    }

