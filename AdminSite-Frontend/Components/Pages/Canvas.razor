            _selectedBlockIds.Remove(position.Id);
        else
            _selectedBlockIds.Add(position.Id);
        _editPanelSelectedBlockId = position.Id;
        _activeArrangeSectionId = position.SectionId;
        _arrangeReturnSectionId = position.SectionId;
