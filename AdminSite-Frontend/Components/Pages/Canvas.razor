        var response = await BlockService.UpdateAsync(
            Page.Id,
            block.SectionId,
            block.Id,
            BlockUpdateDtoMapper.Build(block));
        if (!response.Success)
        {
            block.EditorLabel = before;
            if (_arrangeBlocks.TryGetValue(block.Id, out var failedStored))
                failedStored.EditorLabel = new Dictionary<string, string>(before);
            Http.Notify(response, failureFallback: T("NotificationSaveFailed"));
            return;
        }

        await ReloadPreviewSafelyAsync();
    }

    private async Task HandleArrangeBlockNameKey(KeyboardEventArgs e, BlockModel block)
    {
        if (string.Equals(e.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            await FinishArrangeBlockNameEdit(block);
        }
        else if (string.Equals(e.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            _arrangeRenameDraft = _arrangeRenameBeforeEdit;
            _arrangeRenamingBlockId = null;
        }
    }

    private void ApplyArrangeBlockName(BlockModel block, string value)
    {
        var language = ActiveArrangeBlockLanguage;
        var trimmed = value.Trim();
        var title = block.EditorLabel is null
            ? new Dictionary<string, string>()
            : new Dictionary<string, string>(block.EditorLabel);

        if (string.IsNullOrWhiteSpace(trimmed))
            title.Remove(language);
        else
            title[language] = trimmed;

        block.EditorLabel = title;
        if (_arrangeBlocks.TryGetValue(block.Id, out var stored))
            stored.EditorLabel = new Dictionary<string, string>(title);
    }

    private void ResetArrangeRenameState()
    {
        _arrangeRenamingBlockId = null;
        _arrangeRenameDraft = string.Empty;
        _arrangeRenameBeforeEdit = string.Empty;
    }

    private void HandleEditorActiveBlockChanged(string? blockId) =>
        _editPanelSelectedBlockId = blockId;

    private async Task HandleSectionSaved(string sectionId)
    {
        var res = await SectionService.GetByIdAsync(Page.Id, sectionId);
        if (res.Success && res.Data is not null)
        {
            var index = Sections.FindIndex(section => section.Id == sectionId);
            if (index >= 0)
            {
                Sections[index] = res.Data;
            }
        }

        await ReloadPreviewSafelyAsync();
    }

    private void HandleSectionEditorDirtyChanged(EditPanel.SectionDirtyChange change)
    {
        if (string.Equals(_selectedSectionId, change.SectionId, StringComparison.Ordinal))
            _sectionEditorDirty = change.Dirty;
    }

    private async Task PreviewSectionDesign(EditPanel.SectionDesignPreviewChange change)
    {
        if (string.IsNullOrWhiteSpace(change.SectionId)) return;
        try
        {
            await JS.InvokeVoidAsync("patchPreviewSectionStyle", change.SectionId, change.Style);
        }
        catch
        {
            // A preview refresh or iframe navigation can briefly make the target unavailable.
        }
    }

    private async Task DiscardSectionChangesAndClose(string sectionId)
    {
        await ReloadSectionFromServer(sectionId);
        await ClosePanel();
        await ReloadPreviewSafelyAsync();
    }

    private void KeepCurrentSection()
    {
        if (_sectionSwitchBusy) return;
        _showSectionSelectionGuard = false;
        _pendingSectionSelectionId = null;
    }

    private async Task DiscardAndSelectPendingSection()
    {
        if (_sectionSwitchBusy) return;
        var pendingId = _pendingSectionSelectionId;
        var currentId = _selectedSectionId;
        var operationVersion = ++_sectionSelectionVersion;
        _sectionSwitchBusy = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(currentId))
                await ReloadSectionFromServer(currentId);
            await ReloadPreviewSafelyAsync();

            if (_sectionSelectionVersion == operationVersion && !string.IsNullOrWhiteSpace(pendingId))
            {
                var pending = Sections.FirstOrDefault(section => section.Id == pendingId);
                if (pending is not null)
                    SelectSectionWithoutGuard(pending);
            }
        }
        finally
        {
            _sectionSwitchBusy = false;
            _showSectionSelectionGuard = false;
            _pendingSectionSelectionId = null;
        }
    }

    private Task OnSectionSelectionGuardVisibilityChanged(bool visible)
    {
        if (!visible && _sectionSwitchBusy)
            return Task.CompletedTask;
        _showSectionSelectionGuard = visible;
        if (!visible) _pendingSectionSelectionId = null;
        return Task.CompletedTask;
    }

    private async Task ReloadSectionFromServer(string sectionId)
    {
        var response = await SectionService.GetByIdAsync(Page.Id, sectionId);
        if (!response.Success || response.Data is null) return;
        var index = Sections.FindIndex(section => section.Id == sectionId);
        if (index >= 0) Sections[index] = response.Data;
    }

    private async Task HandleBlocksChanged(string sectionId)
    {
        await RefreshSectionModelAsync(sectionId);
        await ReloadPreviewSafelyAsync();
    }

    private async Task RefreshSectionModelAsync(string sectionId)
    {
        var response = await SectionService.GetByIdAsync(Page.Id, sectionId);
        if (!response.Success || response.Data is null)
            return;

        var index = Sections.FindIndex(section => section.Id == sectionId);
        if (index >= 0)
            Sections[index] = response.Data;
    }

    private async Task ToggleVisibility(SectionModel section)
    {
        var res = await SectionService.SetVisibilityAsync(Page.Id, section.Id, !section.Visible);
        Http.NotifyInline(res, "canvas-authoring", T("NotificationSectionVisibilityUpdated"));
        if (!res.Success)
        {
            return;
        }

        section.Visible = !section.Visible;
        await OnSectionsChanged.InvokeAsync();
        await ReloadPreviewSafelyAsync();
    }

    private async Task DeleteSection(SectionModel section)
    {
        var res = await SectionService.DeleteAsync(Page.Id, section.Id);
        Http.Notify(res.Message, res.StatusCode);
        if (!res.Success)
        {
            return;
        }

        if (string.Equals(_selectedSectionId, section.Id, StringComparison.Ordinal))
            await ClosePanel();
        await OnSectionsChanged.InvokeAsync();
        await ReloadPreviewSafelyAsync();
    }

    [JSInvokable]
    public async Task OnReordered(List<string> orderedIds)
    {
        var res = await SectionService.ReorderAsync(Page.Id, orderedIds);
        Http.NotifyInline(res, "canvas-authoring", T("NotificationOrderSaved"), T("NotificationReorderFailed"));
        if (res.Success)
        {
            await OnSectionsChanged.InvokeAsync();
            await ReloadPreviewSafelyAsync();
        }
    }

    // -- Publish / Reset ------------------------------------------

    private async Task PublishPage()
    {
        _publishing = true;
        try
        {
            var res = await PageService.PublishAsync(Page.Id);
            Http.Notify(res, T("NotificationPublished"));
            if (res.Success)
            {
                await OnPageStatusChanged.InvokeAsync();
                await ReloadPreviewSafelyAsync();
            }
        }
        finally
        {
            _publishing = false;
        }
    }

    private async Task ResetPage()
    {
        _resetting = true;
        try
        {
            var res = await PageService.ResetAsync(Page.Id);
            Http.Notify(res, T("NotificationResetComplete"));
            if (res.Success)
            {
                await OnSectionsChanged.InvokeAsync();
                await OnPageStatusChanged.InvokeAsync();
                await ReloadPreviewSafelyAsync();
            }
        }
        finally
        {
            _resetting = false;
        }
    }

    private async Task ReloadPreviewSafelyAsync()
    {
        _previewVersion++;
        // Preserve the old shell height and overlays until the replacement
        // document reports its geometry. This prevents scroll collapse.
        _overlayInitialized = false;
        _sortableInitialized = false;
        _arrangeEditorInitialized = false;
        _appliedArrangeZoneWorkspaceHeights.Clear();
        await InvokeAsync(StateHasChanged);
    }

