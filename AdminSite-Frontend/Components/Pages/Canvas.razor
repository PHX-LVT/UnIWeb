    private static string NormalizeAuthoringShape(string? value) => value switch
    {
        "rounded" => "rounded",
        "pill" => "pill",
        "circle" => "circle",
        "ellipse" => "ellipse",
        _ => "rectangle"
    };
    private static string NormalizeAuthoringRadius(string? value) => value switch
    {
        "small" => "small",
        "medium" => "medium",
        "large" => "large",
        "pill" => "pill",
        "circle" => "circle",
        _ => "none"
