    private async Task FinishArrangeBlockNameEdit(BlockModel block)
    {
        if (!string.Equals(_arrangeRenamingBlockId, block.Id, StringComparison.Ordinal))
            return;

        _arrangeRenamingBlockId = null;
        var before = block.EditorLabel is null
            ? new Dictionary<string, string>()
