    private async Task CreateArrangeBlock(BlockStarterSelection selection)
    {
        var request = _blockCreationRequest;
        if (request is null || _creatingArrangeBlock) return;
        if (request.ReturnToArrange && !ArrangeCreateHasCapacity) return;
        _creatingArrangeBlock = true;
        var created = false;
        try
        {
            var dto = BlockStarterVariantCatalog.CreateDto(selection.Type, selection.VariantKey, selection.FormDefinitionId);
            dto.ParentBlockId = request.ParentBlockId;
            dto.BlockZone = request.BlockZone;
            dto.ZoneId = request.BlockZone;
            dto.ColumnSlotId = request.SlotId;
            dto.PositionMode = request.PositionMode;
            var response = string.IsNullOrWhiteSpace(request.SlotId)
                ? await BlockService.CreateAsync(request.PageId, request.SectionId, dto)
                : await BlockService.CreateInSlotAsync(request.PageId, request.SectionId, request.SlotId, dto);
            Http.Notify(response, T("NotificationBlockCreated"));
            if (!response.Success || response.Data is null) return;
            _showArrangeBlockWizard = false;
            _blockCreationRequest = null;
            _activeArrangeSectionId = request.SectionId;
            _editPanelSelectedBlockId = response.Data.Id;
            if (request.ReturnToArrange)
            {
                await RefreshAuthoringAsync([response.Data.Id]);
            }
            else
            {
                _editPanelInitialTab = "blocks";
                _blockEditorRefreshVersion++;
                await HandleBlocksChanged(request.SectionId);
            }
            created = true;
        }
        finally
        {
            _creatingArrangeBlock = false;
            if (request.ReturnToArrange)
                await CompleteArrangeBusyStateAsync(created);
        }
    }

    private async Task<bool> ReorderBlocksFromToolbar(CanvasArrangeToolbar.CanvasBlockReorderRequest request)
    {
        if (!CanArrange || !IsArrangeScopeSection(request.SectionId) || request.OrderedIds.Count == 0)
            return false;
        var requestedSet = request.OrderedIds.ToHashSet(StringComparer.Ordinal);
        var before = _arrangeBlocks.Values
            .Where(block => block.SectionId == request.SectionId && requestedSet.Contains(block.Id))
            .OrderBy(block => block.Order)
            .Select(block => block.Id)
            .ToList();
        var after = request.OrderedIds.ToList();
        if (before.Count != after.Count) return false;

        async Task<bool> Apply(IReadOnlyList<string> ids)
        {
            var response = await BlockService.ReorderAsync(Page.Id, request.SectionId, ids.ToList());
            Http.NotifyInline(response, "canvas-authoring", T("NotificationOrderSaved"), T("NotificationReorderFailed"));
            if (!response.Success) return false;
            await RefreshAuthoringAsync(_selectedBlockIds.ToList());
            return true;
        }

        if (await Apply(after))
        {
            PushHistory(new CanvasHistoryEntry(T("ReorderBlocks"), () => Apply(before), () => Apply(after)));
            return true;
        }

        return false;
    }

    private async Task ApplyToolbarVisualUpdate(CanvasArrangeToolbar.CanvasBlockVisualUpdate update)
    {
        if (!CanEditVisualSelection) return;
        var selected = _selectedBlockIds.Select(ArrangeBlock).Where(block => block is not null).Cast<BlockModel>().ToList();
        if (selected.Count == 0) return;
        var before = selected.Select(block => new CanvasBlockDtoState(
            block.Id, block.SectionId, CloneUpdateDto(BlockUpdateDtoMapper.Build(block)))).ToList();
        var after = before.Select(state =>
        {
            var dto = CloneUpdateDto(state.Dto);
            dto.Appearance ??= new BlockAppearanceDto { SchemaVersion = 2 };
            dto.Animation ??= new BlockAnimationSettingsDto { SchemaVersion = 1 };
            dto.Layout ??= new BlockLayoutDto();
            switch (update.Scope)
            {
                case "shape":
                    dto.Appearance.Shape = update.Shape;
                    if (NormalizeAuthoringShape(update.Shape) == "circle")
                    {
                        dto.Appearance.AspectRatio = "square";
                        var position = _blockPositions.FirstOrDefault(item => item.Id == state.BlockId);
                        var circleSize = position is null
                            ? Math.Max(dto.Layout.HeightPx ?? 48d, 48d)
                            : Math.Clamp(position.Width, 48, Math.Max(position.SectionHeight, 48));
                        dto.Layout.HeightPx = circleSize;
                        dto.Layout.H = Math.Clamp((int)Math.Round(circleSize / 48d), 1, 40);
                    }
                    break;
                case "fill":
                    dto.Appearance.BackgroundMode = update.BackgroundMode;
                    dto.Appearance.BackgroundColor = update.BackgroundColor;
                    dto.Appearance.TextColor = update.TextColor;
                    break;
                case "border":
                    dto.Appearance.BorderWidth = update.BorderWidth;
                    dto.Appearance.BorderStyle = update.BorderStyle;
                    dto.Appearance.BorderColor = update.BorderColor;
                    dto.Appearance.BorderRadius = update.BorderRadius;
                    break;
                case "animation":
                    dto.Animation.Effect = update.AnimationEffect;
                    dto.Animation.Trigger = update.AnimationTrigger;
                    dto.Animation.DurationMs = update.DurationMs;
                    dto.Animation.DelayMs = update.DelayMs;
                    dto.Animation.Easing = update.AnimationEasing;
                    dto.Animation.PlayOnce = update.PlayOnce;
                    var source = selected.FirstOrDefault(block => block.Id == state.BlockId);
                    dto.Animation.StaggerMs = string.Equals(source?.Type, "container", StringComparison.OrdinalIgnoreCase)
                        ? update.StaggerMs
                        : 0;
                    var isDecorative = dto.Appearance.Decorative == true || source?.Appearance.Decorative == true;
                    dto.Animation.ContinuousEffect = isDecorative ? update.ContinuousEffect : "none";
                    dto.Animation.DisableForReducedMotion = true;
                    break;
                default:
                    dto.Appearance.Opacity = update.Opacity;
                    dto.Appearance.Shadow = update.Shadow;
                    dto.Appearance.TextAlign = update.TextAlign;
                    dto.Appearance.Padding = update.Padding;
                    break;
            }
            return state with { Dto = dto };
        }).ToList();

        if (await ApplyBlockDtoStatesAsync(after))
        {
            PushHistory(new CanvasHistoryEntry(
                T("UpdateBlockAppearance"),
                () => ApplyBlockDtoStatesAsync(before),
                () => ApplyBlockDtoStatesAsync(after)));
        }
        else
        {
            await RestoreToolbarVisualPreview();
        }
    }

    private async Task<bool> ApplyBlockDtoStatesAsync(IReadOnlyList<CanvasBlockDtoState> states)
    {
        if (states.Count == 0) return false;
        _runningAuthoringCommand = true;
        var succeeded = false;
        try
        {
            var updatedBlocks = new List<BlockModel>(states.Count);
            foreach (var state in states)
            {
                var response = await BlockService.UpdateAsync(Page.Id, state.SectionId, state.BlockId, state.Dto);
                if (!response.Success || response.Data is null)
                {
                    Http.Notify(response, failureFallback: T("NotificationSaveFailed"));
                    return false;
                }
                updatedBlocks.Add(response.Data);
            }

            foreach (var block in updatedBlocks)
                _arrangeBlocks[block.Id] = block;

            _visualStateVersion++;
            await InvokeAsync(StateHasChanged);
            for (var index = 0; index < updatedBlocks.Count; index++)
                await PatchPreviewBlockAsync(updatedBlocks[index], index == updatedBlocks.Count - 1);
            succeeded = true;
            return true;
        }
        finally
        {
            _runningAuthoringCommand = false;
            await CompleteArrangeBusyStateAsync(succeeded);
        }
    }

    private async Task PatchPreviewBlockAsync(BlockModel block, bool requestPositions = true)
    {
        var appearance = block.Appearance ?? new BlockAppearanceModel();
        var animation = block.Animation ?? new BlockAnimationSettingsModel();
        var layout = block.Layout ?? new BlockLayoutModel();
        await JS.InvokeVoidAsync("patchPreviewBlockVisual", block.Id, new
        {
            appearance.Shape,
            appearance.AspectRatio,
            appearance.RotationDeg,
            appearance.BackgroundMode,
            appearance.BackgroundColor,
            appearance.TextColor,
            appearance.Opacity,
            appearance.BorderWidth,
            appearance.BorderStyle,
            appearance.BorderColor,
            appearance.BorderRadius,
            appearance.Shadow,
            appearance.TextAlign,
            appearance.Padding
        }, new
        {
            animation.Effect,
            animation.Trigger,
            animation.DurationMs,
            animation.DelayMs,
            animation.Easing,
            animation.PlayOnce,
            animation.ContinuousEffect
        }, new
        {
            layout.X,
            layout.Y,
            layout.W,
            layout.H,
            layout.LeftPercent,
            layout.TopPx,
            layout.WidthPercent,
            layout.HeightPx,
            layout.ZIndex
        }, requestPositions);
    }

    private async Task PreviewToolbarShape(string shape)
