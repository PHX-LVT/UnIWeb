    private string PreviewScaleStyle =>
        $"width: {PreviewViewportWidth}px; height: {CssNumber(EffectiveIframeHeight)}px; transform: scale({CssNumber(CanvasScale)}); transform-origin: top left;";
    private string PreviewIframeStyle =>
        $"width: {PreviewViewportWidth}px; height: {CssNumber(EffectiveIframeHeight)}px; border: none; display: block; pointer-events: {(CanArrange ? "none" : "auto")};";
