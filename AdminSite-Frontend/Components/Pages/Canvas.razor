    private async Task HandleArrangeContentSaved()
    {
        var editedId = _arrangeContentEditBlockId;
        if (string.IsNullOrWhiteSpace(editedId))
            return;

        await LoadArrangeBlocksAsync();
        if (_arrangeBlocks.TryGetValue(editedId, out var block) && IsArrangeScopeSection(block.SectionId))
        {
            _selectedBlockIds.Clear();
            _selectedBlockIds.Add(editedId);
            _editPanelSelectedBlockId = editedId;
            await RefreshSectionModelAsync(block.SectionId);
        }
        else
        {
            _arrangeContentEditBlockId = null;
        }

        ResetArrangeRenameState();
        await ReloadPreviewSafelyAsync();
    }

