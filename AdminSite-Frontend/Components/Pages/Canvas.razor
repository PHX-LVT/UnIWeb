    private async Task RestoreToolbarVisualPreview()
    {
        var selected = _selectedBlockIds.Select(ArrangeBlock).Where(block => block is not null).Cast<BlockModel>().ToList();
        for (var index = 0; index < selected.Count; index++)
            await PatchPreviewBlockAsync(selected[index], index == selected.Count - 1);
    }

    private async Task PreviewToolbarRotation(double delta)
    {
        if (!CanEditVisualSelection || Math.Abs(delta) < 0.001) return;
        var items = _selectedBlockIds
            .Select(ArrangeBlock)
            .Where(block => block is not null)
            .Select(block => new
            {
                id = block!.Id,
                rotationDeg = NormalizeRotation(block.Appearance?.RotationDeg ?? 0, delta)
            })
            .ToArray();
        await JS.InvokeVoidAsync("previewBlockRotation", items);
    }

    private async Task CommitToolbarRotation(double delta)
    {
        if (!CanEditVisualSelection || Math.Abs(delta) < 0.001) return;
        var selected = _selectedBlockIds.Select(ArrangeBlock).Where(block => block is not null).Cast<BlockModel>().ToList();
        var before = selected.Select(block => new CanvasBlockDtoState(
            block.Id, block.SectionId, CloneUpdateDto(BlockUpdateDtoMapper.Build(block)))).ToList();
        var after = before.Select(state =>
        {
            var dto = CloneUpdateDto(state.Dto);
            dto.Appearance ??= new BlockAppearanceDto { SchemaVersion = 2 };
            dto.Appearance.RotationDeg = NormalizeRotation(dto.Appearance.RotationDeg ?? 0, delta);
            return state with { Dto = dto };
        }).ToList();

        if (await ApplyBlockDtoStatesAsync(after))
        {
            PushHistory(new CanvasHistoryEntry(
                T("RotateBlock"),
                () => ApplyBlockDtoStatesAsync(before),
                () => ApplyBlockDtoStatesAsync(after)));
        }
        else
        {
            await RestoreToolbarVisualPreview();
        }
    }

    private async Task DeleteArrangeSelection()
    {
        if (!CanDeleteSelection) return;
        var selected = _selectedBlockIds.Select(ArrangeBlock).Where(block => block is not null).Cast<BlockModel>().ToList();
        var sectionId = selected.Select(block => block.SectionId).Distinct(StringComparer.Ordinal).Single();
        var deletingIds = new HashSet<string>(_selectedBlockIds, StringComparer.Ordinal);
        deletingIds.UnionWith(OwnedDescendantIds(_selectedBlockIds));
        _runningAuthoringCommand = true;
        var deleted = false;
        try
        {
            var response = await BlockService.DeleteGraphsAsync(Page.Id, sectionId, selected.Select(block => block.Id));
            Http.Notify(response, T("NotificationBlockDeleted"));
            if (!response.Success) return;
            if (!string.IsNullOrWhiteSpace(_editPanelSelectedBlockId) && deletingIds.Contains(_editPanelSelectedBlockId))
                _editPanelSelectedBlockId = null;
            _selectedBlockIds.Clear();
            await RefreshAuthoringAsync(Array.Empty<string>());
            deleted = true;
        }
        finally
        {
            _runningAuthoringCommand = false;
            await CompleteArrangeBusyStateAsync(deleted);
        }
    }

    private static double NormalizeRotation(double current, double delta)
    {
        var value = double.IsFinite(current) && double.IsFinite(delta) ? (current + delta) % 360d : 0;
        if (value > 180d) value -= 360d;
        if (value <= -180d) value += 360d;
        return Math.Round(value, 3);
    }

    private static BlockUpdateDto CloneUpdateDto(BlockUpdateDto source)
    {
        var type = source.GetType();
        var json = System.Text.Json.JsonSerializer.Serialize(source, type);
        return (BlockUpdateDto)(System.Text.Json.JsonSerializer.Deserialize(json, type)
            ?? throw new InvalidOperationException("Could not clone the Block update snapshot."));
    }

    private bool IsSelectionParent(string blockId) =>
        _selectedBlockIds.Any(selected => IsAncestor(blockId, selected));

    private bool IsAncestor(string candidateId, string blockId)
    {
        var current = ArrangeBlock(blockId);
        var visited = new HashSet<string>(StringComparer.Ordinal);
        while (current is not null && !string.IsNullOrWhiteSpace(current.ParentBlockId) && visited.Add(current.Id))
        {
            if (current.ParentBlockId == candidateId) return true;
            current = ArrangeBlock(current.ParentBlockId);
        }
        return false;
    }

    private async Task RunAuthoringCommand(string command)
    {
        if (_runningAuthoringCommand) return;
        switch (command)
        {
            case "duplicate": await DuplicateSelectionAsync(); return;
        }
    }

    private HashSet<string> OwnedDescendantIds(IEnumerable<string> containerIds)
    {
        var pending = new Queue<string>(containerIds.Distinct(StringComparer.Ordinal));
        var descendants = new HashSet<string>(StringComparer.Ordinal);
        while (pending.Count > 0)
        {
            var parentId = pending.Dequeue();
            foreach (var child in _arrangeBlocks.Values.Where(block => block.ParentBlockId == parentId))
            {
                if (!descendants.Add(child.Id)) continue;
                if (string.Equals(child.Type, "container", StringComparison.OrdinalIgnoreCase))
                    pending.Enqueue(child.Id);
            }
        }
        return descendants;
    }

    private async Task ApplyLayoutHistoryAsync(
        IReadOnlyList<CanvasLayoutState> before,
        IReadOnlyList<CanvasLayoutState> after,
        string label)
    {
        if (!await ApplyLayoutStatesAsync(after)) return;
        PushHistory(new CanvasHistoryEntry(
            label,
            () => ApplyLayoutStatesAsync(before),
            () => ApplyLayoutStatesAsync(after)));
    }

    private async Task<bool> ApplyLayoutStatesAsync(IReadOnlyList<CanvasLayoutState> states)
    {
        if (states.Count == 0) return false;
        var sectionId = states[0].SectionId;
        if (states.Any(state => state.SectionId != sectionId)) return false;
        _runningAuthoringCommand = true;
        var succeeded = false;
        try
        {
            var response = await BlockService.UpdateLayoutsAsync(Page.Id, sectionId, new BlockBulkLayoutUpdateDto
            {
                Items = states.Select(ToMutation).ToList()
            });
            if (!response.Success)
            {
                Http.Notify(response, failureFallback: T("NotificationSaveFailed"));
                return false;
            }
            foreach (var state in states)
                ApplyStateLocally(state);

            var sectionGrew = await GrowArrangeSectionForFormBlocksAsync(sectionId, states);
            if (sectionGrew)
            {
                await ReloadPreviewSafelyAsync();
            }
            else
            {
                foreach (var state in states)
                {
                    try
                    {
                        await JS.InvokeVoidAsync("patchPreviewBlockLayout",
                            state.BlockId, state.X, state.Y, state.W, state.H,
                            state.LeftPercent, state.TopPx, state.WidthPercent, state.HeightPx, state.ZIndex);
                    }
                    catch { }
                }
                await InvokeAsync(StateHasChanged);
            }
            succeeded = true;
            return true;
        }
        finally
        {
            _runningAuthoringCommand = false;
            await CompleteArrangeBusyStateAsync(succeeded);
        }
    }

    private async Task DuplicateSelectionAsync()
    {
        if (_selectedBlockIds.Count == 0 || !IsCoherentSelection) return;
        var originals = _selectedBlockIds.ToList();
        var sectionId = SelectedPositions[0].SectionId;
        _runningAuthoringCommand = true;
        var succeeded = false;
        try
        {
            List<string> currentIds = new();
            async Task<bool> Duplicate()
            {
                var response = await BlockService.DuplicateAsync(Page.Id, sectionId, originals);
                if (!response.Success || response.Data is null)
                {
                    Http.Notify(response, failureFallback: T("NotificationSaveFailed"));
                    return false;
                }
                currentIds = response.Data.BlockIds;
                await RefreshAuthoringAsync(currentIds);
                return true;
            }
            async Task<bool> Remove()
            {
                var response = await BlockService.DeleteGraphsAsync(Page.Id, sectionId, currentIds);
                if (!response.Success) { Http.Notify(response, failureFallback: T("NotificationSaveFailed")); return false; }
                await RefreshAuthoringAsync(originals);
                return true;
            }
            if (await Duplicate())
            {
                PushHistory(new CanvasHistoryEntry(T("DuplicateBlocks"), Remove, Duplicate));
                succeeded = true;
            }
        }
        finally
        {
            _runningAuthoringCommand = false;
            await CompleteArrangeBusyStateAsync(succeeded);
        }
    }

    private void PushHistory(CanvasHistoryEntry entry)
    {
        _undoHistory.Push(entry);
        _redoHistory.Clear();
        while (_undoHistory.Count > 50)
        {
            var retained = _undoHistory.Take(50).Reverse().ToList();
            _undoHistory.Clear();
            foreach (var item in retained) _undoHistory.Push(item);
        }
    }

    private async Task RunHistoryAsync(bool undo)
    {
        var source = undo ? _undoHistory : _redoHistory;
        var target = undo ? _redoHistory : _undoHistory;
        if (source.Count == 0) return;
        var entry = source.Pop();
        var succeeded = undo ? await entry.Undo() : await entry.Redo();
        if (succeeded) target.Push(entry);
        else source.Push(entry);
    }

    private async Task RefreshAuthoringAsync(IEnumerable<string> selection)
    {
        _arrangeBlocksLoadedForPage = null;
        await LoadArrangeBlocksAsync();
        _selectedBlockIds.Clear();
        foreach (var id in selection.Where(_arrangeBlocks.ContainsKey)) _selectedBlockIds.Add(id);
        await ReloadPreviewSafelyAsync();
    }

    private CanvasLayoutState StateFromPosition(BlockPosition position)
    {
        var width = Math.Max(position.SectionWidth, 1);
        var leftPercent = Math.Clamp((position.Left - position.SectionLeft) / width * 100, 0, 100);
        var topPx = Math.Clamp(position.Top - position.SectionTop, 0, 10000);
        var widthPercent = Math.Clamp(position.Width / width * 100, 1, 100);
        return new CanvasLayoutState(
            position.Id, position.SectionId,
            Math.Clamp((int)Math.Round(leftPercent / 100d * 12), 0, 11),
            Math.Clamp((int)Math.Round(topPx / 48d), 0, 60),
            Math.Clamp((int)Math.Round(widthPercent / 100d * 12), 1, 12),
            Math.Clamp((int)Math.Round(position.Height / 48d), 1, 40),
            leftPercent, topPx, widthPercent, Math.Clamp(position.Height, 24, 10000),
            position.ZIndex);
    }

    private static BlockLayoutMutationDto ToMutation(CanvasLayoutState state) => new()
    {
        BlockId = state.BlockId,
        Layout = new BlockLayoutDto
        {
            X = state.X, Y = state.Y, W = state.W, H = state.H,
            LeftPercent = state.LeftPercent, TopPx = state.TopPx,
            WidthPercent = state.WidthPercent, HeightPx = state.HeightPx,
            ZIndex = state.ZIndex
        }
    };

    private async Task<bool> GrowArrangeSectionForFormBlocksAsync(
        string sectionId,
        IReadOnlyList<CanvasLayoutState> states)
    {
        var formBottomPx = states
            .Where(state => string.Equals(ArrangeBlock(state.BlockId)?.Type, "form", StringComparison.OrdinalIgnoreCase))
            .Select(state => state.TopPx + state.HeightPx)
            .DefaultIfEmpty(0)
            .Max();
        if (formBottomPx <= 0)
            return false;

        var section = Sections.FirstOrDefault(item => item.Id == sectionId);
        if (section is null)
            return false;

        var measuredSection = _sectionPositions.FirstOrDefault(item => item.Id == sectionId);
        var currentHeight = Math.Max(section.Style?.CustomMinHeightPx ?? 0, measuredSection?.Height ?? 0);
        var desiredHeight = Math.Clamp(
            (int)Math.Ceiling(formBottomPx + ArrangeFormSectionPaddingPx),
            120,
            ArrangeSectionMaxHeightPx);
        if (desiredHeight <= currentHeight + 1)
            return false;

        var style = ToSectionStyleDto(section.Style);
        style.Height = "custom";
        style.CustomMinHeightPx = desiredHeight;

        var response = await SectionService.UpdateStyleAsync(Page.Id, sectionId, style);
        if (!response.Success || response.Data is null)
        {
            Http.Notify(response, failureFallback: T("NotificationSaveFailed"));
            return false;
        }

        if (response.Data.Style is not null)
        {
            section.Style = response.Data.Style;
        }
        else
        {
            section.Style ??= new SectionStyleModel();
            section.Style.Height = "custom";
            section.Style.CustomMinHeightPx = desiredHeight;
        }
        return true;
    }

    private static SectionStyleDto ToSectionStyleDto(SectionStyleModel? style) => new()
    {
        BackgroundType = style?.BackgroundType,
        BackgroundColor = style?.BackgroundColor,
        BackgroundImageUrl = style?.BackgroundImageUrl,
        BackgroundVideoUrl = style?.BackgroundVideoUrl,
        BackgroundImageFit = style?.BackgroundImageFit,
        BackgroundImagePosition = style?.BackgroundImagePosition,
        GradientFrom = style?.GradientFrom,
        GradientTo = style?.GradientTo,
        GradientDirection = style?.GradientDirection,
        OverlayColor = style?.OverlayColor,
        OverlayOpacity = style?.OverlayOpacity,
        Height = style?.Height,
        CustomMinHeightPx = style?.CustomMinHeightPx,
        Padding = style?.Padding,
        ContentWidth = style?.ContentWidth,
        TextColor = style?.TextColor,
        MobileLayout = style?.MobileLayout,
        BlockLayoutMode = style?.BlockLayoutMode,
        BlockGridColumns = style?.BlockGridColumns,
        BlockGap = style?.BlockGap
    };

    private void ApplyStateLocally(CanvasLayoutState state)
    {
        var position = _blockPositions.FirstOrDefault(item => item.Id == state.BlockId);
        if (position is not null)
        {
            position.Left = position.SectionLeft + position.SectionWidth * state.LeftPercent / 100d;
            position.Top = position.SectionTop + state.TopPx;
            position.Width = position.SectionWidth * state.WidthPercent / 100d;
            position.Height = state.HeightPx;
            position.ZIndex = state.ZIndex;
        }
        var block = ArrangeBlock(state.BlockId);
        if (block?.Layout is not null)
        {
            block.Layout.X = state.X; block.Layout.Y = state.Y;
            block.Layout.W = state.W; block.Layout.H = state.H;
            block.Layout.LeftPercent = state.LeftPercent;
            block.Layout.TopPx = state.TopPx;
            block.Layout.WidthPercent = state.WidthPercent;
            block.Layout.HeightPx = state.HeightPx;
            block.Layout.ZIndex = state.ZIndex;
        }
    }

