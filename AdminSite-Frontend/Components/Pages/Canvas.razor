    private async Task EnterArrangeBlocks(string sectionId)
    {
        if (!CanModify || _arrangeBlocksActive)
            return;

        var section = Sections.FirstOrDefault(item => item.Id == sectionId);
        if (section is null || !IsArrangeCompatible(section))
            return;

        _arrangeBlocksActive = true;
        _arrangeReturnSectionId = section.Id;
        _activeArrangeSectionId = section.Id;
        _activeArrangeZoneId = null;
        _activeArrangeZoneKind = string.Equals(section.Type, "canvas", StringComparison.OrdinalIgnoreCase)
            ? "canvas"
            : "column";
        _activeArrangeColumnSlotId = null;
        _pendingArrangeExit = false;
        _pendingArrangeSelectionId = _editPanelSelectedBlockId;
        _editPanelInitialTab = "blocks";
        _selectedSectionId = null;
        _sectionSelectionVersion++;
        _restoreSectionEditorOnEdit = false;
        ResetArrangeWorkspaceState(clearActiveSection: false);
        await RefreshWorkspaceModeAsync();
    }

    private async Task DiscardSectionChangesAndEnterArrangeBlocks(string sectionId)
    {
        var response = await SectionService.GetByIdAsync(Page.Id, sectionId);
        Http.SilentSuccess(response);
        if (!response.Success || response.Data is null)
            return;

        var index = Sections.FindIndex(section => section.Id == sectionId);
        if (index >= 0)
            Sections[index] = response.Data;
        _selectedSectionId = response.Data.Id;
        await EnterArrangeBlocks(sectionId);
    }

    private async Task ExitArrangeBlocks()
    {
        if (!_arrangeBlocksActive)
            return;

        if (ArrangeAuthoringBusy)
        {
            _pendingArrangeExit = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await CompleteExitArrangeBlocksAsync();
    }

    private async Task CompleteExitArrangeBlocksAsync()
    {
        if (!_arrangeBlocksActive)
            return;

        var sectionId = _activeArrangeSectionId ?? _arrangeReturnSectionId;
        await ClearArrangeColumnWorkspacesAsync();
        _editPanelSelectedBlockId = _selectedBlockIds.FirstOrDefault() ?? _editPanelSelectedBlockId;
        _arrangeBlocksActive = false;
        _restoreSectionEditorOnEdit = false;
        _editPanelInitialTab = "blocks";
        _selectedSectionId = Sections.Any(item => item.Id == sectionId) ? sectionId : null;
        _sectionSelectionVersion++;
        _arrangeReturnSectionId = null;
        _pendingArrangeExit = false;
        ResetArrangeWorkspaceState(clearActiveSection: true);
        await RefreshWorkspaceModeAsync();
    }

    private async Task CompleteArrangeBusyStateAsync(bool commandSucceeded)
    {
        if (_pendingArrangeExit && !ArrangeAuthoringBusy)
        {
            if (commandSucceeded)
            {
                await CompleteExitArrangeBlocksAsync();
                return;
            }

            _pendingArrangeExit = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResetArrangeWorkspaceState(bool clearActiveSection)
    {
        // Keep the measured preview geometry. Clearing it shrinks the scaled
        // iframe before its next report and clamps the canvas viewport to top.
        _selectedBlockIds.Clear();
        _showArrangeBlockWizard = false;
        _blockCreationRequest = null;
        _arrangeBlocks.Clear();
        _arrangeBlocksLoadedForPage = null;
        _undoHistory.Clear();
        _redoHistory.Clear();
        _appliedArrangeZoneWorkspaceHeights.Clear();
        _sortableInitialized = false;
        _arrangeEditorInitialized = false;
        if (clearActiveSection)
        {
            _activeArrangeSectionId = null;
            _activeArrangeZoneId = null;
            _activeArrangeZoneKind = null;
            _activeArrangeColumnSlotId = null;
        }
    }

    private async Task RefreshWorkspaceModeAsync()
    {
        _currentPageId = Page.Id;
        _currentPreviewUrl = PreviewUrl;
        _currentLang = AdminLanguage;
        _currentCanModify = CanModify;
        _currentCanArrange = CanArrange;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectSection(SectionModel section)
    {
        if (!CanModify || _sectionSwitchBusy)
            return;

        if (string.Equals(_selectedSectionId, section.Id, StringComparison.Ordinal))
            return;

        if (!string.IsNullOrWhiteSpace(_selectedSectionId) &&
            (_sectionEditorDirty || _editPanel?.HasUnsavedChanges == true))
        {
            _pendingSectionSelectionId = section.Id;
            _showSectionSelectionGuard = true;
            return;
        }

        SelectSectionWithoutGuard(section);
        await Task.CompletedTask;
    }

    private void SelectSectionWithoutGuard(SectionModel section)
    {
        _editPanelSelectedBlockId = null;
        _selectedSectionId = section.Id;
        _sectionSelectionVersion++;
        _sectionEditorDirty = false;
        _pendingSectionSelectionId = null;
        _showSectionSelectionGuard = false;
    }

