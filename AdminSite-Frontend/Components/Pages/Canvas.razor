        _selectedBlockIds.Select(ArrangeBlock).All(block => string.Equals(block?.Type, "container", StringComparison.OrdinalIgnoreCase));
    private bool CanContinuousAnimationSelection => _selectedBlockIds.Count > 0 &&
        _selectedBlockIds.Select(ArrangeBlock).All(block => block?.Appearance.Decorative == true);
