    private async Task TargetArrangeSection(string sectionId)
    {
        if (!CanArrange) return;
        var section = Sections.FirstOrDefault(item => item.Id == sectionId && IsArrangeCompatible(item));
        if (section is null) return;

        if (!string.Equals(_activeArrangeSectionId, section.Id, StringComparison.Ordinal))
            await ClearArrangeColumnWorkspacesAsync();

        _activeArrangeSectionId = section.Id;
        _arrangeReturnSectionId = section.Id;
        _activeArrangeZoneId = null;
        _activeArrangeZoneKind = string.Equals(section.Type, "canvas", StringComparison.OrdinalIgnoreCase)
            ? "canvas"
            : "column";
        _activeArrangeColumnSlotId = null;
        _selectedBlockIds.Clear();
        _editPanelSelectedBlockId = null;
        _showArrangeBlockWizard = false;
        _blockCreationRequest = null;
    }

    private async Task TargetArrangeZone(ZonePosition zone)
    {
        if (!CanArrange) return;
        var section = Sections.FirstOrDefault(item => item.Id == zone.SectionId && IsArrangeCompatible(item));
        if (section is null) return;

        if (!string.Equals(_activeArrangeSectionId, section.Id, StringComparison.Ordinal))
            await ClearArrangeColumnWorkspacesAsync();

        _activeArrangeSectionId = section.Id;
        _arrangeReturnSectionId = section.Id;
        _activeArrangeZoneId = zone.Id;
        _activeArrangeZoneKind = string.IsNullOrWhiteSpace(zone.Kind) ? "canvas" : zone.Kind.Trim().ToLowerInvariant();
        _activeArrangeColumnSlotId = string.Equals(_activeArrangeZoneKind, "column", StringComparison.OrdinalIgnoreCase)
            ? zone.Id
            : null;
        _selectedBlockIds.Clear();
        _editPanelSelectedBlockId = null;
        _showArrangeBlockWizard = false;
        _blockCreationRequest = null;
    }

    private bool IsArrangeTargetZone(ZonePosition zone) =>
        CanArrange &&
        string.Equals(zone.SectionId, _activeArrangeSectionId, StringComparison.Ordinal) &&
        string.Equals(zone.Id, _activeArrangeZoneId, StringComparison.Ordinal);

    private static string ArrangeZoneWorkspaceKey(string sectionId, string zoneId) =>
        $"{sectionId}|{zoneId}";

    private int ArrangeZoneWorkspaceHeight(ZonePosition zone)
    {
        var key = ArrangeZoneWorkspaceKey(zone.SectionId, zone.Id);
        return _arrangeZoneWorkspaceHeights.TryGetValue(key, out var height)
            ? height
            : Math.Max(ArrangeColumnWorkspaceDefaultHeightPx, (int)Math.Ceiling(zone.Height));
    }

    private async Task ResizeArrangeZoneWorkspaceAsync(ZonePosition zone, int delta)
    {
        if (!CanArrange || !string.Equals(zone.Kind, "column", StringComparison.OrdinalIgnoreCase))
            return;

        var key = ArrangeZoneWorkspaceKey(zone.SectionId, zone.Id);
        var next = Math.Clamp(
            ArrangeZoneWorkspaceHeight(zone) + delta,
            ArrangeColumnWorkspaceDefaultHeightPx,
            ArrangeSectionMaxHeightPx);
        _arrangeZoneWorkspaceHeights[key] = next;
        _appliedArrangeZoneWorkspaceHeights.Remove(key);
        await SyncArrangeColumnWorkspacesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncArrangeColumnWorkspacesAsync()
    {
        if (!CanArrange || string.IsNullOrWhiteSpace(_activeArrangeSectionId))
            return;

        var section = Sections.FirstOrDefault(item => item.Id == _activeArrangeSectionId);
        if (!string.Equals(section?.Type, "columns", StringComparison.OrdinalIgnoreCase))
            return;
        var sectionId = section!.Id;

        foreach (var zone in _zonePositions.Where(item =>
                     string.Equals(item.SectionId, sectionId, StringComparison.Ordinal) &&
                     string.Equals(item.Kind, "column", StringComparison.OrdinalIgnoreCase)))
        {
            var key = ArrangeZoneWorkspaceKey(zone.SectionId, zone.Id);
            var desired = ArrangeZoneWorkspaceHeight(zone);
            _arrangeZoneWorkspaceHeights[key] = desired;
            if (_appliedArrangeZoneWorkspaceHeights.TryGetValue(key, out var applied) && applied == desired)
                continue;

            try
            {
                var appliedToPreview = await JS.InvokeAsync<bool>(
                    "setArrangeColumnWorkspace", zone.SectionId, zone.Id, desired);
                if (appliedToPreview)
                    _appliedArrangeZoneWorkspaceHeights[key] = desired;
            }
            catch (JSException)
            {
                // A stale browser asset must not terminate the Blazor circuit.
                return;
            }
        }
    }

    private async Task ClearArrangeColumnWorkspacesAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("clearArrangeColumnWorkspaces");
        }
        catch (JSException)
        {
        }

        _arrangeZoneWorkspaceHeights.Clear();
        _appliedArrangeZoneWorkspaceHeights.Clear();
    }

