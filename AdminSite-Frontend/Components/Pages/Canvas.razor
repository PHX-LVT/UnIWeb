    private static string NormalizeContainerPurpose(string? value) => value == "collection" ? "collection" : "composition";
    private BlockAppearanceModel? EffectiveArrangeAppearance(BlockModel? block)
    {
        if (block?.Appearance?.InheritFromContainer != true || string.IsNullOrWhiteSpace(block.ParentBlockId))
            return block?.Appearance;
        var parentLayout = ArrangeBlock(block.ParentBlockId)?.ContainerLayout;
        return parentLayout?.ShareAppearance == true ? parentLayout.SharedAppearance ?? block.Appearance : block.Appearance;
    }

    private string ContainerPolicyLabel(BlockModel? container)
    {
        if (container is null) return T("Container");
        var used = _arrangeBlocks.Values.Count(block => block.ParentBlockId == container.Id);
        var capacity = ContainerCapacityPolicy.MaxChildren(
            container.PresetKey,
            container.ContainerLayout?.Mode,
            container.ContainerLayout?.Columns);
        var capacityLabel = $"{used}/{capacity}";
        if (ContainerPresetCatalog.IsFormation(container.PresetKey))
            return $"{T("Formation")} · {capacityLabel}";
        if (NormalizeContainerPurpose(container.ContainerLayout?.Purpose) != "collection")
            return $"{T("Composition")} · {capacityLabel}";
        var allowed = container?.ContainerLayout?.AllowedChildType;
        var policy = string.IsNullOrWhiteSpace(allowed)
            ? T("EmptyCollection")
            : $"{T("Collection")}: {T(BlockTypeLabelKey(allowed))}";
        return $"{policy} · {capacityLabel}";
    }

