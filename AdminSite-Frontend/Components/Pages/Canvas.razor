    private ArrangeCreateTarget? CurrentArrangeCreateTarget
    {
        get
        {
            var sectionId = _activeArrangeSectionId;
            BlockModel? selected = null;
            if (_selectedBlockIds.Count > 0)
            {
                selected = ArrangeBlock(_selectedBlockIds.First());
                if (selected is not null) sectionId = selected.SectionId;
            }
            var section = Sections.FirstOrDefault(item => item.Id == sectionId && IsArrangeCompatible(item));
            if (section is null) return null;

            if (selected?.Type == "container" && _selectedBlockIds.Count == 1)
            {
                return new ArrangeCreateTarget(section.Id, selected.Id, "default", null, null,
                    $"{ArrangeSectionDisplayName(section)} / {BlockDisplayLabel(selected.Id)}");
            }

            if (selected is not null)
            {
                return new ArrangeCreateTarget(
                    section.Id,
                    selected.ParentBlockId,
                    NormalizeBlockZone(selected.BlockZone),
                    selected.ColumnSlotId,
                    selected.PositionMode,
                    string.IsNullOrWhiteSpace(selected.ParentBlockId)
                        ? ArrangeSectionDisplayName(section)
                        : $"{ArrangeSectionDisplayName(section)} / {BlockDisplayLabel(selected.ParentBlockId)}");
            }

            var isCanvas = string.Equals(section.Type, "canvas", StringComparison.OrdinalIgnoreCase);
            var activeZoneKind = string.IsNullOrWhiteSpace(_activeArrangeZoneKind)
                ? (isCanvas ? "canvas" : "column")
                : _activeArrangeZoneKind;
            var activeColumnSlot = string.Equals(activeZoneKind, "column", StringComparison.OrdinalIgnoreCase)
                ? _activeArrangeColumnSlotId
                : null;
            var defaultSlot = isCanvas
                ? null
                : activeColumnSlot ?? _zonePositions.FirstOrDefault(zone => zone.SectionId == section.Id && zone.Kind == "column")?.Id;
            if (!isCanvas && string.IsNullOrWhiteSpace(defaultSlot)) return null;
            var targetZone = isCanvas || string.Equals(activeZoneKind, "canvas", StringComparison.OrdinalIgnoreCase)
                ? "canvas"
                : "default";
            var label = string.IsNullOrWhiteSpace(defaultSlot)
                ? ArrangeSectionDisplayName(section)
                : $"{ArrangeSectionDisplayName(section)} / {T("ColumnZone")}";
            return new ArrangeCreateTarget(section.Id, null, targetZone, defaultSlot, null, label);
        }
    }

    private string ArrangeCreateTargetLabel => CurrentArrangeCreateTarget?.Label ?? T("SelectSection");
    private BlockModel? ArrangeCreateParent => CurrentArrangeCreateTarget?.ParentBlockId is { Length: > 0 } parentId
        ? ArrangeBlock(parentId)
        : null;
    private int ArrangeCreateChildCount => ArrangeCreateParent is null
        ? 0
        : _arrangeBlocks.Values.Count(block => block.ParentBlockId == ArrangeCreateParent.Id);
    private int ArrangeCreateCapacity => ArrangeCreateParent is null
        ? int.MaxValue
        : ContainerCapacityPolicy.MaxChildren(
            ArrangeCreateParent.PresetKey,
            ArrangeCreateParent.ContainerLayout?.Mode,
            ArrangeCreateParent.ContainerLayout?.Columns);
    private bool ArrangeCreateHasCapacity => ArrangeCreateParent is null || ArrangeCreateChildCount < ArrangeCreateCapacity;
    private ContainerPresetDefinition? ArrangeCreatePreset => ArrangeCreateParent is null
        ? null
        : ContainerPresetCatalog.ForExisting(ArrangeCreateParent.PresetKey);
    private ContainerPresetSlotDefinition? ArrangeCreateNextSlot =>
        ArrangeCreateParent is null
            ? null
            : ContainerCapacityPolicy.NextAvailableSlot(
                ArrangeCreateParent.PresetKey,
                _arrangeBlocks.Values
                    .Where(block => block.ParentBlockId == ArrangeCreateParent.Id)
                    .Select(block => block.Authoring?.PresetSlotName),
                ArrangeCreateAllowedTypes?.Count == 1 ? ArrangeCreateAllowedTypes.First() : "text");
    private string ArrangeAddTitle => ArrangeCreateHasCapacity
        ? T("AddBlock")
        : string.Format(T("ContainerCapacityReached"),
            ContainerCapacityPolicy.NormalizeMode(ArrangeCreateParent?.ContainerLayout?.Mode),
            ArrangeCreateCapacity);
    private IReadOnlyCollection<string>? ArrangeCreateAllowedTypes
    {
        get
        {
            var parent = ArrangeCreateParent;
            if (parent is null) return null;
            var lockedType = parent.ContainerLayout?.AllowedChildType;
            return NormalizeContainerPurpose(parent.ContainerLayout?.Purpose) == "collection" &&
                   ContainerCapacityPolicy.CanOwn(lockedType)
                ? new[] { lockedType! }
                : ContainerCapacityPolicy.AllowedChildTypes(parent.PresetKey);
        }
    }
    private string? ArrangeCreateConstraintLabel
    {
        get
        {
            var parent = ArrangeCreateParent;
            if (parent is null) return null;
            var messages = new List<string>
            {
                string.Format(T("ContainerCapacityStatus"), ArrangeCreateChildCount, ArrangeCreateCapacity)
            };
            if (ArrangeCreatePreset is not null)
                messages.Insert(0, string.Format(T("ContainerPresetStatus"), ArrangeCreatePreset.DisplayName));
            if (ArrangeCreateNextSlot is not null)
                messages.Add(string.Format(T("NextContainerSlot"), ArrangeCreateNextSlot.DisplayName));
            if (NormalizeContainerPurpose(parent.ContainerLayout?.Purpose) == "collection")
            {
                messages.Add(string.IsNullOrWhiteSpace(parent.ContainerLayout?.AllowedChildType)
                    ? T("CollectionFirstChildLocksType")
                    : $"{T("CollectionAllowsOnly")} {T(BlockTypeLabelKey(parent.ContainerLayout.AllowedChildType))}.");
            }
            return string.Join(" ", messages);
        }
    }

