@using Contracts.Public
@using System.Text.Json

<div class="sc-block sc-block--map">
    <div class="sc-map-block__canvas"
         data-sc-network-map
         data-center-lat="@(Block.CenterLat ?? 0)"
         data-center-lng="@(Block.CenterLng ?? 0)"
         data-zoom="@(Block.DefaultZoom ?? 12)"
         data-pins="@PinsJson"
         aria-label="Map">
        <div class="sc-map-placeholder">Map</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PublicMapBlockDto Block { get; set; } = default!;
    [Parameter] public string Lang { get; set; } = "en";
    private string PinsJson => JsonSerializer.Serialize((Block.Pins ?? new())
        .OrderBy(pin => pin.Order)
        .Select(pin => new { pin.Label, pin.Lat, pin.Lng, pin.Href }));
}
