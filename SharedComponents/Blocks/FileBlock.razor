@using Contracts.Public
@using SharedComponents.Helpers

<div class="sc-block sc-block--file">
    @if (!string.IsNullOrEmpty(Block.FileUrl))
    {
        <a href="@Block.FileUrl"
               download="@(Downloads ? Block.Filename : null)"
               target="@(Downloads ? null : "_blank")"
               rel="@(Downloads ? null : "noopener")"
               data-sc-download="@(Downloads ? "true" : null)"
               class="sc-file-link">
            <i class="@FileIcon" aria-hidden="true"></i>
            @DisplayName
        </a>
    }
    else
    {
        <span class="sc-file-link sc-file-link--unavailable">
            <i class="fas fa-file"></i>
            @DisplayName
        </span>
    }
</div>

@code {
    [Parameter, EditorRequired] public PublicFileBlockDto Block { get; set; } = default!;
    [Parameter] public string Lang { get; set; } = "en";
    private string DisplayName => StyleHelper.Lang(Block.DisplayName, Lang) is { Length: > 0 } value
        ? value
        : Block.Filename ?? string.Empty;
    private bool Downloads => string.Equals(Block.OpenBehavior, "download", StringComparison.OrdinalIgnoreCase);
    private string FileIcon => (Block.FileType ?? string.Empty).ToLowerInvariant() switch
    {
        var value when value.Contains("pdf") => "fas fa-file-pdf",
        var value when value.Contains("word") => "fas fa-file-word",
        var value when value.Contains("excel") || value.Contains("spreadsheet") => "fas fa-file-excel",
        var value when value.Contains("powerpoint") || value.Contains("presentation") => "fas fa-file-powerpoint",
        _ => Downloads ? "fas fa-file-download" : "fas fa-file"
    };
}
