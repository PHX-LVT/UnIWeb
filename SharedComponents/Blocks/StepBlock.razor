@using Contracts.Public
@using SharedComponents.Helpers

<div class="sc-block sc-design-block sc-step-block">
    <div class="sc-step-block__marker">
        @if (Block.IconVisual is not null || !string.IsNullOrWhiteSpace(Block.Icon))
        {
            <ContentIcon Icon="Block.IconVisual" LegacyClass="Block.Icon" Lang="Lang" />
        }
        else
        {
            <span>@MarkerLabel</span>
        }
    </div>
    <div>
        <div class="sc-step-block__label">@MarkerLabel</div>
        <h3>@StyleHelper.Lang(Block.Title, Lang)</h3>
        <p>@StyleHelper.Lang(Block.Description, Lang)</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PublicStepBlockDto Block { get; set; } = default!;
    [Parameter] public string Lang { get; set; } = "en";
    private string MarkerLabel => Block.AutoNumber
        ? $"{(Block.SequenceNumber ?? Block.Order + 1):00}"
        : StyleHelper.Lang(Block.StepLabel, Lang);
}
