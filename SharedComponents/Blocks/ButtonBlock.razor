@using Contracts.Public
@using SharedComponents.Helpers

<div class="sc-block sc-design-block sc-button-block">
    <ActionButton Action="@Block.Action" FormDefinitionId="@Block.FormDefinitionId" Href="@(string.IsNullOrWhiteSpace(Block.Href) ? "#" : Block.Href)"
                  Target="@Target" Rel="@Rel" Download="@Downloads"
                  CssClass="@($"sc-btn sc-btn--{(string.IsNullOrWhiteSpace(Block.Style) ? "filled" : Block.Style)}")">
        @if ((Block.IconVisual is not null || !string.IsNullOrWhiteSpace(Block.Icon)) && Block.IconPosition != "right")
        {
            <ContentIcon Icon="Block.IconVisual" LegacyClass="Block.Icon" Lang="Lang" />
        }
        @StyleHelper.Lang(Block.Label, Lang)
        @if ((Block.IconVisual is not null || !string.IsNullOrWhiteSpace(Block.Icon)) && Block.IconPosition == "right")
        {
            <ContentIcon Icon="Block.IconVisual" LegacyClass="Block.Icon" Lang="Lang" />
        }
    </ActionButton>
</div>

@code {
    [Parameter, EditorRequired] public PublicButtonBlockDto Block { get; set; } = default!;
    [Parameter] public string Lang { get; set; } = "en";
    private bool Downloads => string.Equals(Block.Action, "downloadFile", StringComparison.OrdinalIgnoreCase);
    private bool IsExternal => string.Equals(Block.Action, "externalUrl", StringComparison.OrdinalIgnoreCase);
    private string? Target => IsExternal ? "_blank" : null;
    private string? Rel => IsExternal ? "noopener noreferrer" : null;
}
