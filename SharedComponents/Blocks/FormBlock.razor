@using Contracts.Public

@if (string.IsNullOrWhiteSpace(Block.FormDefinitionId) || !Block.FormDefinitionAvailable)
{
    <div class="sc-form-definition-missing" role="status">
        <i class="fas fa-wpforms" aria-hidden="true"></i>
        <strong>@MissingTitle</strong>
        <span>@MissingHint</span>
    </div>
}
else
{
    <PublicFormRenderer Block="Block"
                        Lang="Lang"
                        Context="embedded"
                        OnSubmit="OnSubmit" />
}

@code {
    [Parameter, EditorRequired] public PublicFormBlockDto Block { get; set; } = default!;
    [Parameter] public string Lang { get; set; } = "en";
    [Parameter] public Func<Dictionary<string, string>, Task<PublicFormSubmitResult>>? OnSubmit { get; set; }

    private bool IsVietnamese => Lang.StartsWith("vi", StringComparison.OrdinalIgnoreCase);
    private bool IsChinese => Lang.StartsWith("zh", StringComparison.OrdinalIgnoreCase) || Lang.StartsWith("cn", StringComparison.OrdinalIgnoreCase);
    private string MissingTitle => IsVietnamese ? "Biểu mẫu không khả dụng" : IsChinese ? "表单不可用" : "Form unavailable";
    private string MissingHint => IsVietnamese ? "Biểu mẫu này chưa được cấu hình hoặc hiện đang tắt." : IsChinese ? "此表单尚未配置或当前已停用。" : "This form is not configured or is currently inactive.";
}
