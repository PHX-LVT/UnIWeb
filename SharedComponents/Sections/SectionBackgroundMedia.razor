@using Contracts.Public

@if (ShouldRenderImage)
{
    <img class="sc-section-bg-image"
         src="@BackgroundImageUrl"
         alt=""
         style="@ImagePlacementStyle"
         aria-hidden="true" />
}
else if (ShouldRenderVideo)
{
    <video class="sc-section-bg-video"
           src="@BackgroundVideoUrl"
           autoplay
           muted
           loop
           playsinline
           preload="metadata"
           aria-hidden="true"></video>
}

@code {
    [Parameter] public PublicSectionStyleDto? Style { get; set; }

    private string? BackgroundVideoUrl => Style?.BackgroundVideoUrl;
    private string? BackgroundImageUrl => Style?.BackgroundImageUrl;
    private string ImagePlacementStyle => StyleHelper.GetMediaPlacementStyle(
        Style?.BackgroundImagePlacement,
        Style?.BackgroundImageFit,
        Style?.BackgroundImagePosition);

    private bool ShouldRenderImage =>
        string.Equals(Style?.BackgroundType, "image", StringComparison.OrdinalIgnoreCase) &&
        !string.IsNullOrWhiteSpace(BackgroundImageUrl) &&
        Style?.BackgroundImagePlacement is not null;

    private bool ShouldRenderVideo =>
        string.Equals(Style?.BackgroundType, "video", StringComparison.OrdinalIgnoreCase) &&
        !string.IsNullOrWhiteSpace(BackgroundVideoUrl);
}
