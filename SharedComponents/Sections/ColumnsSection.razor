@using Contracts.Public
@using SharedComponents.Helpers
@using SharedComponents.Blocks

<section data-section-id="@Section.Id"
         class="@StyleHelper.GetSectionClass(Section.Style)"
         style="@StyleHelper.GetSectionStyle(Section.Style)">

    <SectionBackgroundMedia Style="Section.Style" />

    <div class="sc-section-overlay"
         style="@StyleHelper.GetOverlayStyle(Section.Style)"></div>

    <div style="position: relative; z-index: 1" class="sc-columns sc-columns--@Section.ColumnRatio sc-columns--gap-medium
        @(Section.StackOnMobile == true ? "sc-columns--stack" : "")">
        @foreach (var slot in Section.ColumnSlots?.OrderBy(s => s.Order) ?? Enumerable.Empty<PublicColumnSlotDto>())
        {
            var slotBlocks = slot.Blocks.OrderBy(block => block.Order).ToList();
            <div class="sc-column sc-block-zone sc-block-zone--column @(slot.Blocks.Any(IsFreeform) ? "sc-column--has-freeform" : "")"
                 data-block-zone="@slot.Id"
                 data-block-zone-kind="column">
                <SectionBlocks Blocks="@slotBlocks"
                               Style="@BuildSlotStyle(slotBlocks)"
                               SectionId="@Section.Id"
                               BlockZone="default"
                               DataZoneId="@slot.Id"
                               BlockFrameZoneId="@slot.Id"
                               IncludeDefaultZone="true"
                               MobileCompositionMode="stack"
                               Lang="@Lang"
                               ShowInvisible="@ShowInvisible"
                               OnSubmit="@OnSubmit" />
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public PublicColumnsSectionDto Section { get; set; } = default!;
    [Parameter] public string Lang { get; set; } = "en";
    [Parameter] public bool ShowInvisible { get; set; }
    [Parameter] public Func<string, Dictionary<string, string>, Task<PublicFormSubmitResult>>? OnSubmit { get; set; }

    private static bool IsFreeform(PublicBlockDto block) =>
        string.Equals(block.PositionMode, "freeform", StringComparison.OrdinalIgnoreCase);

    private static PublicSectionStyleDto BuildSlotStyle(IReadOnlyCollection<PublicBlockDto> blocks)
    {
        var freeformHeight = FreeformColumnHeight(blocks);
        return new PublicSectionStyleDto
        {
            BlockLayoutMode = freeformHeight.HasValue ? "freeform" : "stack",
            BlockGridColumns = 12,
            BlockGap = "medium",
            MobileLayout = "stack",
            CustomMinHeightPx = freeformHeight
        };
    }

    private static int? FreeformColumnHeight(IEnumerable<PublicBlockDto> blocks)
    {
        var freeform = blocks.Where(IsFreeform).ToList();
        if (freeform.Count == 0) return null;

        var height = Math.Max(320, freeform.Max(block =>
        {
            var layout = block.Layout ?? new PublicBlockLayoutDto();
            return FreeformTopPx(layout) + FreeformHeightPx(layout);
        }));
        return (int)Math.Ceiling(height);
    }

    private static double FreeformLeftPercent(PublicBlockLayoutDto layout) =>
        Math.Clamp(layout.LeftPercent ?? (Math.Clamp(layout.X, 0, 11) / 12d * 100), 0, 100);

    private static double FreeformWidthPercent(PublicBlockLayoutDto layout) =>
        Math.Clamp(layout.WidthPercent ?? (Math.Clamp(layout.W, 1, 12) / 12d * 100), 1, 100);

    private static double FreeformTopPx(PublicBlockLayoutDto layout) =>
        Math.Clamp(layout.TopPx ?? (Math.Clamp(layout.Y, 0, 60) * 48d), 0, 10000);

    private static double FreeformHeightPx(PublicBlockLayoutDto layout) =>
        Math.Clamp(layout.HeightPx ?? (Math.Clamp(layout.H, 1, 40) * 48d), 24, 10000);
}
