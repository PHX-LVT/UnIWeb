@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject ThemeService ThemeService
@inject IJSRuntime JS
@inject PublicApiService Api
@inject LanguageService LangService
@inject NavigationManager Navigation
@using SharedComponents.Helpers

@if (_ready)
{
    <SiteHeader Branding="_branding"
                Nav="_nav"
                GlobalButtons="_globalButtons"
                Lang="@_lang"
                Languages="_langs"
                OnLanguageChanged="SwitchLang"
                Scrolled="@_headerScrolled"
                Hidden="@_headerHidden" />

    <main>
        @Body
    </main>

    <SiteFooter Footer="_footer" />

    @if (_socialButtons.Any())
    {
        <SocialFloat Buttons="_socialButtons" />
    }

    <PublicFormModalHost Lang="@_lang" />
}
else if (_shellUnavailable)
{
    <div class="sc-not-found" role="alert">
        <h1>Site temporarily unavailable</h1>
        <p>@_shellMessage</p>
        <button type="button" class="sc-btn sc-btn--theme" @onclick="RetryShellAsync">Try again</button>
    </div>
}
else
{
    <div class="sc-loading"><div class="sc-spinner"></div></div>
}

@code {

    private bool _ready = false;
    private bool _disposed = false;
    private bool _headerScrolled = false;
    private bool _headerHidden = false;
    private bool _scrollInitialized = false;
    private bool _resetHeaderScrollPending = false;
    private bool _widgetsInitialized = false;
    private bool _shellUnavailable;
    private string _shellMessage = string.Empty;
    private string _lang = "en";
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    private List<PublicGlobalButton> _globalButtons = new();
    
    private PublicBranding _branding = new();
    private List<PublicNavItem> _nav = new();
    private PublicFooter _footer = new();
    private List<PublicSocialButton> _socialButtons = new();

    private List<string> _langs = new() { "en", "vi", "cn" };

    private async Task SwitchLang(string lang)
    {
        await LangService.SetAsync(lang);
        _lang = await LangService.GetAsync();
        await PublishLanguageAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_ready && !_scrollInitialized && !_disposed)
            {
                await InitializeHeaderScrollAsync();
            }

            if (_ready && _scrollInitialized && _resetHeaderScrollPending && !_disposed)
            {
                _resetHeaderScrollPending = false;
                await JS.InvokeVoidAsync("userSiteShell.resetHeaderScroll");
            }

            if (_ready && !_widgetsInitialized && !_disposed)
            {
                await JS.InvokeVoidAsync("cmsWidgets.init");
                _widgetsInitialized = true;
            }

            return;
        }

        Navigation.LocationChanged += HandleLocationChanged;
        await LoadShellAsync();
    }

    private async Task LoadShellAsync(bool forceThemeReload = false)
    {
        _ready = false;
        _shellUnavailable = false;
        _shellMessage = string.Empty;

        await LangService.LoadSettingsAsync();
        StyleHelper.SetFallbackLanguage(LangService.FallbackLanguage);
        _langs = LangService.Languages.Select(l => l.Code).ToList();
        _lang = await LangService.GetAsync();
        if (!_langs.Contains(_lang, StringComparer.OrdinalIgnoreCase))
        {
            _lang = "en";
        }

        await PublishLanguageAsync();

        var theme = await ThemeService.GetAsync(forceThemeReload);
        var css = ThemeService.ToCssVariables(theme);
        await JS.InvokeVoidAsync("userSiteShell.setThemeVars", css);

        var brandingTask = Api.GetBrandingAsync();
        var navTask = Api.GetNavigationAsync();
        var footerTask = Api.GetFooterAsync();
        var socialTask = Api.GetSocialAsync();
        var globalButtonsTask = Api.GetGlobalButtonsAsync();


        await Task.WhenAll(brandingTask, navTask, footerTask, socialTask, globalButtonsTask);

        var shellResultsAvailable = brandingTask.Result.IsAvailable &&
                                    navTask.Result.IsAvailable &&
                                    footerTask.Result.IsAvailable &&
                                    socialTask.Result.IsAvailable &&
                                    globalButtonsTask.Result.IsAvailable &&
                                    ThemeService.LastLoadStatus is PublicOperationStatus.Success or PublicOperationStatus.NotConfigured &&
                                    LangService.LastLoadStatus is PublicOperationStatus.Success or PublicOperationStatus.NotConfigured;
        if (!shellResultsAvailable)
        {
            _shellUnavailable = true;
            _shellMessage = FirstFailureMessage(
                (brandingTask.Result.IsAvailable, brandingTask.Result.Message),
                (navTask.Result.IsAvailable, navTask.Result.Message),
                (footerTask.Result.IsAvailable, footerTask.Result.Message),
                (socialTask.Result.IsAvailable, socialTask.Result.Message),
                (globalButtonsTask.Result.IsAvailable, globalButtonsTask.Result.Message));
            if (string.IsNullOrWhiteSpace(_shellMessage))
                _shellMessage = !string.IsNullOrWhiteSpace(ThemeService.LastLoadMessage)
                    ? ThemeService.LastLoadMessage
                    : LangService.LastLoadMessage;
            if (string.IsNullOrWhiteSpace(_shellMessage))
                _shellMessage = "The site shell could not be loaded. Please try again.";
            if (!_disposed) StateHasChanged();
            return;
        }

        _branding = brandingTask.Result.Data ?? new PublicBranding();
        _nav = navTask.Result.Data ?? [];
        _footer = footerTask.Result.Data ?? new PublicFooter();
        _globalButtons = globalButtonsTask.Result.Data ?? [];
        _socialButtons = socialTask.Result.Data ?? [];

        if (_disposed) return;
        _ready = true;
        StateHasChanged();
    }

    private Task RetryShellAsync() => LoadShellAsync(forceThemeReload: true);

    private static string FirstFailureMessage(params (bool Available, string Message)[] results)
    {
        foreach (var result in results)
        {
            if (!result.Available && !string.IsNullOrWhiteSpace(result.Message))
                return result.Message;
        }
        return string.Empty;
    }

    private async Task InitializeHeaderScrollAsync()
    {
        _scrollInitialized = true;
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("userSiteShell.initHeaderScroll", _dotNetRef);
    }

    private async Task PublishLanguageAsync()
    {
        await JS.InvokeVoidAsync("userSiteShell.setLanguage", _lang, LangService.FallbackLanguage);
    }

    [JSInvokable]
    public async Task SetHeaderState(bool scrolled, bool hidden)
    {
        var nextHidden = scrolled && hidden;
        if (_disposed || (_headerScrolled == scrolled && _headerHidden == nextHidden))
        {
            return;
        }

        _headerScrolled = scrolled;
        _headerHidden = nextHidden;
        await InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            // MainLayout persists between routes. Make a newly navigated page start
            // with a visible header, then let the browser re-sync its real position
            // after FocusOnNavigate has moved the viewport.
            _headerScrolled = false;
            _headerHidden = false;
            _resetHeaderScrollPending = _scrollInitialized;
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_scrollInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("userSiteShell.disposeHeaderScroll");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        Navigation.LocationChanged -= HandleLocationChanged;
        _dotNetRef?.Dispose();
    }
}
