@page "/"
@inject PublicApiService Api
@inject LanguageService LangService
@inject IJSRuntime JS
@implements IDisposable

@if (_page is not null)
{
    <PageRenderer Page="_page" Lang="@_lang" OnFormSubmit="HandleFormSubmit" />
}
else if (_notFound)
{
    <div class="sc-not-found">
        <h1>Page not found</h1>
    </div>
}
else if (_loadFailed)
{
    <div class="sc-not-found" role="alert">
        <h1>Page temporarily unavailable</h1>
        <p>@_loadMessage</p>
        <button type="button" class="sc-btn sc-btn--theme" @onclick="LoadPageAsync">Try again</button>
    </div>
}

@code {
    private PublicPageDto? _page;
    private bool _notFound = false;
    private bool _loadFailed;
    private string _loadMessage = string.Empty;
    private bool _widgetsInitialized = false;
    private string _lang = "en";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_page is not null && !_widgetsInitialized)
        {
            await JS.InvokeVoidAsync("cmsWidgets.init");
            _widgetsInitialized = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LangService.Changed += HandleLanguageChanged;
        _lang = await LangService.GetAsync();
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _notFound = false;
        _loadFailed = false;
        var result = await Api.GetPageAsync("home");
        _page = result.Data;
        _notFound = result.Status == PublicOperationStatus.NotFound;
        _loadFailed = !result.IsSuccess && !_notFound;
        _loadMessage = result.Message;
    }

    private Task<PublicFormSubmitResult> HandleFormSubmit(
        string pageId, string sectionId, string blockId,
        Dictionary<string, string> data)
    {
        return _page is null
            ? Task.FromResult(PublicFormSubmitResult.Rejected(PublicOperationStatus.Unavailable, "The page is not ready for submission."))
            : Api.SubmitFormAsync(_page.Slug, sectionId, blockId, data, _lang);
    }

    private void HandleLanguageChanged(string lang)
    {
        _lang = lang;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LangService.Changed -= HandleLanguageChanged;
    }
}
