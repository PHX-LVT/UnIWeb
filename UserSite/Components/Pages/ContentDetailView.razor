@page "/insights/{ContentType}/{ContentSlug}"
@inject PublicApiService Api
@inject LanguageService LangService
@inject IJSRuntime JS
@using Contracts.Public
@implements IDisposable

@if (_page is not null)
{
    <PageRenderer Page="_page" Lang="@_lang" OnFormSubmit="HandleFormSubmit" />
}
else if (_notFound)
{
    <div class="sc-not-found">
        <h1>Page not found</h1>
    </div>
}
else if (_loadFailed)
{
    <div class="sc-not-found" role="alert">
        <h1>Content temporarily unavailable</h1>
        <p>@_loadMessage</p>
        <button type="button" class="sc-btn sc-btn--theme" @onclick="LoadPageAsync">Try again</button>
    </div>
}

@code {
    [Parameter] public string ContentType { get; set; } = string.Empty;
    [Parameter] public string ContentSlug { get; set; } = string.Empty;

    private PublicPageDto? _page;
    private bool _notFound;
    private bool _loadFailed;
    private string _loadMessage = string.Empty;
    private string? _widgetsInitializedForPageId;
    private string _lang = "en";

    protected override async Task OnInitializedAsync()
    {
        LangService.Changed += HandleLanguageChanged;
        _lang = await LangService.GetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _notFound = false;
        _loadFailed = false;
        _widgetsInitializedForPageId = null;
        var result = await Api.GetContentPageAsync(ContentType, ContentSlug);
        _page = result.Data;
        _notFound = result.Status == PublicOperationStatus.NotFound;
        _loadFailed = !result.IsSuccess && !_notFound;
        _loadMessage = result.Message;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_page is not null && _widgetsInitializedForPageId != _page.Id)
        {
            await JS.InvokeVoidAsync("cmsWidgets.init");
            _widgetsInitializedForPageId = _page.Id;
        }
    }

    private Task<PublicFormSubmitResult> HandleFormSubmit(
        string pageId,
        string sectionId,
        string blockId,
        Dictionary<string, string> data)
    {
        return _page is null
            ? Task.FromResult(PublicFormSubmitResult.Rejected(PublicOperationStatus.Unavailable, "The content page is not ready for submission."))
            : Api.SubmitFormAsync(_page.FullSlug ?? _page.Slug, sectionId, blockId, data, _lang);
    }

    private void HandleLanguageChanged(string lang)
    {
        _lang = lang;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LangService.Changed -= HandleLanguageChanged;
    }
}
