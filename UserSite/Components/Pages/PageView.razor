@page "/{slug}"
@page "/{parentSlug}/{childSlug}"
@inject PublicApiService Api
@inject LanguageService LangService
@inject IJSRuntime JS
@using Contracts.Public
@implements IDisposable

@if (_page is not null)
{
    <PageRenderer Page="_page" Lang="@_lang" OnFormSubmit="HandleFormSubmit" />
}
else if (_notFound)
{
    <div class="sc-not-found">
        <h1>Page not found</h1>
    </div>
}
else if (_loadFailed)
{
    <div class="sc-not-found" role="alert">
        <h1>Page temporarily unavailable</h1>
        <p>@_loadMessage</p>
        <button type="button" class="sc-btn sc-btn--theme" @onclick="LoadPageAsync">Try again</button>
    </div>
}

@code {
    [Parameter] public string? Slug { get; set; }
    [Parameter] public string? ParentSlug { get; set; }
    [Parameter] public string? ChildSlug { get; set; }

    private PublicPageDto? _page;
    private bool _notFound = false;
    private bool _loadFailed;
    private string _loadMessage = string.Empty;
    private string? _widgetsInitializedForPageId;
    private string _lang = "en";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_page is not null && _widgetsInitializedForPageId != _page.Id)
        {
            await JS.InvokeVoidAsync("cmsWidgets.init");
            _widgetsInitializedForPageId = _page.Id;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LangService.Changed += HandleLanguageChanged;
        _lang = await LangService.GetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _notFound = false;
        _loadFailed = false;
        var result = !string.IsNullOrEmpty(ChildSlug)
            ? await Api.GetChildPageAsync(ParentSlug!, ChildSlug)
            : await Api.GetPageAsync(Slug!);
        _page = result.Data;
        _notFound = result.Status == PublicOperationStatus.NotFound;
        _loadFailed = !result.IsSuccess && !_notFound;
        _loadMessage = result.Message;
    }

    private Task<PublicFormSubmitResult> HandleFormSubmit(
     string pageId, string sectionId, string blockId,
     Dictionary<string, string> data)
    {
        if (!string.IsNullOrEmpty(ChildSlug))
            return Api.SubmitChildFormAsync(ParentSlug!, ChildSlug, sectionId, blockId, data, _lang);

        return Api.SubmitFormAsync(Slug!, sectionId, blockId, data, _lang);
    }

    private void HandleLanguageChanged(string lang)
    {
        _lang = lang;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LangService.Changed -= HandleLanguageChanged;
    }
}
