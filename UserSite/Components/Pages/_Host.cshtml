@page "/_Host"
@namespace UserSite.Pages
@using UserSite.Components
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MySite</title>
    <base href="~/" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Lato:wght@300;400;700;900&family=Lexend:wght@300;400;500;600;700;800&family=Montserrat:wght@300;400;500;600;700;800&family=Noto+Sans:wght@300;400;500;600;700;800&family=Noto+Serif:wght@300;400;500;600;700;800&family=Open+Sans:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800&family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="_content/SharedComponents/sc-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="_content/SharedComponents/css/html-sections/insights.css" />
    <link rel="stylesheet" href="_content/SharedComponents/css/html-sections/industry.css" />
    <link rel="stylesheet" href="_content/SharedComponents/css/html-sections/solutions.css" />
    <link rel="stylesheet" href="_content/SharedComponents/css/html-sections/sustainability.css" />
    <link rel="stylesheet" href="_content/SharedComponents/css/html-sections/technology.css" />
    <link rel="stylesheet" href="_content/SharedComponents/css/html-sections/about.css" />
    <link rel="stylesheet" href="_content/SharedComponents/css/html-sections/contact-network.css" />
    <link rel="stylesheet" href="_content/SharedComponents/css/theme-typography.css" />
    <style id="theme-vars"></style>
</head>
<body>
    <component type="typeof(App)" render-mode="Server" />
    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">x</a>
    </div>
    <script>
        window.cmsPublicApiBaseUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["ApiBaseUrl"] ?? ""));
        window.userSiteShell = window.userSiteShell || {};
        window.userSiteShell.setLanguage = window.userSiteShell.setLanguage || ((lang) => {
            const normalized = (lang || "en").toString().trim().toLowerCase() || "en";
            window.cmsPublicLanguage = normalized;
            document.documentElement.lang = normalized;
        });
    </script>
    <script src="js/site-shell.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="_content/SharedComponents/cms-widgets.js" asp-append-version="true"></script>
    <script src="_content/SharedComponents/block-diagrams.js" asp-append-version="true"></script>
    <script src="_content/SharedComponents/block-animations.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
